        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は政界の要路にあり、強い影響力を持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "多くの要路にいる人物たちが、その会議に出席した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "要路に就くことは、大きな責任を伴う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
