          "standard": [
            {
              "text": "パーティーに着ていくため、彼は新しいスーツに身を装った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "舞台に立つ女優は、華やかな衣装を身に装い、観客の視線を集めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、自分が犯人ではないと装うために、いつもと違う服装をした。",
              "citation": {
                "source": "Illusions AI",
