        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今年の米の出来は豊作だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "果物の出来具合をチェックする。",
              "citation": {
