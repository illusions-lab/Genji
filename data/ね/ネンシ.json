        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "遠方に住む親戚には、電話で年始の挨拶をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「今年もよろしくね！」と、年始に来た友人に挨拶した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新年の年始には、取引先を訪問するのが慣例だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
