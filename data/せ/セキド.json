  {
    "uuid": "f6671e00-d764-5ffe-96b7-0cd605a9bfe8",
    "entry": "積土",
    "reading": {
      "primary": "せきど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
