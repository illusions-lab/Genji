        "examples": {
          "standard": [
            {
              "text": "ゲシュタルト心理学では、外界の受容野（場）とその構造が重視される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ゲシュタルト心理学の場の理論は認知に関する重要な概念だ。",
              "citation": {
                "source": "Illusions AI",
