    "definitions": [
      {
        "index": 1,
        "gloss": "steadily",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は毎日コツコツと勉強を続けた結果、試験に合格した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "プロジェクトは遅々として進まなかったが、チームはコツコツと作業を続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "コツコツ貯金することが、将来の安心につながる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "そうかと思うと二、三日風呂にも行かず夜更まで机へすがったきりでコツコツ何か書いたり読んだりする。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "猟師は、焼木杭に烟管をコツコツ叩きながら、　今がた雷鳥が何羽も出来やした。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから夜しめ出しをくった時入口の戸をコツコツ叩く猫もある。",
              "citation": {
                "source": "猫六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "前者は纎細簡潔、冗漫や無駄を嫌つて一字一字を惜みながらコツコツと筆を運んだが、後者は深刻重厚、筆力のあふれるままにグングン筆を走らせた。",
              "citation": {
                "source": "氣質と文章",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……大方眠りつこうとしていると、不意に土間の隅に設けてある鶏舎のミノルカがコツコツコと騒ぎだした。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、ポケットから手を出して、その扉をコツコツ叩いた。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼は、指先で、窓硝子をコツコツ叩いた。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "足を悶える度にそれがコツコツ戸棚や扉に当る堅い冷たい不愉快な感覚が非常に誇張されて苦しみを助けた。",
              "citation": {
                "source": "病中記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、三番日の酔っぱらいだけは、全く正気を失っているものの如く、ぐにゃ／＼の頭は、洋車の泥よけにコツコツぶつかっていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに卑屈に落ちぶれたって、やっぱしコツコツと働かなきゃならないのが工人だ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――コツコツ、コツコツ――「なんだい、あの音は」食事の箸を止めながら、耳に注意をあつめる科で、行一は妻に※せする。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "淋い、森とした中に手拍子が揃って、コツコツコツコツと、鉄槌の音のするのは、この小屋に並んだ、一棟、同一材木｜納屋の中で、三個の石屋が、石を鑿るのである。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに就いて可笑しい話は、柄が三尺もある大きい薪割が今も家に在りますが、或日それを窃に持出しコツコツ悪戯して遊んで居たところ、重さは重し力は無し、過って如何なる機会にか膝頭を斬りました。",
              "citation": {
                "source": "少年時代",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚や鶏は時々隊をはなれて道傍の芝生へそれようとするのを、小さな針金のような鞭でコツコツとつっついては列に追い返している男がいる。",
              "citation": {
                "source": "夢",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、この鉄片の軽く地面をたたくコツコツという音が、次第にそれほど不愉快でなく、それどころか、おしまいにはかえって一種の適度な爽快な刺激として、からだを引きしめ、歩調を整えさせる拍節の音のようにも感ぜられるようになって来た。",
              "citation": {
                "source": "試験管",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その木の皮を石でたたきつぶすと、いいにおいがしたので、おとなたちが、昼ねをしている昼さがりなど、三人で、まるできつつきのように、木のみきをコツコツとたたいていたりしました。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "仔牛はコツコツコツコツと葡萄のたねをかみ砕いてゐました。",
              "citation": {
                "source": "黒ぶだう",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」仔牛がコツコツ鳴らしながら答へました。",
              "citation": {
                "source": "黒ぶだう",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "質素とした暮し向きでもわかる」「のみならず、結納まで済んだ話が、寝返りを打たれそうになっている事なぞはツイこの頃まで気付かずにおったらしく、騒動の起ったその日までコツコツと祝言の準備をしておった様子。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとの通りに淋しくなった山の中へコツコツと引き返した。",
              "citation": {
                "source": "怪青年モセイ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "工兵が数人かかって塔のねもとにコツコツ穴をうがっていた。",
              "citation": {
                "source": "LIBER STUDIORUM",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お話しをするまでもありません、過失って取落しまする際に、火の消えませんのが、壺の、この、」　と目通りで、真鍮の壺をコツコツと叩く指が、掌掛けて、油煙で真黒。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と促がすように言いかけられて、ハタと行詰ったらしく、杖をコツコツと瞬一ツ、唇を引緊めた。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉱蔵　（ふわふわと軽く詰め寄り、コツコツと杖を叩いて）血迷うな！",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗吉はそう断念めて、洋傘の雫を切って、軽く黒の外套の脇に挟みながら、薄い皮の手袋をスッと手首へ扱いて、割合に透いて見える、なぜか、硝子囲の温室のような気のする、雨気と人の香の、むっと籠った待合の裡へ、コツコツと――やはり泥になった――侘い靴の尖を刻んで入った時、ふとその目覚しい処を見たのである。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
