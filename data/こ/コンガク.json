  {
    "uuid": "b735a80e-8aee-5beb-b6a3-f4d4c0fbf56d",
    "entry": "困学",
    "reading": {
      "primary": "こんがく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
