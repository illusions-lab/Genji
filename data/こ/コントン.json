[
  {
    "uuid": "15db0e9f-ab61-5664-8d16-5f75ce5617f0",
    "entry": "混沌",
    "reading": {
      "primary": "こんとん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
