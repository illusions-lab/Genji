        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「乞目、」と坊主が、互に一声。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何うやら今までの乞目では、一度に一年も懸りさうぢや。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何を、切ればと言ふて早や今は……乞目！",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……雲、花片の数を算めば、思ふまゝの乞目が出て、双六に勝てたのに、……唯一刻を争ふて、焦つてお悶へ遊ばすから、危いとは思ひながら、我儘おつしやる可愛らしさに、謹慎もつひ忘れ、心が乱れて、よもやに曳かされ、人間の采を使つたので、効なく敵に負けました。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
