  {
    "uuid": "bc698b34-83df-5935-9cba-365e806fd4f9",
    "entry": "宝竜",
    "reading": {
      "primary": "ほうりゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この樹は枝が宝竜のごとく百の宝華を吐く故この名あり。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "七代三右衞門は天保十一年十月二日に四十四歳で歿し、寶龍院乘譽依心連戒居士と法諡せられた。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "天保元年に眞志屋十二代の五郎兵衞清常が歿した時、増田氏の金澤には七十九歳の自適齋東里、五十九歳の梅翁、三十四歳の寶龍院依心、十七歳の明了軒深廣、十歳の榮壽軒利貞が並存してゐた筈である。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "寶龍寺の部落を離るれば、山と山と相迫りて、唯※一條の血染川と細逕とを餘すのみなり。",
              "citation": {
                "source": "鹿野山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
