          "literary": [
            {
              "text": "弟余を顧みて曰く、秀吉の時代、義経の時代、或は又た明治の初年に逢遇せざりしを恨みしは、一、二年前のことなりしも、今にしては実に当代現今に生れたりしを喜ぶ。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから「人々に答ふ」といふ標題で出たのがいかなる難問に逢遇しても、極めて明快に極めて容易に解説されたが、いかにも心持がよくつて今だに忘れない。",
              "citation": {
                "source": "竹の里人〔二〕",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "果たしてしかりとせば、風災、火災、人災の三災に逢遇せりといわざるを得ず。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "午時、帆船二隻、汽船一隻に逢遇す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入り、二回小汽船に逢遇し、互いに汽笛を鳴らして過ぐ。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときどき汽船に逢遇す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前一回、汽船に逢遇す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁は此の運動の爲に、あらゆる悲慘をも甞め、あらゆる困難にも逢遇した。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁は此の運動の為に、あらゆる悲惨をも甞め、あらゆる困難にも逢遇した。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは僕の生涯に只一度の逢遇であるに相違ない。",
              "citation": {
                "source": "ヴエスヴイオ山",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし交渉は幾多の困難に逢遇しました。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
