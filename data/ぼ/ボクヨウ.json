        "動詞-サ変"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sheep farming",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ニュージーランドの多くの農家は、古くから牧羊を営んで生計を立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は高品質なウールを生産するため、牧羊の技術を学ぶためにイギリスへ留学した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "荒れ果てた土地を耕す代わりに、牧羊を始めることで村の経済を立て直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "牧羊者の祖先が山地の住民であったためか、それとも羊を追い回しおおかみでも追い払うために使われたものか、ともかくもいわゆるステッキとはだいぶちがったものである。",
              "citation": {
                "source": "ステッキ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "死者を納れる石棺のおもてへ、淫らな戯れをしている人の姿や、牝羊と交合している牧羊神を彫りつけたりした希臘人の風習を。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大マルズック星（木星）が天界の牧羊者（オリオン）の境を犯せば神々の怒が降るのも、月輪の上部に蝕が現れればフモオル人が禍を蒙るのも、皆、古書に文字として誌されてあればこそじゃ。",
              "citation": {
                "source": "文字禍",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに、己の家族が戮せられてふたたび漢に戻る気持を失ってからは、いっそうこの「漢節を持した牧羊者」との面接を避けたかった。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧羊人かつて蛇が莫大の金を巻けるを見、予て心得いた通り牛乳一桶をその辺に置き潜み窺うと、案の定かの蛇来て乳を飲み尽くし、また金を巻きいたが、渇いて何ともならずついに遠方へ水を求めに往った。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に牧羊人大願成就｜忝ないと、全然その金を窃み得た（ハーンの『アルバニッシュ・スチュジエン』巻一）。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝えて言う、かつて牧羊夫が三月に三月中天気を善くしてくれたら子羊一疋進ぜようと誓うた。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて気候至って穏やかに、三日｜経たば四月になるという時、三月、牧羊夫に子羊を求むると、たちまち吝くなって与えず。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬の望みで免状を認め賜わったのを、犬の内もっとも大きく信用もあらばとて牧羊犬に預け置いた。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋来って牧羊犬多忙となり、持ち歩む事ならず乾いた置き場所もない故、件の免状をその親友牝猫に預けようというと早速承知の印しにその背を曲げ高めて牧羊犬の足に擦り付けた。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにおいて牧羊犬と猫が、懸命になって免状を捜したが、と見れば殺して食う事となった。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧羊犬は免状なしに他の犬どもに見ゆるを恥じて姿を隠したので、諸犬これを尋ね廻れど更に行方知れず。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "畏怖　　　　　　エミイル・ヴェルハアレン北に面へるわが畏怖の原の上に、牧羊の翁、神楽月、角を吹く。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "疾風に歌ふ牧羊の翁、神楽月よ、今、わが頭掠めし稲妻の光にこの夕おどろおどろしきわが命かな。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "畏怖北に面へるわが畏怖の原の上に、牧羊の翁、神樂月角を吹く。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "疾風に歌ふ牧羊の翁、神樂月よ、今、わが頭掠めし稻妻の光にこの夕おどろおどろしきわが命かな。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "日はやゝに傾きて、遠里に靄はたち、中空の温もりに、草の香いや高き片岡、夢｜薫り、現は匂ふ今、眠眼の牧羊神、笙を吹きやみぬ。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "村雨ははらゝほろ、山梨の枝にかゝれば、けんけんほろゝうつ雉子の鳴く音に覺まされて、磐床いづる牧羊の神パアン、胸毛の露をはらひつゝ延欠して仰ぎ見れば、有無雲の中天をひとり寂しく鸛の鳥、遠の柴山かけて飛ぶ。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "慰はたゞこの笙の笛、牧羊神の笛の音に、世の秘事ぞかくれたる。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "をちこち山の影長く、夕の空の艶なるになほも笛吹く牧羊神。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　この逞しい老人は古い書棚をふり返り、何か牧羊神らしい表情を示した。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、この近代の牧羊神もやはり十字架を荷つてゐた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、この近代の牧羊神もやはり十字架を荷っていた。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "このアナトオル・フランスは十字架を背負つた牧羊神である。",
              "citation": {
                "source": "続文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "決して巷の漂流人や草原の牧羊者ではない。",
              "citation": {
                "source": "季節の馬車",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "（しかしこれも――彼は晩年ニコラス・セギユウルの「アナトオル・フランスとの對話」を讀んで、この幸福らしい牧羊神もまた十字架を背負つてゐるのを知り、大いに同感してゐたやうである。",
              "citation": {
                "source": "芥川龍之介論",
                "author": "――藝術家としての彼を論ず――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
