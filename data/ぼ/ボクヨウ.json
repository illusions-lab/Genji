[
  {
    "uuid": "5ad70f81-b8ca-5a1b-a098-a795d8c4fe0d",
    "entry": "牧羊",
    "reading": {
      "primary": "ぼくよう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
