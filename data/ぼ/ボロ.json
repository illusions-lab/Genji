    },
    "definitions": [
      {
        "index": 1,
        "gloss": "tremendous",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はぼろ儲けして、あっという間に大金持ちになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今回のプロジェクトでぼろ損を出してしまい、会社は大打撃を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昨日の株取引で、彼はぼろ勝ちしたと喜んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "長の年月、海を見るたびに、おぼろに感じてゐたことが、急に明るみに出た感じ。",
              "citation": {
                "source": "海の詩",
                "author": "――人と海――",
                "note": "青空文庫"
              }
            },
            {
              "text": "みよ空にまぼろしの島うかびて、樹木いつさいに峯にかがやき、憂愁の瀑ながれもやまず、われけふのおとろへし手を伸べ、しきりに齒がみをなし、光る無禮の風景をにくむ。",
              "citation": {
                "source": "光る風景",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "機会宮沢賢治恋のはじめのおとなひはかの青春に来りけりおなじき第二神来は蒼き上着にありにけりその第三は諸人の栄誉のなかに来りけりいまおゝその四愛憐は何たるぼろの中に来しぞも",
              "citation": {
                "source": "機会",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨、象のことを知らないで、象の部分を知つたことを以て、何かおぼろに感じた象のことを言表はさうとするやどんなことになるであらうか？",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "人夫よ　はやく夏草を刈りつくせ狼火をあげよ　烟を空にたなびかせよ空想の陣幕を野邊にはつてまぼろしの宴樂をほしいままにせよ。",
              "citation": {
                "source": "敵",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなにぼろぼろでも自分専用の楯があったら」「あります」私は思わず口をはさんだ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "震災に焼けなかったお蔭で、ぼろぼろにはなったが、昔の姿の名残を止めている。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "細民街のぼろアパアト、黄塵白日、子らの喧噪、バケツの水もたちまちぬるむ炎熱、そのアパアトに、気の毒なヘロインが、堪えがたい焦躁に、身も世もあらず、もだえ、のたうちまわっているのである。",
              "citation": {
                "source": "音に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おぼろげながら、それと察知できても、人々は何かの理由で大事をとつて、いたづらに右顧左眄し、笑ひにまぎらはし、確言を避ける風である。",
              "citation": {
                "source": "檀君の近業について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、こんな時に、おぼろげな記憶をたよつて、むかし讀んだ筈の本を搜しに歩かなければならぬはめに立ち到るのであるが、いまは、それもむづかしいだらう。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の齒は、ぼろぼろに缺けてゐるのである。",
              "citation": {
                "source": "容貌",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓の中にはさはやかの、おぼろかの　　砂の色せる絹｜衣。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦田には風が低く打ち、おぼろで、灰色だつた。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、幹には苔が蒸して、皮は土より柔く、ぼろぼろに腐っているから、生あるものの肌のようで、ぬらりと滑り、ぐちゃりと触れて、いやな気持がする。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めの方はもうぼろぼろに朽ちているが、それでもところどころに比較的鮮明な部分はある。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑中にある民家でぼろぼろに腐朽しているらしく見えていながら存外無事なのがある。",
              "citation": {
                "source": "颱風雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "思えば思うほどひとり壁立｜万仭の高さに挺身して行こうとする娘の健気な姿が空中でまぼろしと浮び、娘の足掻く裳からはうら哀しい雫が翁の胸に滴って翁を苦しめた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "高く抽き出でた花は蒐ってまぼろしの雲と棚曳き魂魄を匂いの火気に溶かしている。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すと」「すと」花にたまった雨の澪の砂に滴る音を聴いていると夢まぼろしのように大きな美しい五感｜交融の世界がクッションのように浮んで来て身辺をとり囲む。",
              "citation": {
                "source": "桃のある風景",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの所で川はまるで白と水色とぼろぼろになって崩れ落ちてゐた。",
              "citation": {
                "source": "あけがた",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、茶いろの少しぼろぼろの外套を着て、白い巾でつつんだ荷物を、二つに分けて肩に掛けた、赤髯のせなかのかがんだ人でした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もそれは間もなく日光にあたってぼろぼろに裂け、度々の出水に次から次と削られて行きましたが、新らしいものもまた出て来ました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "母国を叩く師匠のハリセンの音が、高くパーンと響くたび重苦しいしこりの一角がぼろっと崩れ落ちて胸のつかえがとれる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょっ、こんなにぼろっきれを集めてさ、まるでお宝みたいに抱いて寝てるんだよ……」　こう言ってナスターシャは、例の病的な神経性の笑い声を高々と立てるのであった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時はじめてご安心あそばして、まる一昼夜、そのぼろっ屑を両手に握りしめていらっしったっけ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "わずか十ルーブリか二十ルーブリくらいの品を取り出して、それをポケットへねじ込んでさ、女物のはいった長持の中でぼろっきれを引っかき回しただけなんだ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　がんりきはカンテラを持ち上げて、清次が逃げて行った方を冷笑気分に見廻し、「ぼろっ買い！",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、のろまがのろまでねえ証拠には、ぼろっ買い、とうとう味を占めやがった、抜け目のねえのろまめ！",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンスにはちがいないんだが、パァトナアをぼろっ布のように投げたり、ひきよせたり、ぐるぐる廻したり、たいへんな力技なんだ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きている空と海陸も海も　天地いっぱいああ何にも生きている世界だぼろっ切れを投げ捨てろ胸を　胸の皮引き剥がして仕舞えぐっと胸突きあげてくるものそいつが空いっぱい氾濫するのだ今！",
              "citation": {
                "source": "サガレンの浮浪者",
                "author": "広海大治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
