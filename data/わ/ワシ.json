  {
    "uuid": "d9f900a1-6c97-5453-bcce-82496643ecdb",
    "entry": "雕",
    "reading": {
      "primary": "わし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "道徳の旨を知らず、雕飾綴緝して、以て新奇となし、歯を鉗し舌を刺して、以て簡古と為し、世に於て加益するところ無し。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "否々、われも樂しかりし日なきにあらず、その樂しかりし日をのみ憶ひてあるべきに、君が昔話を聞きて、端なくもわが心の裡に雕られたる圖を繰りひろげつゝ、身のめぐりなるめでたき畫どもを忘れたりとて、姫は我に先だちて歩を移しき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「雕朽木、老大免左遷」の句がある。",
              "citation": {
                "source": "なかじきり",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "二年六十七歳、熈徳院石槨蓋裏雕文作字。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一年七十六歳、霊台院石槨蓋裏雕文作字。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "花亭の書牘に、「この北条小学纂註を蔵板に新雕いたし候、所望の人も候はば、何部なりとも可被仰下候、よき本に而御座候」と云つてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "石経山房の址を訪ふには、其手前｜雕塑家菊池氏の家の辺より南に入る。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに嶺松寺の廃絶した時、錦橋の墓はこれに雕つてあつた杉本仲温撰の墓表と共に湮滅し、錦橋は惟法諡を谷中共同墓地にある一基の合墓上に留め、杉本の文は偶江戸黄檗禅刹記中に存してゐること、既に云つた如くである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "居室にも竜を雕り繍帳にも竜を画き、日常竜の中に起臥していた。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "次いでゴーロア戦死し、王ついにイゲルナを娶り、これもほどなく戦死、アーサー嗣ぎ立て武名を轟かせしが、父に倣うてか毎に竜を雕った金の兜を着けたとあれば、英国でも竜を兜に飾った例は、五、六世紀の頃既にあったのだ。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "上にも言った通り、この神の一族は蛇を族霊としたから、この時も品地別命が肥長比売の膚に雕り付けた蛇の族霊の標か何かを見て、その部族を忌み逃げ出した事と思う。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "雕工に聞くに山茶と枇杷の木の槌で身を打てば、内腫を起し一生煩う誠に毒木だと。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "古川重房の『筑紫紀行』十に、丹後の九世渡の犬の堂、これは戒岩寺と智恩寺と両寺して犬一つ飼いけるが、両寺一度に鐘を鳴らすを聞いて、何方にか行かんと行きつ戻りつして労れ死にせしを埋めたる跡なりとて、林道春の文を雕りたる石碑立てりとある。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは檻に雕彫をした朱の窓の見える美しい舟であったが、中から笙に合せて歌う歌声がかすかに聞えていた。",
              "citation": {
                "source": "西湖主",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前者はアッシリアの浮雕を撮影した全紙の玻璃版で、極めて緻密なる細部の雕刻までを鮮明に現わして殆んど実物を髣髴せしめた。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "一面には従来の文章型を根本から破壊した革命家であったが、同時に一面においてはまた極めて神経的な新らしい雕虫の技術家であった。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "服部長八の漆喰細工の肖像館という見世物に陳列された椿岳の浮雕塑像はこの写真から取ったのであった。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "袋の文字は大河内侯の揮毫を当時の浅草区長の町田今輔が雕板したものだそうだ。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "僅か二十分ほど話して美術学校の一年生ぐらいが作ったらしい木雕の牛を見せられたが、それぎり美妙とは会わなかった。",
              "citation": {
                "source": "美妙斎美妙",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツマリ『其面影』の時は「文人でない」といいつつも久しぶりでの試みに自ずと筆が固くなって、余りに細部の雕琢にコセコセしたのが意外の累いをした。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "二葉亭の理智の認める処を正直にいわせれば世界における文学芸術の位置なぞは問題ではないのだが、儒教や武家の教養から文芸を雕虫末技視して軽侮する思想が頭の隅のドコかに粘り着いていて一生文人として終るを何となく物足らなく思わした。",
              "citation": {
                "source": "二葉亭追録",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、間もなく王昭君は、呼韓邪単于との間に儲けた伊屠智牙師という子を連子として次代の単于の雕陶漠皐へ喜びを以て嫁入った。",
              "citation": {
                "source": "沙漠の美姫",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "管子、小匡篇には齊桓公のことを記して「北至於孤竹山戎穢貉拘秦夏、西至流沙西虞、南至呉越巴雕題黒齒荊夷之國」とある。",
              "citation": {
                "source": "禹貢製作の時代",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち子張之儒・子思之儒・顏氏之儒・孟氏之儒・漆雕氏之儒・仲良氏之儒・孫氏（荀子）之儒・樂正氏之儒のあることを記してゐる。",
              "citation": {
                "source": "支那目録學",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし主もな本としては文心雕龍などが中心となつてゐる。",
              "citation": {
                "source": "支那目録學",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "史論としては劉※の文心雕龍から歴史に關する議論を引いてゐる。",
              "citation": {
                "source": "支那目録學",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "五、作品の雕琢に熱心なる事。",
              "citation": {
                "source": "彼の長所十八",
                "author": "――南部修太郎氏の印象――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
