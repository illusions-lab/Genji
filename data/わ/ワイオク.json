        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "六月八日夏亦涼わがこゝろ足らひてあれば四坪にも足らぬ小庭の蔭もすずしき六月二十七日三間屋余出獄之後、賃得者纔三間之矮屋也、竊審容膝之易安、陶然賦一絶容膝三間屋　　膝を容る三間の屋、曲肱一卷書　　肱を曲ぐ一巻の書。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "此点は懶惰な朝鮮農民の粗末な矮屋と甚だ異つてゐる。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "市街は矮屋小店のみなるも、汽車の来往頻繁なるは、石炭輸送のためなり。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "港頭に市街あるも矮屋のみ。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸頭の家屋、小丘の上下に点在し、木造トタンぶきまたは板ぶきにして、みな矮屋のみ。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "その所を以てすれば萩城の東郊にある、台所六畳、坐敷八畳の矮屋に過ぎず。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、昔ながらの山野と矮屋とを見慣れた我々の祖先が、かつて夢みたこともない壮大な伽藍の前に立った時の、甚深な驚異の情を想像する。",
              "citation": {
                "source": "偶像崇拝の心理",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "茅葺のいかにも矮屋也。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
