        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その書類なら、机の上かここ等に置いてあるはずなんだけど。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "いつもならこの時間、そこ等を散歩しているおじいさんの姿が見当たらない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "駅はどのあたりかと尋ねたら、「あそこ等へんだよ」と指をさして教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
