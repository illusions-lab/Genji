  {
    "uuid": "d7aec6f3-d844-5375-8922-091982fc65ca",
    "entry": "来来",
    "reading": {
      "primary": "らいらい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「二階にお通ししてお茶でも上げてお置き、なんだって今ごろ……御飯｜時も構わないで……」　とめんどうくさそうにいったが、あれ以来来た事のない古藤にあうのは、今のこの苦しい圧迫からのがれるだけでも都合がよかった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々は、道々、自分達が何故去年の夏以来来なかつたか！",
              "citation": {
                "source": "冬の風鈴",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「来世もまた来来世も、わたしはあなたの妻、あなたは私の夫よ、太郎さま。",
              "citation": {
                "source": "赤い婚礼",
                "author": "RED BRIDAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この別荘を持っている人も震災以来来なくなったんだね。",
              "citation": {
                "source": "悠々荘",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "同廿五日夜五ツ時頃高柳楠之助が家来来ル。",
              "citation": {
                "source": "坂本龍馬手記",
                "author": "イロハ丸航海日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "（家来来て桜実一皿を机の上に置き、バルコンの戸を鎖さんとす。",
              "citation": {
                "source": "痴人と死と",
                "author": "ホフマンスタアル　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
