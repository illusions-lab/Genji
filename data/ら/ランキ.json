          "literary": [
            {
              "text": "遊覧季節ではなかつたので、泊り客は甚だ少なく、ひつそりしてゐた。",
              "citation": {
                "source": "幼少の思ひ出",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "實はさつき山の内の駐在所の方からこちらへ寄つて行くやうにと云ふことでしたので……」　私は物慣れた巡査の態度にいゝ感じを受けて、入口の外のベンチに腰かけてゐた弟を促して、すぐ近くの停留場から、もうすつかり遊覽季節の客で混み合つてゐる藤澤行きの電車に乘つた。",
              "citation": {
                "source": "不良兒",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
