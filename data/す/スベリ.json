        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公園の大きな滑り台の滑りが良すぎて、子供たちが勢いよく飛び出してくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "顕微鏡のプレパラートを作成するために、慎重にスライドガラスを滑りの上に載せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "山道での土砂滑りに注意を促す標識が、至る所に立てられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
