    "definitions": [
      {
        "index": 1,
        "gloss": "Sasamorpha borealis (species of bamboo grass unique to Japan)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "篠竹の群生が山肌を覆い、風が吹くたびにザワザワと不思議な音を立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "篠竹は細くて丈夫なため、古くからザルや籠などの細工物の材料として重宝されてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "登山道が篠竹に覆われて見えにくくなっていたが、目印を頼りに慎重に進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "白い柔らかい鶏の羽毛を拇指の頭ぐらいの大きさに束ねてそれに細い篠竹の軸をつけたもので、軸の両端にちょっとした漆の輪がかいてあったような気がする。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朽葉色に垢附きて、見るも忌わしき白木綿の婦人の布を、篠竹の頭に結べる旗に、（厄病神）と書きたるを、北風に煽らせ、意気揚々として真先に歩むは、三十五六の大年増、当歳の児を斜に負うて、衣紋背の半に抜け、帯は毒々しき乳の上に捩上りて膏切ったる煤色の肩露出せり。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして竹林の中の草深い私の家を、土間の篠竹を、また紅い芙蓉や黄のカンナを、妻と二人の子を、その一人は生れてやっと一と月にしかならぬ篁子のことを、夜はまた満天の星座と浪の音と虫の声々とに闌けてゆく壊れかかった二階のバルコンと寝室とを私はまた心にふり返った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "某時木曾の御岳の麓へ往って、山の中で一夜を明し、朝の帰り猪を打つつもりで、待ち受けていると、前方の篠竹がざわざわ揺れだした。",
              "citation": {
                "source": "女仙",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの頃は亡くなった父が秋草を北千住の家の裏庭に作っていたので、土曜日に上条から父の所へ帰って見ると、もう二百十日が近いからと云って、篠竹を沢山買って来て、女郎花やら藤袴やらに一本一本それを立て副えて縛っていた。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛇はそのまま体を放して下に落ちて篠竹の茂りに隠れて往った。",
              "citation": {
                "source": "山寺の怪",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあたりは前岸から見ると草山のようになっているが、人の背たけほどもあるような箱根名物の篠竹と樹木が絡みあっていた。",
              "citation": {
                "source": "山寺の怪",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "路は篠竹と樹の絡みあって谷底のようになった処をあがったりおりたりした。",
              "citation": {
                "source": "山寺の怪",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "篠竹と樹木の絡みが次第に濃くなって来た。",
              "citation": {
                "source": "山寺の怪",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "分ける後から篠竹と樹木は音もなく絡みあった。",
              "citation": {
                "source": "山寺の怪",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "武士は篠竹と樹木の絡みが濃くなるにしたがって勇気が出た。",
              "citation": {
                "source": "山寺の怪",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十町ばかり往ったと思う比、天鵞絨の峰の頂上が篠竹と樹木の絡みあった前方に夕陽を浴びて見えた。",
              "citation": {
                "source": "山寺の怪",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは平地になって樹木と篠竹の茂が遠のいて一面に木の花が咲いていた。",
              "citation": {
                "source": "山寺の怪",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "地べたにはっているつるを起こして、篠竹を三本石垣に立て掛けたのにそれをからませてやったら、それから幾日もたたないうちに、おもしろいように元気よくつるを延ばし始めた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "善三は、青い篠竹を三本切って来て、何か拵えようとしているのであった。",
              "citation": {
                "source": "蜜柑",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杭も朽ち横に渡した竹も大方は朽ちはてゝゐるのであるが、其處に生えた篠竹やその間に匐うてゐる蔓草のために辛うじて倒壞を免れてゐる。",
              "citation": {
                "source": "庭さきの森の春",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、其處から上はやがて樹木は絶えて打續いた篠竹の原となつていた。",
              "citation": {
                "source": "樹木とその葉",
                "author": "四邊の山より富士を仰ぐ記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに一ツのアサガオの苗が芽を出したと仮定すると、これに適度の量の適温の水を与え、或いは汚泥、或いは腐魚、或いは糠秕、或いは燐酸石灰等の肥料を与え、その蔓を絡ませる篠竹や葭等で、支柱を設けて地に倒れることのないようにして、丁寧にその虫害を防ぐようなことは即ち助長である。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひよろ松の林もあれば、篠竹の藪もあつた。",
              "citation": {
                "source": "旅から帰つて",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、わるいくちなはでもあつたら何うするんです――』　道綱は路傍に生えてゐる篠竹を折つて、それを鞭のやうにして、まだそこいらに蛇がゐはしないか、ゐたら、今度こそ遁がさないと言つたやうに草原の中を打ちつゝ先に立つた。",
              "citation": {
                "source": "道綱の母",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな門を中に入らなくとも、路から庭や座敷がすっかり見えて、篠竹の五、六本｜生えている下に、沈丁花の小さいのが二、三株咲いているが、そのそばには鉢植えの花ものが五つ六つだらしなく並べられてある。",
              "citation": {
                "source": "少女病",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて暇を告げた医師は、ちょうどそこに酸漿提灯を篠竹の先につけた一群れの行列が、子供や若者に取り巻かれてわいわい通って行くのに会った。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから篠竹か木の枝を切つて來て、今の落葉の板の二つの側に當てがひ、それの助けを借りて、そうつと胸に抱きかかへるやうにして持ち上げて、豫め用意しておいた二條の蔓の上におくのである。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "篠竹の杖、五銭位のハンカチ。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は篠竹のステッキで路ばたの藪をたたきつつ、口笛まじりに、朝霧のこめた馬洗川伝いに一時間も歩くと母校の柵や、いらかがもう見え出した。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "八つになる弟が強請んで種を下してもらった□□はやって置いた篠竹では足りなかったものと見えて、後の槇の梢まで這い上って、細い葉の間々に肉のうすい、なよなよした花が見えて居る。",
              "citation": {
                "source": "後庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風はだんだんに冷たくなって道の傍の篠竹の葉のすれ合う音が、私達の下駄の音と、もつれあってさびしい。",
              "citation": {
                "source": "転機",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　椅子をなおし「穴んなってるんだよ」　篠竹のきれっぱしでずっとさしてみる。",
              "citation": {
                "source": "日記",
                "author": "一九四七年（昭和二十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "締りのしてあるらしい裏口の戸と、傍の竹垣の上から覗いてる篠竹の粗らな葉とが、彼の眼にとまった。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
