        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "橋脚の基礎を安定させるため、川底には大量の捨て石が投入されて地盤が固められた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「地盤が緩い場所だから、しっかり捨て石を敷き詰めてから基礎工事に入らないと危ないぞ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古くから続く港の防波堤の下には、波の衝撃を和らげるための捨て石が幾層にも重なっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
