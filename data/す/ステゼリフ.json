[
  {
    "uuid": "3a7cf9a0-12ed-56d5-82fd-e1661cd7bfce",
    "entry": "捨て台詞",
    "reading": {
      "primary": "すてぜりふ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
