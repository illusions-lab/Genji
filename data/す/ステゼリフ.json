  {
    "uuid": "3c137bb4-b07e-5092-9fac-984227bee1a9",
    "entry": "捨白",
    "reading": {
      "primary": "すてぜりふ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何か捨白が言いたくなった。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と捨白辞をのこして、パッパと隣りへ行ってしまった。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "俗に捨白といふのがそれだ。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "その捨白は、明かに敗北者の自己満足なんだ。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはハムレットの捨白、ファンタジオの独白に似て、しかもなほ一層虚無的な心境の告白である。",
              "citation": {
                "source": "仏国現代の劇作家",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（さう捨白を残して、逃げるやうに立ち去る）底野、あつけに取られ、元の位置に帰り、ごろりと寝転がる。",
              "citation": {
                "source": "運を主義にまかす男",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔つぱらひのその捨白が、その晩から、彼には非常な心配の種になつた。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            },
            {
              "text": "杖と酔漢の捨白とが、彼自身でさへ時々は可笑しいばかり気にかかる。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、二三間｜隔った声で、「精々用心したまえ」　という捨白が、囁くように聞き取れた。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
