  {
    "uuid": "2f06b4cc-77b9-5a70-9a9f-ee8e241bec64",
    "entry": "恤",
    "reading": {
      "primary": "じゅつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
