[
  {
    "uuid": "4f7c5cc4-33c2-59a5-8cf2-c8a246ee8286",
    "entry": "実",
    "reading": {
      "primary": "じつ",
      "alternatives": [
        "じち"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
