      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼はコゼットを車除石に背をもたしてすわらせ、黙っているように命じて、それから管が地面についてる所へ走っていった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、ルノアール市場の一軒の酒屋の門口で、濃い頤髯のあるイタリー音調のひとりの男が、車除石の上に上って、神通力を発散してるかと思われるような不思議な文を声高に読み立てていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八三二年四月四日、サント・マルグリット街の角にある車除石の上に、ひとりの通行人は上って叫んだ、「僕はバブーフ派である。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
