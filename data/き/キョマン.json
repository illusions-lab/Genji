[
  {
    "uuid": "0e518597-0a64-5e5a-a7f9-3eeb1a79d5f1",
    "entry": "巨万",
    "reading": {
      "primary": "きょまん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
