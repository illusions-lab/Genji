  {
    "uuid": "e8bcdb75-aa5b-5be3-a56a-e19ccc411d0c",
    "entry": "キカク",
    "reading": {
      "primary": "きかく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "従来ノ殺害目的者ニ対シテハ、殺害ノ予告ノミヲシテ方法及ビ期日ヲセザリシ為メ普通月並ナル脅迫状位ニ思フテ覚梧（死ノ）モセズ、遺言モセズ、不意ニ我党ノ手ニ掛リ、卑怯ナル不敏ナル最後トナリシ者アリシニ付キカク明ラカニセリ。",
              "citation": {
                "source": "編輯室より（一九一三年六月号）",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕も読売のキカクで呉清源と一局対局した。",
              "citation": {
                "source": "太宰治情死考",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "小林相談役に、「忠臣蔵」では何でも僕に宗匠か何かやらせるらしい、宝井其角でせうが、困ると言ふと、「そいつはキカクが悪いね」と、小林一三一世一代の駄洒落。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
