    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「いなせ」「いさみ」「伝法」などに共通な犯すべからざる気品・気格がなければならない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "気格乃ち本句に過ぐ、之を剽と謂はざるも可なり。",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その七　――放翁詩話三十章――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、どんな気格の高い他の人の書に出会っても、それはそれで少しの引け目を感ぜずに、その内容の個性味を、どこまでもはっきりと押して行っているのである。",
              "citation": {
                "source": "一茶の書",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の気格を以て、すべてを終始している。",
              "citation": {
                "source": "春屋の書について",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆蹟に表われたる気格、心韻に拠って察するのである。",
              "citation": {
                "source": "墨蹟より見たる明治大正の文士",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "気中万物の生育悉く天地の気格に随ふゆゑ也。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "排水の換気格子に蹄鉄が触れたほんの一瞬、馬が消滅。",
              "citation": {
                "source": "見えざる力",
                "author": "THE INVISIBLE FORCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "画史の上から観れば、武蔵が、水墨画に親しんだのは、その最盛期ではなく、むしろ、気格を一義とする墨画としては、そろそろ内容的には堕落し始めた――水墨画末期であったといってよい。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "觸れて作ゆきを細かく見る、隅から隅まで仔細に鑑賞する、さうして器物のもつ氣格を受けいれるといふことは、無論大切な條件である。",
              "citation": {
                "source": "やきもの讀本",
                "author": "小野賢一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
