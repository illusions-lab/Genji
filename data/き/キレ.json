    },
    "definitions": [
      {
        "index": 1,
        "gloss": "piece",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "布を一切れ切り取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "紙の切れを貼り合わせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "肉を食べやすい大きさの切れに分ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それに金のことなぞ念頭にあるやうではやり切れない性質の仕事をしてゐるから、一層金は、金の方で足が付いてやつて来て呉れる方がいいに決つてゐる。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手の籔が切れる所に来ると、右手の方に養漁場がみえ、その他は一面の田で遠く神田上水源の方の森並に縁取られてゐる。",
              "citation": {
                "source": "その一週間",
                "author": "――不真面目なわが心……",
                "note": "青空文庫"
              }
            },
            {
              "text": "常に彼の作品は、二二が四で割り切れる所の、あまりに常識的な理智的合理物でありながら、しかも言語の或るかくれたる影に於て、ふしぎに神祕的な「鬼」を感じさせる。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "断り切れないのである。",
              "citation": {
                "source": "自作を語る",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私には、文章をゆっくり調べて読む癖があるので、とても読み切れない。",
              "citation": {
                "source": "弱者の糧",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンチテエゼの成立が、その成立の見透しが、甚だややこしく、あいまいになって来て、自己のかねて隠し持ったる唯物論的弁証法の切れ味も、なんだか心細くなり、狼狽して右往左往している一群の知識人のためにも、この全体主義哲学は、その世界観、その認識論を、ためらわず活溌に展開させなければなるまい。",
              "citation": {
                "source": "多頭蛇哲学",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、旧約聖書の「詩篇」に於いて、「ヤーエ」と呼ぶ時に、ヤーエといふ一単語の音色が既に今では感じ切れない程の微妙な意味をも有してゐたであらうことなぞ、一応想起されたいのである。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ナストウリ、モノサシトハサミ、カガミガアリマス、イケニフネ……」大急ぎでそれだけ読んだが、そこで息が切れた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "折々堪らないやうに双眼の切れ目から輻射状の皺を発したが、それでも更にそれらの喫殻に手を下さうとしないのは、明かに彼自身にも得体の知れぬ悶えが、彼の中を横行してゐたからである。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処の弁士の子供が幼稚園の同級にゐて、時々フイルムの切れつぱしを持つて来てみんなを羨しがらせた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「廻る／＼／＼………あゝもう寿命が切れかるー………心棒が揺らあ。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに一ヶ月余りといふものを寝て起きて食ふと言ふ全くその文字通りの日暮しのために、いつときも我慢し切れなくなつてゐた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれら魂が稀薄なために、夢が浅いので歯切れが好いばかりだ。",
              "citation": {
                "source": "Me Voila",
                "author": "―― a Cobayashi",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――彼等が歯切れの好いことは彼等の人格と無関係だ。",
              "citation": {
                "source": "Me Voila",
                "author": "―― a Cobayashi",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジイドの作品を通覧すると、そのネタの切れた、実生活の分散し切つた時代を直視した所から生れた芸術だといふ感じが、他の如何なる感じよりも強くするのである。",
              "citation": {
                "source": "アンドレ・ジイド管見",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "石もて蛇を殺すごとく一つの輪※を斷絶して意志なき寂寥を蹈み切れかし。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……王はトーレ・フンドに切りつけたが、魔法の上着は切れなかった。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "足には尻の切れた草履をはいている。",
              "citation": {
                "source": "鴫つき",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それであの親切な情誼の厚い田舎の人たちは切っても切れぬ祖先の魂と影とを弊履のごとく捨ててしまった。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥えて居た方はことに衰へて、あのはち切れさうだつた血色のいゝ皮膚が、今はもうタブタブして居て、ガサガサした感じさへ与へて居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう彼はこらへ切れなくなつて、両人に「オイここで開いて見てもいゝだらうナ」と言つた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "歸途は、なんだか、やり切れない氣持でありました。",
              "citation": {
                "source": "このごろ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでは、檀君も、やり切れぬ思ひであらう。",
              "citation": {
                "source": "檀君の近業について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに何せ薄い板切れでいい加減に作つた舟だから、水がしみ込んで來て危いのよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "板切れの舟は危いから、もつと岩乘に、泥をこねつて作りませうよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "死なばもろとも、夫婦は二世、切つても切れねえ縁の艫綱、あ、いけねえ、切つちやつた。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、世捨人だつて、お金が少しでもあるから、世を捨てられるので、一文無しのその日暮しだつたら、世を捨てようと思つたつて、世の中のはうから追ひかけて來て、とても捨て切れるものでない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私には、Ｎさんの親切は、よくわかるのだが、内々、やり切れない氣持であつた。",
              "citation": {
                "source": "大恩は語らず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、そんな人とは、とても附き合ひ切れない。",
              "citation": {
                "source": "大恩は語らず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "斷り切れなかつたのである。",
              "citation": {
                "source": "小照",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
