[
  {
    "uuid": "dc28a34e-e7e0-577c-91f9-731bffad6ae0",
    "entry": "切れ",
    "reading": {
      "primary": "きれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
