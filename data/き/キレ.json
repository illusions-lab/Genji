          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ナイフの切れが悪い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "包丁の切れを保つために磨く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "切れの良い刃物は作業が楽だ。",
              "citation": {
