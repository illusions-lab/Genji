[
  {
    "uuid": "344aafad-fb97-54e1-8617-5252e50747ab",
    "entry": "胸郭",
    "reading": {
      "primary": "きょうかく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "chest",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "激しい運動で胸郭のあたりが痛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "医師は聴診器で私の胸郭の音を聞いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "レントゲン写真で胸郭の骨に異常がないか確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "深呼吸をすると、胸郭が広がるのを感じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "出刃の切っ先に切られていく骨の一つも、筋の一つも、肉の間に網のごとく走っている白い奇怪な線条も、白く浮き上っている脂肪も、びろびろと胸郭いっぱいに気味悪く広がっている肺も、左肺の下から覗いている真っ赤な桃の実のごとき心の臓も、ターヘルアナトミアの絵図と、一分一点の違いもなかった。",
              "citation": {
                "source": "蘭学事始",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまここに天使のお告げの神聖な鐘の音が高らかに鳴り出でて、荒れた町の上をやわらかになでてゆくならば、どんな美しい共鳴を人々の胸郭内に起こすであろう……。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モグラは蝙蝠と同じく逞ましい胸郭をもっている」と彼は手文庫を閉めながらつづけた、「骨骼と筋肉が驚くほど発達しているし、口には異常な武器を備えている。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "廃帝は左の胸郭のまんなかを射ちぬかれ、枯葉のようにゆらめいて前へ倒れた。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "このごろ胸郭が急にうつろになって、そこを秋風が吹くような気がする。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこにも病気などなさそうに、胸郭の広い厚い胸であった。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉の厚い、逞しい胸郭が大きくふくらみ、手足の筋肉に発条のような力の溢れてくるのがうかがえる。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸郭は肋間筋の収縮によって拡大すると彼は言った。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯はハサミの一種で、胃はビン、腸や腺は篩、血管は管の単なる系、胸郭は１組のフイゴを入れた箱、に過ぎなかった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ってこのような方法すなわち「打診」法によって胸郭内の臓器が正常かまたは病的に変化しているかを確かめることができる。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはヒトの胸を叩く方法であってこれによって起きる音の独自の性質によって胸郭内の状態についての知見が得られる。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸郭の異常音はすべての場合に重篤な危険を示す徴候であると主張する。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "完全な題は長たらしい「新考案、胸壁を叩いて胸郭内部に隠れた病気の病徴をみつけるための」であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "身長六尺、大理石のような胸郭、青銅のような腕、洞穴から出るような呼吸、巨人のような胴体、小鳥のような頭蓋。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "△古河力作　府下瀧ノ川康樂園に雇はれて花造りを職とせり、王子に愛人社なるものを組織し社會主義の普及を圖れり、身の丈三尺五六寸胸廓手足之に準じ一見小兒の如し。",
              "citation": {
                "source": "日本無政府主義者陰謀事件經過及び附帶現象",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "無造作にばら撒かれたやうに、草地の上に突つ立つた黒筐柳や白樺や白楊などの、明暗の青葉を通して、冷気を帯びた、火のやうな閃光がキラキラ輝やきだすと、美女のやうな流れが白銀の胸廓を燦然と露はして、その上には樹々の青葉が捲毛のやうに艶めかしく垂れてゐた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、薄い脂肪の層、いやに紅い筋肉層、肋骨と、順次に切り進んで胸廓を開き、心嚢を破って心臓を出した時分には、僕はやはりいつもの冷静に立ち帰って居た。",
              "citation": {
                "source": "恋愛曲線",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "実験の順序は、先ず家兎を仰向けに、特殊の台の上に固定し、麻酔をかけて、その胸廓の心臓部を開き、更に心嚢を切り開いて、それから私たちの考案した喞筒を、心臓の代りに取りつけるのであります。",
              "citation": {
                "source": "人工心臓",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸廓を切り開いて人工心臓を取りつけ、再び胸廓を塞ぐだけの手術ではありますが、それを十分で行い得たことに就ては、聊か得意を感じました。",
              "citation": {
                "source": "人工心臓",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "申すまでもなく、人工心臓だけは、胸廓の外に出て居ります。",
              "citation": {
                "source": "人工心臓",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸廓の中へ収めることが出来ればそれに越したことはありませんが、前に申上げたとおりの装置では、到底それを望むことが出来ません。",
              "citation": {
                "source": "人工心臓",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は家兎に種々の毒物を与えて絶命せしめ、心臓の最後の搏動の止むのを待って直ちに胸廓を開き、人工心臓を備えつけて実験しましたが、死の直後五分間以内にとりかかるならば、再び家兎の意識を恢復せしめ得ることがわかったのです。",
              "citation": {
                "source": "人工心臓",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "手早く胸廓を開いて、人工心臓を結びつけました。",
              "citation": {
                "source": "人工心臓",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　おのずから神韻縹緲として、胸廓の広きを覚ゆるのである。",
              "citation": {
                "source": "地水火風空",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "剥げかけた白粉と生地の青みがかった皮膚とが斑になり、頸部から寝巻の襟のはだけた、やせた胸廓が黒く脂じみているのが不健康らしくはあったが、いい縹緻には相違ない。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽の光にさらされて脂じみた襦袢と色のさめた赤い下着との間からあらわれた自分の蒼白な胴や胸廓の痩せこけた肉や、萎びて皺のよった皮膚や、一枚一枚暗いひだをつくって見える肋骨の骨ぐみなどを見ていると、自分の多少幸福であった娘の頃はもう遠い別の世界での事実でしかなくなったことが確かめられた。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸廓から腹部にかけての少しばかりの肉の緊張が彼女に若いことを保証していた。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "山地の人は空気が稀薄であるから胸廓も広く、坂道を歩くから自然に足が曲つてきますし背も低いのが普通であります。",
              "citation": {
                "source": "農民自治の理論と実際",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
