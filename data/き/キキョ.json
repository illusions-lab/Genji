        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「おじいちゃん、最近の起居はいかがですか？」と孫が顔を覗き込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "恩師のご起居を案じて、数年ぶりに近況を尋ねる手紙を認めることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "季節の変わり目ですので、何卒ご起居ご自愛くださいますようお願い申し上げます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "standing and sitting",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
