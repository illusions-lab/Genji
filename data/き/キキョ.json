    "definitions": [
      {
        "index": 1,
        "gloss": "one's daily life",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山奥の寺院に入り、僧侶たちと起居を共にする修行の日々が始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「慣れない土地での起居は、思っていた以上に神経を使うものだね」と彼はこぼした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長年連れ添った夫婦は、お互いの起居の音を聞くだけで相手の機嫌がわかるという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この頃ではこの議を随分自分から提唱して、乱れぬ程度でこの女のみに強いられた苛酷な起居から解放されて居るには居ます。",
              "citation": {
                "source": "女性の不平とよろこび",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「寒い満洲でも、兵タイは、こういう温い部屋に起居して居るんで……」「はア、なる程。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、紫の藤より、菖蒲杜若より、鎌倉の町は、水は、其の人の出入、起居にも、ゆかりの色が添ふであらう、と床しがるのみで、まるで以て、然したる容体とは思ひもつかないで居たのに。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "きみもまた、まこと、われを知りたく思ったときには、わが家たずねてわれと一週間ともに起居して、眠るまも与えぬわがそよぐ舌の盛観にしたしく接し、そうして、太宰の能力、それも十分の一くらい、やっと、さぐり当てることができるのじゃないか、と此の言葉の、ほぼ正確なることを信じてよろしい。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その文面はこの若い女が全く慧鶴を未来の夫と思い定め、自分を離れて遠く起居している青年僧に向って、しきりに寂しさ恋しさをかこつのであった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、電燈の前、瓦斯の背後のも、寝る前の起居が忙しい。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "廓に馴れた吾妻下駄、かろころ左褄を取ったのを、そのままぞろりと青畳に敷いて、起居に蹴出しの水色｜縮緬。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理店の、あの亭主は、心｜優いもので、起居にいたわりつ、慰めつ、で、これも注意はしたらしいが、深更のしかも夏の夜の戸鎖浅ければ、伊達巻の跣足で忍んで出る隙は多かった。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と口も気もともに軽い、が、起居が石臼を引摺るように、どしどしする。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "直に小春が、客の意を得て、例の卓上電話で、二人の膳を帳場に通すと、今度註文をうけに出たのは、以前の、歯を染めた寂しい婦で、しょんぼりと起居をするのが、何だか、産女鳥のように見えたほど、――時間はさまでにもなかったが、わけてこの座敷は陰気だった。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……羽織は、まだしも、世の中一般に、頭に被るものと極った麦藁の、安値なのではあるが夏帽子を、居かわり立直る客が蹴散らし、踏挫ぎそうにする……　また幕間で、人の起居は忙しくなるし、あいにく通筋の板敷に席を取ったのだから堪らない。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに貴僧、騒動の起居に、一番気がかりなのは洋燈ですから、宰八爺さんにそう云って、こうやって行燈に取替えました。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この場合なり、何となく、お千も起居に身体が緊った。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "六畳二間に、われら七人の起居なり。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "然りと雖も相互に於ける身分の貴賤、貧富の隔壁を超越仕り真に朋友としての交誼を親密ならしめ、しかも起居の礼を失わず談話の節を紊さず、質素を旨とし驕奢を排し、飲食もまた度に適して主客共に清雅の和楽を尽すものは、じつに茶道に如くはなかるべしと被存候。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "閑居の気持も全く同様、一切を放下し、方丈の庵にあけくれ起居してみなければ、わかるものではござりませぬ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "静子夫人は、その後、赤坂のアパートに起居して、はじめは神妙に、中泉画伯のアトリエに通っていたが、やがてその老画伯をも軽蔑して、絵の勉強は、ほとんどせず、画伯のアトリエの若い研究生たちを自分のアパートに呼び集めて、その研究生たちのお世辞に酔って、毎晩、有頂天の馬鹿騒ぎをしていた。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "起居注の魏観字は杞山というもの、太子に侍して書を説きけるが、一日太祖太子に問いて、近ごろ儒臣経史の何事を講ぜるかとありけるに、太子、昨日は漢書の七図漢に叛ける事を講じ聞せたりと答え白す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄黒い入道は目を留めて、その挙動を見るともなしに、此方の起居を知ったらしく、今、報謝をしようと嬰児を片手に、掌を差出したのを見も迎えないで、大儀らしく、かッたるそうに頭を下に垂れたまま、緩く二ツばかり頭を掉ったが、さも横柄に見えたのである。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "母様は病気が悪いから、大人しくしろよ、くらいにしてあったんですが、何となく、人の出入、家の者の起居挙動、大病というのは知れる。",
              "citation": {
                "source": "薬草取",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "六畳一間に、同僚と三人の起居である。",
              "citation": {
                "source": "犯人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "将校さんだって、そんなに素晴らしい生活内容などは、期待できないけれど、でも、毎日毎日、厳酷に無駄なく起居するその規律がうらやましい。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから二日間、あの宿で、あなたと共に起居して、私は驚嘆の連続でした。",
              "citation": {
                "source": "風の便り",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "寢たり起きたりする時だけは、臍のあたりの筋肉が少し堅くなり過ぎるやうだつたが、それも肥滿した人の起居の敏活でないのは、矢つぱりかうした譯だらう位に思ひ過ごしてゐた。",
              "citation": {
                "source": "第十八號室より",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう時の男の起居挙動は、漫画でないと、容易にその範容が見当らない。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "裾を曳いて帳場に起居の女房の、婀娜にたおやかなのがそっくりで、半四郎茶屋と呼ばれた引手茶屋の、大尽は常客だったが、芸妓は小浜屋の姉妹が一の贔屓だったから、その祝宴にも真先に取持った。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "名代の女房の色っぽいのが、長火鉢の帳場奥から、寝乱れながら、艶々とした円髷で、脛も白やかに起きてよ、達手巻ばかり、引掛けた羽織の裏にも起居の膝にも、浅黄縮緬がちらちらしているんだ。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、その、ひょいと持って軽く置くと、古葛籠の上へも据りそうな、小さな白髪の祖母さんの起居の様子もなしに、悉しく言えば誰が取次いだという形もなしに、土間から格子戸まで見通しの框の板敷、取附きの縦四畳、框を仕切った二枚の障子が、すっと開いて、開いた、と思うと、すぐと閉った。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "起居のおとなしい、何をしても物に柔に当るお玉と比べて見られるのだから、田舎から出たばかりの女中こそ好い迷惑である。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人は伯よりおいたりと見ゆるほどに起居重けれど、こころの優しさ目の色に出でたり。",
              "citation": {
                "source": "文づかひ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
