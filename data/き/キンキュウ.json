[
  {
    "uuid": "63d94258-7b19-5a03-a815-f45cec9138c5",
    "entry": "緊急",
    "reading": {
      "primary": "きんきゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
