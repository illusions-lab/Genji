  {
    "uuid": "89adf5ca-9b60-56dc-a803-4a9272f89428",
    "entry": "帰安",
    "reading": {
      "primary": "きあん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "帰安の魚怪　明代のことである。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "子不語",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰安県の知県なにがしが赴任してから半年ほどの後、ある夜その妻と同寝していると、夜ふけてその門を叩く者があった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "子不語",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、帰安の一県は大いに治まって、獄を断じ、訴えを捌くこと、あたかも神のごとくであるといって、県民はしきりに知県の功績を賞讃した。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "子不語",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名の道士｜張天師が帰安県を通過したが、知県はあえて出迎えをしなかった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "子不語",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれが再びここを通るときに放してやる」　張天師はその後ふたたび帰安県を通らなかった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "子不語",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
