  {
    "uuid": "6e27f398-71ba-5be5-8bc0-83927ba61114",
    "entry": "蔬",
    "reading": {
      "primary": "きのこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
