    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四十年ほど前予が本草学を修めた頃は、京阪から和歌山田辺（想うに全国到る処）の生薬屋に、馬、牛、猴、獺、狐、狸、狗、鹿、鯨、また殊に膃肭獣のタケリ、すなわち牡具を明礬で煮固めて防腐し乾したのを売るを別段不思議と思わず。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "同人雑誌の大合同というのを仕事に一枚加えて、よび集めて、タケリンいきなり国民文学をつくれ、と云ったのだそうです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、大丈夫、オレより先にタケリンがやられるだらう。",
              "citation": {
                "source": "ちかごろの酒の話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "其處からお遷りになつて、筑前の岡田の宮に一年おいでになり、また其處からお上りになつて安藝のタケリの宮に七年おいでになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
