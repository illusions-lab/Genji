  {
    "uuid": "0dd4a019-9a35-5baf-9eec-1b8785696429",
    "entry": "タラシ",
    "reading": {
      "primary": "たらし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スルト　ダンダン　センサウノ　アル　トコロニ　チカヅイテ　キタラシク、トキドキ　トホクノ　ハウカラ　カスカニ　タイハウノ　トドロキガ　キコエテ　キマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ皇室下附ノ土地及私有地限度超過者ヨリ納付シタル土地ヲ分割シテ土地ヲ有セザル農業者ニ給付シ、年賦金ヲ以テ其所有タラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ニ私兵ヲ養ヒテ私利私欲ノ爲ニ攻伐シツツアル現代支那ガ政治的ニ統一セル者ト云フ能ハザル如ク、鐵道電信ノ如キ明白ナル社會的機關ヲスラ私人ノ私有タラシメテ甘ンズル米國ハ金權督軍ノ内亂時代ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英語ガ日本人ノ思想ニ與ヘツツアル害毒ハ英國人ガ支那人ヲ亡國民タラシメタル阿片輸入ト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "主權國民ガ西比利亞ニ於テ露語ヲ語リ濠洲ニ於テ英語ヲ語ル顛倒事ヲナス能ハザルナラバ、日本領土内ニ一律ナル公語ヲ決定シ彼等ガ日本人ト語ルトキノ彼等ノ公語タラシメザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又被告ハ辯護士ノ外ニ自己ヲ證明シ辯護シ得ベキ知己友人其他ヲ瓣護人タラシムベキ完全ノ人權ヲ有スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ヲシテ日本ノ愛蘭土タラシムル如キコトアラバ、將來大羅馬帝國ヲ築カントスル日本ハ全然其ノ能力ナキコトヲ第一歩ニ於テ立證スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "その表情のムゴタラシサ……それを上から見い見いブラ下がっている連中の悲鳴のモノスゴサといったらなかったよ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラガナトカタカナハ相前後シテ生レタラシイガ、前者ハ毛筆ト和紙ニ対シ適合性ヲ持ツテイタタメ今日マデ愛用サレタニ反シ後者ハ適合性ヲ持タナカツタタメ、一千年ノ間カエリミラレルコトガナカツタ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「宗さんの後を追っかけて、少し前から来ているのさ」「ははあそれでは宗三郎を捉え、今度こそ色仕掛けでタラシ込み、俺との約束を果たす気か」「大違いの真ん中だよ、山影宗さんと一緒になり、宗さんに仇するお前さんを、とっちめてやろうとこう思っているのさ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽チ聴ク人喝シ絃轟キ撥閃キ、俄ニ千軍万馬ヲ坐中ニ現出シ来ル、鉄甲錚トシテ鳴リ金戈戞トシテ鳴リ、鉦皷鳴リ砲銃鳴リ、身ハ血戦死闘ノ塲ニ在ルガ如ク、人ヲシテ毛髪為メニ慄然タラシム。",
              "citation": {
                "source": "他山の石",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、ボンコチヤンハイツモ、アタラシイ時ノヤウニ美シウゴザイマス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウオオ、ウオオ、ウオオ、キミハ　キガチガツタラシイヨ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほら、首ククリは小便やクソをたれて、ずいぶんムゴタラシク苦悶するけど、本当は生涯のたのしいことを一時にドッとパノラマに見て、あの時ほど幸福な瞬間はないんだってね。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに女タラシの名人なんだそうですよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十二　愚妖",
                "note": "青空文庫"
              }
            },
            {
              "text": "オキナガタラシヒメ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛鳥の幻――吉野・大和の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷泉をレンゼイ（後にはさらにレイゼイと訛る）、定考をコウジョウ、称唯をイショウ、新たしいをアタラシイ、身体をカダラ、茶釜をチャマガ、寝転ぶをネロコブという類みなこれである。",
              "citation": {
                "source": "サンカ者名義考",
                "author": "――サンカモノは坂の者",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウシタモノカト迷ッテイルウチニ歳ヲ取リ過ギテ、モウ現在デハ手術モ手後レニナッタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」戸ハホンノ僅カ、動クカ動カナイクライニ触レタヾケデアッタガ、早クモ彼女ハ気ヅイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………午後二時過ギ春久来リ、二三時間イタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ予ニソレヲ誇示スルタメニ浴室ヘ招イタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日モ春久ガ来テタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯ノ間カラ莨入レト煙管ノ袋ヲ取リ出シテ一服吸ッタ様子デアルカラ、茶ノ間ニ坐ッテイタヨウデモアルガ、イツノ間ニカ門外ヘ出タラシク、素足ニ吾妻下駄ヲ穿イテ歩イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテレスリーニハ何ノ被害モ受ケナカッタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「颯チャン、颯チャン、ワア、ワア、ワア、―――」「オ止シナサイヨ、オ爺チャン」サッキカラ少シ薄気味悪ソウニ黙ッテジット予ノ表情ヲ見ツメテイタ颯子ハ、偶然眼ト眼ガ打ツカリアッタラ、咄嗟ニ予ノ心ノ変化ヲ看テ取ッタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョット食堂ヘ行ッテ来タイノ」イツノ間ニカ颯子ガ眼ヲ覚マシタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ最初ハホントウニ寝テイタラシイガ、途中カラ眼ガ覚メタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハソノ時ハ明ラカニハットシテ眼ヲ覚マシタラシク瞬イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
