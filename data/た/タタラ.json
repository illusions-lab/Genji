        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "たたら製鉄では大きな踏鞴で砂鉄を熔かす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この地域の踏鞴は木製で非常に重い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "踏鞴による製鉄技術は世代を通じて受け継がれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
