    "definitions": [
      {
        "index": 1,
        "gloss": "foot-operated bellows",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鍛冶職人は大きな踏鞴を足で上下に操作した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "踏鞴の音が工房に響き渡っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古い踏鞴がまだ納屋に保管されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "足を動かせば、それがまるで地踏鞴を踏むやうにしてゐる。",
              "citation": {
                "source": "脱殼",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "紀州熊野の深山でも、一たたら、または一本｜踏鞴などと伝え、かつて勇士に退治せられた話がある。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "狸か何かの皮を縫い合わせて、大なる踏鞴というものを作り、それを足で踏んで盛んに炭の火を起こし、金属を鎔解していろいろの器物を造る人ばかりが、山に竈を築いて多量の炭を製するの必要を持っていたゆえである。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺さぬまでに現責に苦しめ呪うがゆえ、生命を縮めては相成らぬで、毎夜少年の気着かぬ間に、振袖に緋の扱帯した、面が狗の、召使に持たせて、われら秘蔵の濃緑の酒を、瑠璃色の瑪瑙の壺から、回生剤として、その水にしたたらして置くが習じゃ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "むざんや口角より血をしたたらし、合掌し、瞑目し、むざんや天上に縊れたるものの、光る松が枝に靈魂はかけられ、霜夜の空に、凍れる、凍れる。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の若いもんたちは、三日三晩、たたらという大きなふいごを足で踏んで、銅をとかす火をおこしたもんだそうだ。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かみきりや姿を見せよ神国のおそれを知らばやくたたらざれ",
              "citation": {
                "source": "簪につけた短冊",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたがあやつる人生切り紙細工は大｜南北のものの大芝居の如く血をしたたらせている。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "地になびく髪には蘆薈、嘴にまたあかき実を塗る淫らなる鳥にしあれば、絶えず、その真白羽ひろげ乳香の水したたらす。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸国船歳の塩鰤｜競りあぐと寒もものかは裸でおらぶ千石船師走業我が家の市は大歳と千石船の群れて泊てにし南風にして千石船の箱ぐるま金比羅までも我は曳かせつ篦篦や篦、漆掻く篦、篦はよし、色掻き交ぜ、たらりとよ、垂りしたたらす。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "空はよ、皆飛ぶべし、山河よ越えむに、時なし、またたく間ぞ、鳴かぶら矢留の子ら、いざや勢ひ、土たたら踏み飛べや。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その両側の土の色も芝生も落葉松の林も石燈籠も、見るものがことごとく雨をふくんで、また何ともいえぬ緑と白との涼しさをしたたらしていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の間にプープーと湯気を吹いているアルミの大薬鑵や、外の雪をチラチラと透かしながら一面に水滴をしたたらしている硝子窓は、二人が長い間話し込んでいる事を証明していた。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……去年の大地震で、海の底が一体に三尺がとこ上りましての、家々の土地面が三尺たたら踏んで落込みましたもの、の。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たたらめの花のごと、三笠の山の少女をば棄てて」という歌詞を歌いながら源氏は行ってしまった。",
              "citation": {
                "source": "源氏物語",
                "author": "末摘花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいえ寒い霜の朝にね、『たたらめの花のごと掻練好むや』という歌のように、赤くなった鼻を紛らすように赤い掻練を着ていたのをいつか見つかったのでしょう」　と大輔の命婦が言うと、「わざわざあんな歌をお歌いになるほど赤い鼻の人もここにはいないでしょう。",
              "citation": {
                "source": "源氏物語",
                "author": "末摘花",
                "note": "青空文庫"
              }
            },
            {
              "text": "とすると、他人から毒殺されるほどにも恨みをうけるはずはないわけなんだから、自然ここで、右門の見込み捜査は一｜頓挫をきたすべきでしたが、しかし、いったん手を染めたとならば、毎度申しあげたように、そんなことでおめおめとたたらを踏む右門とは右門が違います。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "たたらを踏んでいるまに、早くいってきなよ」　二丁用意させると、いつもながらに、そつのない右門流でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "明月一夜騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれがしたたらしたか、千萩か？",
              "citation": {
                "source": "右門捕物帖",
                "author": "血の降るへや",
                "note": "青空文庫"
              }
            },
            {
              "text": "げにげに汝ら、しをらしく、あるはをかしく、おもしろく、戲れ浮かれて鄙びたる下司のしらべに忘るれど、いづこともなき燒栗の秋のにほひを嗅ぐときは物思ふらむ、嘆くらむ、かつは涙もしたたらむ。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうした事かと疑い惑っていると、舟びとの一人はやがて髪をふり乱して刀を持って、篷のうしろに出たかと思うと、自分の舌を傷つけてその血を海のなかへしたたらした。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "夷堅志",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に、氏族中の一人の女であった鈿女命が頓智を出して、極めて陽気な「たたら舞」をした。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おののく）われら一味はもうとくからたたられているのだ。",
              "citation": {
                "source": "俊寛",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（六月十日）　病室の片側には綱を掛けて陸中小坂の木同より送り来し雪沓十種ばかりそのほかかんじき蓑帽子など掛け並べ、そのつづきには満洲にありしといふ曼陀羅一幅｜極彩色にて青き仏赤き仏様々の仏たちを画がきしを掛け、ガラス戸の外は雨後の空心よく晴れて庭の緑したたらんとす。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手を見くびった人も、人の恨みにたたられたようになって亡くなってしまったのですよ」　と源氏はその点を曖昧に言って、「残した人だってどうだろう、中将は人臣で少しずつ出世ができるだけの男だが、中宮は類のない御身分になっていられる。",
              "citation": {
                "source": "源氏物語",
                "author": "藤のうら葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶と青磁との空は大口をあいてののしり、おもい憎悪をしたたらし、ふるい樹のうつろのやうに蝙蝠の叫びを抱きかかへた。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            },
            {
              "text": "そよぐ幻影あなたは　ひかりのなかに　さうらうとしてよろめく花、あなたは　はてしなくくもりゆく　こゑのなかのひとつの魚、こころを　したたらし、ことばを　おぼろに　けはひして、あをく　かろがろと　ゆめをかさねる。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            },
            {
              "text": "幽霊みたいな運命の奴にたたられどうしだ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "卵と云うものはどうしてこんなにおいしいのだろうと、むつはつぶけた黄味を掌にどろりとしたたらせて、猫のようにそれをなめるのでした。",
              "citation": {
                "source": "クララ",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンク・ルイズのあの名高い小説の中にも、ルシファや「血をしたたらす尼」と共に「さまよえる猶太人」が出て来たように記憶する。",
              "citation": {
                "source": "さまよえる猶太人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
