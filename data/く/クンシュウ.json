        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一九〇四年ベルリンで大評判だった「伶俐なハンス」てふ馬は種々不思議の芸を演じ、観客｜麕集ついに警官出張してその通行を遮るに及んだ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "時世ヲ徴シ風土ヲ察シ、工業ノ進歩如何ヲ考フル為メナレバ、泰西諸国ニハ殊ニ貴重スルコトニテ、博物館ノ如キハ観客日ニ麕集ス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生一人の周囲に、苟も学に志ある聴衆は麕集して来る。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
