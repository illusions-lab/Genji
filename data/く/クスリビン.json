  {
    "uuid": "a2168f0b-43a2-5d06-87e9-21aaab349b4c",
    "entry": "薬壜",
    "reading": {
      "primary": "くすりびん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
