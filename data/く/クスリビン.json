  {
    "uuid": "4eed1709-507b-5a45-93f3-c7319a9db733",
    "entry": "薬罎",
    "reading": {
      "primary": "くすりびん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
