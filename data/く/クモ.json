      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "家はずいぶん古いけれど、根継ぎをしたばかりであるから、ともかくも敷居鴨居の狂いはなさそうだ。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "長らくのくもりもようやくうすらいで、糟谷の家庭にわずかな光とぬくまりとができた。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっきりと口をきくものもない。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "おりよくもそこへ西田がひょっこりはいってきた。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして両足を伸し腹部も十分に張って見たけれど、心のくもって居る様な胸の苦みは少しも減じなかった。",
              "citation": {
                "source": "大雨の前日",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "高くも低くも、其の人だけの家庭を作るより外に、道はないのであろう。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "家庭の主人公なるが如く心得、家庭の事は、男子の片手間の事業かの如く考えて居るのが、今日家庭を説くものの理想らしいが、これが大間違の考と云わねばならぬ。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠き慮りなき時は、近き憂ありとは、能くも云うたものじゃと我から自分を嘲ったのである。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "況や予が生活を得るまでには猶少くも三四年は間があって、母の命八十を必し難しとすれば、予は自分の功名心や、遠い先の幸福などに望を掛けて、大きな考を起す暇がないのである、年少気鋭の時代は何人にもある、予と雖も又其の内の一人であれば、外国へ飛び出さんとの念を起せるも一二度ではなかった。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女等がかざしの玉の赤玉に似たるいちごを採りつゝありく奧山の道のへに咲く草花をうらめづらしみ見せまくもとなおぼつかなき歌なり。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "風はそよとも吹かず、日熱からず、四方のけしきのどかに見わたさるるに時じくに鶯鳴くも二荒のおくなる里は常春にして舟、菖蒲が浜に着く。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "危き橋をようように這いわたりて終に下り着くに滝のしぶき一面に雨の如く足もとより逆に吹きあぐるさますさまじく恐ろしく暫くも彳みかねつ。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は神となりたらん心地にてくすしくとうとくも覚ゆれど余りのすさまじさに得も留まらで復もと来し岩を攀じて登り来る。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり余りゆくもわるい余りゆかぬも悪るいだろうと思うた。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝折戸をあけるわけにもゆかないでしきりにそこ此所からのぞいたけれども屏の内はよくも見えない　無論どなたの声もきこえない。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚くまいとしたり、泣くまいとしたり、喜ぶまいとしたり、さう勉めて見た処でそれはさううまく行くものではあるまい、さういふのは極めて不自然であるのだ。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ意味から見れば、此詩集は又大に面白くもあり価値もある。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お松も家を出て来る時には、一晩泊るつもりで来たものの、来て見ての様子で見ると、此の上一晩泊ったら、愈別れにくくなると気づいて、おそくも帰ろうとしたのだが、自分が少しもお松を離れないので、帰るしおが無かった。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しくもあり楽しくもありというような状態で、忘れようと思うこともないではないが、寧ろ繰返し繰返し考えては、夢幻的の興味を貪って居る事が多い。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "村のものらもかれこれいうと聞いてるので、二人揃うてゆくも人前恥かしく、急いで村を通抜けようとの考えから、僕は一足先になって出掛ける。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「民さんはそんなに戻ってきないッたって僕が行くものを……」「まア政夫さんは何をしていたの。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "端から見たならば、馬鹿馬鹿しくも見苦しくもあろうけれど、本人同志の身にとっては、そのらちもなき押問答の内にも限りなき嬉しみを感ずるのである。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "高くもないけど道のない所をゆくのであるから、笹原を押分け樹の根につかまり、崖を攀ずる。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "余所から見たならば、若いうちによくあるいたずらの勝手な泣面と見苦しくもあったであろうけれど、二人の身に取っては、真にあわれに悲しき別れであった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "これには何か相当の理由があるかも知れねど、ともかくも事実はそうである。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子が今はの時の事もお前に話して聞かせたいけれど私にはとてもそれが出来ない」　などとまた声をくもらしてきた。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故、或る人はtsであったとし、或る人はchであったとし、またｓあるいはshであったと説くものもある。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "風の音｜許り外に騒々しくて、家の内には元気よく騒ぐものもない。",
              "citation": {
                "source": "大雨の前日",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっかく先生に上げようと思ってわざわざ国から取寄せて持ってきたものを気に入ってるこの敏子のところへすぐもうやってしまったと見えるな。",
              "citation": {
                "source": "かれいの贈物",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "懺悔あるみにうむの薄き紙片にすべての言葉はしるされたりゆきぐもる空のかなたに罪びとひとりひねもす齒がみなしいまはやいのち凍らんとするぞかし。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
