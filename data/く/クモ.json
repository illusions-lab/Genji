  {
    "uuid": "34c4fbfc-cf32-576c-b9d2-d7b465364b5f",
    "entry": "くも",
    "reading": {
      "primary": "くも",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
