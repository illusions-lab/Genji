        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の話はいつもジョークばかりで、くすぐりが上手だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その場を和ませるために、彼はちょっとしたくすぐりを披露した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼のくすぐりが面白すぎて、みんなでお腹を抱えて笑った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
