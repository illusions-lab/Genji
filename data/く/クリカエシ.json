        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は、満足のいく結果が出るまで、何度も繰り返し練習を続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "そのフレーズは、会議で繰り返し言及された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供たちは、お気に入りの絵本を繰り返し読んでとせがんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
