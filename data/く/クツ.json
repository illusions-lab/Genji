    },
    "definitions": [
      {
        "index": 1,
        "gloss": "shoe",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新しい靴を買ったので、明日早速履いて出かけよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "雨の日は、防水加工された靴が一番だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この革靴は、履けば履くほど足に馴染んでくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "みなつらなめて逃れゆく、黎明の林を出づる旅びとら、その足竝に音はなけれど、水ながれいでて靴のかかとをうるほせり。",
              "citation": {
                "source": "黎明と樹木",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、われのみの、われのみの聖なる遊戲、知るひととてもありやなしや、怒れば足深空に跳り、その靴もきらめききらめき、涙のみくちなはのごとく地をはしる。",
              "citation": {
                "source": "光る風景",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔郡属伊原忠右エ門〕宮沢賢治郡属伊原忠右エ門科頭にゴムの靴はきて冬の芝生をうちよぎり南ちゞれし綿雲に雨量計をぞさゝげたる天狗巣病にはあらねどもあまりにしげきこずゑかな",
              "citation": {
                "source": "〔郡属伊原忠右エ門〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま彼の靴音は、しつかりとして大地を踏みつけて行く。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "うつむいて、自分の靴の先のあたりを、じつと見つめてゐた。",
              "citation": {
                "source": "校長三代",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はさよならを云つて、冷えた靴を穿いた。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその暗い玄関で、靴を穿いたのを覚えてゐる。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴を穿き終ると私は黙つて硝子張の格子戸を開た。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあね……」と彼女は三和土の上で靴を脱いでる夫の肩に手を置いて声だけを難儀らしくして云つた。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよ出掛けに靴を穿いてゐる時、祖母がやつて来て、「小母さん達は立派な仕度をして来てをるだらうね」といつた言葉を胸にくりかへしながら、彼は田圃路を歩いた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストーブに靴をのつけて、ガシガシと泥をかき落した。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤ン坊の泣声や、おひきずりの靴の音や、昆布や烏賊や洟紙や首巻や、みんなみんな、街頭沿ひの電線の方へ荷馬車の音も耳に入らずに、舞ひり吁！",
              "citation": {
                "source": "暗い天候",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥濘のひどい道に古靴を引きずって役所から帰ると、濡れた服もシャツも脱ぎ捨てて汗をふき、四畳半の中敷に腰をかけて、森の葉末、庭の苔の底までもとしみ入る雨の音を聞くのが先ず嬉しい。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒板へ書いている数式が間違ったりすると学生が靴底でしゃりしゃりと床をこするので教場内に不思議な雑音が湧き上がる。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「××さん、靴はあちらですよ」。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲板をあちこちする船員の靴音がコツリ／＼と言文一致なれば書く処なり。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "下駄の音靴のひゞき。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃｜流行った鍔の広い中折帽を被って縞の着物、縞の羽織、それでゴム靴をはいて折カバンを小脇にかかえている、そうして非常にゆっくり落着いて歩いて来るのである。",
              "citation": {
                "source": "高浜さんと私",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "中折帽に着流しでゴム靴をはいて、そしてひどく考え込んだような風でゆっくり歩いて来る姿をはっきり覚えているように思うのであるが、しかし、これはよくある覚えちがいであるかもしれない。",
              "citation": {
                "source": "高浜さんと私",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "きたない藁靴をはいて來た筈だが。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "繻絆の前をハダけて、靴をツツかけて水を飲みにゆく。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "騎兵聯隊や上肢の運動や、下級官吏の赤靴のことや、山沿ひの道を乗手もなく行く自転車のことを語らうと思ふ。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴム長靴の脛だけの部分、アラビアンナイトの粟粒のような活字で埋まった、表紙と本文の半分以上取れた英訳本。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度の何とか称する貴族で、デッキパッセンジャーとして、アメリカに哲学を研究に行くと云う、青年に貰った、ゴンドラの形と金色を持った、私の足に合わない靴。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃ刑務所出来の靴さ。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、印度の靴の爪尖のように、先が尖って、撥ね上っていた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "――俺たちも――　此考えを、彼等は頑固な靴や、下駄で、力一杯踏みつけた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして行き交う厚い外套と雪靴の街、子供達の雪合戦の街、橇の其処にも此処にも散ばる街――その街はクリスマスの仕度の賑わう街なのです。",
              "citation": {
                "source": "伯林の降誕祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴屋の安売――運動靴に、平常靴に、雪靴に、金と赤のイヴニングシューズまで寄せて一円五十銭也と括りの紐の結び目に正札で下って居ます。",
              "citation": {
                "source": "伯林の降誕祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……対象の知れぬ寂しみ神様はつまらぬものゝみをつくつた盥の底の残り水古いゴムマリ十能が棄てられました雀の声は何といふ生唾液だ！",
              "citation": {
                "source": "（ツツケンドンに）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
