        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "反賊たちは王国の支配に抵抗した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この地に反賊の隠れ家があるという噂だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は反賊のリーダーとして、民衆から信頼されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "公は罪を宥し位に敍せらる、南洲は永く反賊の名を蒙る、悲しいかな。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "「反賊、運のつきだぞ」「こころよく天誅をうけろ」　猛然、迫ってきたものこそ、まさに味方とたのんでいたその二人にまぎれもない。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "反賊仲達、その首をさずけよ」　蜀の姜維は、やにわに槍をすぐって、孔明の車の側から征矢の如く追ってきた。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
