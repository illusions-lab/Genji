[
  {
    "uuid": "2b3edbcc-f0d5-5781-bf5a-e54c6fe8c9a8",
    "entry": "憚り様",
    "reading": {
      "primary": "はばかりさま",
      "alternatives": [
        "はばかりさん"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "感動詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "thank you for your trouble",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「お待たせして、憚り様でした」と、彼は深々と頭を下げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大変な作業をしてくださり、まことに憚り様です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「わざわざお越しいただき、憚り様」と、主人は客を迎えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「さあ、こちらへどうぞ、」「憚り様。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ちっとも憚り様なことはありやしません。",
              "citation": {
                "source": "女客",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "謹さん、」「何ね、」「貴下、その（憚り様ね）を、端書を読む、つなぎに言ってるのね。",
              "citation": {
                "source": "女客",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お種さんが、（憚り様、どうかそこをお閉め下さいまし。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　小造な若い令夫人は声を懸けて向直ったが返事をしなかったので、「貴方｜憚り様ですが呼鈴を、」とお睦まじい。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「憚り様で御座います」「いや、御注意を申すのです」「その御注意が憚り様で御座いますと申上げるので」「ああ、さうですか」「今朝のあの方なら、そんな御注意なんぞは遊ばさんで御座いませう。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "従僕拾うて渡すと芸子｜憚り様と言いざまその僕の手とともに握って戴き取った。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はこう見えても憚り様ながら頭はしっかりしているんだ！",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きい門の闇の中に立って、高い窓へ「夜中、憚り様、将曹様へ急用」　と、益満が叫んだ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　すると家内は澄まし返って、「｜憚り様、あなた。",
              "citation": {
                "source": "真珠の首飾り",
                "author": "ZHEMCHUZHNOE OZHERELJE",
                "note": "青空文庫"
              }
            },
            {
              "text": "細君は、忙がしそうに、台所の障子を開け放したまま出て来て、座敷の入口に立っていたが、この分り切った注意を聞くや否や、「ええ今｜直」と云ったなり、引き返そうとしたが、また戻って来て、「その代り小六さん、憚り様。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人は恐れ入るかと思うと「あの師匠はいやに上品ぶって自分だけ人間らしい顔をしている、馬鹿野郎です」「憚り様、女ですよ。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼鏡を掛ける練習なんて、きいたことがねえよ」「はばかりさま、眼鏡にでも掛け方はありますわよ。",
              "citation": {
                "source": "眼鏡",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私きのう田島さんの塾に行って、田島さんにお会い申してよくお頼みして来ましたから、少し片付いたらはばかりさまですがあなた御自身で二人を連れていらしってください。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きにはばかりさまですね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいかげん人をバカにしてもらいますまいよ」「じゃ、もう洗ってきたか」「いいえ、はばかりさま！",
              "citation": {
                "source": "右門捕物帖",
                "author": "袈裟切り太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "南町はどなたのご配下の岡っ引きだとききやがるから、へん、はばかりさま、いま売り出しのむっつり右門様っていうなおれの親分なんだって、つい啖呵をきっちまいましたら、おやじめがこんなにぬかしやがるんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときに、どうだね、たいそうもなく江戸っ子がっていたようだが、肝心の幽霊水とかの眼はもうおつきかい」「はばかりさま、自慢じゃねえが、まだちっともつかねえんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "御案内しましょう」「はばかりさま」　女中は茶盆を持ってお光を案内する。",
              "citation": {
                "source": "深川女房",
                "author": "小栗風葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はばかりさまだね、下駄をいじらせて――」「いいえ、ね――だって、姐さん危ないんじゃないの？",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "はばかりさまさ――まあ、一ぱいやってから、雪之丞をからかいに来て見るがいい――きもッ玉がでんぐりがえって、腰を抜かさずにはいられめえから――は、は、は、やっぱし、女さかしゅうして、牛うり損うだなあ――大人しく、万引でもしていりゃあいいに、あばずれ奴！",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうもはばかりさま」「あなたがだいこんですか。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤ、はばかりさま」　それじゃア何のことはない。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸むらさきと注文したんだが、これが江戸紫なもんか」「はばかりさま。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳子　はばかりさま、すみませんわね。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちぇッ、いやな面だ」　笑子はぐたぐたと坐り込んで、「いやな面ではばかりさまね。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも、はばかりさま、というようなことをいった。",
              "citation": {
                "source": "予言",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
