  {
    "uuid": "bce49c51-62ca-58eb-a55d-c13854a276c4",
    "entry": "排気",
    "reading": {
      "primary": "はいき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
