        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "exhaust",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "換気扇は、室内の空気を排気する役割を果たす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "厨房の熱気を逃がすため、天井の強力なファンで絶えず排気を行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "排気が不十分な密閉された部屋でストーブを使うと、一酸化炭素中毒の危険がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」くるみ色に塗られた排気筒の下に座って日に当ってゐると私は印度の移民です。",
              "citation": {
                "source": "『春と修羅』補遺",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱｜瓦斯の検査中に被害を受けたものと見えて、直ぐ前の坑壁には切り離された発火坑の排気管が、針金で天盤の坑木に吊し止められ、踏台の上には分析用の器具が乱雑に置かれたままになっていた。",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "工手は切取られた排気管の前に立って、殺された技師の残した仕事をあれこれと弄り廻していたが、急に身を起すと、「係長。",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、瓦斯が出ている」「でも排気してるんでしょう？",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊池技師は排気管を調査した。",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは毒瓦斯をしきりに排気している送風機の音だった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "排気が済まないと、首領は出て来られないのだと、帆村は早くも悟った。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、煙硝が燃えたのですから、膜嚢を排出した時の排気の反動で、恰度ロケットのような現象が現われたのです。",
              "citation": {
                "source": "失楽園殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず河竹は短剣の柄を栓の口に嵌め込んでから、そこと元捻迄の鉛管に小さな孔を開けて、其の部分の空気を排気｜※筒で抜いてしまったのです。",
              "citation": {
                "source": "失楽園殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず河竹は短剣の柄を栓の口に嵌め込んでから、そこと元捻迄の鉛管に小さな孔を開けて、其の部分の空気を排気※筒で抜いてしまったのです。",
              "citation": {
                "source": "失楽園殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだポトリ　ポトリ　雨のしずくがトタン屋根にしたたっているが、前の瓦屋根越に見えるよその排気筒はしずかにゆるやかにまわって、蠅が　巻き上げた簾のところで　かたまってとびまわっている。",
              "citation": {
                "source": "無題（十）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "クーペは薄紫のガソリン排気を後にのこし、車上の男女は視界から去った。",
              "citation": {
                "source": "心臓盗難",
                "author": "烏啼天駆シリーズ・２",
                "note": "青空文庫"
              }
            },
            {
              "text": "上に小さい煙突のようなものがついて、そこから残りの排気らしい煙がすうーッと立ちのぼる。",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "三台の自動車が、次々に白いガソリンの排気をまき散らしながら、通りへ走り出していった。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "車体のうしろの排気管から、白い煙が、濛々と出てきた。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そのうちに、戦車の排気管から、赤い煙が濛々と出て来た。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "重い毒瓦斯は、あの方へ排気するんだ。",
              "citation": {
                "source": "毒瓦斯発明官",
                "author": "――金博士シリーズ・５――",
                "note": "青空文庫"
              }
            },
            {
              "text": "送信術でも二十五ケ一台を三十分にて排気作業完成し完封するので、一日にこれを二十回もくりかえし得るという。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくしてそのトラックは速力を緩めることなしに、店員にガソリンの排気をいやというほど引掛けて遠去かっていってしまったのである。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは御承知の通り、やや排気鐘的な作用をいたしまして、こう、吸盤の面を顔の平面へ吸いつけては離し、吸いつけては離しいたしまして顔面の血行をよくいたします。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車の排気の影響だと、もっとひどくて、三十フィート先を一台の自動車が通ると、今まで二百個くらいだったのが、一挙に十万個にはねあがる。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛行機の排気の影響は、もちろんもっとひどい。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると今までは気がつかなかったが、エンジンカバーの隙間から見える排気の火が、赤く見えてくる。",
              "citation": {
                "source": "アラスカ通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "事実、スケート・リンクでの予備実験は極めて短時日で終了したらしく、石油を完全燃焼させて、その過熱排気を直接大気中に放出する方法を用いることになったらしい。",
              "citation": {
                "source": "霧を消す話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう記事がなくても、今の目的には、即ち大量の熱気を送り出し、その全体の熱量さえ多ければよいという場合には、石油を完然燃焼させて、その熱排気に空気を混じて送り出すというのが一番悧巧な方法である。",
              "citation": {
                "source": "霧を消す話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パン、パン、パン……いま機関銃が鳴ったようだけど」「機関銃……ノオ、戦車の排気音だ」「戦車はどこへ行ったのですか」「あれだって生きものだから、どこかへ寝に行ったのだろう」　がっかりして気が遠くなった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "排気鐘の中　太平洋戦がはじまってから三度目の降誕祭が来かけていた。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄が耕二の間の障子を開けると、「負けちやつた」と耕二はいきなりそれだけ言つた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとジョバンニはいきなりさっきカムパネルラといっしょだったマルソ〔に〕会ひました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　油断をしているうちに、達二はいきなり山男に足を捉まいて倒されました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "expulsion (of air)",
        "register": "standard",
        "nuance": null,
