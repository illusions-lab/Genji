        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "契約内容に不備があったため、その契約は廃棄された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "両国の合意のもと、時代に合わなくなった古い平和条約の廃棄が宣言された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "理事会の決定により、これまでの不合理な学則はすべて廃棄されることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
