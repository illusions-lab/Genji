    "definitions": [
      {
        "index": 1,
        "gloss": "cutting in half",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この大きなケーキを、公平に半切して皆に配りましょう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "厚紙をカッターで半切して、工作の材料にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は、リンゴを器用に半切して、サラダに加えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "彼女の見事な筆跡で書いた半切や色紙短冊が飛ぶように地方へ売れた。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "話の途中で亀田先生は、「あなたは、字を書いた短冊や半切をお売りにならないのですか。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボロボロの唐紙半切に見事な筆跡で、薄墨の走り書きがしてあった。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "青みのある灰色で、半切、ひどい字がのたくっていた。",
              "citation": {
                "source": "グローリア・スコット号",
                "author": "THE \"GLORIA SCOTT\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋燈を片寄せようとして、不図床を見ると紙本半切の水墨山水、高久靄※で無論真筆紛れない。",
              "citation": {
                "source": "浜菊",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その貝を捕る女は半切を片手に引き寄せながら板子を滑らしては面白ろさうに走つてゆく。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒屋男は半切鳴らそと櫂を取る。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "平たい半切に心太も入れられてあった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "景年翁と商人６・25（夕）　東京の絵画商人の某が、京都で展覧会を開くために、今尾景年氏の許へ、半切の揮毫を頼みに出掛けた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "高が半切だと聞いて、画家は会はうともしない。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「半切一枚五十円どつせ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "なに理由を話したら先生の事やさかい、半切の一枚や二枚ちよつくらちよつと書いて呉りやはりますやろ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "短冊や半切を書いて書債を果たす。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、やうやく半切四枚を書きなぐつた、悪筆の乱筆をもつともつと揮はなければなりません！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "しようことなしに、暮羊君から墨を借りて、半切四枚書きなぐる、いつものやうに悪筆の乱筆、仕方がないといへばそれまでだけれど、あまりよい気持ではない、そしてそれを急いで送るべく――早く物に代へて貰ひために、ポストまで出かける、ついでにうどん玉を買ひたかつたが、かなしいかな、銭がなかつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛国婦人会へ寄贈すべき半切の画箋紙を暮羊君から寄贈して貰つた。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一杯機嫌で、愛国婦人会から申込まれてゐた半切と短冊とを書きあげる（傷病将士慰問、書画即売、展覧会の一部として、私は喜んで書いて贈るのである）、慰安するのでなくて、かへつて慰安されるのだ！",
              "citation": {
                "source": "旅日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一杯機嫌で半切十数枚書きなぐつた、魚眠洞君へ、指月堂君へ送つて、ほつとする、重荷をいくつもおろしたやうに。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏の子供に墨をすらせて、半切二三枚書きなぐる、それをやあさんの店に届け、ついでに図書館へまはつて新聞を読んで戻る。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かな部屋の中に、半切の音がかさ／＼鳴つた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　渠は、ランプの光が直接にかの女の顏に當らないやうに、その方へ、原稿紙の半切れを笠に張つて目隱しをしたその蔭を向けるのであつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "□白船老から手紙と半切とが来た、これで其中庵も持つべきものを一つ持つことが出来た訳だ、多謝多謝。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "句集半切代入手、払うて買うて、すぐまた無一文。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "短冊と半切とを書きなぐつた、自分が、自分といふ人間の出来てゐないことを痛感する、かういふ場合にはいつもかういふ痛感があるのだが。",
              "citation": {
                "source": "行乞記",
                "author": "室積行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "但糊入半切に認、上包半紙半分折懸、上に年齢書、下に名。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "但糊入半切認、上包半紙折懸、上に名。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてテエブルの端のほうへランプを引き寄せて、僕に、君が見ている、その灰色の半截紙に書いてある短い手記を手渡した。",
              "citation": {
                "source": "グロリア・スコット号",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし此人の生涯は余りに隔絶したる前後両半截をなすがために、殆どその同名異人なるかを疑ふ人のなきを保し難い。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "小太郎は、二時の授業時に、笑いながら、半截の用紙に、それでもやっと一枚と二行くらい書いて来て、新子にさし出した。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "大分以前京都のある呉服屋が栖鳳、香※、芳文、華香の四人に半截を一枚｜宛頼んだ事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
