        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "書道展に出品するため、彼は半切の紙に力強い書を書いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "日本画の講師は、半切の紙に描く構図の取り方について指導した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の水墨画は、半切の紙の余白を効果的に使っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "half-size paper",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
