    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Hayabusa (Japanese spacecraft)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "小惑星探査機「はやぶさ」の地球帰還は、日本中を感動させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「はやぶさ２」は、新たな小惑星のサンプルリターンに成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "はやぶさプロジェクトは、日本の宇宙開発の大きな一歩となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "五十米レエスならば、まず今世紀、かれの記録を破るものはあるまい、とファン囁き、選手自身もひそかにそれを許していた、かの俊敏はやぶさの如き太宰治とやらいう若い作家の、これが再生の姿であろうか。",
              "citation": {
                "source": "答案落第",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷹やはやぶさ、又さほど強くはなけれども日中なれば烏などまで恐れねばならぬ情ない身ぢゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやぶさなれば空よりすぐに落ちて来て、こなたが小鳥をつかむときと同じやうなるありさまぢゃ、たちまち空で引き裂かれるぢゃ、少しのさからひをしたとて、何にもならぬ、げにもげにも浅間しくなさけないわれらの身ぢゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷹やはやぶさ、又さほど強くはなけれども日中なれば烏などまで恐れねばならぬ情ない身じゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやぶさなれば空よりすぐに落ちて来て、こなたが小鳥をつかむときと同じようなるありさまじゃ、たちまち空で引き裂かれるじゃ、少しのさからいをしたとて、何にもならぬ、げにもげにも浅間しくなさけないわれらの身じゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたはお名まえもたかの中のはやぶさと同じでいらっしゃるのに、さあ早くささぎをとり殺しておしまいなさい」とこういう意味をお歌いになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふふん、このかまどの下は井戸だな」　慧眼はやぶさのごとき眼力で早くも推定がついたものでしたから、こころみにそこをたたいてみると、果然聞こえるものは、ぼうんぼうんという、まだ埋められてない古井戸の音響です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "なぞの八卦見",
                "note": "青空文庫"
              }
            },
            {
              "text": "――烱眼はやぶさのごとき名人が見すごしするはずはないのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ご不審はあとでわかりますから、ひとっ走りお宅へ帰って、早いところおしたくしてくださいましよ」　くし巻きお由、今こそ堅気のあだ者お由でしたが、一年まえまでは生き馬の目を抜いたはやぶさお由です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "明月一夜騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "慧眼まことにはやぶさのごとし！",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ぴかりと名人の目が、はやぶさのように光りました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやぶさと訓ませるのですか。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "やまがらは、驚いて、飛び立とうとして、「それよりは、私は、昨日、嶺のあちらで、はやぶさにねらわれた。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうすこしで捕らえられようとしたのを、いばらのやぶに逃げこんで助かったが、こうして、風が、ふいに吹くと、また、はやぶさにねらわれたかと思って、びっくりする……。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやぶさが、こまどりを狙って、それを捕らえたからです。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はやぶささん、どうか、そのこまどりの命だけは、取らないでください。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、木立は、はやぶさに訴えました。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、はやぶさは、こまどりを片脚で押さえつけて、いいました。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやぶさは、目をくるくるさしていましたが、「ほんとうに、寒い、さびしい日だな。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、はやぶさはいいました。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、はやぶさは、すぐに、こまどりを放してやろうとはしなかったのでした。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "」といって、はやぶさは両脚で、こまどりの体を踏みつけたのでした。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が、ほのぼのとあけかかったとき、木立は、こまどりがどうなったかを見ると、はやぶさは、もはや、そこにはいませんでした。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後へ、先日のしじゅうからが飛んできて、木立から、はやぶさとこまどりの話を聞いて、小さなくびを毛の中にすくめたのです。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな皮と骨ばかりの私どもを、はやぶさだってねらいはしますまいから……。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちらで、はやぶさが、こまどりをにらんでいたからです。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "こまどりは、やはり、怖ろしいはやぶさのすんでいる、山の中が恋しくなりました。",
              "citation": {
                "source": "美しく生まれたばかりに",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、やかましやの親方卜斎、つねに小言と拳骨をくださることはやぶさかでないが、なかなか蛾次郎の慾をまんぞくさせる小遣いなどをくれるはずがない。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
