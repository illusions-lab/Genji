  {
    "uuid": "12b9156b-3d0d-589e-9f46-05f82d227949",
    "entry": "鶻",
    "reading": {
      "primary": "はやぶさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
