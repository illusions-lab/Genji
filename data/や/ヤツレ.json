[
  {
    "uuid": "4a08db06-592e-5d08-9ca4-5782974ccdc4",
    "entry": "窶れ",
    "reading": {
      "primary": "やつれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
