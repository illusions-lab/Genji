[
  {
    "uuid": "490175b2-ae43-52fb-8a7a-967c4ecb3365",
    "entry": "ノウス",
    "reading": {
      "primary": "のうす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
