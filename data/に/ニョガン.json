          "literary": [
            {
              "text": "……夫婦如願離異者。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "家隆や源家長が第一それで、藤原｜秀能なども出家して如願といっていた。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また特に力量抜群の三上皇の御歌を入れなければ歌集の体を成さぬし、家隆や如願法師（秀能）など後鳥羽院の寵遇を蒙った歌仲間の思わくも如何である。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "如願敬造釈迦尊像並挟持及荘厳具竟。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
