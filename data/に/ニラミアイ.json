        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "政治家たちの間に、深刻な政策のにらみ合いが続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "二つの派閥は、長年にわたってにらみ合いを続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "外交交渉は、両国の間ににらみ合いを生んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
