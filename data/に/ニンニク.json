[
  {
    "uuid": "2cb2d8c6-826a-5ce7-908c-c9373a755930",
    "entry": "大蒜",
    "reading": {
      "primary": "にんにく",
      "alternatives": [
        "ニンニク"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
