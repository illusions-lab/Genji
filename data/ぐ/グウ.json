        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「私の偶は、いつも私の話を真剣に聞いてくれる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「昔は、互いを『偶』と呼ぶのが粋だったらしい。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「夫婦円満の秘訣は、お互いを尊重し、良き偶であることだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
