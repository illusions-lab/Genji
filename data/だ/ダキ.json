          "literary": [
            {
              "text": "」　技手は柁機を廻した。",
              "citation": {
                "source": "薔薇",
                "author": "ROSEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の一瞬間に、ヰクトルは今まで握つてゐた手を柁機から離した。",
              "citation": {
                "source": "薔薇",
                "author": "ROSEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに安済丸は海に泛んで間もなく、柁機を損じて進退の自由を失った。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
