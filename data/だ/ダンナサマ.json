[
  {
    "uuid": "6db21fea-0ff8-56cb-b13a-e91d02c48e3d",
    "entry": "旦那様",
    "reading": {
      "primary": "だんなさま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "husband",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「旦那様はまだお帰りではありませんか」と妻は玄関の外を気にしながら尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "旦那様が出張で不在の間、彼女は一人で子育てと家事をこなしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "妻は旦那様の健康を心配して、毎朝欠かさず野菜たっぷりの朝食を用意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "今少しく精細に云って見るならば、役人の家庭、職人の家庭、芸人の家庭、学者の家庭、新聞記者、政治家、農家、商家、其の外に貧富の差がある、智識の差がある、夫婦諸稼の家庭もある、旦那様奥様の家庭もある、女の多い家、男の多い家、斯く数えて来たらば際限がない。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "村人は時々「旦那様の遊戯部屋」の「実験室」についてゴルドンに質問し“That ain't much good, is it?”などと云った。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして「旦那様、どうぞ、御からだを御大事に」と云った。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――旦那様は、洋服で、それ、絵を描く方が、こゝへぶら下げておいでなさる、あの器械を持つて居らしつけえ。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は見るより人目も恥じず、慌てて乳房を含ませながら、「夜分のことでございますから、なにとぞ旦那様お慈悲でございます。",
              "citation": {
                "source": "夜行巡査",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘヘ……旦那様……横道へ入って恐れ入りまするが、私は元来、金持が嫌いで御座いまして……」「フーム。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "とても真実とは思われぬわい」「旦那様……」「何じゃ……」　松倉十内は白々と眼を見開いた。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旦那様……」「何じゃ……」「早ようお手当なさりませぬと、蔵元屋は夜逃げ致し兼ねますまいて……肝腎要の金の蔓の娘が殺されたので御座いますから……」「うう――――むむ……」　松倉十内は恨めしそうな白い眼で赤猪口兵衛を白眼み付けた。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが酒の相手は軒の梅桜　　　　　　　　風に浮かれてチリテツトシャン世の中は三分五厘風鈴の　　　　　　　　ふところ合ひがチリンカラカラ　その風鈴に近い破れ畳の上に、調子悪そうにキチンと坐っているのは相当の商家の若旦那様と見える、二十歳前後のオットリした優男。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那様のお時計はもう出来ております。",
              "citation": {
                "source": "ざんげの塔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある晩のことに私が床を延べていますと、お俊が飛んで参りまして、『どうせ私じゃお気に入りませんよ』と言いざま布団を引ったくって自分でどんどん敷き『サア、旦那様お休みなさい、オー世話の焼ける亭主だ』と言いながら色気のある眼元でじっと私を見上げましたことなどは、ただの仕草ではなかったのでございます。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにそれにも増していやらしかったのは旦那様の淫らなことだった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あたりめえだわ、奉公の道だもの、これが（といってかやの頭を撫でて）己らの旦那様だから、ねえ、おかやちゃん、お江戸のお邸では女子でも御主人を旦那様って云うんですよ」　婆やは、こんなことを、かやに云うとも独言とも付かず云った。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "深切な婆々は、膝のあたりに手を組んで、客の前に屈めていた腰を伸して、指された章魚を見上げ、「旦那様、召上りますのでござりますか。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵のお宿銭ぐらい頂戴をいたします勘定でござりますから、私どもにもう一室、別座敷でもござりますなら、お宿を差上げたい位に、はい、もし、存じまするが、旦那様。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「これは、旦那様お世辞の可い、土地を賞められまして何より嬉しゅうござります。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おお、そういえば旦那様、お宿はどうなさります思召。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "後方の古市でござりませんと、旦那様方がお泊りになりまする旅籠はござりませんが、何にいたしました処で、もし、ここのことでござりまする、必ず必ずお急き立て申しますではないのでござりまするけれども、お早く遊ばしませぬと、お泊が難しゅうござりますので。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那様お通りの時分には、玉ころがしの店、女郎屋の門などは軒並戸が開いておりましてございましょうけれども、旅籠屋は大抵戸を閉めておりましたことと存じまする。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でござりますか、それでは旦那様は、」「うむ、内のもの同然だ。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、（旦那様、お初に。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と私御挨拶をしました処で、爺の口から旦那様が嬉しい、飲ましてやろう、と姉さんが申されたのでござりましたよ。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）桜草の前へ立った時、……お孝に挨拶をした爺さんが、（これは旦那様。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、「家のだんなさまが、お前さんに会いたいから、つれて来いと、おっしゃられた。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、「だんなさま、ごめんください。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ある日、友達を呼びあつめて、ごちそうをしています時、召使の一人が入って来て、「ただ今、カリフさまのお使がお見えになって、だんなさまにお目にかかりたい、とおっしゃいますが。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だんなさま、あなたさまは、そんなつらい目におあいになっても、よくがまんをなすったからこそ、こんなお金持におなりになったのでございます。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとお姫さまは、「ああ、だんなさま、私どうしましょう。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "一、アラジンとふしぎなランプ",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはきっと、だんなさまに悪いことをしようとする者がつけたしるしにちがいない、とモルジアナは思いました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "三、アリ・ババと四十人のどろぼう",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、これはきっと、だんなさまを殺すつもりにちがいない。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "三、アリ・ババと四十人のどろぼう",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは旦那様、ちょっと食後の御散歩は、いかがでしょう。",
              "citation": {
                "source": "竹青",
                "author": "――新曲聊斎志異――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私は、旦那様のようにちゃんと座蒲団に坐って、腕組みしている。",
              "citation": {
                "source": "秋風記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と鞠は落ちつき、「かねてあの青崎百右衛門殿は、いいとしをしながらお嬢様に懸想して、うるさく縁組を申し入れ、お嬢様は、あのような鷲鼻のお嫁になるくらいなら死んだほうがいいとおっしゃるし、それで、旦那様も、――」「そうか、それで事情が、はっきりわかった。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那様は、こんな時には家にいぬものだと言われて、これさいわい、すたこらここへ逃げて来ました。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "松やは、旦那様にも奥様にも申し上げませぬ。",
              "citation": {
                "source": "花火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お客は旦那様のお友達の母様でございます。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥満のお三どんが、ぶっちょう面をしゃあがって、旦那様とか、先生とかお言いなさい、御近所へ聞えます、と吐しただろうじゃねえか。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人にね、お前の盤台を覗かせると、皆欲がるンだから……」「これ、」　旦那様苦い顔で、「端近で何の事たい、野良猫に扱いやあがる。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旦、旦那様、あの、何が、あの、あのあの、」　　　　　矢車草　　　　　　　十　お源のその慌しさ、駈けて来た呼吸づかいと、早口の急込に真赤になりながら、直ぐに台所から居間を突切って、取次ぎに出る手廻しの、襷を外すのが膚を脱ぐような身悶えで、「真砂町の、」「や、先生か。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はい、」「主税さんは……あの旦那様は、」　と言いかけて、急に気が着いたか、「まあ、どうしたの、暗いのねえ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "段の下の扉の蔭から、そりゃこそ旦那様。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「へい、無い事もござりませぬが、旦那様方の住まっしゃりますような邸は、この居まわりにはござりませぬ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "絹足袋の、静な畳ざわりには、客の来たのを心着かなかった鞠子の婢も、旦那様の踏みしだいて出る跫音に、ひょっこり台所から顔を見せる。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "病院に入切で居ながら、いつの何時には、姉さんが誰と話をしたッて事、不残旦那様御存じなの、もう思召ったらないんですからね。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「旦那様、帳場でも、あの、そう申しておりますの。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「へい、……こっちの湯どのは、久しく使わなかったのですが、あの、そう言っては悪うございますけど、しばらくぶりで、お掃除かたがた旦那様に立てましたのでございますから、……あとで頂きますまでも、……あの、まだどなたも。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "桔梗　旦那様の御前に、ちょうど活けるのがございませんから、皆で取って差上げようと存じまして、花を……あの、秋草を釣りますのでございますよ。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）亀姫　ほほほ、貴女を旦那様にはいたすまいし。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "亀姫　旦那様が、おいで遊ばす。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そして旦那様は、こんな台所へ出ていらっしゃるものではありません。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "百合　叔父さん、何にも申しません、どうぞ、あの、晃さん、旦那様のお帰りまでお待ちなすって下さいまし。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "宅膳　またしても旦那様じゃ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）百合　（一目見て）おお晃さん、（ところげ落ち、晃のうしろに身をかくして、帯の腰に取縋り）旦那様、いい処へ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "俎の上で切刻まれ、磔にもかかる処を、神様のような旦那様に救われました。",
              "citation": {
                "source": "錦染滝白糸",
                "author": "――其一幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "りく　旦那様のお帰りですね。",
              "citation": {
                "source": "錦染滝白糸",
                "author": "――其一幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "撫子　（鬢に手をあて、悄れて伏す）旦那様、済みません。",
              "citation": {
                "source": "錦染滝白糸",
                "author": "――其一幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この村越様は、旦那様のお名は何とおっしゃいますえ。",
              "citation": {
                "source": "錦染滝白糸",
                "author": "――其一幕――",
                "note": "青空文庫"
              }
