      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "responding to a call-up for military service",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "戦時中、多くの若者が兵役への応召を命じられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は国からの応召に応じ、戦地へと向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "予備役の兵士は、緊急時には応召の義務がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "小沢は両親も身寄りもない孤独な男だったが、それでも応召前は天下茶屋のアパートに住んでたのだから、今夜、大阪駅に著くと、背中の荷物は濡れないように（また、雨の中を背負って行く邪魔でもあったので）駅の一時預けにして、まず天下茶屋のアパートへ行ってみた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "差出人はＳという私の旧友からで、その手紙を見て、はじめて私はＳが応召していることを知ったのである。",
              "citation": {
                "source": "面会",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、夏子はもともと引っ込み思案で、応召した夫が戦死したのちも、六つになる男の子と昔かたぎの姑と、出戻りの小姑と一緒に暮すつつましい未亡人ぶりが似合う女であった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "商業学校の夜間部を出ると、出納係に雇われたが、間もなく応召し、五年の後復員して来たが、その五年の歳月はこの実直な青年の実直さを、すこしも変えていなかった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボソボソとした小さな声も、応召前と同じで、ソロバンをはじく手にも五年間の異常な経験のしみはついていないようだった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかげで、白崎は大学で覚えたことをすっかり忘れてしまうくらい、毎日逆立ちをやらされ、赤井は本職の落語を忘れてしまうくらい、毎日浪花節を唸らされて、いわば隊長の肴になるために、応召したようなものであった。",
              "citation": {
                "source": "昨日・今日・明日",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、彼等は隊長の酒の肴になるためにのみ応召したのではない。",
              "citation": {
                "source": "昨日・今日・明日",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やア、その節はいろいろと……」　赤井は応召前、佐川の世話で二三度放送したことがあった。",
              "citation": {
                "source": "昨日・今日・明日",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それきり顔を見せなくなったが、応召したのか一年ばかりたって中支から突然暑中見舞の葉書が来たことがある。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "応召した夫に代わって万事を取り仕切り、敗戦の年の冬も、頭上を覆う暗雲に気丈に向き合っていました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年、Ｔ君と見合いをして約婚したけれども、結納の直後にＴ君は応召になって東京の或る聯隊にはいった。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして応召の予定外の人にて取扱い者を定めて練習せしめ、時に競技会でも行なえばただちに上達する事請合いである。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くから起きて松原を散歩する、朝の海はことによろしい、同道して、七時の汽車で徳山へ、昨日も今日も応召兵見送でどの駅も混雑してゐる、涙ぐましい風景である。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時、組内の応召入隊者を駅まで歓送する、しんじつ頭がさがる、どうぞ、どうぞ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "この作家は、他の何人かの作家と共に応召して戦野に赴いた一人であり、応召までの文学的経験もあって、その「糞尿譚」は文芸春秋社の芥川賞に当選した。",
              "citation": {
                "source": "昭和の十四年間",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其｜巻四辛巳の詩中に、「送霞亭北条先生応召赴東都」の七律がある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――なるほど、どうして、君は応召されないんだらう、不思議だね、我輩なぞの身体は全く役に立たないが、……」　私の眼に雪片が飛び込んだ。",
              "citation": {
                "source": "大凶の籤",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "未婚者の考えはどこでどのように変るか外からは分るものではなく、矢代自身にしても、戦争が始ってからは、覚悟のこととはいえ、いつ応召するか分らぬ身であれば、残るものの身の上も考慮に入れて物いう風になって来ていた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "応召の際、父に頼んで、毎夜その日の支出費だけ必ずつけてくれと、云い残しただけだとの事である。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――戦争は段々激しくなり、また再応召が来るやうな話だつたが、直吉は、そんな事はどうでもよかつた。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "広島に応召中だった宮本の弟達治が負傷し、死んだが死体はみつからなかった。",
              "citation": {
                "source": "年譜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九四五年八月六日広島の原爆当日、三度目の応召で入隊中行方不明となった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の話を聞いて了うと、検事は黙って頷きましたが、そこで暫く考えてから、「それでは、あなたは、何の理由で二人が昨夜争ったか、確に御存知ないのですね……それでは一応召使たちに尋ねて見ることに致しましょう……ところで、もう一つ銀笛ですが、これは兄さんの笛でしょうな？",
              "citation": {
                "source": "西班牙の恋",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄の耕一が応召入隊の前に、植木屋から買ってきたもので、一米半ばかりの古い幹に、真白な花をふさふさとつけていました。",
              "citation": {
                "source": "白藤",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺の応召や彼女の病気がそれを妨げたのではなかった。",
              "citation": {
                "source": "白藤",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は応召前、ある医療機械店に勤めていたのだが、帰宅してみると、その店は罹災していて、まだなかなか復興の見通しはつかないらしかった。",
              "citation": {
                "source": "紫の壜",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨年、應召して、あちこち轉戰して、小閑を得る度毎に、戰爭を題材にした小説を書いては、私のところに送つて來ました。",
              "citation": {
                "source": "このごろ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次の妹は、獨り娘にもらつた養子が豫備少尉で、事變應召に勇んで出たのをはじめにして、つい兩三日前、すぐ下の妹の息子と、わたくしが預かつて、赤ん坊の時から育ててゐた、弟の子が、おなじ隊へはいつた。",
              "citation": {
                "source": "四人の兵隊",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころからです、もう身邊あちこちの知人の間に應召の“赤紙時代”が押寄せてまゐりました。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（この人は今でも大連の滿鐵にゐるさうである）ところが日露戰爭のとき應召したので、みんなで刀を贈つた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
