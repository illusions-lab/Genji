[
  {
    "uuid": "611ab65d-bd1f-5e2c-ac28-fa6601d4f12a",
    "entry": "応召",
    "reading": {
      "primary": "おうしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
