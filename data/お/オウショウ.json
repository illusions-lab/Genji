        "examples": {
          "standard": [
            {
              "text": "将棋のタイトル戦で、彼は見事な指し手で王将の座を防衛した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "永世王将の資格を持つ棋士は、その道の大家として尊敬されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "次回の王将戦は、若手棋士とベテラン棋士の対決として注目されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
