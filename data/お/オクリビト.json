[
  {
    "uuid": "a1e062e7-44b4-5f85-a4ee-81a105fbd218",
    "entry": "送り人",
    "reading": {
      "primary": "おくりびと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "person who sees someone else off (e.g. at the airport)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "駅で見送り人が手を振っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "多くの送り人に見送られて出発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "親切な送り人たちに感謝した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "おまきの棺が寺へゆき着くと、そこにはほかにも貧しい葬式があって、その見送り人は徐々に帰りかかるところであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまきの葬式は丁度それと入れ違いに本堂に繰り込むと、前に来ていた見送り人はやはり芝辺の人達が多かったので、あとから来たおまきの見送り人と顔馴染みも少なくなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふだんから評判のよくない母子ではあったが、それでも近所の義理があるのと、もう一つにはお作の横死が人々の同情をひいたとみえて、見送り人は案外に多いらしかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "見送り人の中にはお正も春子さんもいた。",
              "citation": {
                "source": "恋を恋する人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "知名の人の旅立ちでも、新聞があるために妙な見送り人が増して停留場が混雑する。",
              "citation": {
                "source": "一つの思考実験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな旅人とこんな見送り人とは、東京駅の長い歩廊にも恐らく又とはゐまい。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "増上寺の境内に、大勢の見送り人が集っていた。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなに、げらげら笑って」　Ｔ君の見送り人は、ひどく多かった。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尉は出発の時刻を秘密にしていたのであるが、どこで聞き伝えたのか、見送り人はなかなか多かった。",
              "citation": {
                "source": "火薬庫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "先方の見送り人には到底敵ひつこはないが、これは内密だが此方では夫々手配りをして他人まで頼んであるのだ、そして、あんたのお父さんの音頭で景気の好い万歳を唱へて貰ひたいのだ……といふやうなことを云つた。",
              "citation": {
                "source": "小川の流れ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラットフォームでは、駅員も見送り人も、立っている限りの人々は二人のほうに目を向けていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はそれに耳を傾けるような様子はしていたけれども、ほんとうはさして注意もせずに、ちょうど自分の目の前に、たくさんの見送り人に囲まれて、応接に暇もなげな田川法学｜博士の目じりの下がった顔と、その夫人のやせぎすな肩との描く微細な感情の表現を、批評家のような心で鋭くながめやっていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かなり広いプロメネード・デッキは田川家の家族と見送り人とで縁日のようににぎわっていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子の見送りに来たはずの五十川女史は先刻から田川夫人のそばに付ききって、世話好きな、人のよい叔母さんというような態度で、見送り人の半分がたを自身で引き受けて挨拶していた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子の叔母は葉子から二三｜間離れた所に、蜘蛛のような白痴の子を小婢に背負わして、自分は葉子から預かった手鞄と袱紗包みとを取り落とさんばかりにぶら下げたまま、花々しい田川家の家族や見送り人の群れを見てあっけに取られていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルン・デッキから見ると、三等客の見送り人がボーイ長にせき立てられて、続々｜舷門から降り始めた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "親しい間の人たちは別れの切なさに心がわくわくしてろくに口もきかず、義理一ぺんの見送り人は、ややともするとまわりに気が取られて見送るべき人を見失う。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見送り人は一斉に帽子を脱いで舷梯のほうに集まって行った。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "田川夫妻の見送り人たちはこの声で活を入れられたようになって、どよめき渡りながら、田川夫妻の万歳をもう一度繰り返した。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見送り人は思わず鳴りを静めてこの狂暴な若者に目を注いだ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて葬式が出る時刻になって、三十人ほどの見送り人が早桶について行った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "弁天娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "理由は省くが、普通の見送り人ではない一種妙な感情家にならされた。",
              "citation": {
                "source": "冬の風鈴",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　見送り人の一団が遠くに――こわいとみえてそばへは来ないで――かたまって、やたらに手をふったりカメラを向けたりしている。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "大勢の見送り人がハンカチを振ってる絵が映った。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄い灯の下に、下関行きの急行列車が沢山の見送り人を呑みこんでいた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄い灯の下に、下ノ関行きの急行列車が沢山の見送り人を吸いつけていた。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "桟橋の見送り人はどよめき、船のデッキには少しづつ、荷物をおろした乗客が並び出した。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "person who prepares a body for burial",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "映画『送り人』を先週見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "送り人として故人の遺体を整える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "送り人の仕事は非常に神聖である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
