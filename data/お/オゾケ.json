  {
    "uuid": "50e2a4ab-4061-5812-9401-0bdf77c4a9a4",
    "entry": "オゾケ",
    "reading": {
      "primary": "おぞけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "予防注射していますし、あんなに気をつけてそれで頂いたのならマアいいや、だがうちの連中にはさぞオゾケをふるわれるだろうなど、考えて午前四時ごろになってふと喉のところさわったら耳の下がはれ出しています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで白雲も、「しかし、あの海を畳同様に心得ている奴等が、ああやってオゾケをふるうのだから、全く跡形のないことでもあるまい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と今度は音に立てて、さしもの親方が、オゾケを振って一時立ちすくんだのは無理もありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
