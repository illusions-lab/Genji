        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それだから、現に墺匈国の臣民になっています。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "墺匈国では高利貸しが厳禁せられている。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            },
            {
              "text": "墺匈国で領事の置いてある所では、必ず面会しなくてはならない。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            }
