        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "壊れやすいので、梱包は非常に丁寧に行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は、繊細な作業を丁寧に進め、完璧な仕上がりを見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この資料、確認は丁寧にお願いしますよ。」「はい、承知いたしました。細部まで注意して確認します。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
