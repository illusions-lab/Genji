  {
    "uuid": "6ca4613c-a1c6-55df-aa49-7d32cd79d1cb",
    "entry": "老壮",
    "reading": {
      "primary": "ろうそう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "海野は老壮士なればなり。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒尾譲介は言ふ迄もなく、小説『金色夜叉』に出て来る老壮士である。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『血あり涙あるを口癖にいふ老壮士か。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、百何十人もの老壮若の戸主達がこのばさばさした紙で着ふくれ、列をなして歩くときの様子は、まさに観物にちがひない、といふ実感を抱かせたのである。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
