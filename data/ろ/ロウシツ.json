          "literary": [
            {
              "text": "ただ道也先生がこの一点の温気なき陋室に、晏如として筆硯を呵するの勇気あるは、外部より見て争うべからざる事実である。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "貰ひものなれども余の陋室に灯す術もなからむ。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は下宿の陋室にくすぶっているが、やがては二人の恋愛から……。",
              "citation": {
                "source": "叔父",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝太平の陋室で目覚めた庄吉は、学生時代によみがへつた若々しさで、目を細くして殺風景な部屋の隅々まで見廻して一つ一つ頭に書入れてゐるやうな様子であつたが、その様はなつかしさに溢れてゐた。",
              "citation": {
                "source": "外套と青空",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
