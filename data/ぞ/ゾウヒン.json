[
  {
    "uuid": "9889bf19-b54e-5cbc-8bbf-e37c688a6260",
    "entry": "贓品",
    "reading": {
      "primary": "ぞうひん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
