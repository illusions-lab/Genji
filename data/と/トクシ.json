        "examples": {
          "standard": [
            {
              "text": "若い世代の間で、社会貢献への篤志が高まっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は地域活性化事業に対し、並々ならぬ篤志を抱いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "環境問題への篤志から、多くの市民がボランティア活動に参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
