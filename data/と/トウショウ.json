[
  {
    "uuid": "7c0240f6-fb56-51d9-8619-0779a97b2e59",
    "entry": "凍傷",
    "reading": {
      "primary": "とうしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
