  {
    "uuid": "ae9ceb68-84df-5b0a-bf3b-ce9397c838f7",
    "entry": "トウゴ",
    "reading": {
      "primary": "とうご",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "東牟婁郡第一の高山、大塔の峰で年久しく働く人々に聞いたは、かの山難所で時計など持ち行く者なく、鶏飼うべき所もないが、ちょうど一番鶏の鳴く頃ゴキトウゴキトウと鳴く鳥あり。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノギ・トウゴーの名が建築家である若い父のまわりで鳴りひびいた。",
              "citation": {
                "source": "菊人形",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ムツヒト陛下さま、クロキ・ノギ・トウゴ――当時私たちは血の多い青年でした。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス10点”　あたりは再び静寂に包まれる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス10点”　またしても頭の中に甲高い金属音が鳴り響く。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス20点”“オメデトウゴザイマス　プラス20点”“オメデトウゴザイマス　プラス20点”　しかし敵の宇宙船は巧みに編隊を組み、今度はなかなかレーザー光線が命中しなくなる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス20点”　書斎の安楽椅子に深々と体をうずめながら擬似体験ゲームの世界に没入しているあなたは、塾から帰った小学生の秀夫がこっそり部屋に入って来たのに気づかない。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス５点”　頭の中に金属音が響き渡る。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス10点”　頭の中でまたしても金属音が鳴り響く。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス３点”　ちくしょう、俺はゲーム得点が欲しくて戦っているわけじゃないんだ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス３点”「今度はお前の番だ」あなたは大魔王ミノスを威嚇するようににらみつける。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス20点”　しかしその金属音は頭の中で常に響いているキーンという音に妨害されてよく聞こえない。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘔吐を助けるために召使が頭と脇を支えているあいだに患者はトウゴマ（ヒマ）の枝を咽喉に押し込む。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
