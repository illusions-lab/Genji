    "definitions": [
      {
        "index": 1,
        "gloss": "runner (of a sliding door)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "敷居の戸走りにゴミが溜まっていて、引き戸の滑りが悪くなっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "戸走りの溝に蝋を塗ると、驚くほどスムーズに開閉できるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長年使い込まれた戸走りは、表面が少し磨り減って光沢を帯びている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "全身の血が一度に血管を破つて体外にほとばしり出たやうな感じがした。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも熔岩と砂礫の互層や、岩脈のほとばしりを露出して、整然たる成層美を示すところもあるが、多くは手もつけられないほど、砂礫や灰を放擲したようで、紛雑を極めている。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "字を書くことの上手な人はこういう機会に存分に筆を揮って、自分の筆端からほとばしり出る曲折自在な線の美に陶酔する事もあろうが、彼のごとき生来の悪筆ではそれだけの代償はないから、全然お勤めの機械的労働であると思われる上に、自分の悪筆に対する嫌忌の情を多量に買い込まされるのである。",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "血も沸かば沸け、炎も燃へばもへよ」とて、微笑を含みて読みもてゆく、心は大滝にあたりて濁世の垢を流さんとせし、某の上人がためしにも同じく、恋人が涙の文字は幾筋の滝のほとばしりにも似て、気や失なはん、心弱き女子ならば。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度クリストフは手鼻をかんだ処で、そのとばしりが地の透くやうになつた上衣に掛かつてゐるのを、丁寧にゴチツク形の指で弾いてゐる。",
              "citation": {
                "source": "老人",
                "author": "GREISE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは浴場についている水口で、絶えず清水がほとばしり出ているのである。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次は消防作業でポンプはほとばしり消防夫は屋根に上がる。",
              "citation": {
                "source": "火事教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは今にもほとばしり出ようとする勢力が内部に渦巻いている事を感じさせる。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱっと塔のねもとからまっかな雲が八方にほとばしりわき上がったと思うと、塔の十二階は三四片に折れ曲がった折れ線になり、次の瞬間には粉々にもみ砕かれたようになって、そうして目に見えぬ漏斗から紅殻色の灰でも落とすようにずるずると直下に堆積した。",
              "citation": {
                "source": "LIBER STUDIORUM",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この場所ですごした最後の夜に、心の底からほとばしり出た一つのメロディーだったのです。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふんすいからは、すばらしくおいしいブドウ酒がほとばしり出ました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "たちまち、指からは血がほとばしり出ました。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "こころみにそのひとつをちぎりとり歯にあてると、果実の肉がはち切れるほど水気を持っていることとて歯をあてたとたんにぽんと音高く割れ冷い水がほとばしり出て鼻から頬までびしょ濡れにしてしまうほどであった。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "水は斜に巨巖の上を幾段にも錯落離合してほとばしり下るので、白龍｜競ひ下るなどと古風の形容をして喜ぶ人もあるのだが、この瀧の佳い處はたゞ瀧の末のところに安坐して、手近に樂々と見ることと、巖石の磊※たるをば眼前にする所にある。",
              "citation": {
                "source": "華嚴瀧",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはれ、この少女のこころは恒に狭き胸の内に閉ぢられて、こと葉となりてあらはるる便なければ、その繊々たる指頭よりほとばしり出づるにやあらむ。",
              "citation": {
                "source": "文づかひ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "あわれ、この少女のこころはつねに狭き胸のうちに閉じられて、ことばとなりてあらわるる便なければ、その繊々たる指さきよりほとばしり出ずるにやあらん。",
              "citation": {
                "source": "文づかい",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして其とばしりが私の紋付の羽織へかゝつたのであつた。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は一朝暴風が此平靜な海を吹き亂して雲と相接して居る水平線の先の先から煽り立てゝ來る激浪が此の大箱の懸崖に吼えたけびてしぶきのとばしりが此の青芝へ氷雨の如く打ちかゝる時に牡鹿が角を振り立てゝ此岬に突つ立つ所を想像して見た。",
              "citation": {
                "source": "鉛筆日抄",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋は更に沸々として汁のとばしりが四方に飛ぶ。",
              "citation": {
                "source": "佐渡が島",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホースの尖端からは、沸騰点に近い熱湯がほとばしり出たが、それがデッキを五尺流れるうちには凍るのであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」　水を吐き出す時は、傍で察する程苦しくはなく、たゞその勢ひに伴れて、肩を怒らせたり落したり、手首をひらひらさせたりするが、いよいよ水が枯れて、胃液がほとばしり出る時になると、まさしく格好だけは「七転八倒の苦しみ」であつた。",
              "citation": {
                "source": "秋晴れの日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そういって、倭文子は、涙がほとばしりそうになる目の上に羽ぶとんをかけた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣室からは、博士の忙しそうに歩きまわる足音のあいまあいまに、水道から水のほとばしり出る音、硝子器のふれあう音などが、かすかにきこえ鋭敏な鼻にはほのかな薬品の匂いさえかぐことができた。",
              "citation": {
                "source": "人造人間",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　裾をからげて湯殿へ這入つたおくみは、後に立つてゐられる洗吉さんに言ひながら、さつき折角洗つた洗濯物を取り入れたのが、じつとり濡れたまゝで竿にかゝつてゐるのを片寄せて、そこの板の間の真ん中へ雨が漏るのへ、バケツを受けておいて、まはりがとばしりでびたびたになつてゐるのを雑巾で拭いた。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "天はゆるさじ良民の自由をなみする虐政を十三州の血はほとばしり「もう少し静かにお歌いなさいな」と母様が仰言った。",
              "citation": {
                "source": "少年・春",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由をなみする虐政を十三州の血はほとばしりここに立ちたるワシントン「まあお上手だねえ」と母様は仰言る。",
              "citation": {
                "source": "少年・春",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "この僧の風采は、短躯矮小みるかげもないものであり、身には襤褸をまとい腰には縄の帯をしめ、醜穢をきわめていたものの、手に十字架を握り驢馬にまたがり、一度口をひらくや熱弁奔流の如くにほとばしり聞く者をして涙を流させ切歯扼腕させた。",
              "citation": {
                "source": "ローマ法王と外交",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありがたい、もったいない、すまない、という感謝報恩の心は、湧然として、ほとばしり出るのです。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとわたしの涙が、おそろしい勢いでほとばしり出たので、彼女はびっくりしてしまった。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　古賀は堰かれたものがほとばしり出たやうな勢でべらべらとしやべりはじめたのである。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
