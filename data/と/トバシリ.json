        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "伝統的な木製家具の仕上げに、天然の戸走りを用いて美しい艶を出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "戸走りは和ろうそくの原料としても古くから重宝されてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "職人は、戸走りの粘り気を指先で確認しながら作業を続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
