[
  {
    "uuid": "13adbcc4-8583-53f8-902c-d4a440becf02",
    "entry": "戸走り",
    "reading": {
      "primary": "とばしり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
