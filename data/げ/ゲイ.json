    "definitions": [
      {
        "index": 1,
        "gloss": "tattoo (esp. a traditional Japanese one)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代の罪人は、黥（げい）を施されることがあったという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の背中には、見事な日本の伝統的な黥が彫られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "黥という言葉は、現代ではあまり使われなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "女の方が却って男の不器用を察して気ずつない思いを紛らすために、わきを向きながら小さな声で唄ったなど　　黥ける利目など　　黥ける利目　これは、男の顔を、ちらと見たとき、自然と思い浮べられた歌の文句だった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あゝ、女の雪の二の腕だと、松葉が命の黥をしよう、指には青い玉と成らう。",
              "citation": {
                "source": "飯坂ゆき",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那で昔から行なわれた肉刑の主なるものとして、黥、（あしきる）、宮、の四つがある。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さう呟きながら、黥をした老爺や老婆達が、哀しげに虔み深く、赤ん坊を禮拜したといふ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ黥はしてゐない。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "黥をした、たるんだ皮膚が、搖れ動く焔にチラ／＼と赤く映える。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "何處にも黥の見えないのは、其の女がまだ若くて、日本の公學校教育を受けて來たためであらう。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "無理に大きく引伸ばした耳朶に黒光りのする椰子殼製の輪をぶら下げ、首から肩・胸へかけて波状の黥をした・純然たるトラック風俗である。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう呟きながら、黥をした老爺や老婆たちが、哀しげに虔み深く、赤ん坊を礼拝したという。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ黥はしていない。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "黥をした、たるんだ皮膚が、揺れ動く焔にチラチラと赤く映える。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処にも黥の見えないのは、その女がまだ若くて、日本の公学校教育を受けて来たためであろう。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "無理に大きく引伸ばした耳朶に黒光りのする椰子殻製の輪をぶら下げ、首から肩・胸へかけて波状の黥をした・純然たるトラック風俗である。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処にも黥の見えないのは、其の女がまだ若くて、日本の公学校教育を受けて来たためであらう。",
              "citation": {
                "source": "夾竹桃の家の女",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ余りの事に呆れ果て、茫然と佇みて在りしが、物好きの心俄かに高まり来りて止み難くなりつ、何気なく前庭に出づるに、早くも起き出でし寺男と思しく、骨格逞ましく、全身に黥したる中老人が竹箒を荷ぎて本堂の前を浄め居り。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一気に扉を押し破りて窖の中に躍り入り、呀つと逃げ迷ふ奈美女の白き胴体を、横なぐりに両断し、総身の黥を躍らせて掴みかゝる馬十の両腕を水も堪まらず左右に斬り落す。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがツイ二三年前のこと、甲州生れの大工上りとかいう全身に黥をした大入道で、三多羅和尚という豪傑坊主が、人々の噂を聞いて、一番俺がその妖怪を退治てくれようというのでその寺に住い込み、自分でそこ、ここを修繕して納まり返り、近郷近在の無頼漢を集めて御本堂で賭博を打たせ、寺銭を集めて威張っている。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他、壁布の絵、衣裳の模様、人体の黥、その他何でも、芸術作品というものは、その盛り込まれる相手の形状、用途、環境、対象等の各条件によって、それらしいノンセンス味を加味して行かれねばならぬ。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦女不毛の事など長々書き立つるを変に思う人も多かろうが、南洋の諸島に婦女秘処の毛を抜き去り三角形を黥するとあり。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムッチリした大きな身体に、薄光りする青地の長襦袢を巻き付けているのが、ちょうど全身に黥をしているようで、気味のわるいほど蠱惑的に見えた。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "高祖は之に對して「幸分我一く諸侯に賜うた（『史記』卷九十一、黥布傳）。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い所では一般に五刑と云ひますと、　墨黥、、宮、殺大辟の五種の刑辟を指しました。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "黥と云ふのは入墨することであり、と云ふのは足を切ることであり、つまり歩行出來ないやうにするので、どこを切るかは一寸分りませぬ。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "岳鵬挙の幽せらるゝや、背に尽忠報国の大字を黥し、笑つて死を旦夕に待ち、項羽の烏江に戮せらるゝや、亭長に与ふるに愛馬を以てし、故人に授くるに首級を以てし、自若として自ら刎ね、王叔英の燕賊に襲はるゝや、沐浴して衣冠を正し南拝して絶命の辞を書し、泰然として自縊して死せり。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "目をさくとは、眦を、刺のようなもので割いて、墨を入れて、黥をすることをいふ、古い言葉であります。",
              "citation": {
                "source": "歌の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あめつゝちとりましとゝ　何故　黥ける　利目お前の目は、なぜそんなに黥がしてあるのか、といふ以上に、確かな説明の出來た人がないのです。",
              "citation": {
                "source": "歌の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "――夕明下に投げいだされた、萎れ大根の陰惨さ、あれはまだしも結構だつた――今や黒い冬の夜をこめどしやぶりの雨が降つてゐる。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の不注意を悔いて、自分の力なきをなげいて泣くよりほかはない。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "不起訴ということになって、やがて出牢できたけれども、男は、そのときの検事の笑いを思うと、五年のちの今日でさえ、いても立っても居られません、と、やはり典雅に、なげいて見せた。",
              "citation": {
                "source": "あさましきもの",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大将が、向うで、腹をかかえて笑いながら、剣をかざして、「胴上げい、用意っ。",
              "citation": {
                "source": "さるのこしかけ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
