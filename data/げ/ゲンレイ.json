        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "陳独秀が呉松路通インタナショナル理髪館で変装して上海の共同租界から各国兵の監視をくぐってオランダ船で逃れた当日は、彼は失業工人の一団を率いて特別戒厳令のなかに潜伏していた。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "動物界に戒厳令が行なわれているといってよい。",
              "citation": {
                "source": "去年",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日には東京府、神奈川、静岡、千葉、埼玉県に戒厳令が布かれ、福田大将が司令官に任命されて、以上の地方を軍隊で警備しはじめました。",
              "citation": {
                "source": "大震火災記",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹明君は来てゐない、来てくれさうにもない、九、一九の脱線でまた戒厳令をしかれたのかもわからない。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十二年九月一日の大震火災後一二ヶ月の間、東京市中に婦人の戒厳令が布かれた事を。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人への戒厳令「新宿、品川、吉原等の遊廓は潰れた。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "公武間の周旋をもって任ずる千余人の薩摩の精兵が藩主に引率されて来た時は、京都の町々はあだかも戒厳令の下にあったことをも知らせて来た。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "――京都の町々は今、会津薩州二藩の兵によってほとんど戒厳令の下にある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "戒厳令を施かれた会館の附近では、銃劒をつけた警官隊と義勇隊とが数｜間の間を隔いて廻っていた。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八四八年二月、フランスで二月革命が起りイギリス、ドイツに波及しベルギーでは戒厳令が布かれた。",
              "citation": {
                "source": "カール・マルクスとその夫人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風俗常憂頽敗※　人人左衽拍二其肩一逸居飽食坐終日　飲二此無名野草煙一　それで、島津氏も厳令を下して喫煙を禁止しようとしたのである。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "風俗常憂頽敗※　人人左衽拍其肩逸居飽食坐終日　飲此無名野草煙　それで、島津氏も厳令を下して喫煙を禁止しようとしたのである。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにその時は、毎夜｜戒厳令のような大規模の非常線が張りつめられて、連中の捜査に疲れた警官も倦まず撓まず必死の努力を継続した。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "戒厳令は既に布かれ、巴里の城門は堅く閉され、旅行も全く不可能になった。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "戒厳令下に、銃剣を握って立つ、歩哨たちも、横を向き、黙々として、声を発しなかった。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上述べたるところにより明らかなる如く、日本要塞は、外部より何者といえども、絶対に侵入するを許さざる建前により、戒厳令中は、たとえ黒馬博士なりとも、ベトンを越えて日本要塞内に入ることを許されず。",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、黒馬博士は、戒厳令中、日本要塞より締め出されたる状態にあり、乞う諒解せよ」「なんだ、私は、祖国日本から、締め出しをくったのか。",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "商埠地を過ぎて大西辺門から辺城に入ると、門内には支那の戒厳令が布かれて、銃に剣を附けた一隊の支那兵が将校に引率されて門内の左右を固めてゐる。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "保釈の際、判事は二・二六による戒厳令下の事情によって百合子の公判が終了するまで顕治への面会通信は控えるようにといった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（自注15］退院後の余り威張れない効果をともなった態度――戒厳令下の事情という判事の言葉に制約されて、百合子が公判までの三ヵ月ばかり顕治に差入れに行っても面会せず、公然と手紙を書かなかったこと。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "余り突然の大事なので、喫驚することさえ忘れて聞いていた私は、「為めに全市に亙って戒厳令を敷き」と云う文句を耳にすると、俄かにぞっとするような恐怖を感じた。",
              "citation": {
                "source": "私の覚え書",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五つか六つの時、孫の薬とりに行った老婆が、電信柱に結びつけられ兵隊に剣付鉄砲で刺殺されたと云う、日比谷の焼打ちの時か何かの風聞を小耳に挟んで以来、戒厳令と云うことは、私に何とも云えない暗澹と惨虐さとを暗示するのだ。",
              "citation": {
                "source": "私の覚え書",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな田舎の新聞でも、戒厳令を敷いたことまで誤報はしまい。",
              "citation": {
                "source": "私の覚え書",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分等葡萄棚の涼台で、その号外を見、話をきき、三越、丸の内の諸ビルディング　大学　宮城がみなやけた戒厳令をしいたときく。",
              "citation": {
                "source": "大正十二年九月一日よりの東京・横浜間大震火災についての記録",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "福田戒厳令司令官が山梨に代ったのもこの理由であったのだ。",
              "citation": {
                "source": "大正十二年九月一日よりの東京・横浜間大震火災についての記録",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小使がつい、予審判事に戒厳令という言葉を言ったために。",
              "citation": {
                "source": "年譜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "戒厳令の布かれた後、僕は巻煙草を啣へたまま、菊池と雑談を交換してゐた。",
              "citation": {
                "source": "大正十二年九月一日の大震に際して",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、直ちにそれを共産党の蜂起とデマり、鎮圧の名目で軍隊を繰り出し、市街戦で革命的労働者、前衛を虐殺し、それをきっかけに戒厳令をも布く。",
              "citation": {
                "source": "刻々",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、十八日、ハルビンに戒厳令がしかれた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ國民教育ノ根本的革命ハ戒嚴令施行中ヨリ實施スベキ者ナルヲ以テ、現時ノ校舍ヲ直チニ使用スベキコトヲ明示シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
