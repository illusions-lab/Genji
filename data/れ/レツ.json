  {
    "uuid": "16f11d10-02f4-55bf-b022-6464d6ec1f87",
    "entry": "裂",
    "reading": {
      "primary": "れつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
