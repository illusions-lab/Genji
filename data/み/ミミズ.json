[
  {
    "uuid": "800210c3-129c-5f5d-9182-3ea275431610",
    "entry": "蚯蚓",
    "reading": {
      "primary": "ミミズ",
      "alternatives": [
        "みみず",
        "めめず"
      ],
      "is_heteronym": false
    },
    "grammar": {
