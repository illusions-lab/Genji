    "definitions": [
      {
        "index": 1,
        "gloss": "red spider lily (Lycoris radiata)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "秋のお彼岸の頃、土手には一面の曼珠沙華が咲く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "曼珠沙華の燃えるような赤色は、見る人の心を引きつける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃、曼珠沙華の群生を見て、少し不気味に感じたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "もう永遠に帰らないことを思つて　　酷白な嘆息するのも幾たびであらう……私の青春はもはや堅い血管となり、　　その中を曼珠沙華と夕陽とがゆきすぎる。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "前号『曼珠沙華』などはそれである。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と扇子の要で、軽く払うにつれて、弱腰に敷くこぼれ松葉は、日に紅く曼珠沙華の幻を描く時、打重ねた袖の、いずれ綿薄ければ、男の絣も、落葉に透くまで、薄の簪は静である。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "曼珠沙華ひら／＼と、其の左右に燃えたるを、あれは狐か、と見し夜戻りの山法師。",
              "citation": {
                "source": "婦人十一題",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "曼珠沙華も咲きだした。",
              "citation": {
                "source": "草と虫とそして",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "萩の花は塵と呼ばれているように、曼珠沙華のように、花としてはさまで美しくはないけれど、何となく捨てがたいところがある。",
              "citation": {
                "source": "草と虫とそして",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "曼珠沙華が一輪、路傍の叢に咲き出てゐた、折つて戻つて、机上に飾つてゐたら、油虫が食べてしまつた。",
              "citation": {
                "source": "行乞記",
                "author": "仙崎",
                "note": "青空文庫"
              }
            },
            {
              "text": "極性な朱でござったろう、ぶちまけた甕充満のが、時ならぬ曼珠沙華が咲いたように、山際に燃えていて、五月雨になって消えましたとな。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "わかい男の忍びあし、まがひパナマに日が射せば、苦みばしつた横顔のことにつやつや蒼白く、ほそく割いたる青竹に蝮挟みてなつかしく、渚のほとり、草土手の曼珠沙華さくしたみちを、九月｜午後、忍びあし。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹の根の曼珠沙華だよ。",
              "citation": {
                "source": "第二海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "孟宗と月凡て、大正十年秋の木兎の家の生活より竹と曼珠沙華わが門の竹の林に、曼珠沙華赤く咲きたり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなあはれ、摩訶曼珠沙華、出で入るとひとり眺めて、時をりは妻と眺めて、昨日よりいよよ殖えしと、まだ今日も赤しとぞ見る。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "山住の心安さは、藪越しに浪の音聴き、里囃子うれしとも聴け、施餓鬼過ぎ流石さびしく、人訪はぬ今は堪へえね、また出でて竹の根見れば、曼珠沙華赤く赤きに、ちらと向き、釣眼野狐、うしろ向き尖り口して、小藪吹き、吹き吹く風に、日の暮に、あな、飛び飛びて消えつつ失せぬ。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "この集の中でも「曼珠沙華」の一篇はその「思ひ出」の中から抜いたのでした。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "曼珠沙華ゴンシヤン、ゴンシヤン、何処へ行く。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤いお墓の曼珠沙華、曼珠沙華、けふも手折りに来たわいな。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "何時まで取つても曼珠沙華、曼珠沙華、恐や、赤しや、まだ七つ。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹と曼珠沙華　わが門の竹の林に、曼珠沙華赤く咲きたり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなあはれ、摩訶曼珠沙華、出で入るとひとり眺めて、時をりは妻と眺めて、昨日ゆかいよよ殖えしと、まだ今日も赤しとぞ見る。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "山住の心安さは籔越しに浪の音聴き、里囃子うれしとも聴け、施餓鬼過ぎ流石さびしく、人訪はぬ今は堪へえね、また出でて竹の根見れば曼珠沙華赤く赤きに、ちらと向き、釣眼野狐、うしろ向き尖り口して、小籔吹き、吹き吹く風に、日の暮に、あな、飛び飛びて消えつつ失せぬ。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の幽霊草というのは曼珠沙華のことで、墓場などの暗い湿っぽいところに多く咲いているので、幽霊草とか幽霊花とかいう名を付けられたのだが、ここらでいう幽霊藻はまったくそれとは別種のもので、水のまにまに漂っている一種の藻のような浮き草だ。",
              "citation": {
                "source": "水鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "崖のくずれを雑樹また藪の中に、月夜の骸骨のように朽乱れた古卒堵婆のあちこちに、燃えつつ曼珠沙華が咲残ったのであった。",
              "citation": {
                "source": "夫人利生記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　時に青空に霧をかけた釣鐘が、たちまち黒く頭上を蔽うて、破納屋の石臼も眼が窪み口が欠けて髑髏のように見え、曼珠沙華も鬼火に燃えて、四辺が真暗になったのは、眩く心地がしたからである。",
              "citation": {
                "source": "夫人利生記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして思ひがけなくもその柳の蔭の物洗場に一面に曼珠沙華が咲き出した。",
              "citation": {
                "source": "村住居の秋",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "女郎花咲きみだれたる野辺のはしにひとむら白きをとこへしの花　僅かに一本二本と咲き始めたころに見出でて、オヽ、もうこれが咲くのかと驚かるゝ花に曼珠沙華がある。",
              "citation": {
                "source": "秋草と虫の音",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "曼珠沙華いろ深きかも入江ゆくこれの小舟のうへより見れば　東京の、三宅坂から濠越に見る宮城の塀の近くに唯だ一個所だけこの花の群つて咲くところのあるのを偶然見つけて、毎年それを見に行つたものだが、今でも咲くかどうかと、ふといま思ひ出された。",
              "citation": {
                "source": "秋草と虫の音",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "東蔵赤面閉口していると、磐次磐三郎はまたいわく、真の狩人はかくのごときことのみにあらず、なおかくあるべきにとて、さらにまた気を吐けば前の尾嶺に忽然として出現ましませしは南無ありがたや三十三観音、金色燦爛、微妙清音、まんじゅしゃげを雨と降らせたまいてダンスをしたもう。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉たちと山で私ははじめて珠数花（まんじゅしゃげ）を手折った。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は今でも真紅なまんじゅしゃげを手に持って、川の見える崖道を、華やかに笑いながら、ハンカチを手にして少し婀娜っぽく、その花にまけず美しく見えた豊子姉の姿が忘れられない。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まばゆい、曼珠沙華のような極光の倒影。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫、虫、月、月、柿、柿、曼珠沙華、々々々々。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・人がゐてしぐれる柿をもいでゐた・庵のぐるりの曼珠沙華すつかり枯れた・つゆくさ実をもち落ちつかうとする夜はまた粥を煮て食べた、私には粥がふさはしいらしい、その粥腹で、たまつた仕事をだいぶ片付けた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
