  {
    "uuid": "41ca1c5a-9511-5aef-82f7-d2920865b2f4",
    "entry": "蒔付",
    "reading": {
      "primary": "まきつけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
