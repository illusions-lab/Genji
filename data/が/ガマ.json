  {
    "uuid": "d46173e5-c888-5053-a4c1-e4ef10e1c95d",
    "entry": "蟆",
    "reading": {
      "primary": "がま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
