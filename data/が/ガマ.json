      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "入り口は黒板べいの一部を切りあけ、形ばかりという門がまえだ。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の下駄が三足あるけれどちゃんと内へ向いて並んでいる　よその人のらしくない　客もないなとは思うたがまずまず今日はよるまいと決心した。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫を飼はゞ、その猫がまた争ひの種となるらん、かなしきわが家。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまた煤やら垢やらで何の木か見別けがつかぬ位、奥の間の最も煙に遠いとこでも、天井板がまるで油炭で塗った様に、板の木目も判らぬほど黒い。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子は小声で、「お増がまた何とか云いますよ」「二人共お母さんに云いつかって来たのだから、お増なんか何と云ったって、かまやしないさ」　一事件を経る度に二人が胸中に湧いた恋の卵は層を増してくる。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はしばらくの間、涙の出るがままにそこにぼんやりして居った。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お祖母さんがまた、「政夫さん、あなた力紙を結んで下さい。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "愚かなことでしょうがこの場合お前さんに民子の話を聞いて貰うのが何よりの慰藉に思われますから、年がいもないこと申す様だが、どうぞ聞いて下さい」　お祖母さんがまた話を続ける。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "サ行ザ行の音は、室町以前における的確な音がまだわからないからして、どんな変遷を経て来たかは、言うことが出来ない。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは「ひ」がまだfiと発音せられた時代のものである故、それに「ヒヽ」とあるのは上の説明と矛盾するが、しかしこの文には疑いがあるのである。",
              "citation": {
                "source": "駒のいななき",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてこれを歴史的に見ますと、平安朝に入るとその例外がますます多くなって来て、そうして醍醐、村上の御代になりますと、かような区別のあった痕迹も見えないのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "嬉しきは月の夜の客人、つねは疎々しくなどある人の心安げに訪ひ寄たる、男にても嬉しきを、まして女の友にさる人あらば如何ばかり嬉しからん、みづから出るに難からば文にてもおこせかし、歌よみがましきは憎きものなれどかゝる夜の一言には身にしみて思ふ友とも成ぬべし。",
              "citation": {
                "source": "月の夜",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは亡き兄の物なりしを身に伝へていと大事と思ひたりしに、果敢なき事にて失なひつる罪｜得がましき事とおもふ。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌よみがましきは憎くき物なれど、かかる夜の一ト言には身にしみて思ふ友ともなりぬべし。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「野暮は垣根の外がまへ、三千楼の色｜競べ、意気地くらべや張競べ」というように、「いき」は媚態でありながらなお異性に対して一種の反抗を示す強味をもった意識である。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "「野暮は垣根の外がまへ、三千楼の色競べ、意気地くらべや張競べ」というように、「いき」は媚態でありながらなお異性に対して一種の反抗を示す強味をもった意識である。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "不幸な結婚をした出戻りではあるがまだ三十になったばかりの美しい敏子はかなり派手な着物をすらりとした身体に着こなして魅力の溢れた挨拶をした。",
              "citation": {
                "source": "かれいの贈物",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "和辻哲郎君がまだ京都にいた頃のことである。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "その良人たちがまた、妻に対して妾を兼ね、母性に対して情婦の愛嬌を兼ねるところの、二重の情操を要求して居る。",
              "citation": {
                "source": "家庭の痛恨",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "反キリストの詩人ニイチェの意味に於て、Ecce homo がまた同じく、キリスト教への魔教的冒涜を指示してゐるにちがひない。",
              "citation": {
                "source": "ニイチェに就いての雑感",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイチェの場合にあつては、この禁物が多すぎる為、詩がまるで理窟っぽい警句のやうなものになつてしまつて居る。",
              "citation": {
                "source": "ニイチェに就いての雑感",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "輪※と轉生地獄の鬼がまはす車のやうに冬の日はごろごろとさびしくまはつて輪※の小鳥は砂原のかげに死んでしまつた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも遂に、理性がまた彼女に回復して来た。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はもはや、この上客人たちの白々しさと無礼とを、がまんすることが出来なかった。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまた可笑しく、一層チャンチャン坊主の憐れを増し、見物人を悦ばせた。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "街路は冬のやうに白つちやけて、昔ながらの大道店が、ガマの油や、オツトセイや、古着類や、縞蛇や、得體のわからぬ壞れた金物類などを賣つてる。",
              "citation": {
                "source": "悲しい新宿",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると頬つぺたを脹まし、ガマのやうに顏をふくらして、何か喉の邊でグーグーといふ奇聲を出してる。",
              "citation": {
                "source": "田端に居た頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしかに、漢文のガマ仙が、そう教えた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、ガマ仙は、にたりにたりと笑いながら、「たいくつしている時に、庭先から友人が、上酒を一升、それに鴨一羽などの手土産をさげて、よう！",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、中学校のガマ仙の、上酒一升、鴨一羽は、遺憾ながら、凡俗の解釈というより他は無いらしい。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
