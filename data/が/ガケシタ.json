          "literary": [
            {
              "text": "が、蔵前の煙突も、十二階も、睫毛に一眸の北の方、目の下、一雪崩に崕になって、崕下の、ごみごみした屋根を隔てて、日南の煎餅屋の小さな店が、油障子も覗かれる。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その崕下の民家からは炊煙が夕靄と一緒になって海のほうにたなびいていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "永田町の総理大臣官邸の崕下にゐます」「あれから、大分たちますわ。",
              "citation": {
                "source": "老残",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑事は我と我目を疑って、態々｜崕下へおりて行き、生々しい血潮に触って見た。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
