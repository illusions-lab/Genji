        "examples": {
          "standard": [
            {
              "text": "「山」という字の右側にある、あの払いの部分は「雁垂れ」という部首だよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "書道で「崖」という字を書くとき、雁垂れを綺麗に書くのが難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "漢字の部首について調べていると、「雁垂れ」という名称が出てきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "そんげのオトトとオカカが居るがんだれば、オメ様の代りにオトトとオカカにきてもろて鼻介の野郎をくらすけてもろた方が話が早えわ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "飛燕流開祖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
