  {
    "uuid": "b134cd8e-e944-53bd-84f0-043dc5a9f23a",
    "entry": "ツカミ",
    "reading": {
      "primary": "つかみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレカラ、オテテデ　ミチコサンノ　ネクタイヲ　ツカミマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイキナリ道子ノ髪ヲツカミ清三ノ持ッテ居タナイフヲ突キツケテ声ヲ立テルト殺スゾト云ッテヤリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "起久子、安彦と、彼は指を折って考えこんでいたが、また、口をとんがらして、頭上へ蛸のツカミ屁をくれて、気合いをかけた。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛸のツカミ屁で気合いをかける必要どころか、話の泉の物識り博士のようなものだな」「エッヘッヘ」　蛸重はキマリ悪そうな笑いをうかべ、ことさら顔をしかめて、ブッと又ツカミ屁をやり、頭上に放して気合いをかけた。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲虫の化け物などに騙されないよう、読者も折がありましたら、蛸のツカミ屁で気合いをかけたらよろしいでしょう。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、ツカミ屁をかまされますから覚悟して下さい。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツカミ屁の教祖というのがあるもんですかね。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツカミ屁をかまされるのは覚悟しているが、お手やわらかに頼むぜ」「イヤア。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は再び台所へ戻り、塩のつまった大きなカメから、二ツカミの塩を壺の中へ入れた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを邦語でヤカツカミといった。",
              "citation": {
                "source": "オシラ神に関する二三の臆説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬小屋の横から一対の畚を持ってくると、馴れた手つきでそのツカミ肥料を、木鍬で掻い込んだ。",
              "citation": {
                "source": "麦の芽",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "令の神祇令には天神地祇という名を存し、地祇は『倭名鈔』のころまで、クニツカミまたはクニツヤシロと訓みますが、この二つは等しく神祇官において、常典によってこれを祭ることになっていまして、奈良朝になりますと、新旧二種族の精神生活は、もはや名残なく融合したものと認められます。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
