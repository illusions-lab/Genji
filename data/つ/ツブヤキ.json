        "examples": {
          "standard": [
            {
              "text": "著名人の呟きが、瞬く間にインターネット上で拡散された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新商品の情報が、公式アカウントの呟きで発表された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のユーモアあふれる呟きは、いつも多くのフォロワーを笑顔にする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
