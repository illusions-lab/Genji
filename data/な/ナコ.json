    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "観客は私のことをプチトアナコと云って人気者だったのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　　　　　モナコの悲劇　ジョージ・佐野に、妾の内部的な魂の推移は分かる筈はなかったのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて妾達旅芸人の一行は、ギリシヤ女の水泳する腕にも似たモナコの町に着きました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、それまで黙々としていた彼の顔が、危険な形相に変って、邪慳に妾の腕を振払うと、モナコの花開く寺院の饗宴場に向って行ってしまいました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スイス・ホテルから電話でロダンさんが妾の後を追ってモナコにいらっしゃったことが分りました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルーレットのモナコ、悪徳の町、三十九の機会の町、妾の運命、そんなとりとめのない頽廃した意思が妾を支配していたのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾はロダンさんと、花匂うモナコの浜に沿って、心の悲劇を象徴するような大寺院の賭博場に向って、馬車を走らせました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "モナコの王国、円い月のかかった二つの塔の前で、黒と紅と金に装い凝らしたモンテ・カルロの巡査が、ユーロップの草花の前で澄まして直立していました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し、モナコに於て、零落したフランス貴族の復辟の夢も破れてしまったのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして妾は、モナコの賽の目に現れる妾自身の運命に対して、不吉な予感をその時感じました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日、モナコの華美な海浜の妾達の芝居小屋は、世界各国の観衆で一杯でした。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "モナコの賽の目に現れた不吉が、佐野を行方不明にしてしまい、妾は傷の癒えるまでニースの赤十字病院にロダンさんの手厚い看護を受けました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ミサコはいまさらのように善良な夫を見つめていたが、「あなた、ナナコはまだ学校を引けないわね。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「妾はナナコにたいして厳格な精神をもっているわ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾をとりまく事業と、企画とナナコと、妾の善良な夫のために妾はどんなことでもしてのけるわ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "瘤取りムカシ　ムカシノオ話ヨミギノ　ホホニ　ジヤマツケナコブヲ　モツテル　オヂイサン　このお爺さんは、四国の阿波、剣山のふもとに住んでゐたのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "瘤取りムカシ　ムカシノオ話ヨミギノ　ホホニ　ジヤマツケナコブヲ　モツテル　オヂイサン　このお爺さんは、四國の阿波、劍山のふもとに住んでゐたのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）特務曹長「その次は、」大将「これはモナコ王国に於てばくちの番をしたとき貰ったのじゃ。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピナコテークの画堂ではムリロやデュラーやベクリンなどを飽くほど見て来ました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから二人の間に、コナコナした湿やかな話が始まった。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "けふ着きたまひしことなれば、『ピナコテエク』、また美術会の画堂なども、まだ見玉はじ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのをりは『ピナコテエク』に懸けたる画を見しのみにて、学校の人々などに、交を結ぶことを得ざりき。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ピナコテエク』の館出でし時は、雪いま晴れて、街の中道なる並木の枝は、一つ一つ薄き氷にてつつまれたるが、今点ぜし街燈に映じたり。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "『和名抄』に仁之木倍美と訓んだ蛇嶺南に生ず、大なるは五、六丈、囲り四、五尺、小なるも三、四丈を下らず〉とあるが、『エンサイクロペジア・ブリタンニカ』十一版に南米熱地産なるアナコンダに次いで諸蛇の最大なるものとあり。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち頭に近く二前脚ありとは全く誤聞だが、ここに件の大蛇が蛇群の蛇はおよそ六十種あり、熱帯アメリカのボアやアナコンダ、それから眼前予の論題たる蛇群は蛇のもっとも原始な性質を保存すと言った。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "身の大きさ　ベーツの『｜亜馬孫河畔の博物学者』アナコンダ蛇が四十二フィートまで長じた事ありと載せ、テッフェ河汀で小児が遊び居る所へアナコンダが潜み来て巻き付いて動き得ざらしめその父児の啼くを聞きて走り寄り、奮って蛇の頭を執らえ両｜齶を※き裂いたと言う。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛇の魅力はまだ精査せぬが、蟾蜍が毒気を吹いて、遠距離にある動物を吸い落すというはこんな事で、恐怖でも何でもなく、虎や大蛇アナコンダが、鹿来るべき場所を知りて待ち伏せするような事で、蟾蜍や蛙の舌は、妙に速く出入するがあたかも吸い落すよう見ゆるのじゃ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
