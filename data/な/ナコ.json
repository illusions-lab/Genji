[
  {
    "uuid": "abb14469-f3d2-5008-985e-d10c7ce7e43a",
    "entry": "ナコ",
    "reading": {
      "primary": "なこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
