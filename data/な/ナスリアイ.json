        "examples": {
          "standard": [
            {
              "text": "夫婦喧嘩は、互いの擦り合いになってしまい、なかなか解決しない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "責任の擦り合いをしている間に、問題はさらに深刻になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "議論が白熱し、最後は感情的な擦り合いに終始した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "たまには犀眼にも見間違えがある」「まあいい、またこんな所で、泥のなすりあいから仲間割れをしてくれるな。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
