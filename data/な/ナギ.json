          "standard": [
            {
              "text": "湿地に咲く水葱の青紫色の花が、夏の訪れを告げていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "水葱の群生は、水辺の風景に涼しげな彩りを添える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃、田んぼで水葱の花を摘んで遊んだ記憶がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "薦、水葱に根を護られながら、昼は咲き夜は恋宿という合歓の花の木が岸に並んで生えている。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処には半ば埋もれた池に、水葱が少し作つてあつた。",
              "citation": {
                "source": "六の宮の姫君",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "水葱はかすかな新月の光に、ひつそりと葉を簇らせてゐた。",
              "citation": {
                "source": "六の宮の姫君",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "○○射ゆしゝをつなぐ河辺の若草の（斉明紀）　………………認河辺の和草の（万葉巻十六）○はるがすみ春日の里｜爾殖子水葱（同巻三）　上つ毛野いかほの沼｜爾宇恵古奈宜（同巻十四）今日我々の持つ時間観念を含まずに、此に似た熟語を作つた場合は、沢山ある。",
              "citation": {
                "source": "形容詞の論",
                "author": "――語尾「し」の発生――",
                "note": "青空文庫"
              }
            },
            {
              "text": "必しも「射られたるしゝ」「栽ゑたる水葱」と言ふまでもない。",
              "citation": {
                "source": "形容詞の論",
                "author": "――語尾「し」の発生――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あだねつき染め木が汁に染め　衣を……（シムルトコロノ衣シメタル衣）上つ毛野いかほの沼に栽ゑ　小水葱……（ウヽルトコロノ小水葱ウヱタル小水葱）右の例における接続点は、前代の文法及び、其形式を襲ふものでは問題にならないが、やはり次第に、整頓せられて来る。",
              "citation": {
                "source": "形容詞の論",
                "author": "――語尾「し」の発生――",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからどこまで「青春」とか「若さ」とかいふ叙情的の印象がみなぎつてゐる。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
