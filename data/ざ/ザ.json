[
  {
    "uuid": "1cd0c1b7-ebbe-5353-9f06-a9ffe126682f",
    "entry": "ザ",
    "reading": {
      "primary": "ザ",
      "alternatives": [
        "ジ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "未分類"
      ],
