[
  {
    "uuid": "5906a134-81c0-51d1-8af4-e8e3ceb06460",
    "entry": "弁士",
    "reading": {
      "primary": "べんし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
