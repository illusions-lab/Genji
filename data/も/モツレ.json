  {
    "uuid": "53f59187-5bdc-5316-87d9-55a07172789e",
    "entry": "縺",
    "reading": {
      "primary": "もつれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
