        "examples": {
          "standard": [
            {
              "text": "彼女は頻回に海外出張をするため、なかなか家にいない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この病気は、頻回な発作が特徴だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会議の頻回な開催は、業務の効率を低下させる原因にもなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "さあ、それだから私の迷はないやうに、貴方の口からお念仏を唱へて、これで一思ひに、さあ貫一さん、殺して下さい」　朱に染みたる白刃をば貫一が手に持添へつつ、宮はその可懐き拳に頻回頬擦したり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は帰り来らざるなるか、帰り得ざるなるか、帰らざるなるかなど、又｜思放つ能はずして、貫一は寝苦き枕を頻回易へたり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "住居、都市、および個人の清潔は法律によって規制され、頻回の入浴、全身をそること、衣服を完全に洗うこと、について僧侶は素晴らしい実例になった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
