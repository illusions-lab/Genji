[
  {
    "uuid": "aac4f100-eb2d-565f-a439-1adf734ab943",
    "entry": "引き出し",
    "reading": {
      "primary": "ひきだし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "drawer",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "机の引き出しに大切な書類をしまってある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このタンスは引き出しが多くて収納に便利だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ペンが見つからない。もしかしたら引き出しの中に入っているかもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いいえ、お逢いしたことは無いのでございますが、私が、その五、六日まえ、妹の箪笥をそっと整理して、その折に、ひとつの引き出しの奥底に、一束の手紙が、緑のリボンできっちり結ばれて隠されて在るのを発見いたし、いけないことでしょうけれども、リボンをほどいて、見てしまったのでございます。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋にそなへつけの机のまへに坐つて、右の引き出しには、書きあげた原稿を、左の引き出しには、まだ汚さない原稿用紙を。",
              "citation": {
                "source": "九月十月十一月",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "父も母も祖母も、耕二の話の時には兄が級長をしてゐた小学時代を引き出した。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「天の一方に」は、「天一方望美人」というような漢詩から、解釈の聯想を引き出して来る人があるけれども、むしろ漠然たる心象の幻覚として、天の一方に何物かの幻像が実在するという風に解するのが、句の構想を大きくする見方であろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんなところが登れようかね」と、岩壁の白い薙を指しながら、話の緒を引き出したところが、あすこは嘉門次が、つい去年、山葵取りに入りこんで、始めて登ったところで、未だ誰もその外に、入ったものはないと言うので、私はふと聞き耳を立てた。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "然も呪はれたことにはまた次の一册を引き出して來る。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにも用心深く徐々と身体を曲げて頭の見えなくなるまで挿し入れた、と思うと間もなく引き出した。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして引き出しを手伝ってくれた近隣の者と、義兄や甥に酒を振る舞った。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、机の引き出しから一円銀貨を掴んできた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも呪われたことにはまた次の一冊を引き出して来る。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝子が彼女の写真帖を引き出して来て、彼のところへ持って来た。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しっ、どうどうどうと背戸を廻る鰭爪の音が縁へ響いて親仁は一頭の馬を門前へ引き出した。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてその燃えがらをつまみ上げ、子細らしい手つきで巻き紙を引きやぶって中味の煙草を引き出したと思うといきなりそれを口中へ運んだ。",
              "citation": {
                "source": "あひると猿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、机の引き出しを引っぱればあくものと思っているのが錯覚であるように、自分のほしいものが市場にあるはずだと思うのはやはりはなはだしい錯覚であるに相違ない。",
              "citation": {
                "source": "錯覚数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはとにかく、この振り出し薬の香をかぐと昔の郷里の家の長火鉢の引き出しが忽然として記憶の水準面に出現する。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、その引き出しの中には、もぐさや松脂の火打ち石や、それから栓抜きのねじや何に使ったかわからぬ小さな鈴などがだらしもなく雑居している光景が実にありありと眼前に思い浮かべられる。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "時代に適応するつもりで骨を折って新しがってみても、鼻にしみ込んだこの引き出しのにおいが抜けない限り心底から新しくなりようがない。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に眼前に映写されている光景が観客の知識の戸棚のどの引き出しに入れていいかわからないで、ラベルのつかないばらばらの断片になってしまっているのである。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その先端の綿の繊維を少しばかり引き出してそれを糸車の紡錘の針の先端に巻きつけておいて、右手で車の取っ手を適当な速度で回すと、つむの針が急速度で回転して綿の繊維の束に撚りをかける。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「秋について」という注文が来れば、よし来た、と「ア」の部の引き出しを開いて、愛、青、赤、アキ、いろいろのノオトがあって、そのうちの、あきの部のノオトを選び出し、落ちついてそのノオトを調べるのである。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗い電気の下で兄は、私にあちこちの引き出しをあけさせ、いろいろの手紙や、ノオトブックを破り棄てさせ、私が、言いつけられたとおり、それをばりばり破りながらめそめそ泣いているのを、兄は不思議そうに眺めているのでした。",
              "citation": {
                "source": "兄たち",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは全部、むかし母から送られ、或る種の倉庫にあずけていたものを必要に応じて引き出して着ているのである。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまさか引き出して見たところで何がわかろう。",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人は忙しく懐から孟子を引き出した、孟子を！",
              "citation": {
                "source": "初恋",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝押し入れから蒲団や行李を引き出して荷造りをしている間にも、宿を移ったとて私はどうなるだろうと思う。",
              "citation": {
                "source": "亮の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその引き出しの中にある手紙を出してくれと頼んでしまった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "園はすぐ机の方に手を延ばして、引き出しを開けにかかった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は手籃を引きよせて、花を引き出しながらその名を教えてくれた。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬草と葫とバタとこね合せたパテを作って置き、それに引き出した身をまぶし再び殻に詰め込み火鍋にかける。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは好きな煙草ものまないで、まず火鉢のひきだしから大きい湯呑みを取り出して、冷めかかっている薬罐の湯をひと息に三杯ほども続けて飲んだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
