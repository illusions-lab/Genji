        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの男は狒々のような目で女性を見ていると噂されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会社の飲み会で狒々のような振る舞いをする上司にうんざりした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔話には、狒々のような悪役が登場することがよくある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
