        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "健康のために、白米に碾き割りを混ぜて炊くようにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "碾き割りの麦は火が通りやすく、スープの具材としても使いやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昔は主食として、碾き割りが一般的だった地域もある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
