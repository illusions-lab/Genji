[
  {
    "uuid": "1061fcce-840f-5cb7-ae8f-151837fed677",
    "entry": "引き金",
    "reading": {
      "primary": "ひきがね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
