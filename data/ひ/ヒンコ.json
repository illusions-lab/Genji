          "standard": [],
          "literary": [
            {
              "text": "駅吏｜竹秉炬を持て迎ること里余。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗仙寺に於ける秉炬の語と覚しきものが、同じ刀自の蔵儲中にある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そう思って、平気で、宗演老師の秉炬法語を聞いていた。",
              "citation": {
                "source": "葬儀記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢庵は秉炬の語を作って、夢回五十有余年。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
