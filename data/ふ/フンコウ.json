  {
    "uuid": "6d2151ea-1c33-54f4-84aa-a4f12beee989",
    "entry": "奮興",
    "reading": {
      "primary": "ふんこう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "精神奮興してる自分は癪に障つて堪らなくなつた。",
              "citation": {
                "source": "水害雜録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "八人の兒女があるといふ痛切な感念が、常に肉體を奮興せしめ、其苦痛を忘れしめるのか。",
              "citation": {
                "source": "水害雜録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈍根のものには、自然はたゞ官能的に見えるばかりだが、理性の發揮して來るのと、意志の奮興して來るのとで、僕等は官能的壓制をのがれることが出來るから、自然の輪廓と表面とは透明になつて、もう見えなくなつてしまう。",
              "citation": {
                "source": "神秘的半獸主義",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助は何故ダヌンチオの様な刺激を受け易い人に、奮興色とも見傚し得べき程強烈な赤の必要があるだらうと不思議に感じた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助は何故ダヌンチオの様な刺激を受け易い人に、奮興色とも見傚し得べき程強烈な赤の必要があるだろうと不思議に感じた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "五六間以上｜後れると、長蔵さんが、振り返って五六歩ずつは待合してくれるから、仕方なしに追いつくと、追いつかない先に向うはまた歩き出すんで、やむを得ずだらだら、ちびちびに自己を奮興させた成行に過ぎない。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "奮興の度が烈しくなる。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてその状態がいつまでも進行して、奮興の極度に達すると、やはり二様の作用が出る訳だが、とくに面白いと思うのはその一つ、――すなわち積極の頂点からとんぼ返りを打って、魂が消極の末端にひょっくり現われる奇特である。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕府は盛に能楽と謡曲とを奮興して、代々の世主厚く能楽の大夫を遇し、而して諸藩の君主も彼等を養ひて、武門の士の能く謡曲を謳ふこと能はざるは恥辱の如き隆運に向へり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "律法儀式にのみ拘泥したる羅馬教の胎内よりプロテスタニズム生れ出で、プロテスタニズムよりピユリタニズム生じ、ピユリタニズムによりて、長く人心を苦しめたる君主専制の陋弊を破りたる自由の思想の威霊あるものを奮興したり。",
              "citation": {
                "source": "各人心宮内の秘宮",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はスミスの伝を読んでこれらの章に至るごとに、古人の刻苦力を用うるの久しくしてかつ至れる、その勝躅遺蹤、大いにもって吾人を感奮興起せしむるに足るあるを磋嘆するに耐えざる者である。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩は人間を感奮興起させる。",
              "citation": {
                "source": "論語物語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながらその撤廃をして有効ならしめるには、彼ら自身において自ら発奮興起し、普通民と社交上において並進しうべきまでに改善するところがあらねばならぬ。",
              "citation": {
                "source": "特殊部落ということについて",
                "author": "まず部落としての集団的取扱いを廃せよ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに深く理解するかによって、その作品は、児童の真の友達となり忠告者となり、最もよき代弁者ともなるのであって、いまゝでの如く強圧することのかわりに、内部的に感奮興起せしむるに至るのであります。",
              "citation": {
                "source": "新童話論",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "果して能くかくの如くんば、国威は奮興し、材俊は振起し、決して国体を失うに至らざるなり」と。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の頃、二十代の荒畑寒村の書いた『谷中村滅亡史』を読んで感奮興起したときのかんじと似ている。",
              "citation": {
                "source": "叛骨・中野正剛",
                "author": "――主観的な覚え書き",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
