[
  {
    "uuid": "03f13f56-afd3-56f0-8975-2aed1e9ef7a9",
    "entry": "踏み付け",
    "reading": {
      "primary": "ふみつけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
