[
  {
    "uuid": "3f20eb8a-cc2a-5a1b-8571-379f08f14294",
    "entry": "踏み台",
    "reading": {
      "primary": "ふみだい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
