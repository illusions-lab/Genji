[
  {
    "uuid": "f8d4b996-44c3-5713-861b-d412fb8278e1",
    "entry": "浮腫",
    "reading": {
      "primary": "ふしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
