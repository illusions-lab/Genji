[
  {
    "uuid": "298ccb2a-fa94-5eba-a9e4-fb42c083c289",
    "entry": "毛抜き",
    "reading": {
      "primary": "けぬき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
