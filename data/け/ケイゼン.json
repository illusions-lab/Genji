    },
    "definitions": [
      {
        "index": 1,
        "gloss": "alone",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "故郷を離れ、煢然と一人、異国の地で暮らしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古い写真には、煢然として座る若い頃の自分の姿があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は煢然として、遠い空を見つめていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "」合はせて六｜里余、あの磽※たる樵路を、連もなく、と思ふと、三｜角先生に宜しく、と挨拶して、ひとり煢然として峠を下る後態の、湖は広大、山毛欅は高し、遠見の魯智深に似たのが、且軍敗れて、鎧を棄て、雑兵に紛れて落ちて行く宗任のあはれがあつた。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人やゝもすれば、人生を夢幻と云ひ、空華と云ふ、一念｜茲に至れば、空華の根柢に充実せる内容あり、夢幻の遷転影裡猶且つ煢然たる永久の覚醒あり。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠はもとより両親も何もない、最愛の児を失い、最愛の妻を失って、世を果敢むの余り、その妻と子の白骨と、ともに、失うべからざるものの一式、余さずこの古革鞄に納めた、むしろ我が孤の煢然たる影をも納めて、野に山に棄つるがごとく、絶所、僻境を望んで飛騨山中の電信局へ唯今赴任する途中である。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はただ屏風の巌に、一介の栄螺のごとく、孤影｜煢然として独り蓋を堅くしていた。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "田の傍には幾筋かの小さな流が通つて、箱仕掛の小さな水車が煢然として立つて居る。",
              "citation": {
                "source": "痍のあと",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
