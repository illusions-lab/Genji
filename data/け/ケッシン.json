[
  {
    "uuid": "5f818946-67c3-5163-a9f0-02cc1ec0e1ec",
    "entry": "決心",
    "reading": {
      "primary": "けっしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
