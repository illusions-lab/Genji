  {
    "uuid": "d8e54405-241f-5153-9bf4-23bfa2db86df",
    "entry": "削り屑",
    "reading": {
      "primary": "けずりくず",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
