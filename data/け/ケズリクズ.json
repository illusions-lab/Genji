    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "木綿糸の結び玉や、毛髪や動物の毛らしいものや、ボール紙のかけらや、鉛筆の削り屑、マッチ箱の破片、こんなものは容易に認められるが、中にはどうしても来歴の分らない不思議な物件の断片があった。",
              "citation": {
                "source": "浅草紙",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "惣兵衛ちやんは矢を削つてしまふと、前垂から緑い削り屑を、はらひ落しながら、ふと紙鳶に眼をとめた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　義兄は立ち上ると膝に溜つた削り屑をぽん／＼と音高く叩いた。",
              "citation": {
                "source": "悲しめる顔",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮に一つの円い木板があるとして、これに鋭利な刃物を打ち込んで、第二十二図に示すように削り屑を飛び出させるとすれば、木片は矢で示す方向に回転するであろう。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二十二図　打ち出された削り屑もまた同じ方向に回転する、のみならず、刃物との摩擦のために右方に動く、すなわち、板の赤道の運動方向と同じ方向に並行して進む。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "同様に太陽から飛び出した削り屑も太陽に戻らなければならない。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "作家も仕事をもってる」それから丁寧に鉛筆の削り屑を机の下の紙くず籠へすてて「……リベディンスキーの『一週間』というのは日本に知られてるだろうかな？",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この樹木の削り屑の大量は、その明らかな性質を隠し醸造業者の廃棄物から判らないように、半分焦がして粉にして売られている。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
