[
  {
    "uuid": "3a83cb30-23d2-5920-a6ad-8bf8d813423f",
    "entry": "経義",
    "reading": {
      "primary": "けいぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
