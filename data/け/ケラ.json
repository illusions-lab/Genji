[
  {
    "uuid": "78ae7f3c-ada7-5722-8307-1883b1f88c94",
    "entry": "螻蛄",
    "reading": {
      "primary": "けら",
      "alternatives": [
        "おけら",
        "ろうこ",
        "ケラ",
        "オケラ"
      ],
