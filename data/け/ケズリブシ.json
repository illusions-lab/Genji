        "examples": {
          "standard": [
            {
              "text": "温かいお好み焼きに、たっぷりの削り節をかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "味噌汁のだしは、昆布と削り節でとるのが一番だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "猫は削り節の匂いを嗅ぎつけると、すぐに寄ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "今日の買物九銭　バツト　十銭　なでしこ　十五銭　小鰯　壱円三十五銭　酒　七銭　茗荷　三十四銭　干うどん　二十銭　薬　五銭　茄子　十銭　電車賃　六銭　胡瓜　十銭　ハガキ　十弐銭　泥鰌汁　十銭　唐辛　三十五銭　削り節八月廿五日　雨、午後は曇、後晴。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "削り節にもいろいろあって、最上の削り節ならば、まずまずであるが、削り節は削り立てがいいので、時がたってはよろしくない。",
              "citation": {
                "source": "だしの取り方",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫にあてがう食事としてはこちらの飯を分けてけずり節を少しかけてやる程度だが、魚類があれば少し分けてやる、生がかったメザシよりは干物の方を好んで食う、またあんパンなんどをつまんでやると飯よりはかえってよろこんで食う、いまの処｜肴よりはかえってパンが好きらしい。",
              "citation": {
                "source": "百姓弥之助の話",
                "author": "第一冊　植民地の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
