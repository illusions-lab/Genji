  {
    "uuid": "859a33ea-21da-50f5-97b2-ae0d1ae3c9c7",
    "entry": "ケダシ",
    "reading": {
      "primary": "けだし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ボンコチヤンハ、オゲンクワンカラ、ソトヘカケダシテイツテシマヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カケダシですから」「あなたは煙山氏のアジトを知ってますか」「いいえ。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ士君子万巻ヲ読破スルモマタ須ラク廟堂ニ登リ山川ヲ看交ヲ海内名流ニ結ブベシ。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ先生｜預メ葬地ヲ卜セシトイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ術ヲ原芝助ニ受ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "昌卿ハケダシコレニ肖タリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ時勢ノ変ニシテ兵法ノ一定シテ論ズベカラザルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ道光壬寅｜鴉片ノ変魏源｜身ヅカラソノ際ニ遭遇シ清国軍政ノ得失、英夷侵入ノ情状コレヲ耳目ノ及ブ所ニ得タリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシソノ亜舶ニ投ゼントスルノ前数日也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ制造ノ精ナル工人ニ譲ラズトイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ奇禍測リガタキヲ以テ京師ヲ去リソノ故里松坂ニ潜マント欲シ、天明ヲ待テマサニ発セントセシナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ賀寿ノ筵ヲ設ケテ以テソノ窮ヲ救ヘト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "○馬の音のとどともすれば松蔭に出でてぞ見つる蓋し君かと　〔巻十一・二六五三〕　作者不詳　結句、原文「若君香跡」で、旧訓モシハ・キミカト、考モシモ・キミカトであったのを古義でケダシ・キミカトと訓んだ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕みたいカケダシの若僧に弟子入りしたって仕様がない、大家のところへ行きなさい、と言ったら、若い者は若い者同志でさア、と変なことを言やがった。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
