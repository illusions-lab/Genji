[
  {
    "uuid": "1ce02c5f-7a13-5be5-8975-d1804b23f885",
    "entry": "慧眼",
    "reading": {
      "primary": "けいがん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
