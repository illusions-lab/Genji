[
  {
    "uuid": "a569074c-5a81-528c-88af-cd0b069acbb8",
    "entry": "流",
    "reading": {
      "primary": "る",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
