        "examples": {
          "standard": [
            {
              "text": "池には沼縄がたくさん生えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "沼縄の葉は水面に浮かんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "沼縄は食用としても利用されることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そうかと思えば、唄は無くて盲目縞に赤い帯の水国の乙女が、ぬなわ舟に棹さして、こちらをながめているのにでくわす。",
              "citation": {
                "source": "大菩薩峠",
                "author": "Ocean の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
