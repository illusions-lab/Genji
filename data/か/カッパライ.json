  {
    "uuid": "eaf08d6f-7d1d-5a3b-b83e-bdc9dede564e",
    "entry": "カッパライ",
    "reading": {
      "primary": "かっぱらい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ここには明日自由の身となるべき窃盗氏、詐欺氏、カッパライ氏、恐喝氏、持逃げ氏などが集まって来る。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるカッパライの大将いわく、「小僧の二人も内にかくまっておけば、その日その日に不自由をすることはないぜ、鰹節がなくなれば鰹節をさらって来るし、炭がなくなれば、炭をさらって来るし、ホントに便利なもんだ。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カッパライを働くためにこの世に現れた虫のような薄気味わるい小僧なんですよ。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒、バクチ、カッパライ、喧嘩、そして、男。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがきみたちは、ときどきカッパライもやっている。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、諸君はけっして、カッパライなんか、やりたくてやってるんじゃない。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "チンピラ諸君は、カッパライの経験もあるくらいですから、人に気づかれないように立ちはたらくことは、じつにうまいものです。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
