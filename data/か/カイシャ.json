  {
    "uuid": "2d7cff22-05f9-5124-a999-2e50fa110455",
    "entry": "壊者",
    "reading": {
      "primary": "かいしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
