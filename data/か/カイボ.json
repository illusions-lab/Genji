          "literary": [
            {
              "text": "で何となく懐慕しいやうにも思はれ、また其の淋しい末路が哀になツて、「俺の生母のやうに早死しても憫然だが、また比のおふくろのやうになツても氣の毒だ。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆゑその人はその抒情詩の時代をどれだけあとあとまで懐慕するか分らない。",
              "citation": {
                "source": "忘春詩集",
                "author": "忘春詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々の歌には押え切れぬ昔への懐慕があった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第八巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "迫ツた眉には何んとなく悲哀の色が潛むでゐるが、眼には何處となく人懷慕い點がある。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
