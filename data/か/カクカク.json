        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山道をカクカクと曲がりながら進むバスの揺れに、思わず身構えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の描く線は、カクカクしていて独特の味がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この古い機械は、動かすとカクカクとぎこちない音を立てる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "彼が生れて育った少年時代は、信長が天下を席捲し威名カクカクたる時代であった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "choppy (e.g. graphics)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
