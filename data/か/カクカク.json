        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古いパソコンで最新ゲームを起動したら、画面がカクカクしてまともにプレイできなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "動画の読み込みが遅くて、映像がカクカクと途切れてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プレゼンテーションのスライドがカクカクと表示され、聴衆をいら立たせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
