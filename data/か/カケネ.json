        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の話はいつも掛け値が入っていて、どこまで本当かわからない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「とんでもない大物だった」と、彼は少し掛け値をして話した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "営業部長は掛け値なしに、今年の売上は去年比で30%増加したと報告した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
