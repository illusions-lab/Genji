[
  {
    "uuid": "88a8dbb8-ad05-5f69-a2d2-21be88623288",
    "entry": "会見",
    "reading": {
      "primary": "かいけん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
