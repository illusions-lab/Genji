    "definitions": [
      {
        "index": 1,
        "gloss": "Kai Ken (Japanese dog breed)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
