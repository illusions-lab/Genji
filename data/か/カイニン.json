        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "pregnancy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "王妃の懐妊が発表されると、国中で祝福の声が上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女の懐妊を知った家族は、喜びの涙を流して抱き合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "医師から懐妊を告げられた瞬間、長年の願いがようやく叶ったと実感した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "禰宜　女子が正しい懐妊は恥ではないのじゃ。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は尚も言葉をつづけて、私、考えますに葛の葉の如く、この雪女郎のお嫁が懐妊し、そのお腹をいためて生んだ子があったとしたなら、そうして子供が成長して、雪の降る季節になれば、雪の野山、母をあこがれ歩くものとしたなら、この物語、世界の人、ことごとくを充分にうっとりさせ得ると、信じて居る。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが邦でも『調味｜故実』に兎は婦人懐妊ありてより誕生の百二十日の御祝い過ぐるまで忌むべしと見ゆ。",
              "citation": {
                "source": "十二支考",
                "author": "兎に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その出来たときに莫邪の妻は懐妊して臨月に近かったので、彼は妻に言い聞かせた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "最愛の方が懐妊されたのであるから、帝のお志はますます藤壺の宮にそそがれるばかりであった。",
              "citation": {
                "source": "源氏物語",
                "author": "若紫",
                "note": "青空文庫"
              }
            },
            {
              "text": "スラバヤ同様猴に懐妊を祈ること出口米吉氏の「土俗覧帳」（『人類学雑誌』二八巻十号）に『大朝』紙を引いて、尾張海東郡甚目寺観音院境内にオサルサマあり、子を授くるとて信者多し、その本尊木彫の猴、高さ一尺内外の坐像、半身大の桃実を抱き真向に坐す。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はふと定子を懐妊していた時のはげしい悪阻の苦痛を思い出した。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしや懐妊では……葉子は喜びに胸をおどらせてそう思ってもみた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし前の懐妊の経験と今度の徴候とはいろいろな点で全く違ったものだった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋の彼岸前後になると、懐妊した女の乳のように、おしろい花の実が黒く色づき初める。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘はいつか懐妊して、三つの生き物を生み落したが、それは小鰯のような物であった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神後記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人が死刑になれば、政府によって選ばれたる一人の女性が手術による人工受胎法によって一人の嬰児を懐妊し、そして分娩するために国立生殖病院に入れられ、そして一人の人間を補充すればいいんだ。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、それどころではない、その時、細君が懐妊しておったから、不図難産して死ぬ、その後にその女を入れるとしてどうであろう。",
              "citation": {
                "source": "蒲団",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、妻は今の女の児を懐妊していた。",
              "citation": {
                "source": "トコヨゴヨミ",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年の四月頃から懐妊の気味で、其の前から出るの入るのと言つて居たが、愈々上京の話が決ると、『私ばかり置いて行くのかえ、母さん』と言つて泣きに来た。",
              "citation": {
                "source": "朝",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が一年後に、懐妊した細君を里に預けて、其婿は東京へ出て行つたきり帰つて来なかつた。",
              "citation": {
                "source": "朝",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "お作はその時懐妊して七か月目であった。",
              "citation": {
                "source": "ネギ一束",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "欠席したのは四人、その一人は死に、その一人は病み、他の二人は懐妊中とのことで。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだそれでもお父さんの生きているうちは、根気よく手紙をくれて、少年の心得になるようなことや、種々な郷里の方のことや、どうかすると嫂が懐妊したから喜べというような家庭の中のことまで、よく書いてよこしてくれた。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、熱帯の女人の十三にして懐妊することを考へれば、温帯の男子の三十にして頭の禿げるのは当り前である。",
              "citation": {
                "source": "僕の友だち二三人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "その裏面において、侍女を懐妊させたという秘事さえあるのだもの。",
              "citation": {
                "source": "備前天一坊",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "――然るに、その最中余を驚かせたるものありて、幹枝の懐妊を知れり。",
              "citation": {
                "source": "失楽園殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日の談合は――」　と、云って、低い声になって「御部屋様の御懐妊――近々に、目出度いことがあろうが、もし、御出生が、世子ならば、その御世子を飽くまで守護して、御成長を待つか。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるときはお信が懐妊して三月足らずで流産したとき、容太郎はその闇から闇へ往く生命が誰の子であるかを考えて狂いそうに悩みつづけた。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "若草は素人臭く懐妊したとも云兼て居りまする。",
              "citation": {
                "source": "粟田口霑笛竹（澤紫ゆかりの咲分）",
                "author": "粟田口霑笛竹（澤紫ゆかりの咲分）",
                "note": "青空文庫"
              }
            },
            {
              "text": "山吹はこの頃｜懐妊っていた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、塚に魂があって、人の中にはいろうとしており、女の人が通るとその体にはいって懐妊することになるのである。",
              "citation": {
                "source": "石の信仰とさえの神と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "と父の日記にあつて、僕の弟が生れてゐるから、青根温泉湯治中に母は懐妊したのではないかと僕は今おもふのである。",
              "citation": {
                "source": "念珠集",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、懷妊中は別して五體を大切にし病氣に罹らぬ樣注意ねばならぬ故に、先食餌を吟味し精々榮養のものを用ひ、むら喰せぬよふに心懸べし。",
              "citation": {
                "source": "養生の心得",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、懷妊中はは成丈寢起を柔にし、月重りて後は一入轉ばぬように氣を付けるべし。",
              "citation": {
                "source": "養生の心得",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
