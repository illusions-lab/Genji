  {
    "uuid": "d730c281-a33b-5379-b512-8539c3b2306b",
    "entry": "懐妊",
    "reading": {
      "primary": "かいにん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
