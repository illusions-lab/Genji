  {
    "uuid": "e5d7e6ca-ca46-5a13-a446-a6de42a43301",
    "entry": "寛宥",
    "reading": {
      "primary": "かんゆう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "余は教会に捨てられて始めて寛容寛宥の美徳を了知するを得たり、余が小心翼々神と国とに事えんとする時にあたって、余の神学上の説の異なるより教会は余の本心と意志とに疑念を懐きついに或は余を悪人と見るに至れり。",
              "citation": {
                "source": "基督信徒のなぐさめ",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは読者に寛宥を乞うて、下に少しく諸友の告ぐる所を追記しようとおもふ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑法已に和姦を寛宥して罰せずんば禮教又防範する能はざるに至らん。",
              "citation": {
                "source": "支那近世の國粹主義",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸いに概論に対する下手なる詳説として、寛宥あらんことを乞う。",
              "citation": {
                "source": "「特殊部落」と云う名称について",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは特に同情ある読者諸君に向かって、寛宥を願いたい。",
              "citation": {
                "source": "編輯雑感",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "宜しく寛宥を存せ令めて仁寿に登せ、瑕穢を蕩して自ら新にする事を許すべし。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
