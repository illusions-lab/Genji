  {
    "uuid": "2ce400e4-fdc6-5db4-ae91-11e38417729d",
    "entry": "鎰屋",
    "reading": {
      "primary": "かぎや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
