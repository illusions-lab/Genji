          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古い教会の高い天井を見上げると、壮麗なフレスコ画が円蓋のカーブに沿って描かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あの円蓋のてっぺんにある展望台まで登れば、フィレンツェの街並みを一望できるよ」とガイドが勧めてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ルネサンス様式の邸宅を特徴づけているのは、中央にそびえ立つ美しい石造りの円蓋だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "紅と緑の光弾、円蓋、火箭、ああ、その銀光の投網、傘下し、爆裂し、奔流し、分枝し、交錯し、粉乱し、重畳し、傘下し、傘下し、傘下し、八方に爛々として一瞬にしてまた闇々たる、清秀とも、鮮麗とも、絢爛とも、崇美とも、驕奢とも、譬うるに言葉も絶えた。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝々の群は、一つの途方もなく大きな円蓋だ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず坪を割って土台をきめ、しほんといって四本の柱をもって支柱を建て、箱根竹を矯て円蓋を作り、そのしほんに梯子段を持たせて、いつぞやお話した百観音の蠑螺堂のぐるぐると廻って階段を上る行き方を参考としまして、漸々と下から廻りながら登って行く仕掛をこしらえて行きました。",
              "citation": {
                "source": "佐竹の原へ大仏をこしらえたはなし",
                "author": "高村光雲",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず坪を割って土台をきめ、しほんといって四本の柱をもって支柱を建て、箱根竹を矯めて円蓋を作り、そのしほんに梯子段を持たせて、いつぞやお話した百観音の蠑螺堂のぐるぐると廻って階段を上る行き方を参考としまして、漸々と下から廻りながら登って行く仕掛けを拵えて行きました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "佐竹の原へ大仏を拵えたはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時京都画壇には今尾景年先生、岸竹堂先生、幸野楳嶺先生、森寛斎先生などの方々がそれぞれ一家をなしていられたが、景年先生なども月を描かれる時には丸い円蓋とか丸い盆、皿などを用いられて描かれていたが、松年先生は決してそのような器具は使われなかった。",
              "citation": {
                "source": "三人の師",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、そのむかし帝王が出御の玉座、名残りの円蓋で数珠かけ鳩が、何処、何処とばかり啼いていた。",
              "citation": {
                "source": "ルバイヤート",
                "author": "RUBA'IYAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、法水はいかにして、鐘鳴器の音から死体の所在を知ったのであろうか※三、易介は挾まれて殺さるべし　ところが、法水はすぐ鼻先の拱廊へは行かずに、円廊を迂回して、礼拝堂の円蓋に接している鐘楼階段の下に立った。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前篇にも述べたとおり、その室は礼拝堂の円蓋に接していて、振鐘のある尖塔の最下部に当っていた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「床から円蓋の頂点までが五｜米ぐらいか、それから鐘までも同じぐらいあるだろう。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして最後に、指紋の無効果と、円蓋には烈風と傾斜とで霙の堆積がないこと――などで、すべてが空しかった。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ法水君、風が烈しかったのと傾斜とで、円蓋に霙が積っていない。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、円蓋に足跡のないことが、かえって想像を自由にしてくれる。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず振綱に攀じ登ってから塔の窓に出て、そこで兇器を裏門の方へ投げ捨ててから、架空線を伝わって円蓋を下り、そして、回転窓の下に引き込まれてある動力線に吊り下って、スルスル猿みたいに構外へ出てしまったのだ。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "煉瓦造りの本屋に円蓋をそばだたせ、左右に翼を張り、瓦屋板を前方につきだし、広い深閑たる土間を礼拝所とした。",
              "citation": {
                "source": "台湾の姿態",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "水路を渡った森の帯の向こうに見える炎は、それ自身が巻き上げる煙の円蓋に反映して地表を照らし、今や地平線一杯に広がらんとしていた。",
              "citation": {
                "source": "チカモーガ",
                "author": "Ａ. ビアス　A.Bierce",
                "note": "青空文庫"
              }
            },
            {
              "text": "湧き返るような大喝采、大歓呼のうちに、やがて、砲塔の円蓋を排して現われたのは、眉美しき一人の東洋的令嬢。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "南風吹かば　――モンテ・カルロの巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "見あぐれば淡い新月に照らされて、碧玉随のような螢光を発し、いまにも頭の上に落ちかかろうとする怪偉な山容は、これぞアルプスの大伽藍モン・ブランの円蓋。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "焦慮｜瘠身幾時間ののち、やがて、ミューレの平場へ届こうとするころ『グーテの円蓋』の頂きに、ふと一｜抹の雪煙りが現われた。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう大｜円蓋は目に入らず、ただその寒ざむとした胴の灰色の壁だけが、のしかかるやうに聳えてゐるのでした。",
              "citation": {
                "source": "死児変相",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナポレオンの遺骸も、それから間もなくフランスへ帰ったものと見てよいから巴里の旧廃兵院の大円蓋の下、血紅色の埃及大理石の墓塋におさめられているナポレオンの心臓は、セント・ヘレナで死んだ似非ナポレオンのそれではなく、一八三〇年に加奈陀で死んだ真正ナポレオンのそれなのであろう。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央には美しい円蓋の下に、珍しい形をした屏障の華やかな装飾をうしろにして阿弥陀如来が膝を組んでいる。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓をおし開けて見ると、昇降場の磨硝子の円蓋には水蒸気が白くたち罩め、その天井の高いところから、絶えず滴がたれ落ちていた。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒼天は円蓋の如し陸地、碁局に似たり世人｜黒白して分れ往来に栄辱を争う「おうい、童子。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "透通いて見えん事は無けれどもよ……障子越は目に雲霧じゃ、覗くにはっきりとよう見えんがいの。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "思えんがいないのだ。",
              "citation": {
                "source": "一兵卒",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
