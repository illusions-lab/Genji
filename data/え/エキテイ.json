    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "◯わが日は駅使（早馬使、駅丁）よりも迅く、いたずらに過ぎ去りて福祉を見ず、その走ること葦船の如く、物を攫まんとて飛びかける鷲の如し」との悲歎の語が二十五、六節にある、わが日の過ぎ去る事の早きを陸上、水上、空中の最も早き物に比したのである。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十四日の榛軒の書は鳴海駅丁字屋吉蔵の家に投じた夜に作つたものである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
