  {
    "uuid": "f0a04c53-896b-5f7f-9acd-e81d0ff8a212",
    "entry": "掖廷",
    "reading": {
      "primary": "えきてい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "〕当に掖廷に納れて、后宮の数に盈つべしと。",
              "citation": {
                "source": "水の女",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "……丹波の五女を喚して、掖廷に納る。",
              "citation": {
                "source": "水の女",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "当に掖廷に納れて、后宮の数に盈つべしと。",
              "citation": {
