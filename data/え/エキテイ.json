    },
    "definitions": [
      {
        "index": 1,
        "gloss": "delivery of packages",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "明治初期、駅逓制度が整備されたことで遠方への荷物の配送が飛躍的に早まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "かつての宿場町には、駅逓の拠点として馬を繋いでいた跡が今も残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「駅逓の仕事は過酷だったらしい」郷土資料館の展示を見ながら、昔の輸送に思いを馳せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「駅逓馬車」による永い旅路の門出の場面などでも、こうした映画の中で見ていると、いつの間にか見ている自分が百年前のワルシャウの人になってしまう。",
              "citation": {
                "source": "映画雑感６",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "灯点る、さあれなほ梢はにほひ、全くいま暮れはてし下枝のゆらぎ……四十一年八月　　雨の日ぐらしち、ち、ち、ち、と、もののせはしく刻む音……河岸のそば、黴の香のしめりも暗し、かくてあな暮れてもゆくか、駅逓の局の長壁灰色に、暗きうれひに、おとつひも、昨日も、今日も。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "太田正雄　　冷めがたの印象あわただし、旗ひるがへし、朱の色の駅逓馬車跳りゆく。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "校倉よ、露西亜びとの住み棄てし小舎、駅逓のフラフにも朱は褪せたり。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "露領時代のままの駅逓が或る林中に幽かに薄紫の炊煙を立てているのも見た。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その駅逓は丸太組で、極めて簡朴な、そうして異国風の雅味を持った建築であった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　私たちはまた、こうした原生林の中の幾つかの駅逓や部落を通り過ぎた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの露西亜風の駅逓の前に見たのがそれであった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカに以前｜駅逓総監までつとめたことのあるバアルソンといふ爺さんがある。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした出鱈目な話がいよいよ詳しくなって、しまいには駅逓馭者の名前までが一々あげられだした。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっ先に気づくのは、息つぎ場所の駅逓である。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛脚も駅逓もひらけていない土地に来てしまった彼らには、――わけても女どもには――これがはじめての、思いを込めた便りであった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "手押車を押して来た男の話によれば、彼はその日の朝「｜ジョージ王屋」のところで駅逓馬車（註六）を降り、海岸沿いにどんな宿屋があるかと尋ねて、私の家が多分評判がよく、また一軒離れていると聞かされたのであろう、他のところよりも私の家を滞在処に択んだのだという。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄昏頃、灌木の生い茂った荒地にある「｜ジョージ王屋」のところで、私たちは駅逓馬車に乗り込んだ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁が今住んで居る家は、明治三十九年に出来た官設の駅逓で、四十坪程の質素な木造。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅逓の前は直ぐ北見街道、其向うは草叢を拓いて牛馬舎一棟、人の住む矮い草舎が一棟。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅逓東南隅の八畳が翁の居間である。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先夜は可なりあるように思ったが、駅逓から十丁には過ぎぬ。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今こそ駅逓には冬も氷らぬ清水が山から引かれてあるが、まだ其等の設備もなかった頃、翁の灌水は夏はもとより冬も此斗満川でやったのだ。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅逓に帰って、道庁技師林常夫君に面会。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　駅逓にはいる時、大勢の足音がする。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが斗満｜最奥の人家で、駅逓から此処まで二里。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯くて午後二時｜駅逓に帰った。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早朝関翁以下｜駅逓の人々に別を告げる。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるものは京都府の駅逓印鑑、あるものは柏崎県の駅逓印鑑、あるものは民政裁判所の判鑑というふうに。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸の方にあった道中奉行所の代わりに京都｜駅逓司の設置、定助郷その他｜種々な助郷名目の廃止なぞは皆この消息を語っていた。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅逓司の趣意はまだ皆の間に徹しないかして、一概にこれを過激な改革であるとなし、自分らの利害のみを考えるものも出て来た。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "民意の開発に重きを置いた尾州藩中の具眼者がまず京都駅逓司の方針に賛成したことは不思議でもない。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都駅逓司の新方針によると、たとい諸藩の印鑑で保証する送り荷たりとも、これまでのように問屋場を素通りすることは許されない。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
