[
  {
    "uuid": "8c97654a-91c6-52b6-a1e9-c10f928fcbd6",
    "entry": "ビャク",
    "reading": {
      "primary": "びゃく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
