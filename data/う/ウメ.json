[
  {
    "uuid": "90472f0c-d3aa-5021-aaf5-c00ac76ca977",
    "entry": "梅",
    "reading": {
      "primary": "うめ",
      "alternatives": [
        "むめ",
        "ウメ"
      ],
      "is_heteronym": false
