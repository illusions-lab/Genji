          "literary": [
            {
              "text": "迂老の喜び喩えんに物なし。",
              "citation": {
                "source": "蘭学事始再版之序",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "迂老の喜び喩へんに物なし。",
              "citation": {
                "source": "蘭学事始再版序",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレ実に迂老が至願なりとす。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "迂老は幼にして貧、長じて医を学び、紀伊国濱口梧陵翁の愛護を受け、幸に一家を興すことを得たりと雖、僅に一家を維持し得たるのみにして、世の救済については一毫も貢献する所なし。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
