  {
    "uuid": "9f767af5-b5d3-5f23-8c69-01ca2dc309b2",
    "entry": "鰌",
    "reading": {
      "primary": "どじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
