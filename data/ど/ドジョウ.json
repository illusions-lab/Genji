[
  {
    "uuid": "9e54f361-288f-594e-9ed3-7180c00b6aeb",
    "entry": "土壌",
    "reading": {
      "primary": "どじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
