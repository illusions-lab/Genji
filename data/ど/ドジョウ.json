        "examples": {
          "standard": [
            {
              "text": "飼育している泥鰌が、水槽の底を元気に泳ぎ回っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "泥鰌は水質の変化に強く、飼育しやすい魚として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "釣りの餌として泥鰌を使うこともある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
