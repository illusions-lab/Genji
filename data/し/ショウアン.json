  {
    "uuid": "1169a2c1-d6a2-5ab5-8af1-3764a49d3647",
    "entry": "小案",
    "reading": {
      "primary": "しょうあん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "丁度その尼寺の筋向うに、ちょっと通り抜けられそうもない路地があったが、その中へ私たちの小案内者が、ずんずん得意そうに入って行くので、私たちもさも面白いことでもするようにその汚い路地の中へ入って行った。",
              "citation": {
                "source": "三つの挿話",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔城鼓鼕鼕一庁ニ聚マリ／小案ヲ安排シテ山屏ニ傍フ／高人公事多子無ク／残経ヲ説与シテ広坐ニ聴カシム〕となした絶句がある。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
