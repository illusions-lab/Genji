        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その鮮やかな色彩の絵画は、人々の嘱目を引いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼のユニークなファッションセンスは、常に人々の嘱目するところです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あの虹、すごく綺麗！思わず嘱目しちゃった！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
