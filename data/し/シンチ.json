  {
    "uuid": "848e8d0f-4ccf-506d-94da-3b574e00f029",
    "entry": "侵地",
    "reading": {
      "primary": "しんち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カークも、大湿林の咆吼をよぶ狂風を感じはするが……、死を賭して、不侵地悪魔の尿溜をきわめようなどとは、夢にもさらさら思わないことだった。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ、『天母生上の雲湖』は永劫の不侵地かね」　ダネックも、さすがその日はぐったりしていた。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗い積雲と霧のむこうに、不侵地、「天母生上の雲湖」が、傲然と倨坐している。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ、『｜天母生上の雲湖』は永劫の不侵地かね」　ダネックも、さすがその日はぐったりしていた。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "【三〇】桓公、魯の曹沫に侵地を遷すことを約せしを、約に背きて還さざらんとする也。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "管晏列傳第二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
