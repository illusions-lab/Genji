[
  {
    "uuid": "19d4614c-2223-527f-9833-0de7e165e57c",
    "entry": "喋り",
    "reading": {
      "primary": "しゃべり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
