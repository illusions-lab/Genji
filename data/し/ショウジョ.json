          "literary": [
            {
              "text": "「姉さんどうします」「どうしますって、妾女だからどうして好いか解らないわ。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾女だからそんなむずかしい理窟は知らないけれども、始めて伺ったわ。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "上方筋は別して穢多の増長せし事にて、大坂渡辺の穢多に、大鼓屋又兵衛といへるは、凡拾万両程の分限にて、和漢の珍器宝庫に充満し、奢侈大方ならず、美妾女も七八人ありと云。",
              "citation": {
                "source": "特殊部落と細民部落・密集部落",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
