        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "仏教の教えによれば、徳を積んだ者は極楽浄土を生所とする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "輪廻転生の考えでは、現世の行いによって来世の生所が決まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は自らの最期を悟り、安らかな生所へと旅立つ準備を始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
