  {
    "uuid": "d583051e-b603-567c-b6f3-2e826262f712",
    "entry": "資益",
    "reading": {
      "primary": "しえき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "help",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "皆様からの温かいご支援が、我々の活動に大きな資益をもたらしました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このプロジェクトは、地域社会に多大な資益をもたらすと期待されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の助言は、私の研究にとって計り知れない資益となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "卒業後の三年めの明治三十五年（一九〇二年）から凡そ五年間、それぞれの大辞典の編著や統理に成功を収めた上田・大槻・芳賀・松井等の諸先覚には、他方において国語の研究や調査や教育や改善やの諸事業にわたって計るべからざる種々の資益を得たことが、かれこれと想起されてくる。",
              "citation": {
                "source": "『広辞苑』自序",
                "author": "新村出",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
