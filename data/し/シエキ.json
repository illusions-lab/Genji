          "literary": [
            {
              "text": "王安石は更に市易といふものを考へた、田地絹物などを抵當として政府から約二割の利で金を借る法であります。",
              "citation": {
                "source": "近代支那の文化生活",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            }
