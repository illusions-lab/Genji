  {
    "uuid": "f9eecd2a-f20e-50bb-92ae-c99cbbf815bc",
    "entry": "姿色",
    "reading": {
      "primary": "ししょく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "はてな、妙齢の姿色、忽然として剣侠下地だ、うっかりしちゃいられない。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "又｜妻後藤氏に随つて来た侍女に姿色があつたので、遂に留めて妾としたと言ふ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それより艶容｜匹なく姿色衰えず淫心しきりに生じて制すべからず。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど其性質は悪くはない相で、子供などには中々優しくする様子であるから、何うだ、重右衛門、姿色よりも心と言ふ譬もある、あれを貰ふ気は無いかと勧めた。",
              "citation": {
                "source": "重右衛門の最後",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず姿色もない訣ではない。",
              "citation": {
                "source": "鴉片",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "策士川上が貞奴の名を揚げるために種々と、世人の好奇心をひくような物語を案出するのであろうとはいわれたが、彼女の技芸に、姿色に、魅惑されたものは多かった。",
              "citation": {
                "source": "マダム貞奴",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
