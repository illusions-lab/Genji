[
  {
    "uuid": "b756672d-4b55-5f75-933e-19dda2223d15",
    "entry": "試食",
    "reading": {
      "primary": "ししょく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
