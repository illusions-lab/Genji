        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "国王の承允を取り付けるため、使者は何ヶ月も王宮の門前で待ち続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "両親の承允を得て、彼女はついに海外留学へと旅立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
