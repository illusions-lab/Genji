        "examples": {
          "standard": [
            {
              "text": "「AならばB」が真でも、逆の「BならばA」が真とは限らないと先生が板書した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "命題の逆を考えるとき、前提と結論を入れ替えるだけでは証明にならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "数学の授業で「この命題の逆は成立するか」という問いが出て、クラス全員が考え込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
