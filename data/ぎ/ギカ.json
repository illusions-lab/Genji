    },
    "definitions": [
      {
        "index": 1,
        "gloss": "false fruit",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "イチゴは植物学上、果肉部分が花托が発達した偽果であり、本来の果実は表面の粒々の部分だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "リンゴやナシも偽果の一種で、私たちが食べている甘い部分は花托が肥大したものである。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "植物学の授業で偽果と真果の違いを学び、身近な果物の構造を改めて見直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "そしてこの果はじつは擬果すなわち偽果であって、本当の果実でない事実は素人には分るまいが学者にはよく分っている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、他の器官が主部となって果実をなしているものもあって、そんな場合は、これを擬果とも偽果とも称える。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "困りましたね」「言いすぎかも知れないけれど、君の言葉はひどくしどろもどろの感じです。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五日すぎから、腰の右方に腫物ができて、粗末にしてゐたら次第にそれが成長し、十五日までは酒を呑んだりして不安の氣持をごまかしてゐましたが、たうとう十六日からは、寢たつきりになつてしまひました。",
              "citation": {
                "source": "知らない人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼過ぎから猛烈な吹雪が襲って来たので、捲上の人夫や、捨場の人夫や、バラス取り、砂揚げの連中は「五分」で上ってしまった。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "願ぎかくるは伯母のまにまにである。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "生れてこんなこと始めてだ」「麦とろの食べ過ぎかね」老妓は柚木がよく近所の麦飯ととろろを看板にしている店から、それを取寄せて食べるのを知っているものだから、こうまぜっかえしたが、すぐ真面目になり「そんなときは、何でもいいから苦労の種を見付けるんだね。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "作者はそのとき偶然老妓が以前、和歌の指導の礼に作者に拵えてくれた中庭の池の噴水を眺める縁側で食後の涼を納れていたので、そこで取次ぎから詠草を受取って、池の水音を聴きながら、非常な好奇心をもって久しぶりの老妓の詠草を調べてみた。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだこの世の人でないとはどうしても思われないから、燈明を上げるだけは今夜の十二時過ぎからにしてといった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "定めし私に云われたことが無念でたまらなかったからでしょう」　民子はここで私はそうでありませんと泣声でいうたけれど、母は耳にもかけずに、「なるほど私の小言も少し云い過ぎかも知れないが、民子だって何もそれほど口惜しがってくれなくてもよさそうなものじゃないか。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから平安朝の半過ぎからまた「いろは」の中で「イ」と「ヰ」が同音になり、「エ」と「ヱ」と、「オ」と「ヲ」とも同音になって、四十四だけの音が区別せられるということになります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（モデル娘忙がわし気に帽を脱ぎ、上着を脱ぎかかる。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は窓のところに立つて、大へん迅く次ぎから次ぎへといつまでも過ぎてゆく雲を見つめてゐました。",
              "citation": {
                "source": "旗手クリストフ・リルケ抄",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "両人は上ろうとして、下駄をぬぎかけると、そこには靴と立派な畳表の女下駄とが並べてあった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、暴虐に対する住民の憎悪は、白衛軍を助けている侵略的な日本軍に向って注ぎかえされた。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "午過ぎから帰るつもりでいたが案外気分がいいし天気もいいから白木屋の俳画展覧会を見に行ったらもうすんでいた。",
              "citation": {
                "source": "病中記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "試みにある日曜の昼過ぎから家族四人連れで奥多摩の入口の辺までという予定で出かけた。",
              "citation": {
                "source": "異質触媒作用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて大学生諸君、その晩空はよく晴れて、金牛宮もきらめき出し、二十四日の銀の角、つめたく光る弦月が、青じろい水銀のひかりを、そこらの雲にそそぎかけ、そのつめたい白い雪の中、戦場の墓地のように積みあげられた雪の底に、豚はきれいに洗われて、八きれになって埋まった。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とえゝ、擽つたい処の騒ぎか。",
              "citation": {
                "source": "怪力",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（略）かく荒れ果てたる小堂の雨風をだに防ぎかねて、彩色も云々。",
              "citation": {
                "source": "甲冑堂",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の夕方には、きまって打ち水のあまりがこの石燈籠の笠に注ぎかけられた。",
              "citation": {
                "source": "庭の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "つぎからつぎと、いろんな軍歌を放送して、とうとう種切れになったか、敵は幾万ありとても、などという古い古い軍歌まで飛び出して来る仕末なので、ひとりで噴き出した。",
              "citation": {
                "source": "十二月八日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはいまでも、あのときわたしがうしかいのちょうちんにともしてやった火が、つぎからつぎへうつされて、どこかにともっているのではないか、とおもいます。",
              "citation": {
                "source": "ひとつの火",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二人はしかたなくよろよろあるきだし、つぎからつぎとはしらがどんどんやって来ます。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、一人の十二、三の少年が釣竿を持って、小陰から出て来て豊吉には気が付かぬらしく、こなたを見向きもしないで軍歌らしいものを小声で唱いながらむこうへ行く、その後を前の犬が地をかぎかぎお伴をしてゆく。",
              "citation": {
                "source": "河霧",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴女は続けてときどき花の香をかぎかぎ、ファニーを相手に、怜悧らしくちょいちょい一座を見渡しながら、「この薔薇は紅いでしょう。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と雨が――忘られさうだつた雨がしと／＼と黒ずんだ雪の上一面にそゝぎかゝる。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして人間の心には、人世のあらゆることを凌ぎかつ無限に向上せしめて行く力があることを信じます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "家族一同業務に就くときは、主人は背広服を着て事務所へ、主婦は茶の間で家事の采配、子供は学校、書生さんは取次ぎかたがた勉強、めいめい平等方面を引込まして差別方面だけ働かす場合です。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "作者はそのとき偶然老妓が以前、和歌の指導の礼に作者に拵えて呉れた中庭の池の噴水を眺める縁側で食後の涼を納れていたので、そこで取次ぎから詠草を受取って、池の水音を聴き乍ら、非常な好奇心をもって久しぶりの老妓の詠草を調べてみた。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
