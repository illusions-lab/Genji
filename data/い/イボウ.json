  {
    "uuid": "dddfe734-611a-5d55-a88e-0bf80c9d37f1",
    "entry": "遺忘",
    "reading": {
      "primary": "いぼう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近き頃、彼ポムペイの古市と同じく、闇黒の裡より出でゝ人の遺忘を喚び醒したるものは、此祠と穀神祠となり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯二三の注意に値する件々を左に記して遺忘に備へて置く。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木春浦さんが小説の種にもと云って貸してくれた本を、遺忘のために手抄して置いたのである。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな作に考証も事々しいが、他日の遺忘のためにただこれだけの事を書き留めておく。",
              "citation": {
                "source": "興津弥五右衛門の遺書（初稿）",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども※し夫れ、彼にありて極めて高潔、極めて荘重なる事業と認むべき者あらば、吾人は邦と邦との隔離を遺忘するに躊躇せざるなり。",
              "citation": {
                "source": "一種の攘夷思想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "的等恐其世遠遺忘無所考證。",
              "citation": {
                "source": "創建清眞寺碑",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "因ツテ手ヅカラ紅白ノ帛ヲ剪リ、コレヲ襟ニ結ビ以テ遺忘ニ備フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "また宇陀の墨坂八の神に、赤色の楯矛を祭り九、また大坂の神一〇に、墨色の楯矛を祭り、また坂の御尾の神、河の瀬の神までに、悉に遺忘ることなく幣帛まつりたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
