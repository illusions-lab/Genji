          "standard": [],
          "literary": [
            {
              "text": "だが、其以前から、発生的に叙事詩と通用して、殆ど同体異貌のものであつたから、変り始めては居た事であらう。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡厥体像、髣‐髴丈夫、頭上加冠、鬢辺垂纓、成緋衫色、起居不同、遞各異貌、或所作女形、対丈夫而立之、臍下腰底、刻絵陰陽、搆几案於其前、置坏器於其上、児童猥雑拝礼、慇懃捧幣帛、或供香華、号曰｜岐神。",
              "citation": {
                "source": "オシラ神に関する二三の臆説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
