[
  {
    "uuid": "f137160c-63e1-5ee3-99ad-edaff86530ac",
    "entry": "威望",
    "reading": {
      "primary": "いぼう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
