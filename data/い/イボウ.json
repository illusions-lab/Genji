  {
    "uuid": "911d58fd-328c-5347-bdad-95f86fd521c0",
    "entry": "依傍",
    "reading": {
      "primary": "いぼう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "保角依傍は前に出づ。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "榛軒は伊勢安斎と桂川｜桂嶼とに依傍して立言した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "感謝す、予はこの驚絶、駭絶の意識をば、直接に、端的に、神より得たり、一毫一糸だに前人の証権を媒とし、若しくは其の意識に依傍したる所あらざる也。",
              "citation": {
                "source": "予が見神の実験",
                "author": "綱島梁川",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
