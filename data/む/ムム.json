        "examples": {
          "standard": [
            {
              "text": "「むむ、困ったな。予定が大幅に狂ってしまった」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「むむ、どちらの案も捨てがたく、決断に迷うところだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
