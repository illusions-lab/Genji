        "examples": {
          "standard": [
            {
              "text": "退任した前社長は、現在は会社の参与として、経営陣に重要なアドバイスを行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は長年の行政経験を買われ、県知事の政策参与に任命されて多忙な日々を送っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "参与室のドアを叩くと、白髪の紳士が穏やかな笑顔で私を迎え入れてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
