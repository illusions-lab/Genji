[
  {
    "uuid": "2b2370dd-2094-539a-84e9-5f0e0a777e27",
    "entry": "囀り",
    "reading": {
      "primary": "さえずり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
