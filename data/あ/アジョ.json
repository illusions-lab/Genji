        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ええい、くそつ、ソローハの阿女め！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "……こちとらの阿女らみてえにへっちゃぶれた顔していたんじゃ、乞食の嬶にも貰え手ねえや」と村人は唇｜辺を引き歪めて噂した。",
              "citation": {
                "source": "一老人",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの『鶴の屋』にいた小便くせえハア子の野郎さ、あいつが君、くりくりした眼のいい加減のやつになってやがてからに、俺を見たら、へんな顔してしまって、畜生――」「あれッ、あの阿女っちょか」と助役が頓狂な声を上げた。",
              "citation": {
                "source": "瘤",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「しょうある、この馬鹿｜阿女――十三四にもなって赤ん坊の守も出来ねえなんてあるか。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんな取り方で植えられっか、このでれ助阿女――」と彼女はいきなり叱りとばした。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ばか阿女、いくらでも哮えろ」と浩平は気圧され気味で、にっと笑った。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "暢気な彼もそのことを考えぬではなかったが、口では「この不精阿女。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "彦一　あんな、薄ぎたない阿女に、おふくろ面をされてゐる家に帰つて来られるか。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うう、こ、この阿女……」　勇は反動をつけて飛び起き、ミチの髪を片手に、片手を腕にかけて捻じ伏せ様とした。",
              "citation": {
                "source": "刺青",
                "author": "富田常雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この阿女め」　彼女の髪は、武大の手に、後ろからつかまれていた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫も殺さねえ面をしやがって、このすべた阿女の潘金蓮め。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一｜閃、楊雄は躍ッて迎児を斬り伏せ、返すやいな、その血刀で、「阿女、思いしれ」　と、巧雲の心部を刺しつらぬいた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なにを、阿女っちょめが、洒落くせえ」　と、薄刃金の二｜丁斧をひッさげて、彼女の前へ挑みかかった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その体を、突き仆して、「阿女。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　台所のほうへ引きずってゆくと、「ちッ、この阿女がッ……」と馬春堂、真似もできない顔をして、耳がとれるか手を離さすか、大きな図ウ体を不器用にどたばたさせて、その胸元を食ッてかかる。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず第一に貴方様、釘勘という野郎、お粂という阿女、お蝶という女……みんな籖引で、こちとらの仲間が、それぞれ片づけることになっております。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヤ」　と、そこで狼連は予定のごとく腕を捲りあげて、「この阿女め。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やい、起きろッ」「起きねえか、ふてえ阿女だ」　こういって、正体のないお粂の肩を不意に蹴とばした人間がある。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何だと、この阿女め」　性懲りもなく、また飛び起きて来た好色なおやじは、猫が小鳥へかかるように、ぬッと舟べりへ出て来ましたが、同じ怒り猛るにしても、彼がそうして追い廻すことは、かえって強い興味であるらしいのです。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、邸を出ないうちから、『この阿女め、長年、御恩のあるお出入先に、何んな不埓をしやがったのか。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから、がやがやと、「阿女、何を、うまそうに、さっきから、ぴちゃぴちゃと、嘗っているだ、俺にも、分前をよこせ」「嫌だよう」「吝ッたれめ、よこさぬか」「鶏の骨だに、分けようがないだよ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なあ、菰僧さん」「鶏を盗んできて、この阿女め一人で腹を肥してくさる」「その、味噌餅くれれば、鶏の片股をくれてやるだ」「ふざけるな」「だって、おら、子持ちだから。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ家の中から板戸を開けて、そこに立っていた者が、二人の僧であったのに意外な顔をしたが、さらに、性善坊の手から逃げようともがいている女の姿を見ると、「この阿女」と、裸足で飛び出してきて、女の黒髪をつかんだ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "七「この阿女っ」不意だった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、大地を引きずり廻しながら、「いってもいってもこの阿女は、碌でもねえことをしやがって、おれのいいつけを、なんだと思っていやがる」足を上げて、蹴飛ばした。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……もう手荒なことはしねえから離せっていうのに」「じゃあ、堪忍してくれるか」「腹の立つ阿女だが、今日のところは、助けてやら。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "気のきかねえ阿女を嬶に持つと、こうも世話が焼けるものかなあ」「さ、こちらのが燗きました。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟｜弟子の和介の野郎と、てめえは、艶文を交わしているのだろうが」「なんで私が……ええあんまりな」「しぶとい阿女めが」平次郎は、猜疑の鬼になっていた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてなお逃げ転ぶお吉を追って、「阿女っ、逃がしゃあしねえぞっ」と、さけんで躍った。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　着ている風呂敷で、沢庵は、顔や頭のしずくをこすりながら、「こらっ、お通｜阿女、なにをするか。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
