[
  {
    "uuid": "ef3cf45a-b967-57e1-92d7-e84c9aa27372",
    "entry": "和え",
    "reading": {
      "primary": "あえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-接尾辞",
        "名詞-接頭辞",
