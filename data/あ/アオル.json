  {
    "uuid": "2b9132dd-f4f8-5bfe-ac2f-451c62b9d919",
    "entry": "呷",
    "reading": {
      "primary": "あおる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
