        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎日、亜炭について考えています。",
              "source": "幻辞"
            },
            {
              "text": "我が社の亜炭戦略は重要です。",
              "source": "幻辞"
            },
            {
              "text": "亜炭の原理は複雑である。",
              "source": "幻辞"
            },
            {
              "text": "亜炭という言葉が頭から離れない。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは亜炭について学んでいる。",
              "source": "幻辞"
            },
            {
              "text": "亜炭の治療方法は多様である。",
              "source": "幻辞"
            },
            {
              "text": "亜炭に関する法律が改正された。",
              "source": "幻辞"
            },
            {
              "text": "選手たちは亜炭を目指している。",
              "source": "幻辞"
            },
            {
              "text": "自然界での亜炭は見事である。",
              "source": "幻辞"
            },
            {
              "text": "歴史上、亜炭は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "亜炭は日本文化の一部である。",
              "source": "幻辞"
            },
            {
              "text": "旅行中に様々な亜炭を見つけた。",
              "source": "幻辞"
            },
            {
              "text": "「亜炭」という概念について深く考察する必要があります。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "所々には、水増しの時できた小さな壺穴の痕や、またそれがいくつも続いた浅い溝、それから亜炭のかけらだの、枯れた蘆きれだのが、一｜列にならんでいて、前の水増しの時にどこまで水が上ったかもわかるのでした。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "早春黒雲峡を乱れ飛び　　技師ら亜炭の火に寄りぬげにもひとびと祟むるは　　青き Gossan 銅の脈わが索むるはまことのことば雨の中なる真言なり　　来々軒浙江の林光文は、　　　　　　かゞやかにまなこ瞠き、そが弟子の足をゆびさし、　　凛としてみじろぎもせず。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "所々には、水増しの時できた小さな壺穴の痕や、またそれがいくつも続いた浅い溝、それから亜炭のかけらだの、枯れた蘆きれだのが、一列にならんでゐて、前の水増しの時にどこまで水が上ったかもわかるのでした。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "奉天の掘立小屋に住んで亜炭を売り、鉄嶺では金がなくてとうふばかり食っていた。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "近畿地方等で「狐があたんする」と言いますが、この「あたんする」は復讐するということであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも「あたみ」をするということで、動詞で「あたみ、あたむ、あため」と活用するものでありますが、それが名詞になって「あたみ」になり更に「あたん」と転じたものでしょう。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあたんといびらないで置くがいいよ」「わたし時々ほんとうに死にたくなっちまいます」　葉子は途轍もなく貞世のうわさとは縁もゆかりもないこんなひょんな事をいった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そこは寒いからこつちへ來て行火にでもあたんなすつたら……」　孝次郎は店の間に自分の荷物をひとまとめにして、コップとおでんの皿を持つて燈火の方へ行つた。",
              "citation": {
                "source": "雨",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえさん、さあ、炉の榾火に、おあたんなせえと言ったら――」　と、しつッこく手を取るのを、又も、引ッぱずして、浪路は、「無礼もの！",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあ御あたんなさい」　折から風に誘われた雨が四五筋、窓硝子に当って砕けた。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし酷いことをする親もあるもんどすなあ……そんなの芸子にはめずらしいこともおへんけど、あの商売にそんな酷いことをする親はまあたんとはおへんなあ」主人は肝腎の話を忘れてしきりに思い入ったようにいう。",
              "citation": {
                "source": "霜凍る宵",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、おっ母さんや、まあたんと皮算用をしたけりゃしなさいだがね。",
              "citation": {
                "source": "真珠の首飾り",
                "author": "ZHEMCHUZHNOE OZHERELJE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「火鉢に、火がとってあるから、おあたんなさい。",
              "citation": {
                "source": "ある日の先生と子供",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "若者はだれかと思って見ると、人のよいおじいさんなものですから、「こんにちは、いいお天気ですの、風が寒いから火におあたんなさい。",
              "citation": {
                "source": "いいおじいさんの話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「へえ、まあたんとお読みな」――カテリーナ・リヴォーヴナはぽつりと言ったが、冷やかな眼ざしで部屋のなかを見まわしながら、やがて霜の絵模様がべったり附いている窓に視線をとめた。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それじゃまあたんと飲んでから後の事にしよう」と三沢は彼の前にある盃をぐっと干して、それを女の前に突き出した。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "お徳を蹴るのは私へ面当、さあさあたんと蹴られませう』　　　その七　紅塵万丈の都門の中にも、武蔵野の俤のこる四ツ谷練兵場、兵隊屋敷をずつと離れて、権田原に近き草叢の中に、露宿せし一人の書生。",
              "citation": {
                "source": "誰が罪",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいよ」重吉は眼をそらした、「自分でいって飲んで来る、おまえ遊びにゆかないのか」「いかない」とお芳は云った、「たんの番をしていなって、帰るまで番してなって、かあたんが云ったんだもんさ」　重吉は立って勝手へゆき、水瓶からじかに柄杓で三杯水を飲んだ。",
              "citation": {
                "source": "ちゃん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまんまごとになれば、かあたんになるのはお芳ときまっていて、おたつはその娘、亀吉は「手のかかってしゃのない伜」ということになる。",
              "citation": {
                "source": "ちゃん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでふしぎにうまくゆくし、お芳のかあたんぶりも板についていた。",
              "citation": {
                "source": "ちゃん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあまあたんと己をお欺し………」と、そんな風に男は大腹中に構えて、云わば子供を嬉しがらせるような気持で、わざとその手に乗ってやります。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああたん、んめよう、んめよう」　幼児はこういって嬢のほうへよちよちと近寄ってゆき、べたべたの手でその肩へ掴みかかった。",
              "citation": {
                "source": "百足ちがい",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゆきこんこいいね、ゆきこんこ、ああたんゆきこんこいいね」　おせんは幸福な気持だった。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
