  {
    "uuid": "c830c650-b7f9-55b9-8ca8-71bb8a61ed83",
    "entry": "草裏",
    "reading": {
      "primary": "そうり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "手探りに草裏を突かけて、表裏の入口を開けると、厩では乾秣を欲しがる馬の、羽目板を蹴る音がゴト／＼と鳴る。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツイデに起きちまひ、ペラ十枚書いて、漸く四十枚にまとめて「浅草裏おもて」として届けさせる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜すんでから「かっぽれ」の稽古があったが、スカして川口と二人で、浅草裏へ行き、いろ／＼懇談する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
      "synonyms": [],
      "antonyms": [],
      "related": []
    },
    "meta": {
