  {
    "uuid": "eed1cb40-365a-52d3-b25c-49ef16e8064d",
    "entry": "総集",
    "reading": {
      "primary": "そうしゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
