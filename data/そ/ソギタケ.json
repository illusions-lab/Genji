        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鋭利な削竹が節元まで深く咽喉に差さっている。",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "削竹が咽喉に立っている。",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頬冠りに尻｜端折り、腰の辺りに削竹が五六本たばねられて差さっている。",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「白糸」「削竹」のこの二つは、当時大阪を横行していた一群の怪賊の合言葉であった。",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔名与力と謳われた二人がいかに年を取ったとは云え、刀を抜き合わせる暇もなくむざむざ削竹に咽喉を貫ぬかれ、惨殺されたということは、一面から云えば不覚ではあったが、他面彼等盗賊の群がいかに強いかということの新しい証拠ともなるのであって、有司にとっても市民にとっても恐ろしく思われたのは云うまでもない。",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子を貫いた削竹がお袖の喉に突立った。",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我と我喉を削竹で裏掻くまでに突き刺している。",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "削竹のようにトゲトゲと骨ばった顔をうつむけ、薄い唇をひきむすんで、むッつりと坐っている。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "丹頂の鶴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
