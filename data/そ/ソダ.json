  {
    "uuid": "0880a328-9b55-5c09-a1f6-9372eb81271a",
    "entry": "ソダ",
    "reading": {
      "primary": "そだ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "チイサイ　トキカラ、ヤマ　ノ　ケモノ　ヤ、トリタチ　ト、ナカヨク　アソンデ　ソダチマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ　コマッテ、ボク　ハ　ヤマニ　ソダッテ　オヨギ　ハ　シラナイ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ナタネノ　ツボミト　イツシヨニ　ソダツタ　テフテフデスカラ、ナタネノ　花タチトハ　タイヘン　ナカヨシデシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ　フトコロニ　コヒツジヲ　イレテ、「シカタガ　ナイカラ、コノ　コヒツジハ　オレガ　ソダテテ　ヤラウ」ト　ヒトリゴトヲ　イヒナガラ　ヤツテ　ユクウチ　トツプリ　ヒガ　クレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フン、眞ニソダチナハン。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "フン、真ニソダチナハン。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてイソダン郵便局の消印のある一通を忙わしく選り出して別にした。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにこのイソダンの消印のある手紙は、幸にもその暗示的作用を有する機会の一つであった。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分がイソダンで識っていた時は未亡人でいた美人である。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "イソダンの小さい客間である。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "――――――――――――――――――――　イソダン。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだもんですから、イソダンであなたの御交際なさることの出来ましたのは、御両親を存じていたわたくしだけでございましたわ。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな風にしていましたから、人の世話ばかり焼くイソダンの人達も、わたくしの所へあなたのいらっしゃるのをなんとも申さないで、あれは二親の交際した内だから尋ねて往くのだと申していましたのです。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしわたくしだけが知っている事を、イソダンの人達に皆知らせるのが厭になって、わたくしは羞恥の心から思い留まりました。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫は取引の旅行中にその女どもに逢っていますので、イソダンでは誰も知らずにいるのでございます。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのマドレエヌに逢ってみたらイソダンで感じたように楽しい疑懼に伴う熱烈な欲望が今一度味われはすまいか。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "この家なら、そっくりこのままイソダンに立っていたって、なんの不思議もあるまい。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのような種類の人、あなたのように智慧がおありになり、しっかりしておいでになって、そして様子のいいお方、そう云う人にイソダンでめったに出逢うことのないのは当り前でございます。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "イソダンでそうだと申すのではございません。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしはきのうからイソダンに帰っています。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "木を伐る音がこだまして、いよいよ森閑を加える趣の山林の中に、たった一人で精出して、手頃の木を伐っては、その太いところをマキにこしらえ、枝のところをソダにしている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソダごしらえですか」　与八がいう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンコルワット寺院のある所も釋迦如来の太子たりし時の妃の名前が付いて、ヤソダラプラ（耶蘇陀羅城）というのである。",
              "citation": {
                "source": "東洋文化史における仏教の地位",
                "author": "高楠順次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎では今でもソダを燃してイブされながら暖をとる。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬糞蕈　馬の糞や腐った藁に生える菌に馬糞蕈すなわちマグソダケというのがあって、マツタケ科のマツタケ亜科に属し Panaeolus fimicola Fries（＝Coprinarius fimicola Schroet.）の学名を有している。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和二十一年九月十一日に来訪した小石川植物園の松崎直枝君から、このマグソダケが食用になり、それがまたすこぶるうまいということをきいて私は大いに興味を感じた。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マハゼの要領で、ただ、地底が平場よりゴロタ石の間とかソダまわりでの数釣りだけに、針の返りのアゴを取ってやってみたが、思ったほどバレも少なかった。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころ、舟でなく歩いて行った釣り場を思い出してみると、今井橋終点下車で土手を右へ三丁ほど行った造船所の近所、船堀川の向こう岸の杭がらみ、ソダの枕床、また、浦安終点から肥料会社の側五、六丁のところ。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛇籠かソダへかかったのかと、道糸を手に取って引いてみると魚とは違う。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "この巻貝を漁夫はイソダマと呼んでいた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
