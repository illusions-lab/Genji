  {
    "uuid": "0064ef7d-c3da-584e-b93f-d188a2638005",
    "entry": "総轄",
    "reading": {
      "primary": "そうかつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "being in general control of",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はプロジェクトの進行を総轄する立場にあり、全責任を負っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "各部門の代表が集まり、全体の運営方針を総轄する委員会が設立された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "市長は市役所の全業務を総轄し、市民の生活向上に努めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "もっと純一な統合的な力によって総轄されているのだ。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "提調というは監督の下に総教習と聯び立つ学堂事務の総轄者であった。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸籍よ、役場という殿堂を総轄する輝ける神よ、われは汝に礼拝す。",
              "citation": {
                "source": "狂人日記",
                "author": "ギィ・ドゥ・モオパッサン　Guy de Maupassant",
                "note": "青空文庫"
              }
            },
            {
              "text": "弾左衛門は浅草に住し、頼朝公のお墨付というものを持ち伝え、徳川幕府ではこれを認めて、彼を関八州から、甲斐、駿河・伊豆及び奥州地方十二ヶ国のエタ頭とし、エタ非人を総轄せしめたのであった。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただその異なるは、一は法王これを総轄し、一は国主これを総轄するの点にあり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "この大中両本山を総轄するものは法王なり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかして、ロシアの宗教はロシア皇帝をいただき、これをして一宗総轄の権をとらしむ。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "俗人の勅任官を総轄して居る者はシャッベー（総理大臣）でこれも四人である。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
