[
  {
    "uuid": "c32c2ab4-5bd5-504f-a53e-a432298b532e",
    "entry": "総括",
    "reading": {
      "primary": "そうかつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
