        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "面白いことは横町の入口の両脇の角に「ユヤ」「床ヤ」と書いてある。",
              "citation": {
                "source": "子規の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この袋町への入口の両脇に「ユヤ」「床屋」としてある。",
              "citation": {
                "source": "子規自筆の根岸地図",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時の事情に従へば、少くとも、チユヤを生捕にすることは、絶対に、政府には必要だつた。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の漁夫に喚びかけて、香魚の釣れ高をきくと、それが大洲署長さんであつたなどのカリカチユヤもあつた。",
              "citation": {
                "source": "南予枇杷行",
                "author": "河東碧梧桐",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
