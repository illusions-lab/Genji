    "definitions": [
      {
        "index": 1,
        "gloss": "public bathhouse",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔ながらの湯屋で、近所の人たちと交流した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "銭湯のことを「湯屋」と呼ぶこともある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの湯屋の番台さんは、いつも笑顔だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "プリプリしながら、だがその晩は七時にはお湯屋に行き、目覚時計を四時に掛けて八時には床に這入つた。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　祖母が私を噛むやうに何時もの豆腐売と湯屋の亭主を並べた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "更くる夜　　内海誓一郎に毎晩々々、夜が更けると、近所の湯屋の　　水汲む音がきこえます。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "お湯屋の風呂に入って、風呂銭を払わない、煙草屋で、煙草を借りて、そのまゝ借りッぱなしである。",
              "citation": {
                "source": "鍬と鎌の五月",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "饂飩屋も、お湯屋も、煙草屋も、商売の一寸した手落ちにケチをつけられて罰金沙汰にせられるのが怖い。",
              "citation": {
                "source": "鍬と鎌の五月",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは手先の湯屋熊であった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "三「どうもその猫ばばあの死に様がちっと変じゃありませんかね」　湯屋熊の熊蔵はその晩すぐに神田の三河町へ行って、親分の半七のまえできょう聞き出して来た猫婆の一件を報告した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊蔵の家が湯屋であることは前にも云った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれの身分は知らねえでも、熊の野郎が湯屋のほかに商売をもっていることは知っているだろう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯屋の板の間もかせいだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう言えば湯屋はまだある。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、何処ともなく、柳に暗い、湯屋の硝子戸の奥深く、ドブンドブンと、ふと湯の煽ったような響が聞える。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　湯屋は郵便局の方へ背後になった。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "古本屋は、今日この平吉の家に来る時通った、確か、あの湯屋から四、五軒手前にあったと思う。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "横丁の銭湯屋の向いに、小さな店が一軒あって、そこを覗いてみたら、やはり客がいるような様子だったので、引き返しかけたら、主人が窓から首を出して、「すぐ出来ますよ。",
              "citation": {
                "source": "美少女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷町の湯屋で逢うたげな。",
              "citation": {
                "source": "三人の盲の話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯屋の聞いたのは（岡湯）なのである。",
              "citation": {
                "source": "春着",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "向う側の湯屋に柳がある。",
              "citation": {
                "source": "春着",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大川の方へその出つ端に、お湯屋の煙突が見えませう、何ういたして、あれが、霧もやの深い夜は、人をおびえさせたセメント會社の大煙突だから驚きますな。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこか近郊へ出たら、と近まはりで尋ねても、湯屋も床屋も、釣の話で、行々子などは對手にしない。",
              "citation": {
                "source": "木菟俗見",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯屋へはどうして入る？",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その日は霜が消えなかった――居周囲の細君女房連が、湯屋でも、髪結でもまだ風説を絶さぬ、お稲ちゃんと云った評判娘にそっくりなのであった。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯屋の遠いことや、買物の不便なことや、一々かぞえ立てたら色々あるので、わたしもここまで引込んで来たのを悔むような気にもなったが、馴れたらどうにかなるだろうと思っているうちに、郊外にも四月の春が来て、庭にある桜の大木二本が満開になった。",
              "citation": {
                "source": "郊外生活の一年",
                "author": "大久保にて",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯屋が遠いので、自宅で風呂を焚くことにした。",
              "citation": {
                "source": "郊外生活の一年",
                "author": "大久保にて",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　湯屋　湯屋の二階というものは、明治十八、九年の頃まで残っていたと思う。",
              "citation": {
                "source": "思い出草",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしが毎日入浴する麹町四丁目の湯屋にも二階があって、若い小綺麗な姐さんが二、三人いた。",
              "citation": {
                "source": "思い出草",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し相手が武士であるから、迂闊に召捕るわけにも行かないので、手先ふたりは三河屋のせがれ善吉を同道して、次郎の屋敷の近所に網を張つてゐると、彼は湯屋へ行くらしく、手拭をさげて表へ出た。",
              "citation": {
                "source": "赤膏薬",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、敬二郎が二階の窓からたんを吐くと、路地を通っている銭湯屋の娘の顔に掛った。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでおたかと銭湯屋との仲は目立って仲がわるくなり、子供たちは二町も遠方の銭湯へ行った。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "池田の宿にてゆやが事をおもひ出しとき江戸の人に文つかはすことありしそのはしに。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "building with a bath (esp. in a shrine or temple)",
        "register": "standard",
        "nuance": null,
