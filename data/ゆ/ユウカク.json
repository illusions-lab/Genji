        "examples": {
          "standard": [
            {
              "text": "山奥にひっそりと咲く幽客は、見る者を魅了する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "幽客の香りは、あたり一面に広がり、心を落ち着かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "日本の伝統的な庭園には、幽客がよく植えられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 2,
        "gloss": "hermit",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
