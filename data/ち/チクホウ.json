[
  {
    "uuid": "72bb3495-6b15-51f3-98b9-f3c457984c6d",
    "entry": "築法",
    "reading": {
      "primary": "ちくほう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
