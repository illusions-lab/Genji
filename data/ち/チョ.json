[
  {
    "uuid": "c9ba6846-e7a3-534a-a1fa-8d4833725d1d",
    "entry": "著",
    "reading": {
      "primary": "ちょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
