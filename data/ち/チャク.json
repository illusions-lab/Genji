  {
    "uuid": "52b796f1-895b-5c96-8264-8f0783cc8763",
    "entry": "チャク",
    "reading": {
      "primary": "ちゃく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「そこでそのケイザイやゴラクが悪くなるというと、不平を生じてブンレツを起こすというケッカにホウチャクするね。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に、危い二人を救けて、　家臣共を尽く川へ投げ込み、又は打ちのめし、最後にお殿様をチャチャクチャに叩き付けてフラフラになったお殿様の首筋掴んで、Ｔ「仇討の熱病　患者奴！",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "土足のままといっても、しかし、何でもかでも横紙を破り、破目を外し、メチャクチャになれというわけではない。",
              "citation": {
                "source": "土足のままの文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "すくなくとも私は小説を書くために、自分をメチャクチャにしてしまった。",
              "citation": {
                "source": "私の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪趣味というより、まるでメチャクチャだった。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "店仕舞いメチャクチャ大投売りの二日間の売上げ百円余りと、権利を売った金百二十円と、合わせて二百二十円余りの金で問屋の払いやあちこちの支払いを済ませると、しかし十円も残らなかった。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「縄張のあります処から、ここぞともはや面を装い、チャクと黒鬼に構えました。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「顔クチャクチャにして、ゴーンと床に頭付けて笑わすんやから、王道やない」という。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に気立てのいい編集者が、メッチャクチャに人の原稿を変えるのだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯が済んでから、お作が台所へ出ていると、新吉とお国が火鉢に差し向いでベチャクチャと何か話していた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "うるさい、とにかく、こいよ」「メチャクチャじゃない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "中間試験とちがって、先生は採点でムチャクチャにいそがしいから、高志のいうように「生徒の相手なんかしてられない」ことになる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わかんないよ、日本の会社はメチャクチャだから」「ヤードバーズの〈オーヴァー・アンダー・サイドウェイズ・ダウン〉だの、スタンデルズの〈ダーティー・ウォーター〉だの、騒々しい曲ばっかじゃねえか」　三日後に、ワラがアメリカへ帰る。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でもさ、ギター、メッチャクッチャうまいよ」「ギターのうまいへたは、関係ないだろうに」　高志はソファから立ちあがり、ステレオのところへいく。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "躰は慶一よりひとまわり大きいくらいだが、相撲がムチャクチャに強い。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は少しも驚かず懐中から紙袋を出してパンにムチャクチャに噛りついた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ批評家は闘牛師が赤いマントをふりさへすれば、飛びついてゆく牛のやうな、ムチャクチャな単純な頭をもつた批評家といふべきだらう。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "手にふれるものがみんな燃えちまふわわあ　みんなすごい熱だ○あの病気はつまりペチャ　クシャうむ、それでペチャ　ペチャそれだから　ペチャクシャどうも大ぶ病気が重いのぢや○あれつ？",
              "citation": {
                "source": "小熊秀雄全集−22",
                "author": "火星探検―漫画台本",
                "note": "青空文庫"
              }
            },
            {
              "text": "リエの生命を自分のものとしたい不逞なメチャクチャな願いから、アドルムと酒に酔い、一日、兇器をとりリエの下腹さえ刺した。",
              "citation": {
                "source": "さようなら",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思うと、雄吉は自分の感情で、河野の弱さを、メチャクチャに冷笑して居た自分が、不安にならずには居られなかった。",
              "citation": {
                "source": "神の如く弱し",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に京の人をまねて田舎にチャッチャムチャクなる語がはやり出したとはありそうな事で、高橋入道の討ち死にがこの辺で大抵の人に通用すると同例だから、俗語の根源と伝播は当身確かな記録があるにあらざれば正しく説き中る事すこぶる難い。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸教の諸尊にそれ／″＼名號が多いが、其名號がみなゴッチャクタに異名といふべきに非ず、種々の用途に隨つて各別の名號が使はれたといふ事の例示迄に、クベラも毘沙門も同一の神の名號乍ら、使用の場合、意味が差ふといふ事を述たのである。",
              "citation": {
                "source": "再び毘沙門に就て",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも日本人なんかがイクラ想像したって追付かない位、メチャクチャな発達を遂げているのですが、その中でも亦、特別｜誂えの天下無敵の話っていうのが、この崑崙茶の一件なのです。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "三等待合室へ張込んで、クチャクチャになった朝日の袋の中からモウ一本引出して美味い美味い煙を吸った。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サアサア、お父さんだよお父さんだよ」　と揺すり上げながら、思い切り頬ずりをしようとしましたが、その私のチョッキの上を、思いもかけぬ力強さでメチャクチャに蹴立てた赤ん坊は、又も焦げ付くように泣き藻掻き初めました。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは二個の丸い櫛が、私の頭の上に並んで、息も吐かれぬ程メチャクチャに駈けまわり初めたからであった……が……その気持ちのよかったこと……自分がキチガイだか、誰がキチガイだか、一寸の間にわからなくなってしまった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿呆メチャクチャ出鱈目放題。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
