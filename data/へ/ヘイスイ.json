[
  {
    "uuid": "abbdaf0b-0ffa-5ca9-b679-b961751aa1af",
    "entry": "平水",
    "reading": {
      "primary": "へいすい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
