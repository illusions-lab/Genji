          "literary": [
            {
              "text": "唯耶路撒冷を信じてゐる。",
              "citation": {
                "source": "浮浪学生の話",
                "author": "RECIT DU GOLIARD",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも耶路撒冷は遠い処だ、さうして主の君は、われわれのごとく傍にお出遊ばすのだ。",
              "citation": {
                "source": "浮浪学生の話",
                "author": "RECIT DU GOLIARD",
                "note": "青空文庫"
              }
            },
            {
              "text": "衆は耶路撒冷まで往かれまい。",
              "citation": {
                "source": "浮浪学生の話",
                "author": "RECIT DU GOLIARD",
                "note": "青空文庫"
              }
            },
            {
              "text": "耶路撒冷が衆のとこへ来るだらう。",
              "citation": {
                "source": "浮浪学生の話",
                "author": "RECIT DU GOLIARD",
                "note": "青空文庫"
              }
            },
            {
              "text": "――耶路撒冷へ行くのです、聖地を恢復に行くのです。",
              "citation": {
                "source": "癩病やみの話",
                "author": "RECIT DU LEPREUX",
                "note": "青空文庫"
              }
            },
            {
              "text": "――耶路撒冷つて何処だい。",
              "citation": {
                "source": "癩病やみの話",
                "author": "RECIT DU LEPREUX",
                "note": "青空文庫"
              }
            },
            {
              "text": "――耶路撒冷つて、一体、何だい。",
              "citation": {
                "source": "癩病やみの話",
                "author": "RECIT DU LEPREUX",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
