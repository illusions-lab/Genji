        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お勢が、恨み深げな眼を、くわっと宙に※いて、床のうえで冷たく縡切れていたのである。",
              "citation": {
                "source": "地虫",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠居一人が胸に秘めて、五十年来誰にも洩さなかった秘密が、ここに初めて露見したので、孫の隼人を初め江原も縡の不思議に驚いて、この上は唯｜一図に嘘だとか馬鹿馬鹿しいとか云消して了う訳には往かぬ。",
              "citation": {
                "source": "お住の霊",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚いて其の手足を検めると、既に数時間の前に縡切れたらしい、老人の肉も血も全く冷えていた。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その二、三日前に先生の処へ行てチャント様子を知て居るのに、急病とは何事であろうと、取るものも取敢えず即刻宅を駈出して、その時分には人力車も何もありはしないから、新銭座から下谷まで駈詰で緒方の内に飛込んだ所が、もう縡切れて仕舞た跡。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝室にはＡ老人が冷たくなって既に縡切れていた。",
              "citation": {
                "source": "緑衣の女",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那様が縡切れておいでだ」扉を内側から開けて、下男たちがいった。",
              "citation": {
                "source": "什器破壊業事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "早速、かゝりつけの太田医学博士が駆けつけて来たが、死後既に十二時間位経過して、昨夜の十時前後にもう縡切れているので、いかんとも仕方がなかった。",
              "citation": {
                "source": "黄鳥の嘆き",
                "author": "――二川家殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "即座に縡切れたので、むろん、姓名も住所も分らなかった。",
              "citation": {
                "source": "黄鳥の嘆き",
                "author": "――二川家殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっかり縡切れている」　八太郎の急報で飛んで来た町の寺本医師は死体を一眼見ていった。",
              "citation": {
                "source": "青服の男",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜あんなに元気だった博士は、もうすっかり血の気を失って、半眼を見開き、口を歪めて、蒲団から上半身を現わしながら、強直して縡切れていた。",
              "citation": {
                "source": "血液型殺人事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし老人は枕の上に俯伏せになって、はや縡切れていた。",
              "citation": {
                "source": "自責",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "召使が駆けつけたときは、二人は仰のけに倒れて縡切れていた。",
              "citation": {
                "source": "誤診",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "打倒れた途端に、斬られた右の肩先から、ほとんど全身の血を土に飲ませてしまい、道庵先生の羽織一枚は、グチャグチャになってしまい、みるみる、そのさむらいの面は蝋のように変じて、道庵に抱えられながら、虫の息が、ついに断末魔の息となり、やがて眠るが如く縡切れてしまいました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "小名路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "神父は彼がまだ生きてゐると思つてゐて声をかけたが、二度呼んで、縡切れてゐることが分つた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "つゞいてアンデレヤ二右衛門、マチヤス孫兵衛、マチヤス太郎右衛門が順次に息絶えて、神父はすべての信徒たちが縡切れるのを見とどけた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "血の痕を辿って見ると、いちど土蔵の扉のところまで這って行って土扉に手をかけたが、力つきてまた蒲団のところまで戻ってきてここで縡れたのらしい。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "永代経",
                "note": "青空文庫"
              }
            },
            {
              "text": "匕首かなんかで一突きに刳られ、あッと叫ぶ間もなく縡れたのにちがいない。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "山王祭の大象",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに手足に痙攣が来て、吃逆をするような真似をひとつすると、それで縡れてしまった。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "長崎ものがたり",
                "note": "青空文庫"
              }
            },
            {
              "text": "９．喉がかすかにゴロゴロと鳴つたかと思ふと、それで彼は縡切れてしまつた。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピストルの丸は前額に深く這入っていたがまだ縡切れてはいなかった。",
              "citation": {
                "source": "子規居士と余",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "縡切れる數時間前お金や子供は寢臺を圍繞して暖い涙を灑ぎ掛けた。",
              "citation": {
                "source": "續俳諧師",
                "author": "――文太郎の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "手前の八畳に床を敷いて寝ていた主人の重三郎は、頸のあたりを一と突きにやられ、床から抜け出し加減に血潮の中に縡切れ、境の唐紙を開けた次の長四畳には、薄暗い中に据えられた不動明王の木像が、赫怒の面相物凄く、ジッとそれを見下ろしているのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "仏敵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツイ三四間先には死骸が一つ、中年者の武家姿ですが、右手を柄頭に掛けたまま、大袈裟に斬られて、縡切れております。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "辻斬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何だ何だ」「何を騒ぐんだ」　ドカドカ雪崩込んだ子分たち、親分溝口屋鐘五郎が、紅に染んで縡切れた姿を見ると、さすがに乱酔の酒もさめてしまいます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "鐘五郎の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツイ三四間先には死骸が一つ、中年者の武家姿ですが、右手を柄頭に掛けたまゝ、大袈裟に斬られて、縡切れてをります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "辻斬",
                "note": "青空文庫"
              }
            },
            {
              "text": "手前の八疊に床を敷いて寢てゐた主人の重三郎は、頸のあたりを一と突きにやられ、床から拔け出し加減に血潮の中に縡切れ、境の唐紙を開けた次の長四疊には、薄暗い中に据ゑられた不動明王の木像が、嚇怒の面相物凄く、ヂツとそれを見下ろしてゐるのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "佛敵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何んだ／＼」「何を騷ぐんだ」　ドカドカ雪崩込んだ子分達、親分溝口屋鐘五郎が、紅に染んで縡切れた姿を見ると、さすがに亂醉の酒もさめてしまひます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鐘五郎の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "側へ寄つてよく見ると、首に細引を卷いて縡れて居たと言ふぢやありませんか」「時刻は？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "心中崩れ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は顔の前に垂れ下った長い髪の毛を振り乱して、ウーンとのけぞったが、そのまま縡れて、パッタリうしろに倒れてしまった。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
