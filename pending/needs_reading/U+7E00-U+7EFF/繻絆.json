        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その一つに繻絆一枚で腰掛けて老人の読んでゐた新聞に、三十何年とか撒水車を挽いてゐるといふ男の笑つて汗を拭いてゐる写真が通りがかりに見えた。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "剣道場の入口から、時々水を飲みに、剣道用の繻絆姿で現れるのは生徒だが、それは選手だから暑中休暇も帰省しないで道場にゐるといふわけである。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "繻絆の前をハダけて、靴をツツかけて水を飲みにゆく。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "メリヤス繻絆股引金二両二朱。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の衣物は相變らず雨に笹の白縮みだが、帶だけは換はつて、牡丹色の繻子と青みがかつた綿繻珍らしいものとの腹合はせになつて、帶あげは繻絆の袖と同じとき色のメリンスだ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "三千代は手拭を姉さん被りにして、友禅の長繻絆をさらりと出して、襷がけで荷物の世話を焼いてゐた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍に大きな行李が開けてあつて、中から奇麗な長繻絆の袖が半分出かかつてゐた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "平岡が、失敬だが鳥渡待つて呉れと云つた間に、代助は行李と長繻絆と、時々行李の中へ落ちる繊い手とを見てゐた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "繻絆にすると可い」「うん、面倒だから着てゐるが」「洗濯をするから御｜脱ぎなさいと云つても、中々脱がないのよ」「いや、もう脱ぐ、己も少々｜厭になつた」　話は死んだ小供の事をとう／＼離れて仕舞つた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は白地の絣の下に、丁重に白い繻絆を重ねて、紺足袋を穿いてゐた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば私は新しい更紗模様の長｜繻絆一つになってビッショリと汗をかいている。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "未亡人も友禅模様の長繻絆をしどけなく着て私の枕元に横坐りをしている。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……しどけない長繻絆の裾と、解けかかった伊達巻と、それからしなやかにわなないている黒い革の鞭と……私は驚いてうしろ手を突いたまま石のように固くなった。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一丈五尺以上あるんだから、帯の片側と繻絆の袖位は楽に取れる。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまで繻絆というものを着た事のない私が、シャツの上に黒い襟のかかったものを重ねるようになったのはこの時からであった。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次はどうするかと思うと主人の紬の上着を大風呂敷のように拡げてこれに細君の帯と主人の羽織と繻絆とその他あらゆる雑物を奇麗に畳んでくるみ込む。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、店を畳んだ金で、その頃十七、八円もする縮緬の長繻絆や帯や洋傘などを買ってやった。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "依て衣服は精々清潔に心懸、殊に膚着繻絆は度々洗濯して着替るを良しとす。",
              "citation": {
                "source": "養生の心得",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "白のフラネル繻絆は最もよし。",
              "citation": {
                "source": "養生の心得",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふぞくした繻絆でも、下布でも、みんな堅長、横長、角型であるから、たち屑も出ないが、裁ち、縫ふのが樂であると共に、着るのも樂だ。",
              "citation": {
                "source": "きもの",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡緑色の無地の繻絆の襟から、痩せてるわりに肉のむっちりした真白い頸筋を伸べて、周平の方へ微笑みかけた。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "繻絆や襯衣や足袋や……そんなものまで、こうしてああしてと考えといたのよ。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "お帯も上下、二通り、お長繻絆や、なにやかと、さしづめ遁れぬ御用のものは、揃えてあげまするやうと。",
              "citation": {
                "source": "したゆく水",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "絽縮緬の羽織に絽の繻絆をつけ候。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（安つぽい赤の長繻絆を見せ半ば肌脱ぎになつて、鏡台に向つて化粧しながら）――私なんざ、お上手でゐらつしやるからね、沢ちやん見たいにへまはしないのよ――一体あんたは、お客に少し親切過ぎるのよ。",
              "citation": {
                "source": "疵だらけのお秋（四幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
