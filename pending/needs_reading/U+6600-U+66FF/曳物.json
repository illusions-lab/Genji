        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ほかに、附祭といって、踊屋台、練物、曳物数さえつばらに知れぬほど。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "山王祭の大象",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎年の猿の山車のほかに、年番附祭の例にならい、朝鮮人来朝の練物と、小山のような大きな白象の曳物を出すというので、これが江戸中の大評判。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "山王祭の大象",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、いよいよ象の曳物。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "山王祭の大象",
                "note": "青空文庫"
              }
            },
            {
              "text": "曳物の先達が飛んでくる。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "山王祭の大象",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋台車といっしょにお曲輪内へはいったが、そのうちに、麹町の象の曳物の胸から血が出たという噂が、誰の口からともなく風のように伝わってきた。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "山王祭の大象",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭礼の象の曳物の腹の中に万という小判が隠してあるとは誰も気がつかない。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "山王祭の大象",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
