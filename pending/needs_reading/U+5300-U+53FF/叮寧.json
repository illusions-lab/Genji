          "literary": [
            {
              "text": "三造は物が叮寧である、叮寧すぎさへする。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あゝ、三造は叮寧である。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あゝ、三造は叮寧になる。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　ははは、そんなに叮寧に訊かれちや、何にも言へなくなる。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」おしかは殊更叮寧な言葉を使った。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女事務員が為吉にだけは親切だったように、園子は両人に対して殊更叮寧だった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし両人は気が張って親しみ難かった叮寧さが、嫁の本当の心から出ているものとは受け取れなかった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小十郎は半分辞退するけれども結局台所のとこへ引っぱられてってまた叮寧な挨拶をしている。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカゴの技師ははんけちで叮寧に口を拭ってから又云いました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ちついて祭壇に立ってそれから叮寧にさっきのマットン博士に会釈しました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネネムはよろこんで叮寧におじぎをして先生の処から一足退きますと先生が低く、「もう藁のオムレツが出来あがった頃だな。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとそのばけものは、ひどく叮寧におじぎをして、「ええ。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云って又叮寧におじぎをしました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と叮寧に云うものですから、その通り一足中へはいりましたら、全く愕いてしまいました。",
              "citation": {
                "source": "茨海小学校",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私も叮寧に云ひました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの人もどの人もみんな叮寧におじぎをしました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その風に半分声をとられながら、ガドルフは叮寧に云いました。",
              "citation": {
                "source": "ガドルフの百合",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "車掌が手を出しているもんですから何でも構わない、やっちまえと思って渡しましたら、車掌はまっすぐに立ち直って叮寧にそれを開いて見ていました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "助手は囲いの出口をあけごく叮寧に云ったのだ。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "運動も毎日叮寧に、十五分ずつやらしています。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "車掌が手を出してゐるもんですから何でも構はない、やっちまへと思って渡しましたら、車掌はまっすぐに立ち直って叮寧にそれを開いて見てゐました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "臙脂屋は涙を収めて福々爺に還り、叮寧に頭を下げて、「堺、臙脂屋隠居にござりまする。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所から、料理が持ち込まれると、耳の遠い婆さんが、やがて一々｜叮寧に拭いた膳の上に並べて、それから見事な蝦や蛤を盛った、竹の色の青々した引物の籠をも、ズラリと茶の室へならべた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と兄貴は大きい掌に猪口を載せて、莫迦叮寧なお辞儀をして、新吉に差した。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と低声に言って風呂敷を出して、自分で叮寧に包んだ、虚栄も人前もない様子が、何となく頼もしいような気もした。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と叮寧な口を利く。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "新吉が歳暮の砂糖袋と、年玉の手拭とを一緒に断わって出すと、それにも二、三度叮寧にお辞儀をした。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくすると、嫂も裏から上って来て、これも莫迦叮寧に挨拶した。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
