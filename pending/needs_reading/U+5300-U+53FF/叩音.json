          "literary": [
            {
              "text": "クイナらしい叩音もしばしば半夜の夢に入った。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時｜扉の外で叩音が聞こえる。",
              "citation": {
                "source": "探偵戯曲　仮面の男",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾は手真似で合図をして女中を下へかえし、それからまた書斎の扉まで引き返して、こんこんと二つ形式的に叩音して扉をあけた。",
              "citation": {
                "source": "オパール色の手紙",
                "author": "――ある女の日記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "又もや気味の悪い叩音が聞える。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "七啄木鳥――軽井沢で、ロッヂを叩音した禽。",
              "citation": {
                "source": "独楽",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "一向、出てこない栗鼠に、業を煮やして、やけに叩音してゐるのだ。",
              "citation": {
                "source": "独楽",
                "author": "高祖保",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
