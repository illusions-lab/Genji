          "literary": [
            {
              "text": "茎立ちをクモジといった類とも考えられるが、イモジは古くは鋳懸屋のことであった。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "副将軍の薩摩守忠度は紺地の錦の直垂に、黒糸縅の鎧、逞しき黒馬に鋳懸地の鞍置いて打ちまたがった威風あたりを払う姿は、都でも大層な見物という評判であった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第五巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "莖立ちをクモジと謂つた類とも考へられるが、イモジは古くは鑄懸屋のことであつた。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
