        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その百八十一　蘭軒は此年文政十年十二月三日に影抄元板千金翼方に跋して、偶書の銓択に論及した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "是好事蔵家所銓択也。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "是正学蔵家所銓択也。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故に会社が校刻書目を銓択するときに、好事者の好に投ずるものが十の八九に居る。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
