          "literary": [
            {
              "text": "あの娘は阿米といいましてちょうど十八になりますが、親なしで、昨年の春まで麹町十五丁目辺で、旦那様、榎のお医者といって評判の漢方の先生、それが伯父御に当ります、その邸で世話になって育ちましたそうでございます。",
              "citation": {
                "source": "政談十二社",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人は沼田の人で、阿米利加に五年行っていたという画家であった。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人は沼田の人で、阿米利加に五年行つてゐたといふ畫家であつた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "大分後になって、同じような仮説を出した学者が阿米利加にも前にあったことが分ったが、そんなことは別に問題にする必要はない。",
              "citation": {
                "source": "寺田先生の追憶",
                "author": "――大学卒業前後の思い出――",
                "note": "青空文庫"
              }
            }
          ]
        }
