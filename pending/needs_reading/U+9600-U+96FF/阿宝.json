        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その豪商に阿宝という女があって婿になる人を探していた。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、孫は細君を亡くして独身でいたが、悪戯者の一人がまたそれに目をつけて、「君は細君を亡くしているが、阿宝に結婚を申しこんではどうだね」　と言った。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿宝の父親は孫の名を聞いたが、あまり貧乏だからと思って躊躇した。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで媒の婆さんが父親の室を出て帰ろうとしていると、阿宝が出てきた。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿宝も孫の噂を聞いて知っていたので冗談にしてしまった。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一度、あの人を見ようと思ってるのじゃないかね」　孫も阿宝のことで自分をからかっているということを知っていたが、女からばかにせられているので、どんな女であるか一度見たいと思って喜んで随いて往った。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれはきっと阿宝だよ」　急いで往って見ると果して阿宝であった。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい魂が阿宝に随いて往ったのじゃないかい」　孫は考えこんだまま返事もしなかった。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "強いて体を叩いて、「おい、しっかりしろ、どうしたのだ」　といって訊くと、孫はぼんやりした声で、「俺は阿宝の家にいるのだ」　と言った。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめ孫は、阿宝の帰って往くのを見て、捨ててゆけない気になると共に、自分の体がそれに従いて往くのを感じた。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の者はひどく驚いて人を豪商の許へやって、そこで魂を招かしてくれと頼んだので、阿宝の父親は笑って言った。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふだん往復したことのない者が、なんで私の家へ魂を遺してゆこう」　孫の家の者はそれでも是非招かしてくれと頼んだので、阿宝の父親もやっと承諾した。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿宝はその事情を聞いてひどく駭き、他へ往かさずにすぐに自分の室へあげて魂を招かした。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで阿宝の室の鏡台はじめ什具の色合や名前を訊いてみると、すこしも違わなかった。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿宝はそのことを伝え聞いてますます駭くと共に、陰にその情の深いのに感じた。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "孫は既に病牀を離れたが、阿宝のことが忘れられないので、時とするとものを忘れた人のようになって考えこむことがあった。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしていつも阿宝の身辺に注意していて、もう一度逢ってみたいと思っていた。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月八日の灌仏会の日がきて、阿宝が水月寺へ参詣するということを聞いて、朝早く往って道中で待っていた。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "午ごろになって阿宝の車がやっと来た。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿宝は車の中から孫を見つけて、しんなりした手で簾を搴げて、目もはなさずに見つめた。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿宝はとうとう侍女に言いつけて孫に尋ねさした。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "孫はそこでやっと帰ってきたが帰るとまた病気になって、精神が朦朧となり、食事もせずに夢中になって阿宝の名を呼んだ。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、体がひらりと鸚鵡になって、不意に飛びあがりそのまますぐに阿宝の所へ往った。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿宝は入ってきた鸚鵡を見て喜んでつかまえ、肘に鎖をつけて麻の実を餌にやった。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お嬢さん、鎖をつけちゃ駄目です、僕は孫子楚ですよ」　阿宝はひどく駭いて鎖を解いた。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕は、あなたの側にいられるなら、本望だ」　他の人が餌をやっても食わなかったが、阿宝がやれば食った。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、阿宝が坐るとその膝の上に止まり、寝るとその榻に止まった。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿宝はそれがひどく気の毒になって、陰に人をやって孫の家の容子を見さした。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿宝はそこで言った。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
