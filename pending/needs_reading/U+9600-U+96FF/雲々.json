          "literary": [
            {
              "text": "私は他の雲々を見た。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "空の雲々が銀碧色にかがやき出した。",
              "citation": {
                "source": "作男・ゴーの名誉",
                "author": "THE HONOUR OF ISRAEL GOW",
                "note": "青空文庫"
              }
            },
            {
              "text": "恰も行雲々裡に輝く、太白星の如し。",
              "citation": {
                "source": "釣好隠居の懺悔",
                "author": "石井研堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "反乱と蜂起と同盟罷工の群集、一つが他を誘う雲霞のような進出、あらゆる雲々、大建築、橋、道路、停車場、一切の広場と十字街が宮殿が、彼等によって支持され動かされ、運ばれ、遥か彼方、未知の世紀の方に向って移動させられて行くように見える。",
              "citation": {
                "source": "騒擾の上に",
                "author": "百田宗治",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、顳※を薫り佳き桃金嬢もて飾り付け、さて軽々と私を空に連れ去つた彼女らは雲々の間を抜けて、薔薇の葉に仮睡みゐたりし私を運び、風神は、そが息吹きもてゆるやかに、我がささやかな寝台をあやした。",
              "citation": {
                "source": "ランボオ詩集≪学校時代の詩≫",
                "author": "VERS DE COLLEGE",
                "note": "青空文庫"
              }
            }
          ]
        }
