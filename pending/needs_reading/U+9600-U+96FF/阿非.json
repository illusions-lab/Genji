          "literary": [
            {
              "text": "バートンの『東｜阿非利加初入記』五章にエーサ人の牛畜各名あり。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇六年板ワーナーの『英領中｜阿非利加土人』には好んで鼠を食うが婦女や奉牲者に食うを禁ずとあり。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼き食うて珍重さる（シュワインフルトの『阿非利加の心』十六章）。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に転じて阿非汗から印度の方へ及ぼした。",
              "citation": {
                "source": "東亜の平和を論ず",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            }
