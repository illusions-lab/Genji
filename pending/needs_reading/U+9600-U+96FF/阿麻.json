        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それにもうそろそろと肥育をやってもよかろうな、毎日｜阿麻仁を少しずつやって置いて呉れないか。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "折角のその阿麻仁も、どうもうまく咽喉を通らなかった。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが次の日のこと、畜産学の教師が又やって来て例の、水色の上着を着た、顔の赤い助手といつものするどい眼付して、じっと豚の頭から、耳から背中から尻尾まで、まるでまるで食い込むように眺めてから、尖った指を一本立てて、「毎日｜阿麻仁をやってあるかね。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦のふすまを二升とね、阿麻仁を二合、それから玉蜀黍の粉を、五合を水でこねて、団子にこさえて一日に、二度か三度ぐらいに分けて、肥育器にかけて呉れ給え。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからだって毎日麦のふすま二升阿麻仁二合と玉蜀黍の、粉五合ずつやるんだぞ、さあいい加減に判をつけ、さあつかないか。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「夷人雜類とは、毛人、肥人、阿麻美人等の類を云ふなり。",
              "citation": {
                "source": "蝦夷とコロボツクルとの異同を論ず之に潜みて",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「越多の種落之を阿麻別と謂ふ。",
              "citation": {
                "source": "エタ源流考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "天地初發之時、於高天原成神名、天之御中主神、訓高下天云阿麻、下效此。",
              "citation": {
                "source": "古事記",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬琴の『弓張月』にまで書かれている勝連按司の阿麻和利は、沖縄の歴史の上で、すっかり悪者にされてしまっているが、これは伊波普猷君などが早くから注意したように、勝敗｜処をかえれば忠臣とも逆臣ともなった戦国の世の習いであった。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
