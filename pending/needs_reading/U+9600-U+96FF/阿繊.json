        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「これが家の阿繊だ。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして近くへいってみると、どうもその女が阿繊に似ているように思われた。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿繊ももう、あなたの家の婦になっておる。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで別邸を老婆の住居にして、吉日を択んで三郎と阿繊を結婚さしたが、老婆は阿繊に嫁入り仕度を十分にした。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿繊は寡言で怒るようなこともすくなかった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがために上の者も下の者も皆阿繊を可愛がった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿繊は三郎に頼んでいった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　山はますます不思議に思って、家へ帰って両親にそっと話し、どうも阿繊は人であるまいと思って、三郎のために心配したが、三郎は初めとすこしもかわらずに阿繊を愛した。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫くして家の中の人の心がちぐはぐになって阿繊をうたがいだした。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿繊はかすかにそれを察して、夜、三郎に話した。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そういって阿繊は泣いた。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　三郎は一生懸命になってなだめたので、阿繊もそれからは何もいわなかったが、山はどうしても釈けなかった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿繊は懼れはしなかったが面白くない顔をしていた。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある夜、阿繊は老婆のぐあいが悪いからといって、三郎に暇をもらって看病にいったので、夜明けに三郎がいってみた。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "老婆の室は空になって老婆も阿繊もいなかった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "三郎はひどくいやがって一年あまり阿繊のたよりを待っていたが、とうとうそのたよりがなかった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "三郎は山や両親からせめられるので、しかたなしに多くの金を出して妾を買ったが、阿繊を思う心は衰えなかった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで家の者が、皆阿繊を思いだした。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　嵐が扉の隙から窺いてみると果して阿繊であった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "嵐が入っていくと、阿繊はひとりみの苦しさを訴えた。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿繊は悲しそうにいった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "三郎は昼夜兼行でいって阿繊に逢った。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋主の謝監という男は、阿繊の美しいのを見て、妾にしようと思って、初めから家賃を取らずに置いて、頻りに老婆にほのめかしたが、老婆はことわっていた。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると阿繊はいった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこで阿繊は謝のことを話した。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿繊は自分の金を出して、たくさんの倉を建てさせた。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿繊は両親を自分の家へ呼んで養い、兄の山にも金や粟をやってたすけたが、それがなれて常のこととなった。",
              "citation": {
                "source": "阿繊",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
