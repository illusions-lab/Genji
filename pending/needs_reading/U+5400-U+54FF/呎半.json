          "literary": [
            {
              "text": "彼は慥かに六｜呎半より短かいことはなさそうだった。",
              "citation": {
                "source": "グロリア・スコット号",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "「死体の謎も、六｜呎と三呎半の差をいかに除くかによって解決されるんだ。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "王鮭は、ほかの三君が二｜呎半からせいぜい三呎どまりなのに、長さは四呎半、胴廻りすら一呎半もあって、王というより化物というほうがいいような雄大なやつだ。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "四呎半氏がアメリカで鼻曲りが日本だとすると、銀鮭はまず日系米人というところかね。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
