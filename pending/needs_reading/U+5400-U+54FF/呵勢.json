          "literary": [
            {
              "text": "私の「ゾイラス」は、三日三晩の不眠不休の揚句、一気呵勢に完成された。",
              "citation": {
                "source": "ゾイラス",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペンを執りさへすれば半分も何もない何時からでも一気呵勢に書き綴れると思つてゐた。",
              "citation": {
                "source": "雪景色",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」も「……一気呵勢！",
              "citation": {
                "source": "雪景色",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＡとＢでは、出入の別荘から手おしポンプをかりて来て、一気呵勢に池の水を干してしまはうといふ相談が一決した。",
              "citation": {
                "source": "雪景色",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
