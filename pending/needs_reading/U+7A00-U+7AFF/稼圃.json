        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "江稼圃、芸閣の兄弟は清商中善詩善画を以て聞えてゐたと云ふ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "来舶清人｜稼圃江大来に学び、親しく其法を伝ふ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは猶此に梅泉の画を江稼圃に学んだ年に就いて附記して置きたい。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "稼圃が来り航した時、恐くは多く居諸を過すことなく従学したであらう。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "田能村竹田の山中人饒舌に「己巳歳江大来稼圃者至」と書してある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅泉は恐くは文化六年に二十四歳で稼圃の門人となつたのであらう。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは稼圃の長崎に来たのを聞いて直に入門したと云ふ人の言を伝へたものである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅泉の市河米庵に与ふる書、並に大田南畝の長崎にあつて人に与へた書に拠れば、稼圃が初度の来航は文化元年甲子の冬であつたさうである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋舎の名は吟香館で、江稼圃と大田南畝との題※が現に野口孝太郎さんの許に存してゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋琴も亦、木下逸雲、僧鉄翁と同じく、江稼圃の門人であつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
