        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは深窗にゐようと、路上にゐようとおんなしである。",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し凝る氣で從事するものは、其の絹紙筆墨を費すや甚大甚夥なるも、畢に繋がれたる馬の一つの柱を遶り、籠められたる猿の六つの窗に忙しげなると同樣に、何の進境をも示さぬものである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は猿蓑の　　　たゝらの雲のまだ赤き空　　　　　去来　　　一構｜鞦つくる窗のはな　　　　　　凡兆　　　枇杷の古葉に木芽もえたつ　　　　史邦を引いて此不調和を取りつくろつて下すつた。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾て七年の月日を小諸の山の上に送つたことのあるわたしが、東京への往き還りに、あの上州の山々を汽車の窗から望んだことも忘れがたい。",
              "citation": {
                "source": "伊香保土産",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともわたしは長年一日酔えるが如き自分の頭を疑つたが、狼の糞のあつた山や煙草車を駆つた道は、たしかにそこに蕩漾たる春のまぼろしの長酔極みなき紗窗の彼方に浮んでゐるのだ。",
              "citation": {
                "source": "湖の夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "15くもり日の顔に映る　大空の窗の薔薇の花。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七、六、二十二日　聞鐘　　　　　高青邱日暮遠鐘鳴　　山窗宿鳥驚楓橋孤泊處　　曾聽到船聲日暮れて遠寺の鐘ぞ鳴る窓近き山のねぐらの鳥すらもこころを動かせりむかし楓橋に船とめてひとり聴きにし鐘の声！",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その六　――放翁絶句十三首和訳（つけたり、雑詩七首）――",
                "note": "青空文庫"
              }
            },
            {
              "text": "憶去年今夜　　憶ふ去年の今夜、幽窗抱膝身　　幽窓膝を抱きし身。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "病骨支離難耐歩　　病骨支離歩に耐へがたし、間窗枕帙夢江南　　間窓帙を枕として江南を夢む。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月十三日夏涼茅屋階下雖不過三間、夏來而頗涼臥月吟詩草屋隈　　月に臥して詩を吟ず草屋の隈、北窗南、風に向つて開く。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "招涼北窗下　　涼を招く北窓のもと、不妨庭無池　　妨げず庭に池なきを。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "脚下の簪君に拾はせぬ窗には海の燐光の照る　海に臨むホテルのサロンで起つた極めて小さい出来事ではあるが、それが詩人に拾はれ不朽化されて音楽になる、さうするとこの歌になるのである。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして窗から首を出して海を見た。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝蔵の窗の明りの覚束な鳥羽の后の難阿含経　高野山のムゼウムの覚束ない照明をそしり、鳥羽院の皇后が難阿含経を手写し、高野に収めたものなども陳列されてゐるが、いかにも暗くて字体の鑑賞も出来ないと訴へるのである。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "思へらく千戸の封は得ずもあれ梅見ん窗を一つ持たまし　作者は私などに比すればその志は極めて大きかつた。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "窗鎖さで寐れど天城の頂と今さら何を語るべき我　昭和二年頃の歌。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱海ホテルに泊られ夏のこととて窗をささずに寐た。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も少し若かつたら窗から見える筈の大室山の頂きに対して或は心の丈を訴へたり不満を洩らしたりしたかも知れない。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯窗をあけたまま眠る許りである。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "長持の蓋の上にて物読めば倉の窗より秋風ぞ吹く　堺の駿河屋の土蔵の中で更科日記か何か取り出して読んでゐる町娘の姿が浮んで来た。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "事實二人の交情は或夜遲く父親のために彼女の寢室で密通の證據たる現場を發見されたがシリングはその時窗を破つて地上に飛び降り辛くも父親の復讐を逃れて一時事なきを得た。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　わたくしは三カ月ほど外へ出たことがなかったので、人力車から新橋の停車場に降り立った時、人から病人だと思われはせぬかと、その事がむやみに気まりがわるく、汽車に乗込んでからも、帽子を眉深にかぶり顔を窗の方へ外向けて、ろくろく父とも話をせずにいた。",
              "citation": {
                "source": "十六、七のころ",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨日四谷通夜店にて買ひたる梅もどき一株を窗外に植ゆ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "断膓亭窗外の樹木二三株倒れ摧かる。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "机に凭るに窗外尚残蛩の啼くを聞く。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "鵯毎朝窗外の梅もどきに群り来る。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "※辯天の縁日を歩み白瑞香一鉢を購ひ窗外に植ゆ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "断膓亭の小窗に映る樹影墨絵の如し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月に入りてよりは正午の頃影最鮮にて窗の障子一面さながら宗達が筆を見るが如し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "年改りて早くも半月近くなりたる此頃窗の樹影は昼過二時より三時頃最も鮮にして、四時を過ぎても猶消去らず。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
