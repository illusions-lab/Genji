          "literary": [
            {
              "text": "そしてそれを男の油断からだとは思はないで、自分に羽があるからだと穿違へる。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と叫んで、そつと司会者に訊くと、弁士が弔演説をしてゐる男は、今は課長に昇進して、亡くなつた男がその後釜に据つてゐたのを雄弁家がつい早飲込みにその男だと穿違へて了つたのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "通用しないかぎりあきらかにそれは穿違へである。",
              "citation": {
                "source": "「引札」のはなし",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、穿違へや物知らずはわらつてしまへばそれだけだが、婚礼料理の、「産めよ、殖せよ、み国のために」のあつかましさにいたつては義理にもわらつたゞけではすまされないのである。",
              "citation": {
                "source": "「引札」のはなし",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
