        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "客の方では珊珊を邪魔者にして、金を集めて窈娘という妖婦を購って焦生に献上した。",
              "citation": {
                "source": "虎媛",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "焦生は窈娘の愛に溺れて珊珊を顧なくなるとともに、政事も怠りだした。",
              "citation": {
                "source": "虎媛",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窈娘は焦生を自分の者にしたものの、珊珊が傍にいては邪魔になるのでそれをのけようとした。",
              "citation": {
                "source": "虎媛",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで窈娘は飲物の中へ毒を入れて待っていた。",
              "citation": {
                "source": "虎媛",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何も知らない焦生は、窈娘の室へ来て見ると、旨そうな酥酪があるので口にしようとした。",
              "citation": {
                "source": "虎媛",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窈娘は急いでその手をおさえた。",
              "citation": {
                "source": "虎媛",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すこし待ってください、どうもすこし怪しいことがありますから」　窈娘はその飲物を取って庭前に遊んでいる犬の前へ捨てた。",
              "citation": {
                "source": "虎媛",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窈娘はそれを珊珊の仕業だと言った。",
              "citation": {
                "source": "虎媛",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
