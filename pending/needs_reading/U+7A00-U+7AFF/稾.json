        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そは「チベリナ」學士會院（アカデミア、チベリナ）の演壇の、我が上りて詩稾を讀み、又即興詩を吟ずることを許しゝがためなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日我詩稾を閲し、評して水彩畫となし、ボルゲエゼ家の人々に謂ふやう。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "われはこれに退き入り、手に詩稾を把りて、爪甲の掌を穿たんばかりに握りたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "文房具を前に置かれた時、箕浦は、「甚だ見苦しゅうはございまするが」と挨拶して、腹稾の七絶を書いた。",
              "citation": {
                "source": "堺事件",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って、その遺稿集は、『斗南存稾』と題されている。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この『斗南存稾』を前にしながら、三造は、これを図書館へ持って行ったものか、どうかと頻りに躊躇している。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、軽い罪ほろぼしの気持で『斗南存稾』を大学と高等学校の図書館に納めることにした。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "渭南文集五十巻、剣南詩稾八十五巻、詩一万余首。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月二十八日放翁日夕親詩書、廣讀諸家之詩、然遂最愛劍南詩稾邂逅蠹書裡　　邂逅す蠹書の裡、詩人陸放翁　　詩人陸放翁。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしはかつて『夏の町』と題する拙稾に明治三十年の頃には両国橋の下流｜本所御船倉の岸に浮洲があって蘆荻のなお繁茂していたことを述べた。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "断膓亭襍稾出版についての用談なり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧稾つくりばなしを訂正して文明に寄す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "断膓亭襍稾表帋板下絵を描く。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "断膓亭襍稾印刷校正に忙殺せらる。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "断膓亭襍稾校正終了。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央公論社におかめ笹前半の草稾を渡す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "過日断膓亭襍稾を知友に贈呈す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "家に在りて午後より腕くらべ続篇の稾を起す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "花月第一号草稾大半執筆し得たり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "花月の原稾を整理す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻まで新福亭主人の草稾を待ちしが到着せざるを以て別に催促をなさず。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜花月第五号の原稾をつくる。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "心倦みつかれて草稾をつくる気力なし。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "燈下勉強して旧稾を校訂す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "小品文花火を脱稾したれば浄写す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜木曜会※員後藤春樹氏来り、某地方の新聞紙へ掲載すべき小説の草稾を需めて已まず。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸にして浮世絵に関する旧稾あるを思出し、取りまとめて江戸藝術論と題し、之を与ふ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "燈下臙脂を煮て原稾用罫紙を摺る。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正二三年の頃三田文学誌上に載せたる旧稾なり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "草稾後一回にて完結に至るを得べし。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
