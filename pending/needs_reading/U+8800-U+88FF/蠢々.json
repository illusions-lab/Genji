        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「私も秋へなり、蠢々とうごき出候而状ども認候、御内上様、おさよどのへ宜奉願上候、（中略）江戸は今年気候不順に御坐候よし、御病気いかゞ御案じ申候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "二等よりもより雑然たる諸相の中から、湧き出る、溢れ出る、転がり出る、飛び出る、それらの如く、蠢々として、哀々として、莞爾として、突兀として、二人三人五人の青年たちがむくりむくりと起き上って来た。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "蠢々として御玉杓子のごとく動いていたものは突然とこの底のない坑のうちに落ちて、浮世の表面から闇の裡に消えてしまった。",
              "citation": {
                "source": "趣味の遺伝",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇々たる石窟に蠢々として動き、食満々と与えざれば、身心｜※骨と衰えたり。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "逓信省内には、大学を出たての若い学士連が虫のやうに蠢々してゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "無数の蠢々たる生物ありて我等の胸間より発する燦爛の光に仰ぎ入れるあらむ。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "詳に人間生活の状態を観よ、蠢々※々として、何のおもしろみもなく、何のをかしみもなきに似たれど、其実は、個々特種の快楽を有し、人々異様の慰藉を領するなり。",
              "citation": {
                "source": "明治文学管見",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "此塊のある間は、何時まで立つても胸が晴れぬ、朝も昼も晩も夜も四六時中同じ所に同じ塊が蠢々として居る。",
              "citation": {
                "source": "厄年",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "病躯｜蠢々命、旦夕を測られざる者｜豈手を拱して四十歳を待たんや。",
              "citation": {
                "source": "病牀譫語",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "地の底とは思われない広い部屋に、大勢の黒い塊が累々と、また蠢々と、動きまわり、かたまり合っているところ、実に浮世離れのしたながめであった。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "地上の熱度漸く下降し草木漸く萠生し那辺箇辺の流潦中若干原素の偶然相抱合して蠢々然たる肉塊を造出し、日照し風乾かし耳目啓き手足動きて茲に乃ち人類なる者の初て成立せし以来、我日本の帝室は常に現在して一回も跡を斂めたることなし。",
              "citation": {
                "source": "文士としての兆民先生",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生曰く、『汝よく昼の※々として興き、蠢々として食するを知るのみ。",
              "citation": {
                "source": "通俗講義　霊魂不滅論",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
