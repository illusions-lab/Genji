          "literary": [
            {
              "text": "定て卿雲、市野、古庵様、服部、小山、市川あたり、日日｜聚話可有之、御羨敷奉存候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "直卿はなしにて聞けば、詩会連月打つづき、風流御境界之由羨敷奉存候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶山が「風流御境界之由羨敷奉存候」と云ふ所以である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
