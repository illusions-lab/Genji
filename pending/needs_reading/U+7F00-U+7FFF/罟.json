        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さりながら彼女も遂にサタンの罟に陥り、ヨブは全く孤独の人となった。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋し庖犠網罟の制に象どる。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "庖犠は伏羲氏なり、網罟を創めたるの人。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "碁の頭初の布局まことに網罟に似たり。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジサ女、年中何の月にも属せず、太陽天に停まって動かぬと信ぜらるる日を択び、身に罟を被ったのみ故、裸とも著衣とも言えぬ。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ一本引いて見たらば、第九十七凶といふので、その文句は霧罟重楼屋　　佳人水上行　　白雲帰去路　　不見月波澄といふのであつた。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
