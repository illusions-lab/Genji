          "literary": [
            {
              "text": "猜疑は次第に深くなり、忿恨は次第に盛んになった。",
              "citation": {
                "source": "魚玄機",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "青木淳が、烈しい忿恨を以て、ノートに書き付けた文句が、信一郎の心に、アリ／＼と甦つて来た。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "今に見ろ、どんなに白々しい夫人でも、血で書いた青木淳の忿恨の文字に接すると、屹度良心の苛責に打たれて、女らしい悲鳴を挙げる。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "青木淳が、烈しい忿恨を以て、ノートに書き付けた文句が、信一郎の心に、アリ／＼と甦って来た。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "人およそ忿恨、詈罵より人を傷け、人を害すべきことを誡む。",
              "citation": {
                "source": "教門論疑問",
                "author": "柏原孝章",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
