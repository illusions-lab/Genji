          "literary": [
            {
              "text": "五（四三九）　公山弗擾が、費に立てこもって叛いたとき、先師を招いた。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "」○　公山弗擾＝＝公山は氏、弗擾は名。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽虎は敗れて出奔したが、弗擾は費邑に拠つて叛いたのである。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　本章もまた、四三九章の公山弗擾の場合と同様、孔子に対する批難の材料になつている。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            }
          ]
        }
