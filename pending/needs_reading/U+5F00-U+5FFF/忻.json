        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "宵の酒宴の可笑しさよ娘が運ぶ瓶子よりもるる灯影にかしこまる左右の破顏を反り見て七兵衞獨り忻忻たり。",
              "citation": {
                "source": "煤掃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "万方　共に忻び躍りて、率土　元后を戴く。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "一軍は訳も無く忻喜雀躍した。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘉享　盛遇を忻び、尽瘁純誠を※す。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "病夫況復及衰躬、抃忻恩賜防冬服。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "うまく笑えず　Ｈ、Ａ、　西村、「二三度斯ういうことをくりかえして居るうちに、年をとってしまう人かな」涙をながす　若し再び生きてかえれるなら、自分は忻んで死ぬ、死んで、この苦しい境遇をかえ、新しい芽のように、新生涯をふみ出すだろう。",
              "citation": {
                "source": "「伸子」創作メモ（二）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、一つでも、未だ口に出して云われない彼の希望や要求を察して、仕とげたのを発見すると、ひどく忻んだ。",
              "citation": {
                "source": "心の河",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に君は、忻然として君じしんの意思・主観・個性の全部をポケットの奥ふかくしまいこむだろう。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "（七三）假令晏子にして在らば、余之が爲めに鞭を執ると雖も忻慕する所なり。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "管晏列傳第二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
