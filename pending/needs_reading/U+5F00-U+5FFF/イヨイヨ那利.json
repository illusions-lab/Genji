          "literary": [
            {
              "text": "古事記傳八彌彌、彌彌那利　　彌彌は天忍穗耳、神八井耳、手研耳などの耳と同じかるべし。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "彌彌那利は我が古書に其語見えず。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "但し紀の文にては鼻垂といへる賊と相并べて出でたれば、地方君長の尊稱とも見えざれども、傳説の混入多き古記には、彌彌那利の尊稱を種として、耳垂、鼻垂の説話を生出さずとも限らざれば、姑らく此に擧げて參考とするのみ。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
