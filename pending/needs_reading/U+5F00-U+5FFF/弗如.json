          "literary": [
            {
              "text": "孔子が子貢にいった語に、顔淵を賞して、「吾与汝、弗如也」といったのも、これがためであるといった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "といひ、之に對して孔子が、弗如也。",
              "citation": {
                "source": "支那史上の偉人（孔子と孔明）",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉起乃自知弗如田文。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "孫子呉起列傳第五",
                "note": "青空文庫"
              }
            }
          ]
        }
