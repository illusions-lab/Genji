          "literary": [
            {
              "text": "段が右徃左徃している。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "買物客が右徃左徃してゐる、農具や植木や瀬戸物が多い、合羽、竹籠がよく売れる、私はたゞ見て歩いた、買ふ金もなく買ふ気もない。",
              "citation": {
                "source": "行乞記",
                "author": "室積行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "裸坊――それは天神祭独特の、宮市名物――が右徃左徃する、しかし昔ほど盛んでない。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "山口まで歩いた、途中、湯田競馬見物、一競馬見たら嫌になつた、そこには我慾が右徃左徃してゐるばかりだ、馬券がとぶばかりだ、馬を鑑賞する、いや、賭そのものを味ふことすらないのだ、勝負事の卑しい醜い一面しかないのだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜も散歩、どてら姿が右徃左徃する。",
              "citation": {
                "source": "道中記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
