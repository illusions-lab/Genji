          "literary": [
            {
              "text": "我等が往方を塞ぎたるは、極めて卑き際の老若男女なりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "往方は遙なるに、禿げたる巖の面には麪包の木生ふることなし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐賀市を距る十数里、小城を通ぜる国道と会し、往方は坦かなること砥のごとく、しばらくにして牟田部をすぐ、ここも炭坑のあるところなり。",
              "citation": {
                "source": "松浦あがた",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨を折つて、河の岸に生茂つた樺や榛や「サツサフラス」の小枝を押し分け乍ら、岸に沿うて登つて行くに、樹々の枝に蔓を渡して、往方の途に網を張つた、野生の葡萄が、折々足に搦んで、その困難、実に昨日の比ではありませなんだ。",
              "citation": {
                "source": "新浦島",
                "author": "RIP VAN WINKLE. EINE NACHGELASSENE SCHRIFT VON DIETRICH KNICKERBOCKER.",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
