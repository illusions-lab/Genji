          "literary": [
            {
              "text": "士民皆束髮於頂（中略）其辮髮推髻胡服胡語胡姓一切禁止。",
              "citation": {
                "source": "支那人辮髮の歴史",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "故時衣横幅、結束相連而無縫、頭亦無冠、但垂髮於兩耳上。",
              "citation": {
                "source": "隋書倭國傳",
                "author": "魏徴",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人束髮於後、亦衣裙襦裳、皆有、竹爲梳、編草爲薦、雜皮爲表、縁以文皮。",
              "citation": {
                "source": "隋書倭國傳",
                "author": "魏徴",
                "note": "青空文庫"
              }
            }
          ]
        }
