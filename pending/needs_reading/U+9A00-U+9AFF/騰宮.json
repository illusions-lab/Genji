        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ああはれ足一騰宮とよ、行宮。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "足一騰宮は、行宮と　青の岩根に一柱坐す。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "足一騰宮に参出ると、　大わたの亀や、川のぼり来る。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "足一騰宮の大御饗、　誰が献る、はるか雲居に。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "足一騰宮は菟狭津彦、　朝さもらふ、夕さもらふ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "足一騰宮は湍の上や、　足一つ騰り、雲の辺に坐す。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その二月の端や、足一騰宮、一年や、筑紫の崗田の宮。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "足一騰宮は、行宮と青の岩根に一柱坐す。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "足一騰宮に參出ると、大わたの龜や、川のぼり來る。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "足一騰宮の大御饗、誰が獻る、はるか雲居に。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "足一騰宮は菟狹津彦、朝さもらふ、夕さもらふ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "足一騰宮は湍の上や、足一つ騰り、雲の邊に坐す。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
