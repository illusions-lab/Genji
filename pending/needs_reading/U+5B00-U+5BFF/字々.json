        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "字々の部落は立木に囲まれながら処々に塊まっています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し幼時は愚鈍で、書を讀むこと千百遍、字々に意を着けても、それでも善く出來なかつた位の人であつた。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし幼時は愚鈍で書を読むこと千百遍、字々に心を着けても、それでもよく出来なかったくらいの人であった。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "この詩は字々皆我心血なりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある個所に來ると心ある讀者は一字々々にしがみ附かないではゐられなくなる。",
              "citation": {
                "source": "水野仙子氏の作品について",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、新聞は捨ててしまっても、その記事の活字の一字々々迄が、頭の中に刻み込まれたように明瞭に浮んで来るのです。",
              "citation": {
                "source": "たちあな姫",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱中したときの癖で、何時の間にか彼は舌を横に出して、一生懸命一字々々刻んで行つた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてこそ、君が藝術には感情の解放ともいふべきものが強く働いてゐて、その特色が君の作の字々句々の上にあらはれ、わたしたちの心をひかれるのも主としてその點にある。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "給仕がまだそれを一字々々拾い読みしている間に、パーウェル・イワーノヴィッチ・チチコフは市内見物に出かけて行ったが、この市が他の県庁所在地に比べて少しも劣っていないところを見て、どうやら満足がいったらしい。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "官吏や貴族連の多くも矢張り知らず識らずの間にその問題を考えるようになり、周知の如く、その当時非常に流行していた神秘主義にかぶれて、『ナポレオン』という名前を構成している文字の一字々々に或る特殊の意味を発見したり、中にはその名前から＊８黙示録の神秘の数を引き出した者さえ少なくなかったのである。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めは先ず英文を蘭文に飜訳することを試み、一字々々字を引てソレを蘭文に書直せば、ちゃんと蘭文になって文章の意味を取ることに苦労はない。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "けだし活字の初は『康熙字典』によりて一字々々作りたりといへば活字は極めて正しき者にてありき。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "一字々々真紅な心臓から迸出る美しい生血で書つけられたものゝ様……。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "村々字々に消防はあるが、無論間に合う事じゃない。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあひだ、お上人さまは、南無阿弥陀仏々々々々々々と、石ころを拾つては、一字々々おしるしになつた。",
              "citation": {
                "source": "さがしもの",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            },
            {
              "text": "私どもは物珍らしさにその仮名文字を一字々々声に出して読みあげました。",
              "citation": {
                "source": "騎士屋",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            },
            {
              "text": "一字々々がバラ／＼で、一行をまとめて読みとる注意力がつゞかない。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "坐っているときにはいつも一字々々拾い読みして、五虎将の姓名を説きあかすのみならず、黄忠の字が汗升、馬超の字が孟起などということまで知っている。",
              "citation": {
                "source": "風波",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも、文字が不揃で、一字々々｜透き寫しに捺つたものでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "女御用聞き",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを預想して置いて、房吉の帳面字を一字々々拾ひ出し、透き寫しにして、文章を綴つたといふことは、曲者の並々ならぬ太さですが、同時に吉三郎殺しは、房吉ではないといふ證據にもなるのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "女御用聞き",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房が拭い取ろうとするのを制して、母が自分で拭ったのであったが、拭い取る時にいかにも惜しそうに、一字々々、頭へ刻みつけるように視すえつゝ消した。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五日の昼過ぎ、南光院には近隣はいうまでもなく、離、細谷、大荷場あたりの字々から老若の村民が続々と集ってきた。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "また激甚地の字々では、水田の稲草が浮き上っていた。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中から一字々々、入用の字を拾つて、透き寫しにしたのだらう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美しき人質",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
