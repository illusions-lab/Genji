          "literary": [
            {
              "text": "◯天皇陛下御｜宸念。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、おんみずからのご不自由よりも、戦乱のちまたに飢えひしがれている民のうえにご宸念を休ませられたことがない。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お上のご宸念のたえない道理である。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何をそのようにご宸念を傷めておいで遊ばしますか」「朕の行く末は案じぬが、世の末を思うと、夜も安からず思う。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして努めて、士気の昂揚をご宸念あそばして下さい」　と、奏した。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――かならずご宸念をお煩わし遊ばしますな」と、ただただ慰めて、ひとまず退がった。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしたらよいであろう」「さほどご宸念には及ばないでしょう」　仲達はおっとり答えた。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄左近や一味の多くを討死させたのみか、上の御宸念をも煩わせ奉った身が、どの面さげて」「さまで、悔やむなれば、なおさらのことだ。",
              "citation": {
                "source": "私本太平記",
                "author": "婆娑羅帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇室の御宸念は、この世界的變革期に臨んでいふも畏れ多い程である。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
