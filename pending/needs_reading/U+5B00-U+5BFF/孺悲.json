          "literary": [
            {
              "text": "二〇（四五四）　孺悲が先師に面会を求めた。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "先師は病気だといって会われなかったが、取次の人がそれをつたえるために部屋を出ると、すぐ瑟を取りあげ、歌をうたって、わざと孺悲にそれがきこえるようにされた。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　孺悲＝＝魯の人。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一）孺悲には何か不都合なことがあつて、孔子に面会を求めるのは自分から差しひかえなければならなかつたのに、押し強く出て来たので、それを断り、わざと仮病だということを知らせて反省を求めた。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
