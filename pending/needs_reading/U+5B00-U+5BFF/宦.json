        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "宦者忽にして一の紅なる篋を舁き来りぬ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "御史の密奏を聞召して、即ち宦官の建文帝に親しく事えたる者を召して実否を探らしめたもう。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "真宗崩じて後、其｜后の悪みを受け、擅に永定陵を改めたるによって罪を被り、且つ宦官雷允恭と交通したるを論ぜられ、崖州に遠謫せられ、数年にして道州に徙され、致仕して光州に居りて卒した。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "後漢時代の宦官、蔡倫は一〇五年、皇帝に紙を献上したことでその発明者として記憶されています。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ｅｕｎｕｃｈ（宦官）に引っ掛けて、名前はＵｎｉｃｓ（本当に下品な連中だな〜）と付けた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "周禎が矢島氏を冒した時、長男周碩は生得不調法にして仕宦に適せぬと称して廃嫡を請い、小田原に往って町医となった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "文久三年に柏軒が歿してからは家に帰っていて、今｜仕宦したのである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "小田原行は遊賞のためで、仕宦のためではなかつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "又此仕宦は何時であつたか。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして霞亭が仕宦の時を知るにも、亦｜上の語が用立つのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "山陽は霞亭が備後に仕宦するまでの事を叙して、其間に時を指定する語を下さなかつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし仕宦は備後に往つてからの第九年に於いてしたのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に山陽は仕宦と東役とを叙して其間に一の「尋」の字を下し、「尋特召東邸」と云つてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし仕宦と東役とは同年の事であつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは大樹は唐朝にして長藤は宦官だと謂つたのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "独り韓の此詩はわたくしをして唐代宦官の禍を思はしめて已まなかつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして書中には柏軒の仕宦と移居との事が併せ記してある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋江保さんは当時成斎に就いて筆札を学んでゐて、成斎が柏軒の子鉄三郎を待つに、其父の仕宦前後｜厚薄を異にしたことを記憶してゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "又塩田良三、矢島玄碩の仕宦を評した一句がある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを自覚してからは、大丈夫たるべきものが、こんな宦官のするような態度をしてはならないと反省することもあったが、好い子から美少年に進化した今日も、この媚が全くは無くならずにいる。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この刑を受けた者を閹人と称し、宮廷の宦官の大部分がこれであったことは言うまでもない。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "稿をつづけていくうちに、宦者とか閹奴とかいう文字を書かなければならぬところに来ると、彼は覚えず呻き声を発した。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから間もなく、帝の恩寵をこうむっている宦者が何か親族の罪に連坐して、遠い南の国へ流しやられることになった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "録異記",
                "note": "青空文庫"
              }
            },
            {
              "text": "常にこの亀をそばに置いて、害を防げ」　宦者はありがたく頂戴して出た。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "録異記",
                "note": "青空文庫"
              }
            },
            {
              "text": "その声がだんだんに近づいて来るので、宦者はここぞと思って、かの亀を取り出して階上に置くと、やや暫くして亀は首を伸ばして一道の気を吐いた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "録異記",
                "note": "青空文庫"
              }
            },
            {
              "text": "一年の後、宦者は赦されて長安の都に帰った。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "録異記",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルコのソリマン二世一日睾丸抜いた牡馬が戯るるを睹、宦者も丸を去ったばかりでは不安心とて、その根部を切り尽さしめ後帝世々その制を沿襲した。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "けだしその推察通り宦者が婦女を弄ぶ例は尠なからぬ（タヴェルニエー『土耳古帝宮中新話』一六七五年版二八頁、アンシロン『宦者攻撃論』一七一八年版二〇六頁、『人性』八巻四号、緒方正清博士「支那および韓国の去勢について」）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
