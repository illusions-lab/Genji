        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "晩間寒雨瀟瀟として落葉に滴る。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説雨瀟瀟筆大に進む。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年十月中起稾せし雨瀟瀟、始めて脱稿。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十年正月脱稿雨瀟瀟序　拙作『雨瀟瀟』はかつて余が編輯せし雑誌『花月』に掲載せむがため大正七年の秋稿を起せしもの。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかも雑誌『新小説』記者の草稿を求むるに会い浄写の時改めて『雨瀟瀟』となしぬ。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十三年九月『麻布襍記』の一書を梓するに当り、再びこの小篇『雨瀟瀟』を取りてその巻初に掲げぬ。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和二年九月｜書肆改造社の『現代日本文学全集』第廿二篇を編輯するや『雨瀟瀟』の一篇またその巻首に採録せられぬ。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あまりに泣きぬ若き時」は小説「雨瀟瀟」の本文中にその原文と対照して作の一部分を構成していたものである。",
              "citation": {
                "source": "「珊瑚集」解説",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
