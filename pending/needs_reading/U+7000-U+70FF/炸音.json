          "literary": [
            {
              "text": "物凄い炸音が夜空を裂いて、遠く高く光の矢が走った。",
              "citation": {
                "source": "運命のＳＯＳ",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "地におちた瓦は、炸音をたてて割れ散った。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめて地をつたうひびき、呻き、轟炸音！",
              "citation": {
                "source": "原爆詩集",
                "author": "峠三吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の光は天に乱れ、炸音は鳴りやまず、濛々の煙は異臭をおびてきた。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
