          "literary": [
            {
              "text": "對馬國より更に南行して瀚海を渡る、其間一千餘里にして一大國に至る。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "又南渡一海千餘里、名曰瀚海、至一大國、官亦曰卑狗、副曰卑奴母離、方可三百里、多竹木叢林、有三千許家、差有田地、耕田猶不足食、亦南北市糴。",
              "citation": {
                "source": "魏志倭人傳",
                "author": "陳壽",
                "note": "青空文庫"
              }
            }
          ]
        }
