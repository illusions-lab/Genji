        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何でこの状を目睹して躊躇すべき。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちかりにここに微小な人間があって物質分子の間に立ち交じり原子内のエレクトロンの運動を目睹しているがその視力は分子距離以外に及ばぬと想像する。",
              "citation": {
                "source": "物理学と感覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "門を出でゝ　天日を睹る、行也　焉にぞ　肯て苟もせん。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "○夫れ智者は未だ萌さゞるに見、愚者は成事を睹る。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "交相の二字、甚だ力有り、奮戦力闘の状、睹るが如きを覚ゆ。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "惜福の工夫十分なる人が、福運の來訪を受くること多きは、實際の事實で有つて、遠く史上の古人に就て之を檢覈するを須ひず、近く吾人の目睹耳聞するところの今人に就て之を考査すれば、直に明瞭なることであるが、分福の工夫十分なる人が、好運の來訪を受くること多きも、亦明白なる事實である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "源爲朝｜養由基をして射らしむるも、※直からず、羽整はずんば、馬を射るもまた中らざらんとするのは、睹易き道理である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾人の目が睹、心が知るところに就て言をなして見ようか。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち頽廢の意趣感情を含めるものを目睹耳聞する場合には、同じく頽廢的になり、奮激緊張の意趣感情を含めるものを睹聞する場合には、同じく奮激緊張せんとするのであり、幽玄の作品や樂曲に接しては、又同じく幽玄の心緒を動かされ、輕佻淫靡の作品や樂曲に接しては、又同じく輕佻淫靡の心を唆り立てられるのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "是においてかつて親しく嶺松寺｜中の碑碣を睹た人が三人になった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭軒は平洲の墓誌銘を目睹して、士幹と書してゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし若し三種の書が未だ全く湮滅せずにゐて、他日一たび発見せられ、わたくしがこれを目睹することを得たならば、微顕闡幽の真目的は此に始て達せられるであらう。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "是がわたくしの目睹した唯一の慊堂の尺牘である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「勝手に書いたとは何を申すぞ、この一｜埓、表立って江戸大公儀に聞えなば、家名断絶、秩禄没収は火を睹るより明らかじゃ。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが今｜睹た対象は毫もそんな感じを引き起さなかった。",
              "citation": {
                "source": "趣味の遺伝",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はこの人の世に、さばかり清く新くも、崇く優くも、高く麗くも、又は、完くも大いなる者在るを信ぜざらんと為るばかりに、一度は目前睹るを得て、その倒懸の苦を寛うせん、と心｜※くが如く望みたりしを、今却りて浮萍の底に沈める泥中の光に値へる卒爾の歓極まれればなり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は現にさう云ふのを睹てゐる！",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "睹てゐるから今貴下方がかうして一処に死ぬまでも離れまいと云ふまでに思合つた、その満足はどれ程で、又そのお互の仕合は、実に謂ふに謂はれん程の者であらう、と私は思ふ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那の書に角ある蟾蜍の話あるは虚構とするも、予輩しばしば睹た南米産の大蛙ケラトリフス・コルナタは両眼の上に角二つある。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからダニール・ウィルソンいわく、新世界へ欧人移り入りて旧世界でかつて見ざる格別の異物を睹た時、その鳴き声を擬て名を付けた例多し。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルコのソリマン二世一日睾丸抜いた牡馬が戯るるを睹、宦者も丸を去ったばかりでは不安心とて、その根部を切り尽さしめ後帝世々その制を沿襲した。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿は人に近付かぬ故その天然の性行を睹た学者は少ない。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "また機巧あり、ベルトが睹た尾長猴はいかにこんがらがった鎖をも手迅く解き戻し、あるいは旨く鞦韆を御して遠い物を手に取り、また己れを愛撫するに乗じてその持ち物を掏った。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "予壮時諸方のサーカスに随い行きし時、黒人などがほめき盛りの牝牡猴に種々｜猥りな事をして示すと、あるいは喜んで注視しあるいは妬んで騒ぐを毎度｜睹た。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方の窓より異様の感じが起るので、少しく首を転じて寝ながら睹ると、黒紋付の綿入れを着た男が抜刀を提げて老爺を追うに、二人ながら手も足も動かさず、眉間尺の画のごとく舞い上り舞い下りる。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時象が些細な蟹や鼠を見て太く不安を感ずるを睹た。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる無法の合祀励行によって、果たして当局が言明するごとき好結果を日本国体に及ぼし得たるかと問うに、熊楠らは実際全くこれに反せる悪結果のみを睹るなり。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
