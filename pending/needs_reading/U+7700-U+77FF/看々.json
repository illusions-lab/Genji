          "literary": [
            {
              "text": "看々涙の頬の乾ける辺に、異く昂れる気有りて青く耀きぬ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "看々うちに遠くなって、後は万歳の声ばかり。",
              "citation": {
                "source": "昇降場",
                "author": "広津柳浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "天運は果して循環するか、今の一致や昔の一致の若きを得べからずと雖も、分裂の形勢が、看々將さに終らんとするは、一致の形勢が將さに來らんとするの徴にあらずして何ぞや。",
              "citation": {
                "source": "學變臆説",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            }
          ]
        }
