        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どう矧ぎ合わしても病友の生涯の継ぎ伸ばしにはならない。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度は藤川から出発し岡崎で藤吉郎の矢矧の橋を見物し、池鯉鮒の町はずれに在る八つ橋の古趾を探ねようというのであった。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧や「カピトリウム」に登り、「トラステヱエル」（河東の地なり、テヱエル河の東岸に當れる羅馬の一部を謂ふ）に渡らんこと思ひも掛けざりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧や彼人は物に怯るゝこと鹿子の如く、同じ席に列るものもたやすく近づくこと能はざるを奈何せん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし声高く語り合うこともなく、矧てや絃歌の響などは起らなかった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧や逍遙子は古人にあらざるを以て、その一旦擲ちたる椽大の筆を、再びとり上ぐることを得べきをや。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧や逍遙子は早くよりハルトマンが無意識哲學を帳中の祕となしたるをば、我に語りしものあるをや。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧や月ごとに数十金を捐てて無用の淫書を買ふは、わたくしの能く耐ふる所でない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧や関五郎と云ふ三字の称は見えない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧てや確証とすべきものは無い。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧や渡辺氏の史筆の如きものがあつて、遺憾なく辯駁してある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれの手足がすこやかになったら、太刀の柄巻きしても、雀弓の矢を矧いでも、親子ふたりの口すぎには事欠くまい。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に虎を射る場合に限り犀鳥の羽を矧いだ矢を用いてこれに厭勝つのだ。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "一挺の櫓と一枚か二枚の継ぎ矧ぎ帆で、自由自在に三十六｜灘を突破しながら、「絶海遥かにめぐる赤間関」と来る。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧んやこの清平の世、坦蕩の時においておや。",
              "citation": {
                "source": "牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧んや此の清平の世｜坦蕩のときにおいてをや。",
              "citation": {
                "source": "牡丹燈籠　牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯様なものは全体私なんぞの聞くべきものでない、矧や玩ぶべき者でないと云う考を持て居るから、遂ぞ芝居見物など念頭に浮んだこともない。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧や朋輩同士で喧嘩をしたと云うことは只の一度もない。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧や酒を飲むなどゝ云う金は一銭もない。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧んや金だ、渡さなければならぬと捩くれ込んで、到頭持て行て貰いました。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "狙いあやまたず胸板を射抜き、本矧までも貫いた。",
              "citation": {
                "source": "弓道中祖伝",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてその下が中入れで、そうしてその上が弦押しで」「矧ぎ付きというのはどのへんだな？",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」お鈴を鳴らしてなかをのぞいたら、「宮本捨吉明治三十年奉納」の豊公幼時の胆と矢矧の橋の上の小六の槍の石づきをとらえている小さいごろつきのような豊公の絵があって大笑いしました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢矧の橋の長いには驚かされた。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "東歌の山鳥の尾ろの秀尾に　羅摩かけ、捉ふべみこそ、汝によそりけめ（万葉巻十四）と言ふ歌は、依然として、謎の様に辿られるのみであるが、根本には、山鳥の秀尾を矧いだ矢に、鏡をかけたと言ふ幣束が、古い日本にも行はれて居た事実を、潜めて居る様な気がしてならぬ。",
              "citation": {
                "source": "幣束から旗さし物へ",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "矧曰其有能稽謀自天。",
              "citation": {
                "source": "支那歴史的思想の起源",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯の如き方法で、實物がなくても、いくらか後世の實物からして想像し得られるものは漢代から既にあるのであつて、矧んや六朝頃のものになると、唐代のものと全く種類の變らぬものが多く出て來たのであるから、顧野王の玉篇などに載つて居る織物から以後は大體實物を想像し得られる。",
              "citation": {
                "source": "染織に關する文獻の研究",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒板塀に黒鉄の忍返し、姫小松と黒部を矧ぎつけた腰舞良の枝折戸から根府川の飛石がずっと泉水のほうへつづいている。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "稲荷の使",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
