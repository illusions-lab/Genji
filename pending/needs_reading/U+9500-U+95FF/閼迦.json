        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "江畔老といつしよに閼迦流山へ遊ぶ、尻からげ、地下足袋、帽子なしの杖ついて、弥次さん喜多さん、とてもほがらかである。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "一杯の水も仏の涙かな――といふ風の閼迦流山くづしがむき出してある、放浪詩人三石勝五郎さんの作。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫くすると、閼迦桶を片手に持つた母親は、その庫裡から出て来た。",
              "citation": {
                "source": "草みち",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "この鞍馬の護法善神社は、本堂の後右の閼迦井の辺にあるので、地主神たる大蛇を祭ったのだとある。",
              "citation": {
                "source": "憑き物系統に関する民族的研究",
                "author": "その一例として飛騨の牛蒡種",
                "note": "青空文庫"
              }
            },
            {
              "text": "上人その雌に向って、我れこの山にて秘法を修するに、閼迦の水を求めんとす、汝この山を守護すべしと云ったところが、たちまち清泉湧き出でた。",
              "citation": {
                "source": "憑き物系統に関する民族的研究",
                "author": "その一例として飛騨の牛蒡種",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ今の閼迦井である。",
              "citation": {
                "source": "憑き物系統に関する民族的研究",
                "author": "その一例として飛騨の牛蒡種",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちその大蛇を祭って、今も閼迦井護法堂とて小さい堂があるのだというのである。",
              "citation": {
                "source": "憑き物系統に関する民族的研究",
                "author": "その一例として飛騨の牛蒡種",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
