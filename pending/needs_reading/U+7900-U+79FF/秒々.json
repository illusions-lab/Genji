        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこで一ツでも二ツでも、何か突き貫いて徹底し得たと思つたらば、全氣で事に當ると何の樣な光景で何の樣な結果に至るといふことを觀得て、そして刹那々々秒々分々、時々刻々に當面の事を全氣で遣りつけて行く習をつけると、何時の間にか散る氣の習は脱けて仕舞ふやうになるのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "性は時々分々秒々に變じ行くものである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで一ツでも二ツでも何か突き貫いて徹底し得たと思った時は、全心で事に当たれば何の様な光景で何の様な結果になるかということを理解して、そして瞬間々々秒々分々、時々刻々に当面の事を全心で遣りつけて行く習慣をつければ、何時の間にか散る気の習癖は脱けて仕舞うのである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "性は時々分々秒々に変化して行くものである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間にお末は一秒々々に死んで行つた。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一秒々々、ちっともやすまずに湧出づる血潮をせきとめるかたい弁があるのです。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "云わば人間は一秒々々の時間について労作の義務を感じているのである。",
              "citation": {
                "source": "娯楽論",
                "author": "――民衆と娯楽・その積極性と社会性・――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
