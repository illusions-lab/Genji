          "literary": [
            {
              "text": "わっしの町内に万助という糴呉服屋があるんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "化け銀杏",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供衆に遺して行った多くの和漢の書籍は、親戚の立会の上で、後仕末のために糴売に附せられた。",
              "citation": {
                "source": "岩石の間",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "始度一海千餘里、至對馬國、其大官曰卑狗、副曰卑奴母離、所居絶島、方可四百餘里、土地山險、多深林、道路如禽鹿徑、有千餘戸、無良田、食海物自活、乘船南北市糴。",
              "citation": {
                "source": "魏志倭人傳",
                "author": "陳壽",
                "note": "青空文庫"
              }
            },
            {
              "text": "又南渡一海千餘里、名曰瀚海、至一大國、官亦曰卑狗、副曰卑奴母離、方可三百里、多竹木叢林、有三千許家、差有田地、耕田猶不足食、亦南北市糴。",
              "citation": {
                "source": "魏志倭人傳",
                "author": "陳壽",
                "note": "青空文庫"
              }
            }
          ]
        }
