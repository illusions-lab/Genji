          "literary": [
            {
              "text": "水戸神なる速秋津彦、速秋津姫二神の、河海に因りて持ち別けて、生みし神に、沫那芸神あり、沫那美神あり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この速秋津日子、速秋津比賣の二神、河海によりて持ち別けて生みたまふ神の名四は、沫那藝の神。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "沫那藝の神より國の久比奢母智の神まで并はせて八神。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
