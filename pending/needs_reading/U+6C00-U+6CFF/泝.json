        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "其處で僕は昨日チエホフの『ブラツクモンク』を讀さして思はずボズさんの事を考へ出し、其以前二人が溪流の奧深く泝つて「やまめ」を釣つた事など、それからそれへと考へると堪らなくなつて來た。",
              "citation": {
                "source": "都の友へ、Ｂ生より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "人家を離れて四五｜丁も泝ると既に路もなければ畑もない。",
              "citation": {
                "source": "都の友へ、Ｂ生より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "瀬を辿つて奧へ奧へと泝るに連れて、此處彼處、舊遊の澱の小蔭にはボズさんの菅笠が見えるやうである。",
              "citation": {
                "source": "都の友へ、Ｂ生より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして来て見ると、兼ねて期したる事とは言え、さてお正は既にいないので、大いに失望した上に、お正の身の上の不幸を箱根細工の店で聞かされたので、不快に堪えず、流れを泝って渓の奥まで一人で散歩して見たが少しも面白くない、気は塞ぐ一方であるから、宿に帰って、少し夕飯には時刻が早いが、酒を命じた。",
              "citation": {
                "source": "恋を恋する人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その二百三十九　わたくしは京水本系図の来歴より泝つて水津本系図の来歴に及び、水津本が京都で歿した水津官蔵の手より、江戸にゐる女の手にわたつたことを言つた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等は根本資料に泝つて検せなくてはならない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "予（蒲松齢）は庚戌の歳、南に遊んで泝州に往き、雨にへだてられて旅舎に休んでいたが、そこに劉生子敬という者がある。",
              "citation": {
                "source": "蓮香",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此より上に泝れば、即ち上牢下牢関、皆な山水清絶の処なり。",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その七　――放翁詩話三十章――",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど禹貢の九州が荊州即ち楚の地を含めるに見、一方この地方の知られたるは春秋時代なるに見ば、兎に角周時代まで泝らせ得べきには非ざる也。",
              "citation": {
                "source": "『尚書』の高等批評",
                "author": "特に堯舜禹に就いて",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩本梧友の『勾股泝原』は安永八年（一七七九）の作であるが、この書中には算法の額を云々したということも見える。",
              "citation": {
                "source": "芸術と数学及び科学",
                "author": "三上義夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆえに、探勝春余泝澗流、瑞湖風色入吟眸、水清樹緑山如活、始見泰西日本州。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "広東一路泝珠江、看過船居幾万艘、繋纜殖民洲外岸、市声楼影入玻窓。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "紋都湾外艇、終夜泝長江、汽笛時驚夢、舞城入暁窓。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "劒沢を泝り、八時十三分、長次郎谷の出合。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僅に其地を去れば味ひ美ならず、その味ひ美なるものは北海より長江を泝りて困苦したるの度にあたれるゆゑならん。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "つくりをはれば女魚そのなかへを弾着、直に女魚男魚掘のけたる沙石を左右より尾鰭にてすくひかけての河に泝るは子を産んとて也。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなはち宮に入りまさずて、その御船を引き避きて、堀江に泝らして、河のまにまに六、山代に上りいでましき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
