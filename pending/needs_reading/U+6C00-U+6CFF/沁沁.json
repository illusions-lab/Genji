          "literary": [
            {
              "text": "人生の薄暮をさ迷ひ歩いて、物靜かな日陰の小路に、さうした侘しい神神の祠を見る時ほど、人間生活のいぢらしさ、悲しさ、果敢なさ、生の苦しさを、侘しく沁沁と思はせることはないのである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に今夜なども有難い位であつた、」と種田君は沁沁感じ入つて居つた。",
              "citation": {
                "source": "二黒の巳",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "用なしのわたしは何かのついでには此の公園に来て、泉滴の音を聴いたり茶店に坐つたりしてゐたのだつたが、いま此処を去ると思ふと一さう沁沁した気持ちになつた。",
              "citation": {
                "source": "故郷を辞す",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯がゆかつたが沁沁と身にこたへるものがあつた。",
              "citation": {
                "source": "故郷を辞す",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
