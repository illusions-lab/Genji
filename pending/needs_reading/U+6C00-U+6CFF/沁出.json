          "literary": [
            {
              "text": "お島は苦しい夢を見ているような心持で、そこを掃出していたが、不安と悔恨とが、また新しく胸に沁出していた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "成功と活動とのみに飢え渇えているような荒いそして硬い彼女の心にも、そんな憧憬と不満とが、沁出さずにはいなかった。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "下は白い砂を敷いた様な清潔な道が両｜壁の巌から自然に沁出る水があるのか少し湿つて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
