        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "五月、燕兵｜泗州に至る。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "漢武帝の時、黄河大に漲り、瓠子を決して、鉅野に注ぎ、淮泗に通じたることあり。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝病むに及びこの犬食せず、崩ずるに及び号呼｜涕泗して疲瘠す。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "両岸に触れたり、泗流の止むる所となつたりしてはいけない。",
              "citation": {
                "source": "谷合の碧い空",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "又泗流の停むるところとならなかつた。",
              "citation": {
                "source": "谷合の碧い空",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "憑軒悌泗流（杜甫）もしこの詩から出たものとすれば岳陽楼の階を登つた人とは杜甫のことになる。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "南は淮泗から会稽に入り、時に魯中に家を持ったりした。",
              "citation": {
                "source": "岷山の隠士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心臓から出ずる気、呵と称し、脾臓から出ずる気、呼と称し、腎臓から出ずる気、吹と称し、肝臓から出ずる気、嘘と称し、肺臓から出ずる気、泗と称す。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "委細の事蹟は、清の崔述の『洙泗考信録』や、我が蟹江博士の『孔子研究』等に讓つて、二三の注意すべき事蹟を紹介いたさうと思ふ。",
              "citation": {
                "source": "支那史上の偉人（孔子と孔明）",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "清の崔述がこの傳説を、有り得べからざることとして排斥するのは（『洙泗考信録』卷二）、正當とは思ふが、同時にかかる傳説の行はれた時代に、儒家の一部に、かかる思想の存在した事實は、是認せなければなるまい。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正十年三月發行「支那學」第壹卷第七號）　　自注（一）孟子縢文公上に決汝漢排淮泗而注之江とあり、今の尚書禹貢では江水と淮水とは各々獨立して海に入るので、相通ずることがない。",
              "citation": {
                "source": "尚書稽疑",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "漢籍も尼山泗水の間（曲阜）に一大圖書館を作つて藏しておけば、帝室の本が時になくなつても、それで缺を補へるとて、民間に大圖書館を作る必要を論じた。",
              "citation": {
                "source": "支那目録學",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶長二年に父の吉次が死んで吉之丞の代になると、二度目の朝鮮征伐に義弘について泗川に行き、粮米荷頭と小荷駄才領を兼帯でやり、矢丸の下を駆けまわった。",
              "citation": {
                "source": "呂宋の壺",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "泗水の河の畔には、芳草が青々と芽ぐみ、防山、尼丘、五峯の頂の雪は溶けても、沙漠の砂を掴むで来る匈奴のやうな北風は、いまだに烈しい冬の名残を吹き送つた。",
              "citation": {
                "source": "谷崎潤一郎氏の作品",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、吾が身｜未だ死せず、感慕｜涕泗流る。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十二）　孔子は死後、魯の城北の泗のほとりに葬られた。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして弟子たちと共に蘇州黄泗津の日本船に入った。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘘だと思うなら、嶺の上にある泗州大聖の祠からひがしの、林や洞穴の近所をよく見て来てから物をいえ」　李逵は腹が立った。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "南京から出発して安徽の寿州――江蘇の泗洲――江蘇の沛県――山東の金郷――それから現在の泰安と、蒋介石の主力が一戦ごとに北上してゐる地図だ。",
              "citation": {
                "source": "南京六月祭",
                "author": "犬養健",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうさんざんな敗軍の日ではあったし、朱雋は、大いに力を得て、翌日は、孫堅が准泗の精鋭千五百をも加えて、「一挙に」と、宛城へ迫った。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「むかし、漢の高祖は、泗上の一｜亭長から、身を興し、四百年の帝業を創てた。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それをはばかって、もしこの際、呂布のなすままに委せておいたら、袁術と合流して、泗水淮南に縦横し、遂には将来の大患となりましょう。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "泗水の流れはまだ凍るほどにも至らないが、草木は枯れつくし、満目｜蕭条として、寒烈肌身に沁みてくる。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "呂布は、城をめぐる泗水の流れに、逆茂木を引かせ、武具兵糧も、充分城内に積み入れて、「雪よ。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の来り攻めるを待って、一度に突いて出れば、曹軍の大半は泗水に溺れてしまうだろう」「は。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二日余りは矢戦に送っていたが、やがて曹操自身、わずか二十騎ほどを従えて、何思ったか、泗水の際まで駒を出して、「呂布に会わん」　と、城中へ呼びかけた。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "泗水の流れを隔てて、曹操の声は水にこだまして聞えてきた。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず、百世の後まで、悪名を泗水に流すにきまっている。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　寒月は皎々として、泗水の流れを鏡の如く照り返している。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにまた、郭嘉が、「この下※の陥ちないのは、泗水、沂水の地の利あるゆえですが、その二水の流れを、味方に利用せば、敵はたちまち破れ去ること疑いもありません」と、一策を提出した。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
