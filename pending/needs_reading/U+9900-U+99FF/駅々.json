        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "六十一　汽車が武蔵の平野へ降りてくるにつれて、しっとりした空気や、広々と夷かな田畠や矮林が、水から離れていた魚族の水に返されたような安易を感じさせたが、東京が近くにつれて、汽車の駐まる駅々に、お島は自分の生命を縮められるような苦しさを感じた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "良三はまだ残の金を持っていたので、迎えに来た男を随えて東上するのに、駅々で人に傲ること貴公子の如くであった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "一は同行の旗本家人等で、一は駅々の民庶、入京後は洛中の市人である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車旅行をして駅々の停車場に到着したときに、車窓からその停車場をながめる。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "東海道五十三次をかいた広重が今生きていたらば、こうした駅々の停車場の姿をいちいち写生して、おそらく好個の風景画を作り出すであろう。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕も正直にその話をすると、西田さんもひどく心配してくれて、途中の駅々に土地の青年団などが出張していると、それから薬をもらって僕に飲ませてくれたりしました。",
              "citation": {
                "source": "指輪一つ",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "東海道五十三次をかいた広重が今生きていたらば、こうした駅々の停車場の姿を一々写生して、おそらく好個の風景画を作り出すであろう。",
              "citation": {
                "source": "薬前薬後",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "道中の駅々では鞍置馬百五十｜疋、小荷駄馬二百余疋、人足三百余人を続ぎ立てた。",
              "citation": {
                "source": "佐橋甚五郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "参勤の折は、道中の駅々にて、なんらかの事変の起るのを、それとなく待ったこともある。",
              "citation": {
                "source": "恩を返す話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅々で車の停る毎に、農夫の乗客が幾群か入込んだ。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "長野測候所に技手を勤むる人から私は招きの手紙を受けて、未知の人々に逢うために、小諸を発ち、汽車の窓から田中、上田、坂木などの駅々を通り過ぎて、長野まで行った。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなお触れが、筑摩県｜権令の名で駅々村々へ回って来る。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "中仙道の駅々に見る荒廃の姿も見せず。",
              "citation": {
                "source": "伊良湖の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとずれると、太い大黒柱の黒く光っている陰から老人の頭が見えて、その子は今桑摘みに行っていないがとにかく是非休んで行けといって、連りに一行の者を引止めて茶をすすめながら、木曾街道の駅々の頽廃して行く姿をば慨歎して、何とか振興策はあるまいかといっていた。",
              "citation": {
                "source": "木曾御嶽の両面",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、これからいったい何処へ行こうとしているのかしら……駅々の物売りの声を聞くたびに、おびえた心で私は目を開けている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車が駅々へ着くたび昔聞き馴れた田舎言葉がなつかしく耳に響いて来る。",
              "citation": {
                "source": "田舎がえり",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいったい何処へ行くのかしら……駅々の物売りの声を聞くたびに、おびえた心で私は目を開く。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めは枕の下のピストンの音かと思つてゐましたが、やがて地鳴りのやうに変り、砧のやうにチョウチョウと云つた風な音になり、十三日の夜の九時頃から、十四日の夜明けにかけて、停車する駅々では、物々しく満人の兵隊がドカドカと扉を叩いて行きます。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此度で一等楽しみで、プロレタリヤ的なのは、お湯が、駅々で只で貰へた事です。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「随分、やられたものだなァ」　駅々の間の、荒凉とした焼跡に眼をとめて、伊庭はそれでも珍しさうに窓外を見てゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅々の広告看板で、宿の名前を読みながら、長岡といふところで降りる気になり、ゆき子はそこで網棚の荷物をおろして下車してみた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前二時三時となり、段々信州の高原にさしかかると、停車する駅々の雰囲気が一つ毎に、緊張の度を増して来た。",
              "citation": {
                "source": "私の覚え書",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの駅々の警備の厳重なところを見れば、全くそんな事がないとは云われない。",
              "citation": {
                "source": "私の覚え書",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛ぶ様に変って行く景色、駅々で乗込んで来る皆それぞれの地方色を持った人達に心がひかれて私は自分が今妹の病気のために帰京するんだなどとは云えないほど澄んだ面白い様な気持になって居た。",
              "citation": {
                "source": "悲しめる心",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本中で、千人針が縫われ、駅々街々で紙の小旗がふられていた。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "舁ぐ人足は雲助で、五十三次の駅々に問屋があって、そこへ藩の者といって、掛合えば幾人でも雲助を出してくれる。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "本来は切棒に父が乗るはずであるが、それに継母と弟の大之丞とを乗せ、私と曾祖母と祖母とを各垂駕籠に乗せ、父は別に駕籠を作らせず、歩きもし、馬にも乗り、また駅々の竹で編んだのに時には乗っても宜いといって、駕籠無しで出発した。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "その意味からいつても、重なり重なる山岳の輪廓を車窓の外に望みながら、篠山まで來た、丹波大山まで來た、とゆく先の停車場で驛々の名を讀み、更に次の驛まで何マイルと記してあるのを知り、時に修學旅行の途中かと見えるやうな日に燒けた女學生の群が、車窓に近くゆき過ぐるのを眺めることすら、私はそれを樂しみにした。",
              "citation": {
                "source": "山陰土産",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "大津、石山、草津、安土――わたしに取つては四十年前の旅の記憶の忘れられずにある驛々を汽車の窓から見て通り過ぎた。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとづれると、太い大黒柱の黒く光つてゐる陰から老人の頭が見えて、其子は今桑摘みに行つて居ないが兎に角是非休んで行けと云つて、連りに一行の者を引止めて茶をすゝめながら、木曾街道の驛々の頽廢して行く姿をば慨歎して、何とか振興策はあるまいかと云つてゐた。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
