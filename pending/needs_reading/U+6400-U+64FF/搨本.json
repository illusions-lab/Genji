          "literary": [
            {
              "text": "病める蘭軒を慰むるものは、此｜古搨本古槧本であつただらう。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「冠山老侯賜其令愛遺墨搨本。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "五叟子信州より取寄せし荷物の中より余が先考の墓誌搨本を見出したりとて示さる。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "碑文の搨本をわたくしは市河三陽氏から借覧した。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
