          "literary": [
            {
              "text": "「石崎士整与諸子同千秋亭賞月、題詩扇面、携来見示、即次韻。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「余蔵白氏集活字版本、旧年売却、頃書肆英平吉携来一本、即旧架物也、購得記喜。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「去年カピタンが携来りし妻は世に稀なる美人にて、日本人が見てもえならず見え、両婢ともにうつくしきこと限なしと、みな人申候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹田屋の主人写真機を携来りて偏奇館書斎を撮影す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "而してその遺骨を薬王寺に携来った孤児の生死については遂に知ることを得ない。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "依ッテ、明日改メテ迎エノ使者ヲ出ス故、御携来ヲ希ウ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
