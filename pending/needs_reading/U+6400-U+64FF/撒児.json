        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あれぞ総大将｜成吉思汗の弟、合撒児でござります。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児　（成吉思汗の弟、下手よりつかつかと現る。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（天幕の垂れをはぐり、はいろうとする）忽必来　合撒児さま、殿はまだお昼寝のつづきです。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児　うう、（振り返る）まだ寝てる？",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児　木華里はまだ帰らぬな。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児　忽必来、進撃の前だ。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児様、殿に、進発の御催促を申し上げては。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児　そうだとも。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "汪克児　（したり顔に腕組みして、合撒児の仮声で）するてえと、兄貴の野郎、まだ、合爾合姫のことを想っているのだなあ。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児　こら、豚め！",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児様、もはや一刻の猶予もならぬ。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児　（じっと考え込んで、ひとり言）おれはよく知っている。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児　やかましい！",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児　頭痛がしたって歩けるだろう。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児　はっはっは、大切な乃蛮征伐を前にして、軍の大幹部がみんな急病とは大変だな。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そら、あなたが狩猟においでになって、弟の合撒児さまと御一緒に、妾の父の家へ水を飲みにお寄りになったことがありましたわね。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児のやつの肩車に乗って、高いところの枝を折ろうとする拍子に、手に棘を刺してねえ。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟｜合撒児を先頭に、忽必来、速不台、小姓｜巴剌帖木、その他参謀等多勢、厳しき武装にて馳せ入り、成吉思汗の前に整列する。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一種の点呼）合撒児の手は、十本の指がみな毒蛇、哲別の白髪は針鼠、忽必来の胸は鉄の楯だ。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
