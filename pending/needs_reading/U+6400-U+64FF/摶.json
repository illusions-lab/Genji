        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "むかし私の胸｜摶つた希望は今日を、厳めしい紺青となつて空から私に降りかゝる。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽虫が水を摶つごとに細紋起きてしばらく月の面に小皺がよるばかり。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "脈摶を取ってみたがたしかであった。",
              "citation": {
                "source": "病中記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなとき、彼の心臓に打った不吉な摶動が、どうして母を眼覚まさないと言い切れよう。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "飮む、買ふ、摶つ、道樂は少もないが、たゞ性來の釣好きであつた。",
              "citation": {
                "source": "夜釣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "飲む、買ふ、摶つ、道楽は少もないが、たゞ性来の釣好きであつた。",
              "citation": {
                "source": "夜釣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとこの若い鳥は翼で横腹を摶ってみましたが、それは全くしっかりしていて、彼は空高く昇りはじめました。",
              "citation": {
                "source": "醜い家鴨の子",
                "author": "DEN GRIMME AELING",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　諍えば諍うほど、お増は自分を離れて行く男の心の冷たい脈摶に触れるのが腹立たしかった。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は今白い摶飯を三つ食べて、冷めたい紅茶を一杯ぐつとあほつたところだ。",
              "citation": {
                "source": "雀の卵",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだか忌々しいような気になったので、彼はそこらの小石をひろって投げつけると、鶏は羽摶きをして姿を消した。",
              "citation": {
                "source": "夢のお七",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きい鳥の羽摶きの音だ。",
              "citation": {
                "source": "鷲",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥は一摶に手摺の下まで飛んで来た。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏は羽摶きをして臼から飛び下りる。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "キキーと鋭どい羽摶をして一羽の雉子が藪の中から飛び出す。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の弱点が御常の弱点とまともに相摶つ事も少なくはなかった。",
              "citation": {
                "source": "道草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが急に慌だしく羽摶きをしたと思ふと、一斉に飛び上つて、そして遠く離れ離れに飛んで行つた。",
              "citation": {
                "source": "初冬の記事",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "庄吉は、短刀を突き出して、鶏の羽摶くように、片袖を翻しつつ、飛びかかった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "郊外に聳ゆるは何の塔ぞ、屋根あり、破風ありて、家屋の上に峙つは、下｜摶つ鳥の皷翼に似たり。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "又名品を盛んに生んで心にくいほど我等の心を摶つ。",
              "citation": {
                "source": "やきもの讀本",
                "author": "小野賢一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗中の人影が蔵人に向かって、ただ大鷲の羽摶くように、颯と飛び掛かって行ったからであった。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっ」　と驚いたジョン少年は思わず声を筒抜かせたが、それより一層驚いたのは足を折られた大烏で、バタバタと枝から離れると、さも倦怠そうに羽摶きながら、森を潜って舞って行く。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏は二人を誘うかのように、時々こっちを振り返って見ては悠々翼を羽摶いた。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして肉体の探窮美にのみ、胸を摶たれるのです。",
              "citation": {
                "source": "足の裏",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その、蒼白い月光と、赤い焔のような光線の混乱し錯綜した、斑まだらな明りのうちで、我を失ったＷは、自分の魂にピッタリ貼りついたように近々と髪を乱し、歯をギリギリと噛みながら、瀕死の鳥が羽摶く通りに身をもがくマーガレットの、恐怖と哀願と、そして極度の憤怒にかきむしられたような顔を眺めた。",
              "citation": {
                "source": "美しき月夜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "死して祀らざる、これを鬼という」と）賈誼曰、忽然為人兮、何足控摶、化為異物兮、亦何足患、若人之形千変万化、未始有極、忽然為人矣、化為異物矣。",
              "citation": {
                "source": "通俗講義　霊魂不滅論",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がその前に立ち止まると、一羽の、ついぞ見かけたこともないような、青味を帯びた鳥がちょっと愕いたように羽摶いて飛び立ったが、すぐ他の枝に移ったままかえって私に挑みでもするように、再びギャッ、ギャッと啼き立てた。",
              "citation": {
                "source": "風立ちぬ",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉢の中からは生きた鳩が、眼をきよとつかせながら羽摶き下りた。",
              "citation": {
                "source": "受驗生の手記",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
