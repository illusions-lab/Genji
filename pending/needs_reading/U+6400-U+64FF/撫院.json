        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「文化丙寅五月十九日、長崎｜撫院和泉守曲淵公に従て東都を発す。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "撫院をはじめ諸士歩行せし故、路険に労して背汗｜たり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃撫院｜衣一ぬぎたり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三日、此日は南宮山に詣らんとして未明撫院に先つて発せり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "此より山中奥の院は十八丁ありといふ故｜不行して駅へ帰りければ撫院已に駅長の家に来れり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳塚を経て寺門前茶店に至て撫院を待。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「七日卯時伏見舟場より乗船、撫院に侍す。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "撫院は為川辰吉の家に入る。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "みな撫院の応接にいづるとなり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "城主より撫院迎接の為に山上に茶亭を作る。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "撫院河内屋藤右衛門といふものの家に小休す。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなはち撫院の船に陪乗す。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "巌竜島を経て内裏の岸につき撫院舟より上て公事あり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "末に「此外に数曲ありといへり、撫院の云、文中に東都の地名あれば東都御舟歌ならんと、定て然らん」と云つてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "山を下るとき撫院を迎ふるもの満路、余が輩にいたりても名刺を通じて迎もの百有余人なり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
