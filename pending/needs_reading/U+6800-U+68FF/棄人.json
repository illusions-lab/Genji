        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だがな、またこの和尚が世棄人過ぎた、あんまり悟りすぎた。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "形だけも世棄人、それでこそ、見得も外聞も洒落も構わず、変徹も無く、途中で芸者を見ていらるる。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）そこでお前方だが、始終世棄人のように引っ込んで生きていて、大きな事を企てたことがない。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてあの世棄人も、遠い、微かな夢のように、人世とか、喜怒哀楽とか、得喪利害とか云うものを思い浮べるだろう。",
              "citation": {
                "source": "冬の王",
                "author": "ハンス・ランド　Hans Land",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
