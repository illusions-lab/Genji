        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さてこそと天にも昇る心地にて、控所に伴われ行きしに、典獄署長ら居並びて、謹んで大赦文を読み聞かされたり。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "基康　（家来に目くばせす）家来　（雑色の首にかけたる布袋より赦文を取り出し、うやうやしく基康に捧げる）基康　つつしんできけ。",
              "citation": {
                "source": "俊寛",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（赦文を読む）重科｜遠流を免ず。",
              "citation": {
                "source": "俊寛",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "俊寛　（声をふるわす）その赦文をも一度お読みください。",
              "citation": {
                "source": "俊寛",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "基康　この赦文には俊寛という名は記してない。",
              "citation": {
                "source": "俊寛",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（赦文を康頼に渡す）俊寛　康頼殿。",
              "citation": {
                "source": "俊寛",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "基康　わしの役目はこの赦文に記されたとおりを行使するのにある。",
              "citation": {
                "source": "俊寛",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "少なくとも赦文の意味を文字どおりに行使するのが最も賢いことがわしにはっきりしているほどには。",
              "citation": {
                "source": "俊寛",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬼界ヶ島流人赦免のことは正式に決まり、清盛から赦文を貰った使者の一行は都を立っていった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第三巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸く落ちついた俊寛の前に、清盛の大｜赦文をしたためた赦文が差し出された。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第三巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "目を血走らせた彼は、赦文の包み紙をひったくるようにして見た。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第三巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "半狂乱になって赦文を隅々まで探したが、求める二字はなかったのである。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第三巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "平家が思い忘れたか、赦文を書いた役人の書き間違いか、これはどういうことなのか、おれにはわからん」　狂ったように泣く俊寛の両手には、浜のぬれた砂がつかまれた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第三巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
