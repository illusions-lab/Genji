        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "梨枝子と同じ年の娘がゐて、名を瑩芳と云ひます。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは瑩芳と云つて、僕の家内です。",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "瑩芳　　シヤーオー　ピンハオメイユーフーリヨー田代　　なんてね？",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "話をしなければわからんが、ぬい子さんが君と結婚するといふ話を聞いて、それこそ日夜煩悶をしてゐた僕を、心から慰め労つてくれたのは、当時僕の秘書として働いてゐたこの瑩芳なんだ。",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（そつちを顧みて）ウワンニヨイプー瑩芳　　リヤンヤーオ劉　　これで日本語は一言もわからないんだ。",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "瑩芳　　シンフオーライチユータオミヤンナー・トーレンナンキン。",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬい子　　（突然、長椅子に打ち伏して、声をあげて泣く）瑩芳　　（そのそばに近づき、のぞき込むやうに）チヨンマイホー、チヨンマイホー。",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
