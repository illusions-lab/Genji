          "literary": [
            {
              "text": "瑤々と簾をゆるがしてゆく貴人の輦がある。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "瑤々たる波騒いのかすかに立つところ、見ゆるが如くまた見えぬようでもある。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――と、空ゆく雲のそれのように、静の水干の袖が瑤々とうごいた。",
              "citation": {
                "source": "日本名婦伝",
                "author": "静御前",
                "note": "青空文庫"
              }
            },
            {
              "text": "血に酔って、沸いていた城下の狂軍は、禁門の楼台に瑤々と翳された天子の黄蓋にやがて気づいて、「天子だ」「ご出御だ」　と、その下へ、わいわいと集まった。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
