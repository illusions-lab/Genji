        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "雨後すぐに真白に冴えて、夕陽に瑩光を放っている椰子林の砂浜に出た。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨の中の髄漿と申しましょうか、明瑩々、玲瓏そのものであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此地の瑩域は、高き石垣もて水面より築き起されたるさま、いにしへのノアが舟の洪水の上に泛べる如し。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸子は既に卒して、法諡を瑤津院殿瓊山妙瑩大禅尼と云ひ、祥雲寺に葬られた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日帰りて委細不承候内は、往来｜上下人足の沙汰計、書状も瑩々とわけきこえかね候故、確然は得信可申上候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれの父の瑩という人に一人の愛妾があったが、母は非常に嫉妬ぶかい婦人で、父が死んで埋葬する時に、ひそかにその妾をも墓のなかへ押し落して、生きながらに埋めてしまった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神後記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "湛然として音なき秋の水に臨むが如く、瑩朗たる面を過ぐる森羅の影の、繽紛として去るあとは、太古の色なき境をまのあたりに現わす。",
              "citation": {
                "source": "薤露行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "柄には緑色の玉を獅子頭に彫みて、象牙の如く瑩潤に白き杖を携へたるが、その尾をもて低き梢の花を打落し打落し、「今お留守へ行きまして、此処だといふのを聞いて追懸けて来た訳です。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸くその顔の明に見ゆる隙を求めけるが、別に相対へる人ありて、髪は黒けれども真額の瑩々禿げたるは、先に挨拶に出でし家扶の畔柳にて、今一人なるその人こそ、眉濃く、外眦の昂れる三十前後の男なりけれ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "気宇｜凜然として山河を凌銷し、万象｜瑩然として清爽際涯を知らずと書物には書いてあります。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その隣りは普通一般の湯の由だがこれまたもって透明、瑩徹などとは誓って申されない。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その盡きたる所、その顯れたる所は、則ち清瑩玉の如く、急駛矢の如く、深碧染むるが如き鬼怒川の水！",
              "citation": {
                "source": "日光山の奧",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　川俣温泉の浴槽は、旅亭の奧にあるもの二、川の彼岸にあるもの一、いづれも適當なる温度を保ちて、清瑩徹底、掬ぶに堪ゆべき程なれば、粟山郷中、最も秀でたる温泉と稱するを得べし。",
              "citation": {
                "source": "日光山の奧",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "氷瑩女史の「うつしゑ」という作品なんかも、パール・バックが描いている現実のこっち側から書いているという風なところがあって、やっぱり本国人の作品というあらそわれない味があります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "中国の謝冰瑩という、連合国の代表で来ておった人が、上海へ帰りまして、「日本の人は立派です。",
              "citation": {
                "source": "社会と人間の成長",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「瑩然として裸立す、羞愧の状、殆ど堪ふ可からず。",
              "citation": {
                "source": "鴉片",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "三百年間親戚としての往来はおろか、敵視状態だったのが、明治元年に絶交を解いて、交際が復活したからとて、両方の法主――光尊、光瑩の両裏方を、お互いに養女としあって、戸籍上の姻戚関係をむすんだといっても、お宝娘の武子さんを、となると、惜んだもののあったのも、わからなくもない。",
              "citation": {
                "source": "九条武子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "大谷派の本願寺の三代前の法主大谷光瑩さんの落しだねだといふうはさが、古くからあつた。",
              "citation": {
                "source": "宗十郎を悼む",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "梨枝子と同じ年の娘がゐて、名を瑩芳と云ひます。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは瑩芳と云つて、僕の家内です。",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "瑩芳　　シヤーオー　ピンハオメイユーフーリヨー田代　　なんてね？",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "話をしなければわからんが、ぬい子さんが君と結婚するといふ話を聞いて、それこそ日夜煩悶をしてゐた僕を、心から慰め労つてくれたのは、当時僕の秘書として働いてゐたこの瑩芳なんだ。",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（そつちを顧みて）ウワンニヨイプー瑩芳　　リヤンヤーオ劉　　これで日本語は一言もわからないんだ。",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "瑩芳　　シンフオーライチユータオミヤンナー・トーレンナンキン。",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬい子　　（突然、長椅子に打ち伏して、声をあげて泣く）瑩芳　　（そのそばに近づき、のぞき込むやうに）チヨンマイホー、チヨンマイホー。",
              "citation": {
                "source": "昨今横浜異聞（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（吾子）　屈原の志は玉の瑩くが如く、誠に潔白にして渝ることがない。",
              "citation": {
                "source": "楊雄と法言",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "凝不成花異淞ニ異ナリ／著来シテ物物｜各オノ容ヲ異ニス／柳条ハ脆滑ニシテ蓴油ノゴトク膩ラカナリ／松葉ハ晶瑩ニシテ蛛網ノゴトク封ヅ／氷柱四檐繖角ニ垂レ／真珠万点裘茸ニ結ブ／詩人何ゾ管セン休徴ノ事／奇景｜看ノアタリニ驚ク老イニ至リテ逢フトハ〕按ズルニ曾南豊ノ集中ニ淞トイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "この額の筆者｜丹治瑩斎というのは毅堂の仕えた久留里の藩主黒田伊勢守直質の雅号であろう。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち先年の東本願寺光瑩上人の葬式の時に、六人の「宝来」と称する者の参加したのはこれである。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初の弥撒が唱えられた瑩窟は、単にローマの一｜洞窟だったのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
