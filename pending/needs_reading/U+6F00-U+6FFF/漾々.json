        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "薄闇が、ただ漾々と身辺に動いてゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄闇が、ただ漾々と身邊に動いてゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふとかたわらを見れば、漾々たる霞が池は、霜の置きたるように微黯き月影を宿せり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しその河は漾々として無辺際から無辺際へと流れて行く。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "波は漾々として遠く烟り、月は朧に一湾の真砂を照して、空も汀も淡白き中に、立尽せる二人の姿は墨の滴りたるやうの影を作れり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "楠氏の正統篠姫は、翠華漾々平和の国、周防大内家へ行ったのである。",
              "citation": {
                "source": "弓道中祖伝",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその中へ飛び込んで、恍惚として泳ぎ、漾々として波のまにまにただよい、そして嵐の中に全く沈んでしまうことができる。",
              "citation": {
                "source": "神童",
                "author": "DAS WUNDERKIND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
