        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "わしは昨日舎衛城へ行って演若という気狂いの話しを聞いた。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "演若は或朝、鏡で顔を映して見た。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "演若は鏡の中に頭の無いのに驚いて、自分を化物と思い込んだ。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "演若の頭は矢張り自分の胴の上について居るのだ。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "演若は自分の粗忽から、自分で自分の頭を失うたと思った。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "演若の心がそう思っても演若の頭は元より演若の肩の上に据わって居るのである。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
