        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "道衍｜少きより学を好み詩を工にし、高啓と友とし善く、宋濂にも推奨され、逃虚子集十巻を世に留めしほどの文才あるものなれば、道衍や筆を執りけん、或は又金忠の輩や詞を綴りけん、いずれにせよ、柔を外にして剛を懐き、己を護りて人を責むる、いと力ある文字なり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "孝孺は宗濂の門下の巨珠にして、道衍と宋濂とは蓋し文字の交あり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "道衍の少きや、学を好み詩を工にして、濂の推奨するところとなる。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "宋濂に故愚庵先生｜方公墓銘文あり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "濂又曰く、古に謂わゆる体道成徳の人、先生誠に庶幾焉と。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋し濂が諛墓の辞にあらず。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "時に宋濂一代の大儒として太祖の優待を受け、文章徳業、天下の仰望するところとなり、四方の学者、悉く称して太史公となして、姓氏を以てせず。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "濂｜字は、景濂、其先金華の潜渓の人なるを以て潜渓と号す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "太祖｜濂を廷に誉めて曰く、宋景濂｜朕に事うること十九年、未だ嘗て一｜言の偽あらず、一人の短を誚らず、始終｜二無し、たゞに君子のみならず、抑賢と謂う可しと。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "太祖の濂を視ること是の如し。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "濂の人品｜想う可き也。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "孝孺｜洪武の九年を以て、濂に見えて弟子となる。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "濂時に年六十八、孝孺を得て大に之を喜ぶ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "抽斎は彼の終始｜濂渓の学を奉じていた艮斎とは深く交らなかったのに、これに良三を託したのは、良三の吏材たるべきを知って、これを培養することを謀ったのであろう。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "周濂溪、張横渠、程明道、程伊川、これらの学説を集成したものが、すなわち朱子の学である。",
              "citation": {
                "source": "前記天満焼",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明の始めに出た鄭濂と云ふ人は、同居三百年一家三千口と云はれて居ります。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、後の鄭濂の家では三百年の間別家せずに居つたので、三千人が同居したと云ふのですから、隨分なものでありませう。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "明初の鄭濂の一家は三千人も同居して居つたと云ふ大家族ですが、此人に明の天子が、お前は能く一家和合して居るが、その和合の祕訣は何處にあるかと云うて問ひました。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "處が鄭濂は即座に「護守祖訓。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "――呉景濂氏に会った時、氏は大きな一分刈の頭に、紫の膏薬を貼りつけていた。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "古人云ふ、「主靜立人極」○宋、周濂溪の語是其至誠の地位なり、不愼べけんや、人極を立ざるべけんや。",
              "citation": {
                "source": "遺訓",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
