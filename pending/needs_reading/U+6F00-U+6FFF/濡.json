        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "衣は雨に濡れたらんが如し。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "道の真中は乾いているが、両側の田についている所は、露にしとしとに濡れて、いろいろの草が花を開いてる。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子は雑巾がけをしてからうっかり忘れてしまって、蓆を入れずに野へ出た処、間がわるくその日雨が降ったから、その蓆十枚ばかりを濡らしてしまった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「家は腰高の塗骨障子を境にして居間と台所との二間のみなれど竹の濡縁の外には聊かなる小庭ありと覚しく、手水鉢のほとりより竹の板目には蔦をからませ、高く釣りたる棚の上には植木鉢を置きたるに、猶表側の見付を見れば入口の庇、戸袋、板目なぞも狭き処を皆それぞれに意匠して網代、船板、洒竹などを用ゐ云々」。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてびしよびしよに濡れてしまつた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "影も　からだも　生活も　悲哀でびしよびしよに濡れてしまつた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は貧乏を見たのですこのびたびたする雨氣の中にずつくり濡れたる　孤獨の　非常に厭やらしいものを見たのです。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞳をひらけば瞳は追憶の情侈になづんで濡れるやうだ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おん脚白く濡らし怒りはげしきにたへざれば足なやみひとり海邊をわたらせたまふ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともすれば學校を休み泣き濡れて小出の林を歩きし昔。",
              "citation": {
                "source": "短歌",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春雨や小磯の小貝｜濡るほど　終日｜霏々として降り続いている春雨の中で、女の白い爪のように、仄かに濡れて光っている磯辺の小貝が、悩ましくも印象強く感じられる。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏祭の日には、家々の軒に、あやめや、菖蒲や、百合などの草花を挿して置くので、それが雨に濡れて茂り、町中が忽ち青々たる草原のようになってしまう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕立や草葉を掴む群雀　急の夕立に打たれて、翼を濡らした雀たちが、飛ぼうとして飛び得ず、麦の穂や草の葉を掴んでまごついているのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人と結婚して間もない頃、雨でずぶ濡れになった小猫を拾って帰り、その泥だらけのままの猫を懐中に入れて、長い間やさしく暖めていた。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪鞋をはいて歩く男のその濡れた藁は重さうにぐつしより濡れて、凍傷を防ぐための赤毛布の脚絆は水を吸ひ飽きたスポンヂのやうに水氣でふくらむ。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベランダの板は露に濡て、夜冷えがしてゐた。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はやくしないと、あたしのジバンが濡れちやふわよう、お祖母さん！",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "蹴り出されたお皿は庭の土の上で、だんだん雨に濡れてゐた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "柿の幹も見る間に余りなく濡れていつた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして赤坊の唾液で濡れた拑子を指先で挟んで持つてゐながら、母親が子供を揺りながら泣いたり、その子の瞳を見入つて一言二言狂気のやうに云つたりするのを「そんなにして俺が何が出来るものか」と思つて立つてゐた。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "割烹着の胃に当る辺りが濡れてゐるところを見ると、今の今まで茶碗でも洗つてゐたという風だ。",
              "citation": {
                "source": "西部通信",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "響の雨は、濡れ冠る！",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘉門次が一行の案内を務めるのは、言うまでもない、雨でグッショリ濡れた青草や、仆れている朽木からは、人の嗅覚をそそるような古い匂いがして、噎びそうだ、足が早いので、一丁も先になった嘉門次は、私を振り返って「他所の人足は使いづらくて困る」とブツブツ言いながら、赤石の河原に出た。",
              "citation": {
                "source": "槍ヶ岳第三回登山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
