          "literary": [
            {
              "text": "これ等はみな、わたしの方がおまえに索かれる魅点ばかりを述べたものだ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでわたしがおまえに与える魅点の番である。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの恋の打明けばなしの時、わたしはおまえの魅点だけを語って、わたし自身の魅点には一切触れなかった。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
