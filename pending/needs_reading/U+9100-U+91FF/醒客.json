        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレから江戸に来て、江戸が東京となっても、芝居見物の事は思出しもせず、又その機会もなくして居る中に、今を去ること凡そ十五、六年前、不図した事で始めて東京の芝居を見て、その時｜戯れに、誰道名優伎絶倫先生遊戯事尤新春風五十独醒客却作梨園一酔人と云う詩が出来ました。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥山閣から――花屋敷とよばれた中にあった、宇治の鳳凰堂のような五層楼――凌雲閣を睨む人に正直正太夫の緑雨醒客のあるのも面白い。",
              "citation": {
                "source": "田沢稲船",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "子は別に不願醒客と号した。",
              "citation": {
                "source": "梅雨晴",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "不願醒客訪来りしかば築地橋頭の酒亭に飲む。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "不願醒客と木曜会に徃く。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "不願醒客と麻布網代町の妓家に飲む。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "不願醒客と三十間堀に飲む。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "不願醒客と南鍋町弥生に飲む。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "不願醒客と風月堂に会し、月中漫歩、九段の妓窩に徃きて大に飲む。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
