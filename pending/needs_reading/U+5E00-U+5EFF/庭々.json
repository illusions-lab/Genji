        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこにはウクライナ地方の庭々で見られるありとある花があった。",
              "citation": {
                "source": "紅い花",
                "author": "КРАСНЫЙ ЦВЕТОК",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの庭々の冬ざれの樣子が、巧みに配された人事と相俟つて、たいへん興趣深く語られてゐる。",
              "citation": {
                "source": "「文藝林泉」讀後",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "餘りに凝りすぎて瘠せた庭々のなかを歩いてくると、もはや私のからださへ衰弱するやうな慘酷な造庭技術の中で、寧ろ私は嘘ばかり見て歩いてゐるのではないかとさへ思はれるのであつた。",
              "citation": {
                "source": "京洛日記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "薪一休寺、西芳寺、龍安寺、高桐院、――それらの庭々の苔はまるでゆめのやうに、眼に殘つて蒼かつた。",
              "citation": {
                "source": "京洛日記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "境内、山内、末院の庭々はいうまでもない。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
