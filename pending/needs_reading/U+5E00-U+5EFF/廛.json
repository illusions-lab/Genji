          "literary": [
            {
              "text": "だから、考へると、市廛の元の作りが訣つて来る様に思ふ。",
              "citation": {
                "source": "たなばたと盆祭りと",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄丕烈は宋版の本百餘種を得て、百宋一廛と號した。",
              "citation": {
                "source": "藏書家の話",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の手の寺院にあるもの、幸にして舞馬の災を免れしといへども、移行く世の気運は永く市廛繁華の間に金石の文字を存ぜしむべきや否や。",
              "citation": {
                "source": "礫川記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "潮ハ方ニ落チテ舟ノ行クコト太ダ駛カニ橋ヲ過グルコト七タビ始メテ市廛ヲ離ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれがおいおいに肆廛となり、往還はやや迂回しつつ、城のすぐ近くを貫ぬくようになった。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
