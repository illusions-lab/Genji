        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "断膓亭襍稾表帋板下絵を描く。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "春陽堂番頭予の全集表帋見本を持来りて示す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座右に在りし狂歌集表帋の綴糸切れたるをつくらふ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "途次榛原帋舗の前を通過ぎし故、雁皮紙罫引帳面を購はむとせしに、近頃雁皮の製本をなす職人少くなり、又之を求むる顧客も稀になりたれば、出来合の品売切になりしまゝ備へ置かずといふ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜臙脂を煮て原稾用罫帋を摺ること四五帖なり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時はかならず暴風力をそへて粉に砕たる沙礫のごとき雪を飛せ、白日も暗夜の如くその慄しき事｜筆帋に尽しがたし。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "女太夫とか鳥追ひの三味線にめでたき哥をうたひ、娘の児のやり羽子、男の児の帋鳶、見るもの聞ものめでたきなかに、初日影花やかにさし昇たる、実に新玉の春とこそいふべけれ。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "木やり音頭取五七人花やかなる色木綿の衣類に彩帋の麾採て材木の上にありて木やりをうたふ。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "神事をはれば人々｜離散して普光寺に入り、初棄置たる衣類懐中物を視るに鼻帋一枚だに失る事なし、掠れば即座に神罰あるゆゑなり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "二百四五十帋の自筆なり嘗梱外へ出さゞりしを、狂哥堂真顔翁｜珎書なれば懇望してかの家より借りたる時｜余も亡兄とともに読しことありき。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "又木履、天井のした、角少し壁の落たる処より出、次の鴨居の所にて、すこし低ふなり、夫よりまた高くなり、次の押込のから帋に、木履のはま喰付候、それを見て、みな／＼帰り、夫より寝候へば、蚊屋真白くなり、浪打如く也。",
              "citation": {
                "source": "三次実録物語",
                "author": "稲生武太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "建安十二年十二月吉日再拝「帋筆をお下げあれ」「おすみになりましたか」「先生がお帰りになられたらはばかりながらこの書簡を座下に呈して下さい」　云いのこして、玄徳は堂をおり、関羽、張飛をつれて、黙々、帰って行った。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜々、秋の気は蕭索として、冷涼な風は帳をゆすり、秘壇の燈や紅帋金箋の祭華をもそよそよ吹いた。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "長竿に板の武者絵や帋幟　　　　※村　この幟も同類である。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
