        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして乾草の代は錏一文だつて払ふこつちやないぞ！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "格式は一等本座と云ふので法類仲間で幅の利く方だが、交際や何かに入費の掛る割に寺の収入と云ふのは錏一文無かつた。",
              "citation": {
                "source": "蓬生",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "元の渡世へ戻りさえすれば、うぬに銭金は錏一文なくても、食う寝るには困らねえ。",
              "citation": {
                "source": "沓掛時次郎　三幕十場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
