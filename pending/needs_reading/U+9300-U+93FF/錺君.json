          "literary": [
            {
              "text": "」「鐙君や錺君と格段に違いますか。",
              "citation": {
                "source": "心のアンテナ",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀さんに向って対等意識を持ち始めた鐙君と錺君は当然同一の問題を考えた。",
              "citation": {
                "source": "心のアンテナ",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐙君と錺君は本能的に自己を主張した。",
              "citation": {
                "source": "心のアンテナ",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物音を聞きつけて銀さんが駈けつけたら、鐙君と錺君が睨み合っていた。",
              "citation": {
                "source": "心のアンテナ",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
