          "literary": [
            {
              "text": "葉末葉末につたわって、すこやかな幹を顫慄させる泉の深い感応。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗い内庭のなかほどに佇んで、出て来た建物をふりかえり、明るい大窓の中をまだ黒く動いている列の影を見たとき、伸子は深い顫慄におそわれた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雄のささきりは上の方の青い葉と茎の間に、逆さになってとまり、翅を顫慄させ乍ら雌を呼んでいた。",
              "citation": {
                "source": "青べか日記",
                "author": "――吾が生活　し・さ",
                "note": "青空文庫"
              }
            }
          ]
        }
