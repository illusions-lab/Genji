          "literary": [
            {
              "text": "事実はそうでないが、ベーリング海峡の発見者といわれる丁抹人。",
              "citation": {
                "source": "紅毛傾城",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或｜丁抹人が話したのでは、四川や広東には六年いても、屍姦の噂は聞かなかったのが、上海では近々三週間の内に、二つも実例が見当ったそうです。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳳陽丸に乗った時は、偉い丁抹人と一しょになった。",
              "citation": {
                "source": "長江游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
