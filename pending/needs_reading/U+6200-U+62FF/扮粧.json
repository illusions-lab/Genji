          "literary": [
            {
              "text": "自分の扮粧がその人たちのどれよりも立ちまさっている自信を十二｜分に持っていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "機を見るにさかしい者たちは、遊女らの扮粧を上流の美女に似せ、それよりも放逸で、派手やかであり、淫蕩な裲襠姿をつくりだし、その上に教養もくわえた。",
              "citation": {
                "source": "明治大正美女追憶",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が明けますと太郎と二郎と二人して、弁当を腰に下げて、杖を持て、草鞋を穿いて、同じ、扮粧で出掛たのであります。",
              "citation": {
                "source": "迷い路",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
