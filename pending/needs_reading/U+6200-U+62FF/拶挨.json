          "literary": [
            {
              "text": "安五郎、　「なッ、な、な、何をするんだ」　「おッ、安五郎、人が両手をついて礼儀を厚く拶挨しているんだぞ。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一言拶挨に来たんだ」　吉兵衛が、　「じゃ、手前が小五郎どんを……？",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "錢形の親分に御拶挨をしないか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "正月の香り",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘のお夏は冷たいほど素氣ない拶挨をしたつきり、お茶を運んで來て、あとは顏を見せないのは、八五郎をがつかりさせます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "橋場の人魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "八五郎を留め置きますから」　拶挨もそこ／＼に飛び出してしまつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "江戸の夜光石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御拶挨ですね、親分。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "江戸の夜光石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
