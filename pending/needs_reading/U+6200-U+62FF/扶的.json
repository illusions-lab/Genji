          "literary": [
            {
              "text": "人工で培養した細菌やそれを種ゑた動物の血清で、窒扶斯を防ぎ実扶的里を直すことが出来る。",
              "citation": {
                "source": "妄想",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この妹は父の亡くなる何年前かに実扶的里亜で死んでしまった。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は固より実扶的里亜と云う名前さえ知らなかった。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "宅へ見舞に来た松本に、御前も実扶的里亜かと調戯われて、うんそうじゃないよ僕軍人だよと答えたのを今だに忘れずにいる。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この少し以前、三女らくは実扶的利亜に罹って三歳で亡なっていた。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は前にもいった如く、明治廿年に三歳の楽女を実扶的利で失った。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
