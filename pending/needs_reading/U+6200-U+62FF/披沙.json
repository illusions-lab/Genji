          "literary": [
            {
              "text": "明の謝肇※の『文海披沙』卷七に、左の如き記事がある。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "また曰く、「鬼は人の影、死は生の終」と）文海披沙曰、生以形運、而死以神運。",
              "citation": {
                "source": "通俗講義　霊魂不滅論",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "（『文海披沙』に曰く、「生は形をもって運り、死は神をもって運る」と）理学類編曰、問人死魂魄便散否、晦菴答曰散矣。",
              "citation": {
                "source": "通俗講義　霊魂不滅論",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "文海披沙されば獣中最可悪は狼なり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
