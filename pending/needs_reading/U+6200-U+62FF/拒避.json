          "literary": [
            {
              "text": "という社会的な戦争拒避の声とした例はまれであった。",
              "citation": {
                "source": "今年のことば",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "養育院のあるものはついに新たな収容を拒避したが、これは極めて当然なことである。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "観劇の欲望と、余裕と、必要とをさへもつてゐる人々、娯楽と教養とのために演劇に親しまうとする最も健全なる大衆層、自発的に、人を誘つてでも、たまには少々の趣味的見栄にさへも劇場の切符を買はうとする頼もしい連中を、悉く拒避して、どこに大衆劇があるのであらう。",
              "citation": {
                "source": "演劇の大衆性",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "心で拒避して目が見てゐるのだ。",
              "citation": {
                "source": "蒼白き巣窟",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
