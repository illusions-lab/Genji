        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "詩の頷聯に、「病脚不趨官路険、微量難敵酒軍長」と云つて、「此日不応雪堂招飲、故第四及之」と題下に自註してある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶山が甲戌に江戸に再遊した時、謙甫は重陽に牛込の家に招飲した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "文壇の諸先輩と共に帝国ホテルに開かれた劇場の晩餐会に招飲せられたことがあった。",
              "citation": {
                "source": "十日の菊",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "米刃堂主人文明寄稿家を深川八幡前の鰻屋宮川に招飲す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "此日選評者一同を東仲通鳥屋末広に招飲す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "松莚子小山内氏等と東仲通の末広に郡氏を招飲す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "松莚子余と川尻氏とを竈河岸の八新に招飲す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "花月主人素人写真展覧会を催さむとて、三越呉服店事務員及余等両三人を京橋角東洋軒に招飲す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "松莚子竈河岸の八新に岡、川尻、及余の三人を招飲す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶応義塾教授小泉沢木の二氏、小山内氏と余とを八丁堀の偕楽園に招飲す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "当夜は宮薗千斎は無論の事｜宇治紫仙都吾中らも招飲致候間お互に親類のおつきあひその御覚悟十分しかるべく候。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一は「南谷君晩香園招飲之韻ニ※ユ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月二十五日に薬研堀に住した書家中沢雪城が大槻磐渓、春田九皐、大沼枕山、鷲津毅堂の四家をその居宅なる寿康堂に招飲した。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "律詩の題言に「伊賀中将公名士ヲ本邸ニ招飲ス余モマタコレニ与ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "新生社主人青山氏谷崎氏が上京を機會に、同氏と余とを招飮したき趣、昨日社員酒井氏を遣はされしかど、病後のつかれ猶痊えざれば、江戸川の堤に近き郵便局に至り電報にて辭意を報ず。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "凌霜子が海神の別宅に招飮せられ共に十六夜の月を賞す。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一週日を經て吉田君起草の刊行主意書の印刷成りたれば、與謝野君はいざ此の擧を汎く世の讀書家に告ぐべしとて、まづ東京横濱兩市の新聞社中特に文事の報道を擔當する記者を築地精養軒に招飮す。",
              "citation": {
                "source": "鴎外全集刊行の記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
