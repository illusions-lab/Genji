          "literary": [
            {
              "text": "○　雑誌記者｜屡来って女子拒婚問題の事を問う。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余初め拒婚の字義を解せず、為に婦人雑誌を購読して漸くその意を審かにするを得たり。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "良家の女相約して男子の花柳病を患うるものに嫁せざる事を名けて拒婚同盟となすという。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "拒婚の字義を按ずるに拒は強請せられて後これを防ぐの意。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
