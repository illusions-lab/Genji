          "literary": [
            {
              "text": "シップは喜望峰狗頭猴、下より来る敵を石などを集め抛下して防ぐといい、ダムピエート・ウェーファーは猴が石で牡蠣を叩き開くを記す。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "抛下す、吾家の骨董羹。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし又首肯せざらん乎、――君の一たび抛下すれば、槓でも棒でも動かざるは既に僕の知る所なり。",
              "citation": {
                "source": "久保田万太郎氏",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
