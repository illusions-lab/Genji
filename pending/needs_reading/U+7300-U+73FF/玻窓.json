          "literary": [
            {
              "text": "家屋も石造｜玻窓にかぎり。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "広東一路泝珠江、看過船居幾万艘、繋纜殖民洲外岸、市声楼影入玻窓。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴波涼月汽声閑、船向南辰星下攀、暁入玻窓何処影、摩尼拉海呂宋山。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "山腹および海岸に乱点せる電灯、玻窓に映射し来たる。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入りて、半輪の明月玻窓を照らすあり。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入り一天雲なく、明月玻窓に入ること前夕のごとし。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
