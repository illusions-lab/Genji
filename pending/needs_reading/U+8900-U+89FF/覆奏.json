        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "とりも直さず、神の御食し物を、神自身のした如く、とり収めて覆奏する事から、転じて、人間の物を神物として供へる、と言ふ用語例になつたものに違ひない。",
              "citation": {
                "source": "村々の祭り",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "此などになると、覆奏・奏覧などの義から遠のいて、献上すると言ふ事になつてゐる。",
              "citation": {
                "source": "村々の祭り",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に転じては、神意の現実化した事を覆奏する義にもなつた。",
              "citation": {
                "source": "ほうとする話",
                "author": "祭りの発生　その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "其が偏つて行つて、神の食国のまつりごとの完全になつた事を言ふ覆奏が盛んになつた。",
              "citation": {
                "source": "ほうとする話",
                "author": "祭りの発生　その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "即、田畠を荒す精霊の代表として、鹿や蟹に、服従を誓はす形の呪言があり、鹿や蟹に扮した者の誓ふ、身ぶりや、覆奏詞があつた。",
              "citation": {
                "source": "偶人信仰の民俗化並びに伝説化せる道",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "謂はゞ「覆奏」が原義に近いのであつた。",
              "citation": {
                "source": "神道に現れた民族論理",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "即覆奏で、まをすと転じたのだ。",
              "citation": {
                "source": "神道に現れた民族論理",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "賀正事は、詔旨に対する覆奏なのであつた。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことゞふは、かけあひの詞を挑みかける義で、※歌会の場などに言ふのは、覆奏を促す呪言の形式を見せて居る。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "「亀卜祭文」と言ふは、亀卜の亀のした覆奏の形式の変形と見るべきもので、此に対しての呪言を求めれば、中臣太詔詞の外はない。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "即鹿・蟹に対する呪言及び其副演の間に、当の田畑を荒す精霊（鹿・蟹を代表に）に扮した者の誓ふ身ぶりや、覆奏詞があつたに違ひない。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "此伝宣の詔旨――より寧、覆奏――は、分化して宣命に進むものと、ある呪言の本縁を詳しく人に聴かせる叙事詩（物語）に向ふものとが出来て来た。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、正確に信仰上の事実として云へば、春｜天降られた日の御子が、初春のみことをみこともつて、扨、秋に至つて、みこともつた事の結果の覆奏をなされる。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "此覆奏が、即、まつると云ふ語の最古の意義である。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "覆奏詞をまをす儀だから、まつりごとと言ひ慣したわけだ。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂天つ祝詞の部分に於いて、発唱者と被唱者との間に問答が行はれた事は、祝詞に於ける所謂、返し祝詞或は覆奏の存在によつて知る事が出来る。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "學部の覆奏を見るとかうある。",
              "citation": {
                "source": "支那近世の國粹主義",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰は幾日に送りまつりて、覆奏さむ」と問ひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく平け訖へて、まゐ上りて覆奏しき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここを以ちておのもおのも遣さえし國の政を和し言向けて、覆奏しき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに覆奏まをさく、「大神を拜みたまへるに因りて、大御子物詔りたまひつ。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "（歌謠番號二四）　かれかく撥ひ治めて、まゐ上りて、覆奏まをしたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
