        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "木蘇の御嶽山が、その角々しき峰に白雪を戴いて、青ぎった空に美しい。",
              "citation": {
                "source": "白菊",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "手拭を顔に掛けたり、外套をかぶつたりしてゐるそのいぎたない風景の上に、電燈は明々と明つて、幾つもの仕切板の角々のあのラックの光沢に反射してゐる。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "儀礼的の形式主義に力の角々を嘗め丸められてゐる。",
              "citation": {
                "source": "英国メーデーの記",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「中の島」の基点になるポン・ド・グルネルの橋の突き出しに立っている自由の女神の銅像が炎天に※えて姿態の角々から青空に陽炎を立てゝいるように見える。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "眩しがる二｜尾のキヤリコの金魚は、多少怪訝の動作を鰭の角々のそよぎに示しながら、急に代つた水の爽快さを楽しむらしかつた。",
              "citation": {
                "source": "花は勁し",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "床の一隅、幽欝な鉛製の八つ橋の角々に、王朝時代の情熱を想はせる燕子花。",
              "citation": {
                "source": "花は勁し",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気｜洋燈が煌々と燿いて書棚の角々や、金文字入りの書や、置時計や、水彩画の金縁や、籐のソハに敷てある白狐の銀毛などに反射して部屋は綺麗で陽気である、銀之助はこれが好である。",
              "citation": {
                "source": "節操",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてはいよいよ武光という人もありけり、縁起などいうものは多く真とし難きものなれど、偽り飾れる疑ありて信とし難しものの端々にかえって信とすべきものの現るる習いなることは、譬えば鍍金せるものの角々に真の質の見るるが如しなどおもう折しも、按摩取りの老いたるが入り来りたり。",
              "citation": {
                "source": "知々夫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "女としてはからだがたくまし過ぎるけれど、さりとて決して角々しいわけではない。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "角々は暗黒に翳り、ただ中央だけが往来からの余光でかすかに明るい。",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供は扇子を持って、くるくる踊っていたが、角々がきちんと極まっていた。",
              "citation": {
                "source": "挿話",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "車がようやく池の端に出ると葉子は右、左、と細い道筋の角々でさしずした。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全体が溜塗りのようになっていて、角々には厚い金物が頑丈に打付けてございます。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾張町の角や、京橋の際には、歳の市商人の小屋も掛けられ、その他の角々にも紙鳶や羽子板などを売る店も出た。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ街々を縫つて、かの百姓馬子は青物を呼び賣りしてゐるし、また人通りのある角々には、例の燒きもろこしの店が出てゐる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "種彦は、江戸で二月八日｜御事始に笊を門口に懸けた旧俗を釈くとて、昔より目籠は鬼の怖るるといい習わせり、これは目籠の底の角々は☆｜如此晴明九字（あるいは曰く晴明の判）という物なればなり。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その仄かな光線に照し出された岩の角々は皆、福太郎の見慣れたものばかりであったから……。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "山腹を這う蟻まで見えやしまいかと思うくらいハッキリと岩の角々が太陽に輝いている……と思う間に、その大山脈の絶頂から真逆落しに七千噸の巨体が黒煙を棚引かせて辷り落ちる。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "平面の処や角々は翁自身の工夫でどうにか出来たが、蝶番いの処がわからないので習いに来たのであったという。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "金春を下絵、金剛を荒彫りとすれば、観世は彫り上げて磨きをかけて角々を丸くしたようなもので、見方によっては金春の古雅を転化して円満味とし、金剛の尖鋭さを消化して華麗味としたものかとも考えられる。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　さう言つて学生に別れた岩村男は、控室に帰つて角々の摩り切れた例の紙挟を小脇に挟むだと思ふと、直ぐ表通りへ飛び出した。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それはさうと、君がこちらにゐる頃は簡単なるダンス・ホールなども見あたらなくて、屡々君と憂鬱を感じたことがあつたが、近頃は彼方此方の角々にも多くのホールが出来て、難なく、このまゝ出入することが自由だ。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さう厭に角々しく云はないでもいゝぢやないか、何が気に障つたんだか知らないが若少し落着いてはつきり話して呉れても好ささうなものぢやアないか、えゝ？",
              "citation": {
                "source": "妄想患者",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、そこでペトゥルーシカとセリファンがいったい何をしたかということは、神様より他には御存じあるまいが、とにかく一時間ばかりすると、二人は腕を組みあって、黙りこくったまま、お互いに足許に注意したり、角々を警戒しながら、そこから出て来た。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてしばらく行ってから角々で二、三度あとをふり返って見たが、あとをつけて来るらしいものは何にもなかった。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は幼年学校仕込みの「廻れ右」をわざと角々しくやって、典獄室を出た。",
              "citation": {
                "source": "獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "噴水の周囲を大輪に抱いてゐる水溜りの幾つかの角々は青銅の獅子の頭になつてゐて、それらの街に向つて吠えてゐる口腔からは銀色の水が切りに滾れてゐる。",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲る角々の木を伐り倒し、崖をけずって新しい土を掘り返すのが精一ぱいであった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "体の妙に細い角々しい曲線の手先もうでも太さの同じな、かおのほね立った動く時に埃及模様の中の人間のようになる人がある。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "光君は長い廊を角々の柱に結びつけた赤の糸をたよりにたどって行かれた。",
              "citation": {
                "source": "錦木",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
