        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "新町の町はづれから、枯々な桑畠の間を通つて、思はず斯の郊外の一角へ出たのである。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "千曲川の水は黄緑の色に濁つて、声も無く流れて遠い海の方へ――其岸に蹲るやうな低い楊柳の枯々となつた光景――あゝ、依然として旧の通りな山河の眺望は、一層丑松の目を傷ましめた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは牛の角の癢くなるといふ頃で、斯の枯々な山躑躅が黄や赤に咲乱れて居たことを思出した。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯々とした草土手のところで、丑松は蓮太郎と一緒に成つた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯々な桑畠の間には、其車の音がから／＼と響き渡つて、随いて行く犬の叫び声も何となく喜ばしさうに聞える。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日一日の凩で、急に枯々な木立も目につき、梢も坊主になり、何となく野山の景色が寂しく冬らしくなつた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "時としては其冬木の姿を影のやうに見て進み、時としては其枯々な枝の下を潜るやうにして通り抜けた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子を開けて眺めると、例の銀杏の枯々な梢を経てゝ、雪に包まれた町々の光景が見渡される。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "丑松は頬の紅い少年と少年との間をあちこちと歩いて、別離の言葉を交換したり、ある時は一つところに佇立つて、是から将来のことを話して聞せたり、ある時は又た霙の降るなかを出て、枯々な岸の柳の下に立つて、船橋を渡つて来る生徒の一群を待ち眺めたりした。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "外の樹木の黄に枯々とした中に、まだ緑勝な蔭をとどめたところも有る。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯々とした桑畠に茶褐色に残った霜葉なぞも左右に吹き靡いていた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は枯々とした草土手に身を持たせ掛けて、眺め入った。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒ずんだ土、不規則な石垣、枯々な桑の枝、畦の草、田の面に乾した新しい藁、それから遠くの方に見える森の梢まで、小春の光の充ち溢れていないところは無かった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "近くにある枯々な樹木の梢は、遠い蓼科の山々よりも高いところに見える。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠い森、枯々な梢、一帯の人家、すべて柔かに深い鉛色を帯びて見える。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "その赤土の大波の上は枯々な桑畠で、ウネなりに白い雪が積って、日光の輝きを受けていた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓の外は、枯々な木立もさびしく、野にある人の影もなく、ひっそりとして雪の白く残った谷々、石垣の間の桑畠、茶色な櫟の枯葉なぞが、私の眼に映った。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな話を聞きながら、間もなく私は亭主と連立って屠牛場の門を出た、枯々な桑畠の間には、喜び騒ぐ犬の声々と共に、牛豚の肉を満載した車の音が高く響き渡った。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓側に遠く近く見渡される麦畠のサクの窪みへは雪が積って、それがウネウネと並行した白い線を描いた中に、枯々な雑木なぞがポツンポツンと立つのも見えた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷に面した狭い庭には枯々な柿の樹もあった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓬の枯れたのや、その他種々な雑草の枯れ死んだ中に、細く短い芝草が緑を保って、半ば黄に、半ば枯々としたのもある。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄ばんだ竹の林、まだ枯々とした柿、李、その他眼にある木立の幹も枝も、皆な雨に濡れて、黒々と穢い寝恍顔をしていない物は無い。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも軽井沢ほど小諸は寒くないので、汽車でここへやって来るに随って、枯々な感じの残った田畠の間には勢よく萌え出した麦が見られる。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "収穫を急がせるような小春の光は、植木屋の屋根、機械場の白壁をかすめ、激しい霜の為に枯々に成った桑畠の間を通して、三吉の家の土壁を照した。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "水に臨んだ柳並木は未だ枯々として、蕭散な感じを与える。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾儕は、枯々な桑畠や、淺く萌出した麥の畠などの間を通つて、こゝまで來たが、來て見ると斯の廣い湯槽の周圍へ集る人々は、いづれも東京や横濱あたりで出逢さうな人達ばかりである。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "この村の出はづれに枯々とした耕地があつて、向ふの方には屋根の低い小屋が見える。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯々とした裏庭に出て、父さん達は『シヨクノ』の遊びにする細い木を探したり、それを手ごろの長さに切つたり、地べたへよく打ちこめるやうに先の方を尖らせたり、時にはもう幾度か勝負をした揚句に土のついて齒のこぼれたやつを削り直したりして遊びました。",
              "citation": {
                "source": "ふるさと",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
