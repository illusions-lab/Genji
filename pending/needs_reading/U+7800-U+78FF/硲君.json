          "literary": [
            {
              "text": "当時も正宗氏や硲君も来ていました。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時もこの宿に硲君も正宗氏なども来ていて、毎日近くのシャトウやオリーブの林を描きに出かけたものだった。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、林君や、硲君や、その他の連中が多かったので大変楽だった。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "硲君は、一足先きへ出かけた。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の頃、硲伊之助が、非常な達筆を以つて水彩がかつた大柄の仕事をしてゐましたが、硲君は十七八歳でしたらう。",
              "citation": {
                "source": "私のこと",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
