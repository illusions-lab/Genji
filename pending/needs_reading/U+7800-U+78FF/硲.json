        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "断崖と丘の硲から、細い滝がひとすじ流れ出ていた。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時も正宗氏や硲君も来ていました。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時もこの宿に硲君も正宗氏なども来ていて、毎日近くのシャトウやオリーブの林を描きに出かけたものだった。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "二等のスモーキングルームで林君や、硲、長島君などと夜更けまでしゃべって、一寸湯に入って寝た。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、林君や、硲君や、その他の連中が多かったので大変楽だった。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュネーブホテルで一泊のうえ、夜の急行の一等車で林、硲、長島と僕と四人づれでパリへ入った。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は林、硲、長島と共に、よい家をかりて、その下宿（パンション）で、一人ずつサッパリした部屋をかりてすんでいる。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "硲君は、一足先きへ出かけた。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "榊原と硲が巴里へ帰ったので、今 Cagnes のホテルは正宗氏と僕と二人切りになってしまった。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　妙だと思っていたら、新聞報ずるところは硲、小山の両中堅の春陽会脱退だ。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の頃、硲伊之助が、非常な達筆を以つて水彩がかつた大柄の仕事をしてゐましたが、硲君は十七八歳でしたらう。",
              "citation": {
                "source": "私のこと",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
