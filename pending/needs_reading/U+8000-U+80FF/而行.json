          "literary": [
            {
              "text": "即ち「君子素其位而行、不願乎其外」の義である。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "小田県へ奉還金為受取、未明より人力車に而行。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは胆欲大而心欲小、知欲円而行欲方というのであった。",
              "citation": {
                "source": "陸判",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "客室の※間には、『天樂』の額を掲げ、床の間には、『化而裁之存于變、推而行之存于通』の一軸を掛く。",
              "citation": {
                "source": "沖の小島",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "広吉茂吉は半郷学校え天子様のシヤシン下るに付而行。",
              "citation": {
                "source": "念珠集",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子其維持正氣而行矣。",
              "citation": {
                "source": "遺篇",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "雖篤學附驥尾而行益顯。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "伯夷列傳第一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
