        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "われは聚珍館（ムゼオ、ボルボニイコ）、劇場、公苑など尋ねめぐりて、未だ三日ならぬに、早く此都會の風俗のおほかたを知ることを得たり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は此地の聚珍館内なる瓶又は壺の數々を擧げて、これに畫きし畫工に説き及ぼし、次いでその畫工の技巧を辯明したり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は猶其｜詳なるを教へんために、不日我を聚珍館に連れ往かんと約せり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "共に聚珍館に遊ばんには、これに増す人あるべからず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「古武鑑」、古江戸図、古銭は抽斎の聚珍家として蒐集した所である。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」宋の李如圭の儀礼釈宮一巻は経苑、武英殿聚珍版書等に収められてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "（５）『東觀漢記』卷二十（『武英殿聚珍版全書』所收）。",
              "citation": {
                "source": "紙の歴史",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
