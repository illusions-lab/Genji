          "literary": [
            {
              "text": "元来｜局束にこまり候故、次韻は別而出来兼候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "御上東京より御帰藩被遊候に付、四半時平服に而出仕。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "御隠居様昨卯上刻御逝去被遊候に付、為伺御機嫌今五日四時より九時迄之内、改服に而出仕可致旨。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "石川御供に而出立に付暇乞に行飲。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝飯より人車三乗に而出立。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸婚律には、諸妻無七出及義絶之状而出之者。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "以賜金竊投於其家而出。",
              "citation": {
                "source": "遺篇",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
