          "literary": [
            {
              "text": "故君子事来而心始現、事去而心随空。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは胆欲大而心欲小、知欲円而行欲方というのであった。",
              "citation": {
                "source": "陸判",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、お屋べどのの養子ハ如何様なる暮し方にや、定而心配斗にて気之毒なる事にてあるべく、おやべにハ早、どん腹と屋らおほきになりし事、とくより承りしが、男子出生なれバよろしからんと存じ候。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十二月四日　坂本権平、一同あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "一〇一　身有老少、而心無老少。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝知而心與左右手背乎。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "孫子呉起列傳第五",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
