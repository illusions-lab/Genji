        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "叔母や本田は論ずるに足らんが、お勢が、品格々々と口癖に云ッているお勢が、あんな猥褻な席に連ッている……しかも一所に成ッて巫山戯ている……平生の持論は何処へ遣ッた、何の為めに学問をした、｜先自侮而後人侮之、その位の事は承知しているだろう、それでいてあんな真似を……実に淫哇だ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "┌精神乖離症└精神分裂症┌今日一日の命│大死一番絶後蘇生└死而後已┌剣道四病│　　驚、恐、疑、惑└剣道四綱　　　一眼二足三膽四力　十二月五日　初雪、晴。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃曰、従前条約、｜雖用大君名称、｜自今而後、｜当換以天皇称、而諸国交際之儀、｜専命有司等。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "老子はその『道徳經』のうちに、失道而後徳。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "右刀ハ曽而後藤も来国光と鑒識致候。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十月五日　吉井友実あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "兼而後藤も老母と一子とがあるとやらニて、是も長崎へつれだすとて色々咄合仕候。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年六月二十四日　乙女、おやべあて",
                "note": "青空文庫"
              }
            },
            {
              "text": "二一　畏死者生後之情也、有躯殼而後有是情。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "五一　此學吾人一生負擔、當斃而後已。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "九四　凡區處人事、當先慮其結局處、而後下手。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　私儀狂言作者志望につき福地先生｜門生と相成貴座楽屋へ出入被差許候上者劇道の秘事楽屋一切の密事｜決而口外｜致間敷候｜依而後日のため一札如件　歌舞伎座稽古は後々まで三階運動場を使用するが例なり。",
              "citation": {
                "source": "書かでもの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生宮内省に入り帝室博物館長に任ぜられてより而後全く文筆に遠ざかるべしとのことなり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "自今而後外五位資人の選限は、宜しく令によりて之を行ふべし。",
              "citation": {
                "source": "武士を夷ということの考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "而後在家軒を列ね、竟に遊里傾城町と成云云。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "而後為之宮室、」とか、漢書に「巣居而知風、穴処而知雨、」など、その例がはなはだ多い。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いづれ「當理而後進。",
              "citation": {
                "source": "遺訓",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "審勢而後動」○陳龍川、先主論の語ものにあらずんば、理勢を知るものと云ふべからず。",
              "citation": {
                "source": "遺訓",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に異種の民族異邦の文化両々相比し来て而後真に国民の特質文明の真相を発揮するを得るにあらずや。",
              "citation": {
                "source": "史論の流行",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            }
          ]
        }
