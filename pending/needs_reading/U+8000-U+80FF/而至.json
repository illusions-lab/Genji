          "literary": [
            {
              "text": "註云、客歳春夏之際、吾公嬰疾辞職、而至冬大痊、幕府下特恩之命、賜邸於小川街、而邸未竣重修之功、公来居丸山荘、荘園鉅大深邃、渓山之趣、為不乏矣、公日行渉為娯、故結末及之。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "……而至于邪僻害教。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "○術数｜有余而至誠不足、上杉氏之身ヲ亡ス所以ナリ。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            }
          ]
        }
