        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ムカバキが解けて落ちると、いい加減よれよれになつた麁布の括緒袴があらはれる。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "是は穀の木の皮または葛や藤の皮を織った麁布であると、『阿波志』という書には記している。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらたへの藤江の浦にいさりする海人とか見らん旅行く我をという古い歌があるのを見れば、上古の言葉で「和布」「麁布」と書いたニギタヘ・アラタヘの麁布も、フヂで作ったものだったということが判る。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
