          "literary": [
            {
              "text": "」と捨鞭で歌を読むような見得をいった。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "射向の袖を却て覆ひに捨鞭のみ烈しく打ちて、笑ひを敵に殘すは眼のあたり見るが如し。",
              "citation": {
                "source": "瀧口入道",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは古式の通り捨鞭の扇であります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "お銀様の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬を乗り出すことから、捨鞭の扇を投げるまで、すべて小笠原の古式の通りでありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "お銀様の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
