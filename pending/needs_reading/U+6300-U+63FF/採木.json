        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "採木公司の筏がついて憩んでゐるのを見ると女が乗つてゐる。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅へは満鉄関係の人人の外に、採木公司の人人と其令夫人達とが出迎へて下さるのであつた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達は領事館の晩餐に招かれて行つて、岡田領事御夫婦、採木公司の内藤確介氏御夫婦、吉田氏夫人、満鉄の地方事務所長粟野俊一氏等の人人にお目に掛つた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　翌朝は採木公司の御厚意で特に汽艇を出して頂き、日本市街の埠頭から乗つて、鴨緑江を二里以上溯り、左の山に九連城、右の朝鮮側の山に統軍亭の見える所まで行つて引返した。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽艇は初め出発した埠頭よりも更に下つて、大鉄橋を過ぎ、採木公司の木材置場を見て、またもとの埠頭に帰つて来た。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "張さんは採木公司の社員として勤務し、日本語で歌や詩を作る人である。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "其れで殊に加藤さんが気を揉まれたが、「窮すれば通ずる」と云はうか、たまたま其処へ某採木公司の日本人達が奥から乗つて吉林へ帰られるモオタア・カアが著いたので、その人達の御厚意に由り、私達の一行が代りに乗せて頂くことが出来たのは偶然の幸ひであつた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰路　船中では満鉄理事の神鞭氏常孝、哈爾賓採木公司の深澤暹氏などと乗合せた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
