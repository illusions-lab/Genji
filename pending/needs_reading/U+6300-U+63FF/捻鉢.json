          "literary": [
            {
              "text": "……通りの花屋、花政では、きかない氣の爺さんが、捻鉢卷で、お月見のすゝき、紫苑、女郎花も取添へて、おいでなせえと、やつて居た。",
              "citation": {
                "source": "十六夜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊主頭に捻鉢巻をしているさえ奇抜を通越した大俗さ。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "土と土の山の間に香煙がゆれ、数十人が捻鉢巻で祖先の墓に鍬をふるつてゐる。",
              "citation": {
                "source": "真珠",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "捻鉢巻の人達がみんなガランドウのまはりに集つて来た。",
              "citation": {
                "source": "真珠",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
