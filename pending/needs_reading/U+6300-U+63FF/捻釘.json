        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "木にうちつけてある四つの太い捻釘を引き抜かねばならなかった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は手探りで、一本の捻釘の頭にナイフを差し込むことができ、つぎにも一本の頭に差し込むことができたが、ナイフの刃は欠けるし自分は怪我をした。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "捻釘がばかばかしく長いように思われ、いつまでたっても引き抜けそうになかった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついに最後の捻釘が取れた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこへかくしていたのか、小さな捻釘廻しを硝子戸の鋲へあてた。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "騎手「じゃ、後はまた、これで鋲を締めておいてくんな」　と、トムは窓の外へ出て、捻釘廻しを彼らに預けた。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
