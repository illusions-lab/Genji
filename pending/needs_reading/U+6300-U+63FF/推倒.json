          "literary": [
            {
              "text": "直と足搦掛けて推倒して置いて、馬乗りに乗ってピシャピシャ打つ。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "父はあまりの事に、しばしたゆたひしが、『許したまへ、陛下』と叫びて、王を推倒しつ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「横ざまに推倒されて」以下の文章深く味ふべし。",
              "citation": {
                "source": "処女の純潔を論ず",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら人類の大理想は一切の障壁を推倒して一にならなければ止まぬ。",
              "citation": {
                "source": "謀叛論（草稿）",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの二氏はその議論｜少疵なきにあらずといえども、一世の知勇を推倒し、万古の心胸を開拓す。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            }
          ]
        }
