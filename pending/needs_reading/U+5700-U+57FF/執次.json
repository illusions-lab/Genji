          "literary": [
            {
              "text": "」と執次の者が云ふ。",
              "citation": {
                "source": "二黒の巳",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "下女は何心なく執次いで、私の傍へ持つて参りますを、夫は何故か急き手を差延べまして、こちらへ持つて来ればいいじやないかと、下女を睨みつけました。",
              "citation": {
                "source": "こわれ指環",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "宜しくお執次のほど願わしゅう存じまする」　場馴れない新九郎は、廻りくどいほど丁寧に申し入れた。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……どうぞよしなに、お執次ぎを」と、牡丹に添えて、書面をさしだした。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
