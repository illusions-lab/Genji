        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "曇天暗く埠頭に觀衆の群も散りたり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五年ぶりに帰朝する御主人をお迎えにいそいそ横浜の埠頭、胸おどらせて待っているうちにみるみる顔のだいじなところに紫色の腫物があらわれ、いじくっているうちに、もはや、そのよろこびの若夫人も、ふためと見られぬお岩さま。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、そこから、商埠地の街をはすかいに通りぬけて工場へ通った。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、大連埠頭の碧山荘の苦力を使った経験があった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イ見ヨ、諸君ハ、現ニ、商埠遙ニ散在シテイル貧窮セル居留民達ノ生命ヲモ財産ヲモ保護シテハイナイノデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、張宗昌の落ちのびる列車に乗らず、商埠地にとゞまっていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "船と埠頭の間に渡した色テープの橋の両側で勇ましい軍歌が起った、人々の顔がみんな酔ったように赤く見えた。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二年振りで横浜へ上陸して、埠頭から停車場へ向かう途中で寛闊な日本服を着て素足で歩いている人々を見た時には、永い間カラーやカフスで責めつけられていた旅の緊張が急に解けるような気がしたが、この心持は間もなく裏切られてしまわねばならなかった。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ティアガルテンの冬木立や、オペラの春の夜の人の群や、あるいは地球の北の果の淋しい港の埠頭や、そうした背景の前に立つ佗しげな旅客の絵姿に自分のある日の片影を見出す。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを畢竟するに太陽系がこの星座に向って進んでいるため、丁度船が港に近づく時眼前の景色が目指す埠頭を中心として展開すると同じだと説き、爾来誰も異議を挿むものがなかった。",
              "citation": {
                "source": "宇宙の二大星流",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "埠頭に碇泊している船舶のマストにセイラーが双眼鏡をもってよじ登っていた。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "３　孟買埠頭の藍色の海に室蘭丸が碇泊していた。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "船は何時しか埠頭を遠く離れてゐた。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかに捜して宿をとろうか、それとも今の女のところへ帰ってゆこうか、それはいずれにしても私の憎悪に充ちた荒々しい心はこの港の埠頭で尽きていた。",
              "citation": {
                "source": "冬の蠅",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから十年あまりして私は既に結婚してゐて、良人に連れられて外遊する船がナポリに着いた時、行き違ひに出て行かうとする船に乗り込む遽しいかの女に、埠頭でぱつたり出遭つて、僅かにお互に手を握つた。",
              "citation": {
                "source": "過去世",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊太利の繁華なる港といへば、此處は國中隨一の名港子ープルス、埠頭から海岸通りへかけて商館の數も幾百千、もしや濱島は此港で、其商會とやらを營んで居るのではあるまいかと思ひ浮んだので、實に雲を掴むやうな話だが、萬が一もと旅亭の主人を呼んで聽いて見ると、果然！",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と春枝夫人は此時淋しき笑を浮べて、日出雄少年と共にずつと船端へ行つて、鐵欄に凭れて遙かなる埠頭の方を眺めつゝ『日出雄や、あの向ふに見える高い山を覺えておいでかえ。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ其樣な無※な事もあるまいが、子ープルスの埠頭で、亞尼が泣いて語つた事は、不思議にも的中した。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "船はタンジョンパガールの埠頭に横づけになる。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "埠頭から七マイルの仏寺へ向かう。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊軍の飛行機を輸送船に積み込むというので翼を取りはずした機体を埠頭に並べてある光景の写真が新聞に出ていた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、エイゼンシュテインは港の埠頭における虐殺の残酷さを見せるために、階段をころがり落ちる乳母車を写した。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の若者の出帆を見送ったイドウ親爺とテレーズとが話しながら埠頭を帰って来る。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく宿の嬶に驚かされて跳起※忙として車を埠頭に飛ばし、小蒸気に飛乗つて鳳山丸に乗り付けデッキへ上つて見ると、サルンと覚しき室の前に、ゴタ／＼と集つた人影が見える。",
              "citation": {
                "source": "旅日記",
                "author": "東海道線",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも、彼がやがてリヴァプールの埠頭に姿を現わすであろう、その刹那から、倫敦で下車する瞬間までの間においてである。",
              "citation": {
                "source": "臨時急行列車の紛失",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンディ埠頭にはもうおそらく帰れぬだろうなあ。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの後側の部屋にいる男を、私は埠頭に引き出された時に、はっきり見ることが出来た。",
              "citation": {
                "source": "グロリア・スコット号",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの建物の裏には跳ね上げ式の出口があって、ポールズ埠頭の角がそばなのだが、あそこに口がついていれば、月のない夜、何が通っているのか何か不思議な話でもしてくれるかもしれぬ。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "船尾側ひとつ隣の男のことは、埠頭に連れて行かれたときに、とりわけ気になっていた人物だった。",
              "citation": {
                "source": "グローリア・スコット号",
                "author": "THE \"GLORIA SCOTT\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それは、仕事上の調査で、埠頭の中国人水夫に混じって働いていたからだと。",
              "citation": {
                "source": "瀕死の探偵",
                "author": "THE ADVENTURE OF THE DYING DETECTIVE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
