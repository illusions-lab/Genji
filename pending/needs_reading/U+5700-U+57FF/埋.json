        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "空しく埋めてしまうのは惜しいと云う理由であった。",
              "citation": {
                "source": "牛舎の日記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄ってくれた人たちは当然のこととして、診断書のこと、死亡届のこと、埋葬証のこと、寺のことなど忠実に話してくれる。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "投げ出してるわが子の足に自分の手を添えその足をわが顔へひしと押し当てて横顔に伏している妻は、埋葬の話を聞いてるか聞いていないか、ただ悲しげに力なげに、身をわが子の床に横たえている。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなに深く愛する人でも、どんなに重く敬する人でも、一度心臓音の停止を聞くや、なお幾時間もたたないうちから、埋葬の協議にかかる。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "近隣親族の徒が、この美しい寝顔の前で埋葬を議することを、痛く不快に感じた。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あぶないといっていながら、なぜ早く池を埋めてしまわなかったか。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分もなぜ早く池を埋めなかったか、取り返しのつかぬあやまちであった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひた赤く赤いばかりで光線の出ない太陽が今その半分を山に埋めかけた処、僕は民子が一心入日を拝むしおらしい姿が永く眼に残ってる。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "後には「うもれ（埋）」「うば（嫗）」「うばふ（奪）」「うべ（宜）」などの「う」もこれと同様の音になった。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ竹材には「竹の色｜許由がひさごまだ青し」とか「埋られたおのが涙やまだら竹」というように、それ自身に情趣の深い色っぽさがある。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ竹材には「竹の色許由がひさごまだ青し」とか「埋られたおのが涙やまだら竹」というように、それ自身に情趣の深い色っぽさがある。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが幸ひ（だか不幸だか知らないが）一つの昂然たる貴族的精神によつて、今日まで埋没から救はれてるのは、ひとへに全くニイチェから学んだ訓育の為である。",
              "citation": {
                "source": "ニイチェに就いての雑感",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このへんてこに見える景色のなかへ泥猫の死骸を埋めておやりよ。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きながら墓場に埋められた人の絶望の聲を地上のだれがきくことが出來るか。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これきりに径尽きたり芹の中　塵芥に埋れた径。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが裏街の芥捨場や、雑草の生える埋立地で、詩人の心を低徊させ、人間生活の廃跡に対する或る種の物侘しい、人なつかしい、晩春の日和のような、アンニュイに似た孤独の詩情を抱かせるのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "交通もなく、枯木の林の中に埋っている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして田舎の、寂しい寺に埋めて下さい。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、この悲しい詩人の霊は、雑司ヶ谷の草深い墓地の中に、一片の骨となって埋まっている。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の書かうとした熱情は、いつも埋れ火の如く、微光する影の如く、さうでもない他の斷層――氣質的及び教養的斷層――の下に埋積された。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪に埋み盡された地面――そこには黒ずんだ常盤木の外に緑といふ色の夢にもない――が見る／＼黒土に變り、黒土が見る／＼若草の野に變つて行くあの華々しい變化は、雪國に越年しない人の想像する事が出來ない所だらう。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "発掘されたポムペイ市街の、蠅も鳴かない夏の午、鋪石や柱に頭を打ちつけ、ベスビオの噴煙を尻目にかけて、死んで沙漠に埋められようとも、随分馬鹿にはならないことなのを、それでもまあ、日本は東京に、慎しく生きてゐるのだ。",
              "citation": {
                "source": "散歩生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あれが中日和といふものだつたのでせう』と母は、埋葬を終へた日の宵、私達四人の兄弟がゐる所で云つた。",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は自分をセンチメンタリストと粧ふことがあるかも知れないが、それは彼と人々との齟齬を埋合はせる彼の自然の術なのだ。",
              "citation": {
                "source": "高橋新吉論",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "埋みし犬の何処にか、　　蕃紅花色に湧きいづる　　　　　　春の夜や。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "温泉附近の路が酷くくずれている、宿の前で嗽いをした筧の水などは、埋没してしまっている。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "うしろを振りかえると、そそり立つ山――森林で埋まる山にふさがれて、川は、全く、両山迫れる間の、凹流になってしまう。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "性なきまでに白げられたる、木の骨――というより外に、与える名がない――と、砂に埋まれた楕円石や、稜角の鋭いヒイラギ石やは、丁度、人間の屍骸が、木乃伊となって、木偶か陶製の人物か、区別が見えないと同じように、原性を失って、唯一自然の平等相に復帰している。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
