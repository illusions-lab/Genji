          "literary": [
            {
              "text": "時に臨みて変通せよ、宜しく執一なる勿れ。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "意旁通する者は高く、心執一する者は卑し。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "心執一するとは、心の一に執着して、他面に及ぶ能はざるを言ふ也。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "一に執らわれることは、一以貫之と異なることは勿論だが、一以貫之に対して「執一」を挙げ「我意」の働きなどを説き出したのは、どうも少し説き過ぎていると思われる。",
              "citation": {
                "source": "一貫章義（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "度量遠大、執一の見なく、殆んど一世を籠罩するの概あり」と。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
