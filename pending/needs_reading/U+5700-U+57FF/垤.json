          "literary": [
            {
              "text": "この蟻は地下きわめて深く巣をうがち発掘せる土をもって垤を造る。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、波羅葦僧垤利阿利の絵をあげますか。",
              "citation": {
                "source": "煙草と悪魔",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "麒麟の走獣に於ける、鳳凰の飛鳥に於ける、泰山の丘垤に於ける、河海の行潦に於けるは類なり。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
