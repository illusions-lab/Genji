          "literary": [
            {
              "text": "悠紀殿・主基殿の二个所で、復活なされる必要はない。",
              "citation": {
                "source": "大嘗祭の本義",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "天香具山は、尠くとも、地上に二个所は考へられてゐた。",
              "citation": {
                "source": "水の女",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "万葉集には「はねかづら」と言ふ語が四个所に出て来る。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方には、其時だけ村の少女許り集つて、一个所に竈を築いて遊ぶ事が、今も残つて居る。",
              "citation": {
                "source": "盆踊りの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "源氏物語にも数｜个所、帝の御むすめは夫を持たぬものだと言うことが記されている。",
              "citation": {
                "source": "反省の文学源氏物語",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "大祓詞の中、天つ祝詞が秘伝になつて離れてゐるのも其で、元はまづ、天つ祝詞を唱へて演技をなし、その後物語に近い曲節で、大祓の本文を読み、又天つ祝詞に入ると言ふ風になつて居たからで、此祓詞には、天つ祝詞が数个所で唱へられたらしい。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
