        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "でも、其演出は原作に忠実であつたと言ふだけに、一个処見て置きたい場面があつた。",
              "citation": {
                "source": "村々の祭り",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "かう言ふ噂が伝つて来たところが、沖縄にも唯一个処ながら鮎の棲む川があつた。",
              "citation": {
                "source": "若水の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "此以外に、天皇になる魂即、天皇霊（敏達紀外一个処）がある。",
              "citation": {
                "source": "古代人の思考の基礎",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "沖縄の国頭郡にある二个処の恥蔽阪の伝説は、明らかに其を説明して居る。",
              "citation": {
                "source": "餓鬼阿弥蘇生譚",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三个処、旧盆過ぎて、まだなごりの墓飾りがちら／＼する。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡良の大島・渡良の神瀬・黒崎の唐人神の鼻・勝本の長島・諸津・瀬戸・八幡の鼻・久喜の岸と、八个処に在る訣である。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "卜部氏の下の奴隷は、旧桜町の二个処に居て、叡山との関係は忘れて了うたやうになり、陰陽師の下であるが、同時に、卜部氏を通じて、吉田流の神道方式をも行うた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代では、どうした神やら訣らなくなつてゐるが、香椎の陰陽師の後の屋敷に一个処、みさき明神と称へて祀つてゐて、古くはやはり、やぼさであつた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "志原には、陰陽師の屋敷のある岡続きに、以前崇めたと言ふやぼさが一个処ある。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "志原の神主の祀る一个処には、行器の形を土で焼いた祠が据ゑてあつた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都などでは、殊に此考へが盛んになつて、五个処に御霊様を祀つて、御霊会を行ひ、神を慰め、悪事をやめて貰つたのである。",
              "citation": {
                "source": "大嘗祭の本義",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼方此方の二个処の古川と言ふのが、川岸と言ふやうになり、植物化して考へられて行つた。",
              "citation": {
                "source": "水の女",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳島育ちの伊原生の話に、阿波では一个処、此をほづみと謂ふ地方があつたことを記憶する、と云ふ。",
              "citation": {
                "source": "稲むらの蔭にて",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなに遠くは行かぬ様に見えた「山ごもり」「野あそび」にも、一部はやはり、一｜个処に集り、物忌みするばかりでなく、我が里遥かに離れて、短い日数の旅をすると謂う意味も含まって居たのである。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が、狂言記に二个処ほど（一个処は餌さし十王）がしんを見た。",
              "citation": {
                "source": "方言",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしておもしろいのは、常陸房にも、八百比丘尼にも、一个処懺悔の俤を残してゐることだ。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三个処、道へ雪のおし出して居る所はあるが、大体は谷へ落してしまったから、大丈夫這入って来られるだろうとの返事があった。",
              "citation": {
                "source": "山の湯雑記",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "急いで、報導部の検閲を受けると、暫らくして数个処の附箋をして返して来た。",
              "citation": {
                "source": "鵠が音",
                "author": "追ひ書き",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
