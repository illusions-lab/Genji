          "literary": [
            {
              "text": "先づ大兄は先大人の子と云所から、弱冠にして登庸せられ候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ども我云所の俳諧は其俳諧にはことなりと云ふことにて、荷兮野水等に後見して『冬の日』『春の日』『あら野』等あり。",
              "citation": {
                "source": "芭蕉雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨長明巡歴記云所要此山の傍に、竹採翁と云う者あり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "『坊目考』に籠の坂の語を解して、京終郷俚諺に云所の春日奴婢刀禰と称するもの、往年七人有て、奈良七郷を常に沙汰せしむと云云。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
