        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "敵に怨みをふくむような小さい歪んだ憤念ではない。",
              "citation": {
                "source": "剣の四君子",
                "author": "柳生石舟斎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ひとたび憤念の烈火にみずから恥を感じてみれば、この際、彼に返すことばはないのです。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "館に帰っても、憤念のつかえと、不快な懊悩は去らなかった。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の如き憤念を吐いて、「誓って、荊州を取り、玄徳、孔明の首を見なければ、なんの顔をもって呉侯にまみえよう」　血涙をたたえて云った。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
