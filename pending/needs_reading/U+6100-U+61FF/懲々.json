        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「だから馬鈴薯には懲々しましたというんです。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "貢さん、私ゃ懲々したよ。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら、うつし身の若い男でも、池上や葛岡と共に生きて行くことは此方が負担になって懲々します。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰某は屁玉を喰って凹んだと大きに笑われたそうで、もう懲々して、誰も手出しは致しません、何と、短銃では、岩見重太郎宮本の武蔵でも叶いますまい。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根は低いのに揺れると来て、この前頭痛で懲々したから、今度は歩行くつもりで、今朝小田原からたって来たが、陽気は暖かだし、海端の景色は可し、結句｜暢気で可い心持だ。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さるを今の作者の無智文盲とて古人の出放題に誤られ、痔持の療治をするように矢鱈無性に勧懲々々というは何事ぞと、近頃二三の学者先生｜切歯をしてもどかしがられたるは御尤千万とおぼゆ。",
              "citation": {
                "source": "小説総論",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ですから、私は、貴方の前ですけど、もうもう男は懲々。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先の上さんのような、しなしなした女は懲々だ。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鶴さんで懲々している！",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供のお客様ごつこぢやありますまいし、お返ししたものを、また返していただくなんて、もう一度お預かりした丈で、懲々いたしましたわ。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう旅は懲々でした。",
              "citation": {
                "source": "ちるちる・みちる",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供のお客様ごっこじゃありますまいし、お返ししたものを、また返していただくなんて、もう一度お預かりした丈で、懲々いたしましたわ。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "母　　　私は自分で懲々しとるけに、たねは財産よりも人間のええ方へやろうと思うとる。",
              "citation": {
                "source": "父帰る",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾輩が例の茶園で彼に逢った最後の日、どうだと云って尋ねたら「いたちの最後屁と肴屋の天秤棒には懲々だ」といった。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「真理」や「道徳」は、今日まで長い間気の弱い男や、醜い女と道伴となつたので懲々してゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "だけど私、過日でモウ皆に笑はれて、懲々してるんですもの。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの山師にや、村ではもう懲々して居るだア。",
              "citation": {
                "source": "重右衛門の最後",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう懲々だ、ほんとにこりた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにもう一つ率直に云えば、私は異性に懲々していた。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つは前夜の横波で苦んだ事にも懲々していたので、初は僕が同意せなかったにもかかわらず、遂に命令的に上陸の支度をさせた。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは後の事だが、それに懲々して、文部省勤務中は演説事は断って全くせなかった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "おときさんの事でもう懲々しやはつたらう思ふてましたがな。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
