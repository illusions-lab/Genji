          "literary": [
            {
              "text": "はじめて男を思う武士の娘には、石をもとかす焦熱慕念のほか、何ものもなく、ひとりいて栄三郎さま！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "と驚愕にのけぞると同時に、あきらめきれぬ新しい慕念がグッと胸さきにこみあげてきて、「そうか」　破裂を包んだ低声。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤坂、千早における楠木一族なるものに遠くから注目しだした頃からの慕念であった。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
