        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "折から堤防伝いに蹄の音、一人｜砂烟を立てて、斜に小さく、空を駆けるかと見る見る近づき、懸茶屋の彼方から歩を緩めて、悠然と打って来た。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭髪柔かにやや乱れた額少しく汗ばんで、玉洗えるがごとき頬のあたりを、さらさらと払った葉柳の枝を、一掴み馬上に掻遣り、片手に手綱を控えながら、一蹄三歩、懸茶屋の前に来ると、件の異彩ある目に逸疾く島野を見着けた。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶は一袋一斤半ずつの懸茶二十四袋が例となってあった。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "懸茶屋には絹被の芋｜慈姑の串団子を陳ね栄螺の壼焼などをも鬻ぐ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
