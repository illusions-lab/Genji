          "literary": [
            {
              "text": "其愀然として胡国に嫁ぎたるもの、匈奴が婚を強ひたるに外ならず。",
              "citation": {
                "source": "愛と婚姻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "子路が納得し難げな顔色で立去った時、その後姿を見送りながら、孔子が愀然として言った。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "歳を踰えて二月、夢に絳雪愀然として『今大難せまりぬ。",
              "citation": {
                "source": "『聊斎志異』より",
