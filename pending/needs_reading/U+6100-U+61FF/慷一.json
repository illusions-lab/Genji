        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "なに、言ってやがると砂馬慷一はその小ぜにをひったくるようにした。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "このとき俺は砂馬慷一に会ったのである。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "つとに満州に渡って何事かを画策していた砂馬慷一のことが思い出された。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は砂馬慷一に会ったか」「いいえ、まだ」「砂馬君はどえらい金儲けをしている。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サヤ（家）も豪勢だし……」「豪勢なのは砂馬慷一だ」「どうして？",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸万の言う商売とはつまり砂馬慷一の商売のことだろう。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "蹶起ののち、先生の自宅に電話して、意見や指示を仰いではいるが……」　ここでふと思いついた語調で、「砂馬慷一がコモかぶりを持ちこんできた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「戦争小説のネタの仕込みかい」「砂馬慷一みたいにアブク銭は稼げないからね。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「砂馬慷一のことは何も知らせてこない」　このとき、竹藪の向うから、異様な中国語が聞えてきた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
