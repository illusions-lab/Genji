          "literary": [
            {
              "text": "是に於て彼は懼然として恐れたり。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は余りに激しく見つめていた自分の視線に懼然として、一寸樹影に身を引いて、それから低く呼んだ。",
              "citation": {
                "source": "恩人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "孝太郎は自ら自分の声に懼然とした。",
              "citation": {
                "source": "囚われ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "森厳なる自然の威力に対して、眇たる人間誰かは懼然として懾れざるものあるべき。",
              "citation": {
                "source": "木曾駒と甲斐駒",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
