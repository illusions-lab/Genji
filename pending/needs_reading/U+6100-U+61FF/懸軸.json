        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "床の間は一間の板敷なるが懸軸も無く花瓶も無し。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切のイデオロギーは、極く初歩の思想であることを故郷の家の床の間の、あの懸軸を思ひ浮ぶ時、私には然う分つて来るのである。",
              "citation": {
                "source": "故郷に帰りゆくこころ",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお小さな床には鶯居の名でこの老人へ宛てた手紙を懸軸にしていた。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "懸軸も、花瓶も、書架も、すべての調度は取片づけられて、そこもがらんとしていた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから一ツ懸軸がありました。",
              "citation": {
                "source": "千里の駒後日譚拾遺",
                "author": "楢崎龍、川田雪山",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
