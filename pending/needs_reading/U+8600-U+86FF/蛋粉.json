        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あてがわれる機密費を、自分の貯金として、支那にいる間に、一と財産作って帰る腹の山崎は、Ｍ製粉や、日華｜蛋粉、Ｋ紡績、福隆｜火柴公司などを順ぐりに、めぐり歩いていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日華蛋粉の外交員の名刺も這入っていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一部は、蛋粉工場へ向けられた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うの蛋粉工場からも、呼応して鳴り渡る。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "高取は、蛋粉工場においても、工人達が兵士の威嚇を受けて、すくみ上っているのを知っていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蛋粉工場の中隊は、内地でも有名な中隊だった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、蛋粉工場へ行った中隊の方に近かった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
