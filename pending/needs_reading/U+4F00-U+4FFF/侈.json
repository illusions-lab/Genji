        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "瞳をひらけば瞳は追憶の情侈になづんで濡れるやうだ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は学生に向っても、常に奢侈を戒めて質素を説き、生活を簡易化することの利得を説いた。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "華麗と歓楽とを夢みるように、この雪白く、氷堅き北方の閉鎖から解かれて、南方の奢侈を、立ち姿や、寝像にまで現して、昼となく、夜となく、おそらく、千年も万年も、不断の進みをつづけているのだ。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪に真珠を食に充て、真珠をもって手を暖むとせんか、含玉鳳炭の奢侈、蓋し開元天宝の豪華である。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳川、天保の改革に幕府から厳しい奢侈禁止令が出て女の髪飾りにもいわゆる金銀玳瑁はご法度であった。",
              "citation": {
                "source": "娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方に於ては淫風の流行、奢侈、虚栄、無気力。",
              "citation": {
                "source": "警戒すべき日本",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "其歳閏九月、たま／＼天文の変ありて、詔を下し直言を求められにければ、山西の葉居升というもの、上書して第一には分封の太だ侈れること、第二には刑を用いる太だ繁きこと、第三には治を求むる太だ速やかなることの三条を言えり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の分封｜太侈を論ずるに曰く、都城｜百雉を過ぐるは国の害なりとは、伝の文にも見えたるを、国家今や秦晋燕斉梁楚呉※の諸国、各｜其地を尽して之を封じたまい、諸王の都城宮室の制、広狭大小、天子の都に亜ぎ、之に賜うに甲兵衛士の盛なるを以てしたまえり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "※銀　侈をを免れ難く、莱石　虧を成し易し。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "屏風、衝立、御厨子、調度、皆驚くべき奢侈のものばかりであった。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟夫婦は年少きまま無益の奢侈に財を費し、幾時も経ざるに貧しくなりて、兄の許に合力を乞ひに来ければ、兄は是非なく銭十万を与へけるに、それをも少時に用ひ尽してまた合力を乞ひに来りぬ。",
              "citation": {
                "source": "印度の古話",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、史實は兎に角に墨子の時に於て然樣いふ傳説が有り、そして墨子がそれを振かざして、當時の分國の諸侯等の奢侈を戒め簡素儉約を強調したのは、墨子に於ては至當の事と考へたからであつた。",
              "citation": {
                "source": "墨子",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "雙方に相當の主張は有るが、攻掠侵伐の爭亂が不節用の奢侈、無節度の生活に本づく場合の多いことも疑ふことの出來ない道理で、墨子の時代の君民皆放縱であつたに對し、墨子が節用を強調したのも確に一面の眞理を含んでゐる。",
              "citation": {
                "source": "墨子",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに對して奢侈は人の原徳を喪失するに至らしむる所以であり、又奢侈は安逸遊惰と因果の醜循環を形づくるものである。",
              "citation": {
                "source": "墨子",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "これと同じ比例に遊惰なる生活は奢侈を要求し、奢侈は又人をして遊惰ならざる能はざらしむるものである。",
              "citation": {
                "source": "墨子",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど現時一般女学校の有様を見るに、その学科は徒に高尚に走り、そのいわゆる工芸科なる者もまた優美を旨とし以て奢侈贅沢の用に供せらるるも、実際生計の助けとなる者あらず、以て権門勢家の令閨となる者を養うべきも、中流以下の家政を取るの賢婦人を出すに足らず。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もお召縮緬を着たのは、強ち奢侈と見るべきではあるまい。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "市内の賤民が飢饉に苦むのに、官吏や富豪が奢侈を恣にしてゐる。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻は商人の家に唯奢侈な少時を送つたゞけであります。",
              "citation": {
                "source": "教師",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは今までにも奢侈の生活を送っていなかったのであるから、今後も特に節約をしようとも思わない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "根岸といえば鶯の名所のようにも思われ、いわゆる「同じ垣根の幾曲り」の別荘地を忍ばせるのであるが、根岸が風雅の里として栄えたのは、文化文政時代から天保初年が尤も盛りで、水野閣老の天保改革の際に、奢侈を矯正する趣意から武家町人らの百姓地に住むことが禁止された。",
              "citation": {
                "source": "半七捕物帳",
                "author": "河豚太鼓",
                "note": "青空文庫"
              }
            },
            {
              "text": "増大する窮民はその一揆の口実に徳政を称え、亦奢侈の結果負債に窮した幕吏も、此の点に於て相応じたのである。",
              "citation": {
                "source": "応仁の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　足利八代将軍義政は、政治に心を用ゐず、奢侈に耽り、土木を起し、課税を重くし、度々徳政の令を発したので、人民は塗炭の苦しみに陥入り、極度に頽廃的となつた。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "お佐代さんが奢侈を解せぬほどおろかであったとは、誰も信ずることが出来ない。",
              "citation": {
                "source": "安井夫人",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "道学者は倫理的の立場から始終奢侈を戒しめている。",
              "citation": {
                "source": "現代日本の開化",
                "author": "――明治四十四年八月和歌山において述――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
