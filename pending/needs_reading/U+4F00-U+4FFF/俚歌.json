        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その男は何やらん一座のものに言置き、「ヂツセンチイ、オオ、ミア、ベツチイナ」（降り來よ、やよ、我戀人）と俚歌口ずさみて出行きぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処やらに俚歌を唱ふ声あり。",
              "citation": {
                "source": "花月の夜",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく此島で歌う俚歌ではない。",
              "citation": {
                "source": "漁師の娘",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして“聟迎えの俚歌”などが賑やかに聞えだしている。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
