          "literary": [
            {
              "text": "樹の間のまぼろし葉こそこぼるれ、神無月かかる日なりき、黄櫨の木かげに俯居して、戀がたりする人も見き。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる日よ、在巣の鳥も、うらびれし目路の眺めに、さへづりの徒音を絶えて、俯居すらめ。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹の間のまぼろし一葉こそこぼるれ、神無月、かかる日なりき、黄櫨の木かげに俯居して、戀がたりする人も見き。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "花とを咲けど、『くらやみ』の牢獄の窓に俯居して、ああ曙や、夜もすがら君をこそ待て。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一二『木の叉枝に俯居して、日にまた夜の齋戒に、つと幻のほのめいて、白よそほひの郎姫、花は笑みそろ、一の花。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
