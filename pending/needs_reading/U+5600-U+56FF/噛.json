        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "人間と云うものの総ての上について噛んで含める様に教えた様であった。",
              "citation": {
                "source": "正岡子規君",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "口へは手拭を噛んで、涙を絞った。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは駱駝のやうによろめきながら椰子の實の日にやけた核を噛みくだいた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら自由詩に對する、一つの最も恐るべき毒牙は、直接我我の急所に向つて噛みついてくる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二子山附近われの悔恨は酢えたりさびしく蒲公英の莖を噛まんや。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "われは狼のごとく飢ゑたりしきりに欄干にすがりて齒を噛めどもせんかたなしや　涙のごときもの溢れ出で頬につたひ流れてやまずああ我れはもと卑陋なり。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかなれば故郷のひとのわれに辛くかなしきすももの核を噛まむとするぞ。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は眼を閉ぢてなにかの草の根を噛まうとするなにかの草の汁をすふために　憂鬱の苦い汁をすふために。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは魚のやうにつめたくなつて目からさうめんの涙をたらし情慾のみたされない　いつでも陰氣な悶えをかんずるああこの噛みついてくる蠍のやうにどこをまたどこへと暗愁はのたくり行くか。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐怖への豫感　曠野に彷徨する狼のやうに、一つの鋭どい瞳孔と、一つの飢ゑた心臟とで、地上のあらゆる幻影に噛みつかうとする、あるひとの怒りに燃えついた情慾。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿醉の朝に　泥醉の翌朝に於けるしらじらしい悔恨は、病んで舌をたれた犬のやうで、魂の最も痛痛しいところに噛みついてくる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そは夕暮の海よりして、鱶の如くに泳ぎ來り、齒を以て肉に噛みつけり。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつては蒲公英の莖を噛みながら、ひとり物思ひに耽つて徘徊した野川の畔に、今も尚白い菫が咲くだらうか。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり寂しく、薄暮の部屋に居る時さへも、鱶のやうに鋭どい齒で、私の肉に噛みついてくる意志！",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語に絶えた恐ろしい悲哀を私一人でじつと噛みしめて居なければならない。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「侘び」とは、前にも他の句解で述べた通り、人間生活の寂しさや悲しさを、主観の心境の底で噛みしめながら、これを対照の自然に映して、そこに或る沁々とした心の家郷を見出すことである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「歯に喰ひあてし」という言葉の響に、如何にも砂を噛むような味気なさと、忌々しさの口惜しい情感が現われている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "百たびも牙を鳴らしてわれの欲情するものを噛みつきつつさびしき復讐を戰ひしかな！",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　新聞の寫眞を見た時、悲痛に充ちた自分の心は、唇を噛んで低く呻いた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "芥川君の死去の報に接した時、自分はむしろ彼の前に、舌を噛んで慚死する恥を感じた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜこの世の中は、すべて私の思ふ通りにならないだらうと、あの「忘春詩集」に出る支那人みたいに、いぢらしい宿命を噛みしめてゐる。",
              "citation": {
                "source": "田端に居た頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬ならずとも、牛ならずとも噛みしめて見たいやうな寢よげな若草が叢がつて尖つた葉先きを空の方へ擡げる。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　祖母が私を噛むやうに何時もの豆腐売と湯屋の亭主を並べた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "翔びゆく雲の落とす影のやうに、田の面を過ぎる、昔の巨人の姿――夏の日の午過ぎ時刻誰彼の午睡するとき、私は野原を走つて行つた……私は希望を唇に噛みつぶして私はギロギロする目で諦めてゐた……噫、生きてゐた、私は生きてゐた！",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
