          "literary": [
            {
              "text": "頭を曲げ手足を縮め海老のごとき状態に困臥しながら、なお気安く心地爽かに眠り得た。",
              "citation": {
                "source": "水害雑録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭を曲げ手足を縮め海老の如き状態に困臥しながら、猶氣安く心地爽かに眠り得た。",
              "citation": {
                "source": "水害雜録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶山は江戸に著いて、微恙のために阿部家の小川町の上屋敷に困臥し、紙鳶の上がるのを眺めてゐた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し堅く汚れた床の中に困臥する身にも、豐富華麗なる生活を夢みるだけの自由は許されてゐるのである。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "探偵は陰暗の國に困臥して盜賊の輝ける姿を仰視する。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
