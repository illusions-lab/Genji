          "literary": [
            {
              "text": "先づ噐具製造の原料を調査せん。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日迄の實見と推測とに從ひ噐具を原料に由つて分類すれば左の如し。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨器の類は此他種々｜有れど煩を厭ひて記さず●角器牙器石器時代｜遺跡よりは又鹿の角にて作りたる噐具も出づ。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "●日常生活前々より述べ來りしが如き衣服を着、飮食を採り、竪穴に住ひ、噐具を用ゐたる人民、即ちコロボックル、の日常生活は如何なりしか、固より明言するを得る限りには非ざれど試みに想像を畫きて他日精査を爲すの端緒とせん。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
