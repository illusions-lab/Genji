        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "本來の道理から云へば、社會は惡事をなしたものを監獄に收容するよりも前に、かゝる不幸の人を然るべき園囿に安んじて、そしてこれに十二分の療養を加へしめて宜い譯である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "あめ色の地に、橄欖（オリワ）の如く緑なる色の雲あるをば、樂土の苑囿に湧き出でたる山かと疑ひぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手なる岸の全景は、空想のセミラミスや築き起しゝ、唯だ是れ一大｜苑囿の波上に浮べる如くなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬へばカムパニアの野を變じて一の花卉多き園囿となしたらんが如し。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "一體に左街には宮殿や苑囿が多く、又勳貴官吏らの邸宅多くて淋しい。",
              "citation": {
                "source": "大師の入唐",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "霊の放ち鳥漢土の天子諸侯の生活には、林池・苑囿を荘厳するのが、一つの要件であつた。",
              "citation": {
                "source": "万葉集研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧しい子供は公の園囿にははいることを許されていない。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "その園囿は三百八十町余を擁してゐる。",
              "citation": {
                "source": "トラピスト天使園の童貞",
                "author": "三木露風",
                "note": "青空文庫"
              }
            },
            {
              "text": "その園囿の中を二頭の馬が車を並べて通り得る路が通じてゐる。",
              "citation": {
                "source": "トラピスト天使園の童貞",
                "author": "三木露風",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩みを転じて園囿の草のすろうぷを上る。",
              "citation": {
                "source": "修道院の月",
                "author": "三木露風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
