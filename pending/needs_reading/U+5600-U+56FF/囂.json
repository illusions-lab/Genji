        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヨオロツパでも警察力の完備した所と聞えたストツクホルム、當然喧々囂々たる非難の矢面に立つ責任者だつたから‥‥。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "何分かが喧囂の内に過ぎた。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまた中には、我知らず騷ぎ立ててしまつたうしろめたさを胡魔化さうとして、故意に再び喧囂の内に隱れようとした者さへあつたのである。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最早袂別の時刻も迫つて來たので、いろ／＼の談話はそれからそれと盡くる間も無かつたが、兎角する程に、ガラン、ガラ、ガラン、ガラ、と船中に布れ廻る銅鑼の響が囂しく聽えた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の議論家は素肌の上に上衣を羽織ッて、仔細らしく首を傾げて、ふかし甘薯の皮を剥いてい、お政は囂々しく針箱を前に控えて、覚束ない手振りでシャツの綻を縫合わせていた。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "）同じ※溢、同じ喧囂は我等を迎へたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽音の旋律更に激越想壮の度を加へ、之に諧和せざる梵音はた三絃の声も、囂々として亦その中に雑じる。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽声、沙門、伊留満等の祈祷唱讃の声、諸人の驚き叫ぶ声、紛々囂々ととだえとだえにひびらぐ。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その喧囂たるどよめきの中で、法水は、暗中の彩塵を追いながら黙考に沈みはじめた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、いま部屋のなかは喧囂たる有様だ。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "囂々とひびいて摩擦音を轟かせ、地獄の大釜がたぎるような氷擦の熱霧をあげながら、日速四百十九メートルといわれる化物氷河の谷。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、突然の火光、囂然たる銃声。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "船長、本船は翻弄されているんです」　そう云って、ヴィデの蒼白な顔が、砲栓から離れようとしたとき、三の弾が、今度は船尾旗桿に囂然と命中した。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "更紗を洩れる灯、昼間は気付かなかった露台の影絵、パタンやブルマンの｜喧囂たる取引は、さながら、往時バグダッドの繁栄そのものである。",
              "citation": {
                "source": "一週一夜物語",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、法水は一向に頓着する気色もなく、その日は他の誰にも遇わず、経蔵の再調査だけをして、囂々たる大雷雨の中を引上げて行った。",
              "citation": {
                "source": "夢殿殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ってこの淫蕩極まりない私通史には、是非の論が喧囂と湧き起らずにはいなかった。",
              "citation": {
                "source": "オフェリヤ殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海面は、黒くたかく頭上にそびえ、風と飛沫と囂音で一分の休息もない。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪橋をわたるまえとり急ぎ　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　ケルミッシュより　その夜、主峰の雲のなかで囂々と雷が荒れた。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪橋をわたるまえとり急ぎケルミッシュより　その夜、主峰の雲のなかで囂々と雷が荒れた。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "是が瑞仙の書上に「寛政二年辛亥（中略）請邀る者あり、因て暫く京都に寓」すと云ひ、二世瑞仙晋撰の行状に「後君厭浪華市井之囂塵、寛政壬子秋、游于京師」と云つてある事蹟の真相である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「後君厭浪華市井之囂塵。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "囂々とその釣橋を渡つてまた右折する。",
              "citation": {
                "source": "日本ライン",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜空だ、突如として襲ひ去る囂囂音、囂囂音、囂囂音、囂囂音。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
