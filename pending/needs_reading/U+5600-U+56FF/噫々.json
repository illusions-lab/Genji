          "literary": [
            {
              "text": "「噫々女も気狂にして見なくっちゃ、本体はとうてい解らないのかな」　兄はこう云って苦しい溜息を洩らした。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "噫々、何といふ其風采であらう。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "噫々といふ外には、自分のうら若き友情は、他に此感じを表はすべき辭を急に見出しかねるのだ。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "噫々といふ外には、自分のうら若き友情は、他に此感じを表はすべき辞を急に見出しかねるのだ。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "噫々これはたして孝乎不孝乎。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "噫々われすでに家庭に火を放てり。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "噫々今にして花火線香の玉を消したことは返す返すも残念でならない。",
              "citation": {
                "source": "夢の如く出現した彼",
                "author": "夢野久作氏を悼む",
                "note": "青空文庫"
              }
            }
          ]
        }
