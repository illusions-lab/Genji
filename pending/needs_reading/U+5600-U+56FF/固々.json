          "literary": [
            {
              "text": "と云って固々憎い男ではないんだから粗略にする訳はない。",
              "citation": {
                "source": "創作家の態度",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云って、固々恋人に送る艶書ほど熱烈な真心を籠めたものでないのは覚悟の前である。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、私は、あの雪の日以來、大空を壓して降りて來るあの固々たる雪の中の深い秩序が、何時の雪の日にも、私のこゝろによみがへつて來る。",
              "citation": {
                "source": "雪",
                "author": "中井正一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
