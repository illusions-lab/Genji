        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "海面は、黒くたかく頭上にそびえ、風と飛沫と囂音で一分の休息もない。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜空だ、突如として襲ひ去る囂囂音、囂囂音、囂囂音、囂囂音。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "家は街道にのぞみ、囂音と塵埃と筆硯の繋鎖とに苦しめらる。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "三軒茶屋から登戸への街道に面し、牛車、タンク、砲車隊等の轣音、囂音、火山灰の旋風は堪へがたかつた。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトリコトリ、トンタンと、割られた、丸太の、体のいい薪ざっぽうが、レールの間を流れて、ゴトリゴトリガラガラと、放り落される、と、その井堰型の粉砕機の中での、たちまちの雑音囂音、大動乱である。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "すさまじい囂音が、大地の底からうなりを立てて耳も聾するばかりに響く。",
              "citation": {
                "source": "雲仙岳",
                "author": "菊池幽芳",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
