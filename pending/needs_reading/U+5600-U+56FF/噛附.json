        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "暗がりを啣え楊枝、月夜には懐手で、呑気に歩行いてると、思いがけねえ狂犬めが噛附くような塩梅に、突然、突当る奴がある、引摺倒す奴がある、拳固でくらわす奴がある、一度々々｜呼吸を引かないばッかりで、はッはッと思うことが、毎晩じゃアありませんか。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵どんなものか見当がついたでしょうな」「ああ大村さん、もうお帰りになるんですか」　と玄竜はびっくりして、急にばね仕掛けにでも弾かれたように大村の腕へ獅噛附くように飛び出した。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "」元三爺は獅噛附いて泣き声を上げた。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "女小供は度々さう云ふ書生に逢ふと、『また山犬が來たナ、噛附きさうだから避けよう』と思つて避ける。",
              "citation": {
                "source": "教育の目的",
                "author": "新渡戸稻造",
                "note": "青空文庫"
              }
            },
            {
              "text": "女小供は度々そういう書生に逢うと、「また山犬が来たナ、噛附きそうだから避けよう」と思って避ける。",
              "citation": {
                "source": "教育の目的",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "金「お前さん其様な気の弱い事を云つちやアいけませぬ、石へ獅噛附ても癒らうと云ふ了簡で居なくツちやアいけませぬよ。",
              "citation": {
                "source": "黄金餅",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
