        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今度は小男が勝つたと見えて、赭顔が笑つて五分苅頭をさすつてゐる。",
              "citation": {
                "source": "金貨",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼び出されて、いつも通り二階へ行くものと思っていたら昇り口を通りすぎ、主任が先へ歩きながら、「おっかさんが見えてるんだが……」　立ち止って、グルリと平手で五分苅頭を撫で、「――会いますか」　厭わしさと期待の混り合った感情が自分を包んだ。",
              "citation": {
                "source": "刻々",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五分苅頭の面桶顔、柴栗を押つけた様な鼻と鼻にかゝる声が、昔の耽溺を語って居る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五分苅頭で紋付羽織でも引かけた体は逞しく顔は子供した若者が、此村からも彼村からも府中に集まる。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処には五分苅頭の色蒼ざめた乞食坊主が Preside して居る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
