          "literary": [
            {
              "text": "後になつて友人に聞いたら、醉つて自動車に衝突し、舖道に倒れたといふのである。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "北風が唸りながら舖道の紙屑やごみを浚って吹いた。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "舖道までは大變遠い。",
              "citation": {
                "source": "恐怖について",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ場所で詩人や美術家の連中と話し込みながら夜を更かし、舖道の月を踏んで歸るのが愉快だつたと語つてゐる。",
              "citation": {
                "source": "ジヨオジ・ムウア",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
