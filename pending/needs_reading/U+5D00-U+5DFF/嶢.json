          "literary": [
            {
              "text": "佐南嶢といふ所をすぐ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しそれ左方の嶢角に踞せんか、先の過ぐ所の溪流小橋眇として遙に眼下に在り。",
              "citation": {
                "source": "草津行",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の高厳荘重なるミルトンまでも一度は此轍を履んとし、嶢※豪逸なるカーライルさへ死後に遺筆を梓するに至りて、合歓｜団欒ならざりし醜を発見せられぬ。",
              "citation": {
                "source": "厭世詩家と女性",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤土の裸の丘と、嶢※たる岩地。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三　嶢※たる岩山に沿った泥濘の道を、自動車は、どこまでも走って行く。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
