        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あらゆるものは古代歴史と花崗岩のかなたの地平の目の色。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の方を仰ぐと、赤沢岳が無器用な円頂閣のように、幅びろく突ッ立って、その花崗岩の赤く禿げた截断面が、銅の薬鑵のような色をして、冷めたく荒い空気に煤ぶっている。",
              "citation": {
                "source": "槍ヶ岳第三回登山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その雪には花崗のったような、掌大な痕を印している。",
              "citation": {
                "source": "槍ヶ岳第三回登山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようやく川を渉る、足袋底がこそばゆいから、草鞋を釈いて足袋を振うと、粗製のザラメ砂糖のような花崗の砂が、雫と共に堕ちる。",
              "citation": {
                "source": "梓川の上流",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳳凰山地蔵岳の大花崗岩山は、その峻しい荒くれた膚を、深谷の空気に、うす紫に染めている。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "灘をこえて、水が静かになると、両方の岸を見廻すだけの余裕が出てくる、河原には材木を伐り出す小舎がある、岩石は上流の花崗岩と違つて、小さな褶曲や白や褐色の岩脈が、横に帯をしめたやうな、筋を入れたのが、美しく見える。",
              "citation": {
                "source": "天竜川",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "筑波山の紫は、花崗石の肌の色に負うことが多いが、富士山の冬の紫は、雪の変幻から生ずる色といっても大過はあるまい。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "硬い岩石は、例えば、甲州アルプスで金峰山（二五五一米突）の五丈石、鳳凰山（二七七九米突）の地蔵仏は、結晶岩なる花崗石で、飛騨山脈の槍ヶ岳（三一八〇米突）は石英斑岩の硬石である。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "糞、小便は、長さ五寸、幅二寸五分位の穴から、巌丈な花崗岩を透して、おかわに垂れる。",
              "citation": {
                "source": "牢獄の半日",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "二間位の広さで、花崗岩の腐蝕した白砂土が、太陽の直射に会って、照りかえして、足の下から部屋に射し込む。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで諸君が東京の牛の御前に往ってごらんなさると立派な花崗石で伊藤博文さんが書いた「天下之糸平」という碑が建っております。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ちる時手を放して、僕は左を下に倒れて、左の手の甲を花崗岩で擦りむいた。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "花崗岩の板を贅沢に張りつめたゆるい傾斜を上りつめると、突きあたりに摺鉢のような池の岸に出た。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三　日本橋その他の石橋の花崗石が、大正十二年の震火災に焼けてボロボロにはじけた痕が、今日でも歴然と残っている。",
              "citation": {
                "source": "鑢屑",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "停車場近くの神社で花崗石の石の鳥居が両方の柱とも見事に折れて、その折れ口が同じ傾斜角度を示して、同じ向きに折れていて、おまけに二つの折れ目の断面がほぼ同平面に近かった。",
              "citation": {
                "source": "静岡地震被害見学記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへも緑は影を映して、美しく洗われた花崗岩の畳石の上を、また女の人の素足の上を水は豊かに流れる。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "学士は咽喉をこくっと鳴らし中に入って行きながら三角の石かけを一つ拾ひ「ふん、こゝも角閃花崗岩」とつぶやきながらつくづくとあたりを見れば石切場、石切りたちも帰ったらしく小さな笹の小屋が一つ淋しく隅にあるだけだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "して見るとなんでもこの辺にさっきの花崗岩のかけらがあるね、そいつの中の鉱物がかやかや物を云ってるんだね。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "青き陽遠くなまめきて、　　　右に亙せる高原は、花崗閃緑　削剥の、　　　　　時代は諸に論ふ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔一才のアルプ花崗岩を〕一才のアルプ花崗岩を、　　　　おのも積む孤輪車。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくやすんでから、こんどはみんなで先生について川の北の花崗岩だの三｜紀の泥岩だのまではいった込んだ地質や土性のところを教わってあるいた。",
              "citation": {
                "source": "或る農学生の日誌",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みちをあるいて黄金いろの雲母のかけらがだんだんたくさん出て来ればだんだん花崗岩に近づいたなと思うのだ。",
              "citation": {
                "source": "インドラ［※１］の網",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "学士は咽喉をこくっと鳴らし中に入って行きながら三角の石かけを一つ拾い「ふん、ここも角閃花崗岩」とつぶやきながらつくづくとあたりを見れば石切場、石切りたちも帰ったらしく小さな笹の小屋が一つ淋しく隅にあるだけだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "道ばたで薄ぎたないシナ人がおおぜい花崗石を細かく砕いて篩で選り分けている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "崖の風化した柔らかい岩の中に花崗石の大きな塊がはまっているのを火薬で割って出すらしい。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "九竜で見たと同じ道普請のローラーで花崗石のくずをならしている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
