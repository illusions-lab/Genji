          "literary": [
            {
              "text": "されど先づ實相々々と追ひ行きたる極端に達して、人間の官能を除き去りておもへ。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "一も二もなくお藤の投げた綱に手繰りよせられて、送り狼と相々傘、夢みるような心もちのうちにこの瓦町の家へ届けられてきたのだが……。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがては皆なから近所の板塀や土蔵の壁に相々傘をかゝれて囃された。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "お糸長吉と相々傘にかゝれて皆なから囃された時でもお糸はびくともしなかつた。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがては皆なから近所の板塀や土蔵の壁に相々傘をかかれて囃された。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "お糸長吉と相々傘にかかれて皆なから囃された時でもお糸はびくともしなかった。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は相々傘で雪のまるで無い槍沢を登った。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
