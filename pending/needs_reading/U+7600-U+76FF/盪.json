          "standard": [],
          "literary": [
            {
              "text": "」　妊婦は、あとで「脳振盪」と、病床日誌に死の原因を書きつけられていた。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを拾って読んでみると例えば「一同」「円」などはいいが「盪」などという妙な文字も現われている。",
              "citation": {
                "source": "浅草紙",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、腦震盪を起して人事不省のまま二三週間生死の境をさまよつてゐた。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　　　　　　　八　岸をトンと盪すと、屋形船は軽く出た。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗り合いは再び地上の瀾に盪られて、浮沈の憂き目に遭いぬ。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠の心は激動して、渠の身は波に盪るる小舟のごとく、安んじかねて行きつ、還りつ、塀ぎわに低徊せり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "北窓から飛び込んで南側の庭へ抜けるつもりでガラス障子にくちばしを突き当てて脳震盪を起こして即死したのである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分なども一度学校の玄関の土間のたたきに投げ倒されて後頭部を打って危うく脳震盪を起こしかけたことがあった。",
              "citation": {
                "source": "相撲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　　　　　　　　八　岸をトンと盪すと、屋形船は軽く出た。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚破と、母屋より許嫁の兄ぶんの駈けつくるに、讀みさしたる書伏せもあへず抱きて立てる、栞の萩も濡縁に枝を浪打ちて、早や徒渉すべからず、あり合はす盥の中に扶けのせつゝ、盪して逃るゝ。",
              "citation": {
                "source": "婦人十一題",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「神仙なる者は性命の眞を保つて而して其外に游求する所以の者なり、聊か以て意を盪ぎ心を平らかにし、死生の域を同じうして、而して胸中にする無からんとす、然り而して或者は專ら以て務と爲す、則ち誕欺怪迂の文、彌※である。",
              "citation": {
                "source": "道教に就いて",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "雷の如き響は我胸を鼓盪して、我失望我苦心と相應じ、我をして前に小尼公の爲めにチヲリの瀧の前に立ちて、即興の詩を吟ぜし時の情を憶ひ起さしむ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "数日旅程の暑炎鬱蒸盪瀉し尽せり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いて脳震盪を起した。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人が立ち去ったあとへ、大嫌いの野良犬がどこからか出て来て、突然に彼女の裳をくわえたか、あるいは足を咬んだか、それに強くおびやかされて、彼女は心臓を破ったか、あるいはおどろいて倒れたはずみに石地蔵で頭を打って、脳震盪でも起こしたか。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分この岩の上へ突き落されて、脳震盪を起して死んだのではあるまいか。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　物凄いと云つてよいか、死身と云つてよいか、兎に角、烈々たる夫人の態度は、信一郎の心を可なり振盪した。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "結晶した精神が一度に破裂して上下四囲の空気を震盪さしてワーと鳴る。",
              "citation": {
                "source": "趣味の遺伝",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "新らしく世帶を有つて、新らしい仕事を始める人に、あり勝ちな急忙しなさと、自分達を包む大都の空氣の、日夜劇しく震盪する刺戟とに驅られて、何事をも凝と考へる閑もなく、又落ち付いて手を下す分別も出なかつた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三の世界は燦として春の如く盪いてゐる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　物凄いと云ってよいか、死身と云ってよいか、兎に角、烈々たる夫人の態度は、信一郎の心を可なり振盪した。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に如此くなれば、怪は愈よ怪に、或は夢中に見たりし踪の猶着々活現し来りて、飽くまで我を脅さざれば休まざらんと為るにあらずや、と彼は胸安からずも足に信せて、かの巌の頭上に聳ゆる辺に到れば、谿急に激折して、水これが為に鼓怒し、咆哮し、噴薄｜激盪して、奔馬の乱れ競ふが如し。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "高声を長く引きたるものにて、気味悪く、神経を震盪するが如き響なりき。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が見ました時は顔中血だらけになっておりましたし、正木先生も急激な脳震盪で呼吸も止まっているから迚も助からぬと云うておられましたが、やはり、手足が不自由なまま、壁に頭を打ち付けたのですから、そう強くなかったのでしょう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "脳貧血と、脳震盪が同時に来ているだけなんですから……」「何かね。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "十四五間四方ぐらいは急激｜脳震盪を起して引っくり返る。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに警察から人が来て色々と取調べの結果、昨夜からの事が判明したので、元五郎親爺の死因は過失から来た急劇｜脳震盪ということに決定したが、一方にお八重の胎児の父はどうしてもわからなかった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "余が頭に何十万本の髪の毛が生えているか知らんが、ありとある毛がことごとく根こぎにされて、残る地面がべた一面に蚯蚓腫にふくれ上った上、余勢が地磐を通して、骨から脳味噌まで震盪を感じたくらい烈しく、親方は余の頭を掻き廻わした。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども私が、脳振盪を起して倒れたとすれば、諸君の笑は必ず倫理的の同情に変ずるに違いありますまい。",
              "citation": {
                "source": "教育と文芸",
                "author": "――明治四十四年六月十八日長野県会議事院において――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
