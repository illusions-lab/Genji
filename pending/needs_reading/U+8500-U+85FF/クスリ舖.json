        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "其の醫者は鉛筆で手帖の端へ一寸書きつけて、それでは直に此を藥舖で買つて來るのだといつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "藥舖では罎へ入れた藥を二包渡して呉れた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "醫者は復藥舖へ行つて來いといつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは或期間を經過すれば効力が無くなるので餘計な仕入もしないのだと藥舖ではいつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "醫者は更に勘次を藥舖へ走らせた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
