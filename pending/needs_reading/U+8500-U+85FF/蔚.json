        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大連が一台ずつ、黒塗り真円な大円卓を、ぐるりと輪形に陣取って、清正公には極内だけれども、これを蛇の目の陣と称え、すきを取って平らげること、焼山越の蠎蛇の比にあらず、朝鮮｜蔚山の敵軍へ、大砲を打込むばかり、油の黒煙を立てる裡で、お誓を呼立つること、矢叫びに相斉しい。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "令史敢て動かず、昇ること漂々として愈々高く、やがて、高山の頂一の蔚然たる林の間に至る。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "燕王は正月の酷寒に乗じて、蔚州を下し、大同を攻む。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋し燕の兵を挙ぐるに当って、史｜之を明記せずと雖も、韃靼の兵を借りて以て功を成せること、蔚州を囲めるの時に徴して知る可し。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "本因坊あつて偃武の世に出づるに及び、蔚然一家を為し、太平三百年間、雋異の才、相継で起り、今則ち禹域を圧すといふ。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」韓は韓聯玉、宇は宇清蔚である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "発程の前には暫く宇清蔚の家に舎つてゐたらしい。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして宇清蔚が来て新居を嵯峨に経営することを助けた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "移居当時の事は、樵歌に「予卜居峨阜、宇清蔚偕来助事、適井達夫在都、亦来訪、留宿三日、二月念一日、修営粗了」と云つてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "移居当時の客宇清蔚が辞し去つた時、霞亭は送つて京の客舎に至つた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇清蔚、冢不騫、尾間生である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "前提とは一、宇清蔚は霞亭と偕に竹里に来て、其「留宿三日」には二月二十一日をも含んでゐること、二、霞亭が竹里を去つて市中に住んだ「二旬余」を二十五日と算すること、三、壬申の正月猶梅陽軒に留まること一旬であつたとすることである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "東隣といふのは大きな一構で蔚然たる森に包まれて居る。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央の山陵は杉の木が一杯に掩うて蔚然と小山のやうである。",
              "citation": {
                "source": "松蟲草",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "既にして南方淡靄のうちに、青松蔚然として高きものあり。",
              "citation": {
                "source": "草津行",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄塔神の霊異　蔚州の城内に寺があって、その寺内に鉄塔神というのが祭られているが、その神霊｜赫灼たるものとして土地の人びとにも甚だ尊崇されていた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "夷堅志",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが慶長の役で、加藤清正の蔚山籠城なぞはこの時の事である。",
              "citation": {
                "source": "碧蹄館の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔚山を発ってまもなく、エンジンの激しい音の間にばら、ばら、ばらと云う異様な音が走るので、不思議に思って海の上に眼をやると、そこには己の飛行機と同じ飛行機の姿が判然と影を落している。",
              "citation": {
                "source": "追っかけて来る飛行機",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日露戦争に、蔚山の沖でロシヤ艦隊をやっつけたわが上村巡洋艦隊は強かった。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし蔚山海戦は、巡洋艦と巡洋艦との戦いだったのだ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿拉米多街尽辺、蔚然三達舎台円、登臨全市如碁布、安岳為屏鎖半天。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "背後に蔚然たる五山文学の学芸あり、世は南北朝の暗澹たる底流の上に立って興廃常なき中に足利義満等の夢幻の如き栄華は一時に噴火山上の享楽を世上に流通せしめた。",
              "citation": {
                "source": "美の日本的源泉",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "乙の人はそれはメハジキのヤクモソウ（※蔚すなわち益母草）だといっている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "年の暮れ、この頃山の宿にいた馬楽のところへ行ったら「加藤清正蔚山に籠る」と書いてくれと言う。",
              "citation": {
                "source": "随筆　寄席風俗",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "北朝鮮の寒さには、さすがの日本軍もなやまされ、春の雪どけまで、蔚山に城をきずいて籠城することになった。",
              "citation": {
                "source": "三両清兵衛と名馬朝月",
                "author": "安藤盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "城がどうやらできあがったころ、明軍十四｜万の大兵が京城に到着し、この蔚山城をひともみに、もみ落とそうと軍議していることがわかった。",
              "citation": {
                "source": "三両清兵衛と名馬朝月",
                "author": "安藤盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔚山城のうまやの中でも、あいかわらず、清兵衛は愛馬朝月といっしょに、わらの中にもぐってねむっていると、どうしたことか、にわかに朝月が一｜声いなないて、そこにおいてあった鞍をくわえた。",
              "citation": {
                "source": "三両清兵衛と名馬朝月",
                "author": "安藤盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しい籠城　有名な蔚山籠城の幕は、切って落とされたのである。",
              "citation": {
                "source": "三両清兵衛と名馬朝月",
                "author": "安藤盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　　　×　　　×　　　×　蔚山城のかこみのとけたのは、正月三日で、宇喜多秀家、蜂須賀阿波守、毛利輝元など十｜余大将が、背後から明の大軍を破った。",
              "citation": {
                "source": "三両清兵衛と名馬朝月",
                "author": "安藤盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "問題は蔚山の籠城といふ章だつた。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
