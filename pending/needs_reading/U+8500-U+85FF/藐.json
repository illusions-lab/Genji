        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "藐姑射山に住むといふ神女の飲みさうな冷たく幽邃な匂ひのするコツプの液汁を飲み、情熱の甘さを植物性にしたやうな果肉を掬つて喰べてゐると、歳子はこころがいよ／＼楽しくなつた。",
              "citation": {
                "source": "夏の夜の夢",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬えて似つくものも今すぐ思い出せませんけれども、強いて言ってみれば、女学校時代に漢文の先生が話して呉れた藐姑射の山の神女とかいうものでも持って来るより仕方がございますまい。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "古くさい書物｜棚から、唐守、藐姑射の刀自、赫耶姫物語などを絵に描いた物を引き出して退屈しのぎにしていた。",
              "citation": {
                "source": "源氏物語",
                "author": "蓬生",
                "note": "青空文庫"
              }
            },
            {
              "text": "藐姑射山人は荘子から出てゐること論を待たない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "是は此篇を藐視する消極の言ではなくて、此篇を嫉視する積極の言である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし若し考証の煩を厭ふならば、其人はこれを藐視して已むべきで、これを嫉視するに至るべきでは無い。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "二百の谷々を埋め、三百の神輿を埋め、三千の悪僧を埋めて、なお余りある葉裏に、三藐三菩提の仏達を埋め尽くして、森々と半空に聳ゆるは、伝教大師以来の杉である。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "注に『説文』曰く、〈睨は斜視なり、劉長曰く、邪睨邪視なり〉、同上、麗服｜藐流眄、一顧｜傾城とある＊を、山岡明阿の『類聚名物考』一七六に引いて、邪視をナガシメと訓じあるを見あてた。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和六年四月、『民俗学』三ノ四）＊　註に※は眉睫の間、藐、好き視容なり。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "７ひねもす空の八衢に、すべる車の煌の輪の清きどよみを聞きながら、吹息する夜は神祕の氣、虹のごとくに花やぎて、展くや、ここに大天のさかえ溢るる藐姑の山、高き清きにあくがれて、「いであ」の國に遊ぶ子ぞ、正目にかかる常世べのかかる奇靈も仰ぎえて、生身さながら白金の御座にすがる醉あらむ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この彦太楼尾張屋の主人というは藐庵や文楼の系統を引いた当時の廓中第一の愚慢大人で、白無垢を着て御前と呼ばせたほどの豪奢を極め、万年青の名品を五百鉢から持っていた物数寄であった。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿耨多羅三藐三菩提の仏たちわが立つ杣に冥加あらせたまへ（伝教）　いとめでたき歌にて候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿耨多羅三藐三菩提の佛たちわか立つ杣に冥加あらせたまへ　（傳教）　いとめでたき歌にて候。",
              "citation": {
                "source": "歌よみに與ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿耨多羅三藐三菩提の仏たちわが立つ杣に冥加あらせたまへ　（伝教）　いとめでたき歌にて候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "能於娑婆国土五濁悪世、劫濁見濁煩悩濁衆生濁命濁中得阿耨多羅三藐三菩提。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "当知我於五濁悪世行此難事得阿耨多羅三藐三菩提為一切世間説之難信之法是為甚難仏説此経已舎利弗及諸比丘一切世間天人阿修羅等聞仏所説歓喜信受作礼而去。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "得阿耨多羅三藐三菩提。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいへん前置きが長くなりましたが、これからお話しするところは、「三世の諸仏も、般若波羅蜜多に依るが故に、阿耨多羅三｜藐三｜菩提を得たもう」　という一節であります。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に、「阿耨多羅三｜藐三｜菩提を得たもう」　ということですが、この語は、梵語の音をそのままに写したもので、原語でいえば「アヌッタラ、サミャク、サンボーディン」というのであります。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に三藐ということは、偽りない、正しいという意味です。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、つまり「阿耨多羅三｜藐三｜菩提」とは、訳していえば「無上正※知」または「無上正等覚」というべきであります。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "換言すれば、「この上もない真実なさとり」という意味が、阿耨多羅三藐三菩提ということです。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "北は見渡す限り目も藐に、鹿垣きびしく鳴子は遠く連なりて、山田の秋も忙がしげなり。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            },
            {
              "text": "藐然として流俗の毀譽に關せず、優游自適其の好む所に從ふ、樂は即ち樂なりと雖も、※蛄草露に終ると孰れぞや。",
              "citation": {
                "source": "人生終に奈何",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "床の間には三藐院の掛物がかけてありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "三藐院の掛物は感心こそすれ、あえて異様とするには足りないのですが、その下の置物がたしかに異様でありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "問題の髑髏が三藐院の掛物の前で、ビクビクと震動すると見る間に、すっくと床の間いっぱいに立ち上りましたが、それは骸骨の上に衣冠束帯を着けて現われました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "三藐院の掛物のことが伊太夫の頭に在ってみると、それから連想して、骸骨が衣冠束帯をつけたということも、夜前の印象が、ごっちゃになって伊太夫の脳膜に襲いかかったというだけのものでしょう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣冠束帯に変装した床上の髑髏が、いつの間にか、またもとの一塊の白骨となって、床上に安んじているのを見ると、夢は夢でありながら、伊太夫もなんだか、ばかにされたような気になって、これはそもそも、この三藐院が曲者だなと思いました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "三藐院の掛物が最初から頭にあるので、それで、つい衣冠束帯のお化けが出て来たのだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
