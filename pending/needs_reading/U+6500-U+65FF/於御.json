          "literary": [
            {
              "text": "御隠居様｜御不快被為入御容体書於御家従詰所拝見。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "金巾御紋付御小袖一つ、※御紋付一つ、為別段唐桟御袴地一つ、唐更紗御布団地一つ、計四品、於御納戸頂戴。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "前条の下の段申上候は再度の御書中ニ於御察申、御尤の御事と奉存候。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年十一月十日　林謙三あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "於御尋者、可為本望候。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
