        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "横佩家の郎女が、稱讃淨土佛攝受經を寫しはじめたのも、其頃からであつた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃ちようど、稱讃淨土佛攝受經を、千部寫さうとの願を發して居た時であつた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "稱讃淨土佛｜攝受經を、姫が讀んで居たとしたのは、後に出て來る當麻曼陀羅の説明に役立てようと言ふ考へなどはちつともなかつた。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "稱讚淨土佛｜攝受經を、姫が讀んで居たとしたのは、後に出て來る當麻曼陀羅の説明に役立てようと言ふ考へなどはちつともなかつた。",
              "citation": {
                "source": "山越しの阿彌陀像の畫因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてそれは、止み難き攝受のため息く吐息であつた。",
              "citation": {
                "source": "「槐多の歌へる」序",
                "author": "山本鼎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
