          "literary": [
            {
              "text": "わたくしは其集の末巻を攤いて見た。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで土間で其本を攤いて、舞台と見較べてゐた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "時としては座に就いて巻を攤かずに、今日は疲れてゐるから書物よりは酒にしようと云つて、酒肴を饗した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝山内の僧房に老僧は端座して詩巻を攤き、年少の詩人は酒盃を手にして灯下に相対している光景が歴然として目に浮び来った故である。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "盃をとれば酒を思ひ、骰子をとれば攤うたんことを思ふ。",
              "citation": {
                "source": "帰依と復活",
                "author": "龜井勝一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
