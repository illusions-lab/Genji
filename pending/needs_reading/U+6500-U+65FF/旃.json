        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "加旃ず主人公に扮するは、嘗てナポリに在りしとき、闔府の民をして物に狂へる如くならしめきといふ餘所の歌女なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊枝　加旃また加茂川の大水。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここ過ぎり街にゆく者、――婆羅門の苦行の沙門、あるはまた生皮漁る旃陀羅が鈍き刃の色、たまたまに火の布巻ける奴隷ども石油の鑵を地に投げて鋭に泣けど、この旱何時かは止まむ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "着物は狼や羊や熊の皮を綴り合わせた旃裘。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後蘇武が窖の中に幽閉されたとき旃毛を雪に和して喰いもって飢えを凌いだ話や、ついに北海（バイカル湖）のほとり人なき所に徙されて牡羊が乳を出さば帰るを許さんと言われた話は、持節十九年の彼の名とともに、あまりにも有名だから、ここには述べない。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐の手帳　呉郡の顧旃が猟に出て、一つの高い岡にのぼると、どこかで突然に人の声がきこえた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神後記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の名は百余人の多きにのぼって、顧旃のむすめの名もそのうちに記されていたが、幸いにまだ朱を引いていなかった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神後記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "『正法念処経』七十に竜と阿修羅と赤海下に住み飲食の故に常に共に闘う、〈また大海あり、名づけて竜満という、諸竜あり、旃遮羅と名づく、この海中に住み、自ら相闘諍す〉。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊びに出た歸路、迦旃延が坐禪するを見、群臣と共に之を埋む。",
              "citation": {
                "source": "詛言に就て",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、右手の護摩木長さ一尺二寸、幅三指の――紫剛木、旃壇木、楓香木、菩提樹を取って、炉の中へ積上げ、その上に、小さい杓で、薫陸香、沈香、竜脳、安息香の液をそそいだ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「日蓮は日本国東夷東条安房国海辺｜旃陀羅が子也」と彼は書いている。",
              "citation": {
                "source": "学生と先哲",
                "author": "――予言僧日蓮――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「日蓮は日本国東夷東条、安房の国海辺の旃陀羅が子なり。",
              "citation": {
                "source": "大菩薩峠",
                "author": "安房の国の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「幸いに、拙者を泊めてくれた居士は、まだ世間に流布されていない秘本をずいぶん持っていましたからね……『日蓮ハ日本国東夷東条安房ノ国海辺ノ旃陀羅ガ子ナリ！",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "『イカニ況ヤ、日蓮｜今生ニハ貧窮下賤ノ者ト生レ旃陀羅ガ家ヨリ出タリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが例の二葉より香しというあの木かしらと怪しんだ、大きな旃檀の木の下に転ってる、木の切株の上にあがって、更に爪先で伸びあがって、東の空を透しみたが、まだ黝ずんでる大空の色と見分け難いほどのものが、低く横ざまに流れていた。",
              "citation": {
                "source": "月明",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他には、自ら旃多羅だと呼号した日蓮上人開創の日蓮宗信徒が約四千六百戸で、これが宗派別の第二位におり、他の各宗派に属するものが約二万一千戸とある。",
              "citation": {
                "source": "特殊部落と寺院",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁家の出たる日蓮聖人が自ら「旃陀羅」すなわち屠者の子なりとも、また「畜生の身」なりとも言われたのはこれが為である。",
              "citation": {
                "source": "牛捨場馬捨場",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は文永八年十月佐渡流罪の折に、円浄房へ遣わしたという「佐渡御勘鈔」において、日蓮は日本国東夷東条安房国海辺の旃陀羅が子なり。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "また翌九年三月弟子檀那御中に宛てたいわゆる「佐渡御書」にも、　日蓮今生は貧窮下賤の者と生れ、旃陀羅が家より出でたり。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "などと、さらに詳しくその出生の旃陀羅であることを書いておられるのである。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち日蓮は、自ら旃陀羅の子たることを明らかにし、畜身と云い、畜生の身と云い、またこれを濁水糞嚢にたとえ、色身不相応の故に愚者の侮るもまた故ありなどと云って、自らその出身の極めて賤しき事を認めておられるのである。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "旃陀羅とは印度における屠殺業者の事である。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "天竺に旃陀羅と云ふは屠者也。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "同書の言うところによれば、当時にエタとは餌取の語の転訛で、これすなわちインドにいわゆる旃陀羅に当るというのだ。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "果してしからば聖者日蓮が文永の頃において、自ら旃陀羅の子なりと言われたその旃陀羅は、果してどの意味のエタと同視すべきものであろうか。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "３　インドにいわゆる旃陀羅と我がエタ「塵袋」の著者は、「天竺に旃陀羅といふは屠者なり、生物を殺して売るエタ体の悪人なり」と、雑作もなく説明している。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "「臥雲日件録」のその同じ文安三年十二月二十一日条に、当時の屠者の事を評して、「蓋人中最下之種」と侮辱極まる言辞を用いているのも、畢竟僧侶の同一見地から出た悪口で、当時彼らの見る旃陀羅の地位を言いあらわしたものなのである。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして聖者日蓮は、自らその賤しむべき旃陀羅の子だと云い、身は人身に似て畜身なりとも、身は畜生の身なりとも云っておられるのである。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
