          "literary": [
            {
              "text": "於茲手を取りて泣きぬ。",
              "citation": {
                "source": "花間文字",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "跋は享和甲子即文化紀元の作で、「翁歿十有三年於茲」と云つてあるから、巵兮は寛政四年に歿したと見える。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「余与混外上人相知五六年於茲。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「余与金輪寺混外上人相知五六年於茲、而以病脚在家、未嘗面謁、丙子秋、与石田士道、成田成章、太田農人、皆川叔茂同詣寺、得初謁、乃賦一律。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
