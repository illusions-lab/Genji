        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "が、遠い枯木立や、路ばたに倒れた石敢当も、中佐の眼には映らなかった。",
              "citation": {
                "source": "将軍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯疑ふ、今君亦｜石敢当の起源を知るや否や。",
              "citation": {
                "source": "八宝飯",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "石敢当も亦実在の人物ならず、無何有郷裡の英雄なるべし。",
              "citation": {
                "source": "八宝飯",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし又更に大方の士人、石敢当の出処を知らんと欲せば、秋風｜禾黍を動かすの辺、孤影蕭然たる案山子に問へ。",
              "citation": {
                "source": "八宝飯",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "また薩摩、大隅では、道路のつき当たりに「石敢当」と刻したる建て石がある。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
