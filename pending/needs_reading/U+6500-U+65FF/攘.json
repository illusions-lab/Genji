        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "風は害虫を攘ひ、花粉の交媒を助ける。",
              "citation": {
                "source": "風と裾",
                "author": "――何人か良案はないか？――",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとかして永久にこの幽靈を追ひ攘つてしまふのでなければ、小幡一家の平和を保つことは覺束ないやうに思はれた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はどんな利益を犠牲にしても、悪魔のような久次郎を追い攘ってしまわなければならないと決心した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の攘夷論者は西洋人を獣類の一種と思っていた。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ一婦人の身を以て兵を起し城を屠り、安遠侯柳升をして征戦に労し、都指揮衛青をして撃攘に力めしめ、都指揮｜劉忠をして戦歿せしめ、山東の地をして一時｜騒擾せしむるに至りたるもの、真に是れ稗史の好題目たり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "（中略）三先生既に斯文の宗主、後学の師範たり、仏老を攘斥すというと雖も、必ず当に理に拠って至公無私なるべし、即ち人心服せん。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は証拠文書を攘って来たのだから、それに合せて逐一に述立てた。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "猶源頼朝の蛭が島に在りしや、僅に伊豆一国の主たらんことを願ひしも、大江広元を得るに及びて始めて天下を攘みしが如き也、正統記大鏡等、蓋し其跡に就いて而して之を拡張せる也、故に採らず」と云つてゐる。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "○狂攘して相救へば、先後并に没す。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂攘して相救へば、前軍後軍、相倶に覆没す。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "嚴格に云へば非戰主義では無くて、非侵略主義であるところの墨子の説を實際に成立たせようとすれば、敵が侵略行爲に出て來る以上は對抗撃攘の道を講ぜねば空言に終るから、それで是の如き兵備施爲をば教へたものである。",
              "citation": {
                "source": "墨子",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれは道教が其等の言論を借用し若くは攘取して、自己を飾つたものであると云へるのである。",
              "citation": {
                "source": "道教に就いて",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "今やコルソオの競馬始らんとするなれば、兵士は人を攘はんことに力を竭せり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "少焉ありて、上衣を脱ぎ襯衣の袖を攘げたる男現れて、舞臺の前なる燭を點しつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "帳場に坐るはずであった花村は、その時分には用がなくなり、開業当初の関係を断ち切るために、訪ねて来ても、気分が悪いといって、二階へ上げないこともあり、留守を使って逐っ攘うこともあった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし史朗はその時、清川に頭臚を殴られ、泣き面かきながら逐い攘われて来た。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お作は場所塞げの厄介物を攘った気でいたが、新吉は何となく寂しそうな顔をしていた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああでも言って逐攘わなくちゃ、遣切れやしないじゃないか」お島は顫えるような声で言った。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "此方ではそれぞれ規定の洋服屋があるから」　門番や小使たちは、学生の手から校庭へ撒棄てられる引札を煩がって、彼女を逐攘おうとした。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "私を旦那に逢わしてください」　女はそこを逐攘われると、外へ出ていつまでもぶつぶつ言っていた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
