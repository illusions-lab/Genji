          "literary": [
            {
              "text": "二人共陸軍騎兵中尉で、一人は竜騎兵、一人は旆騎兵に属している。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            },
            {
              "text": "門口に出ると、旆騎兵中尉が云った。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            },
            {
              "text": "」旆騎兵中尉は、「気が違ったかい」と附け加えたかったのを、我慢して呑み込んだ。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            },
            {
              "text": "友達の旆騎兵中尉は、「なに、色文だろう」と、自ら慰めるように、跡で独言を言っていたが、色文なんぞではなかった。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
