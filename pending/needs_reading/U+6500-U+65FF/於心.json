          "literary": [
            {
              "text": "人之能為霊、以其有霊於心也。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "又曰、原我性命受化於心、心受之於意、意受之於精、精受之於神、形体消而神不毀、性命既而神不終、形体易而神不変、性命化而神常然。",
              "citation": {
                "source": "通俗講義　霊魂不滅論",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "不信於躬、而信於心。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
