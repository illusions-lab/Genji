          "literary": [
            {
              "text": "即ち「闕書備於後世」「亡書出於後世」「亡書出於民間」等の論で、その闕書後世に備はるといふのは、同じ本が前に卷數少く後世に多ければ後に備はつたと考へた。",
              "citation": {
                "source": "支那目録學",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "將於後篇、論述此感性之一元、爲何作用焉。",
              "citation": {
                "source": "靈魂一元論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "君将失威於東土、遺嘲於後昆。",
              "citation": {
                "source": "奥州における御館藤原氏",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人束髮於後、亦衣裙襦裳、皆有、竹爲梳、編草爲薦、雜皮爲表、縁以文皮。",
              "citation": {
                "source": "隋書倭國傳",
                "author": "魏徴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
