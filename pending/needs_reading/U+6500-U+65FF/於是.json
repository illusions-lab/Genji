        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "於是村内の惡少、誰も彼も先づ一ツ、（馬鹿な事を）とけなしつける。",
              "citation": {
                "source": "鑑定",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是蒼くなりて大に懼れ、斉しく牲を備へて、廟に詣つて、罪を謝し、哀を乞ふ。",
              "citation": {
                "source": "甲冑堂",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是乎、憂国之士、奮然｜蹶起して、奸邪を芟夷し、孑遺なきを期すべし。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "中根香亭は「朝延大発軍艦北征、我艦要撃之于宮古、敗而還、於是五稜廓為本営、列戦艦於函館港、分遣諸隊於松前江差室蘭、以備敵」と記してゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是乎、腕を拱いて大ハイ大いに考えたのです。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの周の時代に、※王が無道の政を行って、国民の怨を買い、遂に出奔した時、周・召の二宰相がともに協力して、十四年の間国王なしの政治をした事が「十八史略」にも、於是国人相与畔。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "という記事と、更にまた「論語」子路篇の、葉公語孔子曰、吾党有直躬者、其父攘羊而子証之、孔子曰、吾党直者異於是、父為子隠、子為父隠、直在其中矣。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是阿倍志彦神來集不勝而還却。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　於是「先生」は俄然「あなた」に変じ、彼の蛇男は立派な社会評論家になってしまったのである。",
              "citation": {
                "source": "途上の犯人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是、彼に対する嫌疑はいよいよ深くなり、さんざん言いこまれた末、とうとう彼もまま真実に近い自白をはじめた。",
              "citation": {
                "source": "殺人狂の話",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（中略）於是百有餘年。",
              "citation": {
                "source": "支那人辮髮の歴史",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "景行紀ニ又、「天皇將向京、以巡狩筑紫國、始到夷守、是時於石瀬河邊、人衆聚集、於是天皇遙望之、詔左右曰、其集者何人也、若賊乎、乃遣兄夷守弟夷守二人令覩、乃弟夷守還來而諮之曰、諸縣君泉媛、依献大御食而其族會之」夷守ハ、今ノ日向國西諸縣郡小林郷ナリ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是乎千六百十一年、彼等ハ相図リテ移住ノ儀ヲ定メ、永ク英人タルヲ得、且ツ基督教団ノ基礎ヲ据ヱ得ル処ヲ求メタリケルニ、あめりかハ洵ニ能ク此等ノ目的ニ副フモノナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是季孫行父請命于周。",
              "citation": {
                "source": "支那歴史的思想の起源",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "成二年魯於是乎始※。",
              "citation": {
                "source": "支那歴史的思想の起源",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "襄四年魏絳於是乎始有金石之樂。",
              "citation": {
                "source": "支那歴史的思想の起源",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "襄十一年始用人于亳社昭十年魯於是始尚羔。",
              "citation": {
                "source": "支那歴史的思想の起源",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人得至其山、取土来帰、於是天皇甚悦。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是大国主神愁而、告吾独何能得作此国。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是、彼等は其長紳を※き、其大冠を頂き、其管絃を奏で、其詩歌を弄び、沐猴にして冠するの滑稽を演じつつ、しかも彼者自身は揚々として天下の春に謳歌したり。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是時人名白衣神人而已。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "斉明紀四年十一月の条に、「於是皇太子、親間有間皇子曰、何故謀反、答曰、天与赤兄知、吾全不解」の記事がある。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是世人感安武之死諫。",
              "citation": {
                "source": "遺篇",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "高祖曰、此大無義理、於是訓令改之。",
              "citation": {
                "source": "隋書倭國傳",
                "author": "魏徴",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是、設宴享以遣清。",
              "citation": {
                "source": "隋書倭國傳",
                "author": "魏徴",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉起於是聞魏文侯賢。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "孫子呉起列傳第五",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是呉起見公主之賤魏相。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "孫子呉起列傳第五",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是韓非疾治國不務修明其法制。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "老莊申韓列傳第三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
