          "literary": [
            {
              "text": "第一幕　第一場斡児桓河に沿い、抗愛山脈に分け入らんとする麓。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼下はるかに塔米児、斡児桓両河の三角洲。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう斡児桓河を渡ったな。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "塔米児、斡児桓の両河の合する三角洲に設けられた、成吉思汗の大｜天幕の前。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀の鱗と騒ぐ斡児桓と塔米児の川波が、知っているばかりだ。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで一望の砂原と見えたあたりに、斡児桓の川水が光って見えはじめる。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に、兵卒ら多勢走り廻って、ばたばたと天幕を畳めば、斡児桓河の向うに、抗愛山脈が旭に光り、舞台一面の広場となる。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
