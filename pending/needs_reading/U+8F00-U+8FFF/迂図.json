          "literary": [
            {
              "text": "市郎も其の図迂図迂しいのに少しく惘れた。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之も先方から真白昼押掛けて来て、平気でお出でお出でを極めるとは、図迂図迂しい奴、忌々しい奴と、市郎は惘れを通り越して、稍勃然とした。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車賃もない癖に、坑夫になろうなんて呑込顔に受合ったんだから、自分は少し図迂図迂しい人間であったんだと気がついたら、急に頬辺が熱くなった。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
