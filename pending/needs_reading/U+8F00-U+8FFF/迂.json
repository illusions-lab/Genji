        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "思えば自分はどう考えても迂愚であった。",
              "citation": {
                "source": "大雨の前日",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の家の中庭を突つきつて街路へ出たり、狭い石垣の下を通つて横丁へ出たり、勝手口のやうな裏道を迂廻したり、小さな坂を登つたり降りたりする所が多い。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日が来ると羽織袴の、揃つて粗雑な顔をした運動員達が道場の内や外を迂路ついてゐるのが見られた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私自身が無名でさへなかつたならば、何とかしたでもあつたらうけれど、私が話をした知名の人達はどう迂つ闊りとしてゐたものか。",
              "citation": {
                "source": "宮沢賢治全集",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "町外れから、曲り拗ねった路や、立木の暗い下を迂路ついて、与平治茶屋まで来た。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "左側は、駅から迂回して来た鉄路のある山腹の切断面、それから高架線、それらが万寿のかかってる方へ並行していた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ごろ要求するのは、われわれの迂愚であり、同時に万寿丸の恥辱でしょう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっと、迂濶でしたね。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんという迂闊な子だろう。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹田と金木と相隔たる事、四角形の一辺に過ぎないのだが、その間に梵珠山脈があつて山中には路らしい路も無いやうな有様らしいので、仕方なく四角形の他の三辺を大迂回して行かなければならぬのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、そこで降りてみて、いいようだったら、そこで一泊して、それから多少、迂余曲折して、上諏訪のあの宿へ行こう、という、きざな、あさはかな気取りである。",
              "citation": {
                "source": "八十八夜",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五次方程式が代数的に解けるものだか、どうだか、発散級数の和が、有ろうと無かろうと、今は、そんな迂遠な事をこね廻している時じゃないって、誰かに言われているような気がするのだ。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "迂遠な学問なんかを、している時じゃ無い。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の出鱈目を何でも信じてくれる者の胸中には、しばしば何かのおそるべき悪計が蔵せられてゐるものだと云ふ事を、迂愚の狸は知らなかつた。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "迂濶すぎるほどである。",
              "citation": {
                "source": "令嬢アユ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐるりと此の島を大迂回して、陰の港に到着するという仕組なのだろう。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんという迂濶な男だ。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、また大隅君にとっては、この五年振りで逢った東京の友人が、相変らず迂愚な、のほほん顔をしているのを見て、いたたままらぬ技癢でも感ずるのであろうか、さかんに私たちの生活態度をののしるのだ。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の出鱈目を何でも信じてくれる者の胸中には、しばしば何かのおそるべき惡計が藏せられてゐるものだと云ふ事を、迂愚の狸は知らなかつた。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより迂愚の著者である。",
              "citation": {
                "source": "『老ハイデルベルヒ』序",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまの状勢で、あらたに出版業をはじめる事の難儀は、私の如き迂愚の者にも察しがつく。",
              "citation": {
                "source": "『パンドラの匣』あとがき",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、黄河を迂回して、側面からここを圧迫する馮玉祥の騎兵部隊と、泰山の南を縫うて、明水平野に出た陳調元の優勢な一部隊に圧迫せられ、又、戦わずに、界首と、黄河の線を抛棄した。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　自動車は、太馬路から、拒馬や、鉄条網が、頑張っていない、緯四｜路へ出て、七｜馬路で永※門の方面に曲り、日本軍の警備区域でもなく、南軍が散在している区域でもない、その中間の線を選んで迂廻した。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」健二は自分の迂闊さを口惜しがった。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ左右の斷崕と其間を迂回り流るゝ溪水ばかりである。",
              "citation": {
                "source": "都の友へ、Ｂ生より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "此某町から我村落まで七｜里、若し車道をゆけば十三｜里の大迂廻になるので我々は中學校の寄宿舍から村落に歸る時、決して車に乘らず、夏と冬の定期休業毎に必ず、此七｜里の途を草鞋がけで歩いたものである。",
              "citation": {
                "source": "畫の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "この某町から我村落まで七里、もし車道をゆけば十三里の大迂廻になるので我々は中学校の寄宿舎から村落に帰る時、決して車に乗らず、夏と冬の定期休業ごとに必ず、この七里の途を草鞋がけで歩いたものである。",
              "citation": {
                "source": "画の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば路という路、右にめぐり左に転じ、林を貫き、野を横ぎり、真直なること鉄道線路のごときかと思えば、東よりすすみてまた東にかえるような迂回の路もあり、林にかくれ、谷にかくれ、野に現われ、また林にかくれ、野原の路のようによく遠くの別路ゆく人影を見ることは容易でない。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう時に世人はよく理論と実際という常套語を持出して科学者の迂遠を冷笑するのが例である。",
              "citation": {
                "source": "物理学の応用について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "末広君の学術方面の業績は多数にあって到底ここで詳しく紹介することは出来ないし、またそれは工学方面の事に迂遠な筆者の任でもないが、手近な主だったものだけを若干列挙してみると次のようなものがある。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
