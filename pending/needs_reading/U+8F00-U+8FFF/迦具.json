        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……あゝ迦具土の神の鐵車を驅つて大都會を燒亡す車輪の轟くかと疑はれた。",
              "citation": {
                "source": "露宿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "迦具工はなつかしい！",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "『古事記』には火之迦具土神を生ますに御陰炙かれて崩りましぬ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "いと熱き火の迦具土の言葉とも知らずほのかに心染めてき　今思へば、母の胎をさへ焼いたといふ赤熱した雷火のやうな言葉だつたのを、さうとも知らず、やさしいことを言ふものだと思つてなつかしい心持さへ起したが、未熟な少女心とは云へ見当違ひもひどかつた、と生成した心は思ふのである。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時は余程心を悩まされたものと見え　この度は命危ふし母を焼く迦具土二人我が胎に居る　とも作られてゐる。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治の新派和歌では、服部躬治氏の試みられた安房歌（「迦具土」）が此種の最初のものであらうが、全体的に生命が律動してゐない。",
              "citation": {
                "source": "短歌の口語的発想",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "火神｜迦具土神は、伊弉冊神の子なり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「迦具」の義は、かがやくなり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "迦具土神生れて、母神を焼きしも亦た、此方法にして火切杵と火切臼とによりて、切り出されたる火が、其一方に燃え著くを、云う者なり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "神話は語りて曰く、次に火之夜芸速男神を生みます、亦の名は、火之※毘古神と申し、亦の名は火之迦具土神と申す。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊邪那岐命｜御佩かせる十拳剱を抜きて、其子迦具土神の御頸を斬り給う。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあれ――かくてそのかみ伊弉冊が、子の迦具土の息の火に焦しはてたる永遠の女性は遂に招かれて、（さても誉れの囚人や）、また人の世にかへり来ぬ慈悲こそは永遠の女性なれ、かくてこそ人の子の勝利はあれと喝破す。",
              "citation": {
                "source": "『二十五絃』を読む",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "『古事記』の所伝に拠れば、伊弉冉尊は神迦具土をお生みになって、それが為に神避り坐した。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "是に於て伊弉諾尊は御佩せる十拳剣を抜いて迦具土ノ神の頸を斬り給うた。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大蛇退治の神話は出雲以外には無いけれども、竜王即ち神及｜高神、高※神、闇罔象の三神とも、迦具土ノ神から生れた雨神に外ならぬ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "南宮神社は金山彦命を祭神とする国幣大社であるが、古名仲山金山彦神とあるので竜神に関係あること疑ないのみならず、祭神五座の中に闇罔象女神があり今も摂社に闇が祭ってある所から推して、元来神と同じく迦具土の血から生まれた大蛇闇山祗を崇めたものであると信ずる。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はふいと、中學生の時分に、「迦具土」と云ふ服部｜躬治の歌集の中で讀んだことのある一首の歌を想ひ起して、それを口のうちで繰り返した。",
              "citation": {
                "source": "二月堂の夕",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "またの名は火の※毘古の神といひ、またの名は火の迦具土の神といふ。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに伊耶那岐の命、御佩の十拳の劒五を拔きて、その子｜迦具土の神の頸を斬りたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺さえたまひし迦具土の神の頭に成りませる神の名は、正鹿山津見の神七。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また大筒木垂根の王が女、迦具夜比賣の命に娶ひて、生みませる御子、袁那辨の王一柱。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この王、淡海の柴野入杵が女、柴野比賣に娶ひて生みませる子、迦具漏比賣の命。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれ大帶日子の天皇、この迦具漏比賣の命に娶ひて生みませる子、大江の王一柱。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また迦具漏比賣に娶ひて生みませる御子、川原田の郎女、次に玉の郎女、次に忍坂の大中つ比賣、次に登富志の郎女、次に迦多遲の王五柱。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
