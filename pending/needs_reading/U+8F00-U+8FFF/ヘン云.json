        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「百辺云はうと云つたのはどうしたんだ？",
              "citation": {
                "source": "父の百ヶ日前後",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君は馬鹿だよ」と多くのビジネスマンから何辺云はれたか知れない。",
              "citation": {
                "source": "〔同人雑記〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さうです、あなたはたしかに幸福です、ですから私はさつきから、あなたは幸福なんだ、と何辺云つたか知れないじやありませんか。",
              "citation": {
                "source": "嘆きの孔雀",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……何だと、もう一辺云つて見やがれ！",
              "citation": {
                "source": "病状",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし衣の肩をいれながら手を払つてゐた和尚が、「何だつて、もう一辺云つて見ろ！",
              "citation": {
                "source": "心象風景（続篇）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一辺云つて見ろ、シツダルのためにランプ祭の恋歌を作つたロールツヒが此処にゐるのが解らないのか！",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "二六時中ゲジゲジ野郎の相手がでけるけえ、ヘン　酔ぱらわなきゃ　俺アにはこの世の中が暮していけねえよ……」「……ま、一辺云ってみな、野郎……」　ガチャン　バタン　ガラ　ガラ　ガラ……　祭壇の壁一重隣りでは乱闘が始まった。",
              "citation": {
                "source": "反逆",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何邊云つても、母親は又新しいことか何かのやうに、云つた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
