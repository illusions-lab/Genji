        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "が、近附いて見ると、坂東、沢村、市川、中村、尾上、片岡、役者の連名も、如件、おそば、お汁粉、牛鍋なんど、紫の房の下に筆ぶとに記してあった……　松崎が、立寄った時、カイカイカイと、ちょうど塀の内で木が入って、紺の衣服に、黒い帯した、円い臀が、蹠をひょい、と上げて、頭からその幕へ潜ったのを見た。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "右は今出川住人富田無敵の訴出に依れば、盗賊の逐電致せし者にきっとまぎれなき由、依って高札を掲げる事如件」　とあり、何となく面映ゆく赤面していると、意外な囁きが耳に入った。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑い掛けたのは半途で圧え、噴出したのは嚥込んで、いやに静かな事よって如件。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の風恰好亦如件……で、運轉手が前途を案じてくれたのに無理はない。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "以て如件なんだが、さてこれで級第かね？",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "△酔如件――これで何もかも解消！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・豆腐さげてしぐれて濡れてもどる　　　自戒・今日から禁酒のしぐれては晴れる空・菜葉しぐれてきたこやしをやらう・熟柿日和で山の鴉が出てきてさわぐ　　　あつ子嬢新婚　ほんに晴れわたり木の葉のとぶことも　　　改作・ここを死に場所とし草はしげるままに　十一月八日」はママ］日本晴、それから――万事如件。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君を悪物喰といつたのは小生一生の不覚、自今如何やうな事があつても悪物喰などとは決して申すまじ、後日のため一｜札仍而如件。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "よって、誓詞｜如件。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "右之趣御領内急度可被相触候、此旨被仰出者也、｜仍如件。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "後日のため一札、仍って如件　　四月一日　　　　　　　　　　女坂染吉※　大久保一平殿　要するに一平なる人物は、和製カポネ団の一員だったんです。",
              "citation": {
                "source": "ネオン横丁殺人事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "為後日証文｜依而如件。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一札入申候証文之事、私儀御当家様とは何の縁びきも無之、爾今｜門立小唄その他御迷惑と相成可一切事堅く御遠慮申上候、若し破約に於ては御公儀へ出訴なされ候も夢々お恨申す間敷、後日のため覚書の事｜依如件、近江屋さま、つや――とある。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "お茶漬音頭",
                "note": "青空文庫"
              }
            },
            {
              "text": "右爲増神威、殊存祈祷、寄進如件。",
              "citation": {
                "source": "淡路人形座訪問",
                "author": "竹内勝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "返弁之儀当暮限壱割五歩之利足を加、元利共必然皆済可致、仍之借用始末｜如件候。",
              "citation": {
                "source": "手紙",
                "author": "文久元年十月十四日　田中良助あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "形が人頭牛身であるところから、漢字に綴っては件となし、未来に対する予言が必定なところから、世俗もこれにならって、証文などに「依如件」と書くのである。",
              "citation": {
                "source": "「沈黙」の話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち依而如件さ』『なるほど、それから？",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　私儀狂言作者志望につき福地先生｜門生と相成貴座楽屋へ出入被差許候上者劇道の秘事楽屋一切の密事｜決而口外｜致間敷候｜依而後日のため一札如件　歌舞伎座稽古は後々まで三階運動場を使用するが例なり。",
              "citation": {
                "source": "書かでもの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "まづは御笑草まで委細｜如件　　月　　日彩牋堂旧主金阜先生　雨はやっと霽れた。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "有公田之外間田者、如年来にて不可有相違之旨、依鎌倉殿仰執達如件。",
              "citation": {
                "source": "奥州における御館藤原氏",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "為後日一札仍て如件　天保七申十二月　　　日成行村売主　　儀十郎印請人　　弥右衛門印同　　政五郎印大久保村買主　　儀左衛門殿　右の「上十五日」とは、月の上半に右両村内に生じた死牛馬の権利を云ったものなのである。",
              "citation": {
                "source": "牛捨場馬捨場",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "為後日之依て手形如件。",
              "citation": {
                "source": "牛捨場馬捨場",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "為後日一札仍て如件。",
              "citation": {
                "source": "牛捨場馬捨場",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "庄家存此旨、任下知旨、可致其沙汰之状、依衆議下知如件。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "早可止其催之由可被加下知之状、依仰執達如件。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の『掛川声聞師所伝』永禄六年の今川氏裁許状にも、陰陽博士・院内・声聞身の名とともに、散所の称をも用い、「就中随散所下知輩、如往古引付、年貢銭無相違可請取之状如件」などとある。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "木曾長政願文　集古文書巻四十七御岳為精進当郷百日在郷諸願成就皆令満足候事也為後日一筆如件。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "社は現に猪苗代町の北方に立派に保存され、宝物の鏡の銘に奉懸岩椅大明神　　　　本地御正体一面右志趣者為心中祈願成就円満乃至法界平等利益所奉□□如件永仁三年閏二月十八日　　　　　　　　　藤原氏女　敬白と記されている。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "免許　一　横綱之事　右者谷風梶之助依相撲之位令授与畢以来片屋入之節迄相用可申候仍如件寛政元酉十一月十九日本朝相撲之司御行事十九代　吉田追風　　朱判之は正確のものである。",
              "citation": {
                "source": "初代谷風梶之助",
                "author": "三木貞一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
