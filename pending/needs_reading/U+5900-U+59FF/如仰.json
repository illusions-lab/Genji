          "literary": [
            {
              "text": "」「落合敬助太田同居にてたび／＼御逢被成候よし、如仰好人物也。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "如仰梅天不正之儀に御坐候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "（師子間者大宮殿第二御殿与第三御殿之間於申也）御出現時分事如仰長保五年候歟。",
              "citation": {
                "source": "春日若宮御祭の研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "如仰昨日者、さはりなく終日｜申承、本望此事に候。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
