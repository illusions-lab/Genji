          "literary": [
            {
              "text": "（三種い節）とあるは、漢書地理志に粤地の事を記せる文を襲用し、作衣如單被。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "其地大較在會稽東冶之東、與朱崖・布、出白珠青玉、其山有丹、土氣温、衣如單被、貫頭而著之、竝丹朱豆。",
              "citation": {
                "source": "後漢書倭傳",
                "author": "范曄",
                "note": "青空文庫"
              }
            },
            {
              "text": "其風俗不淫、男子皆露、作衣如單被、穿其中央、貫頭衣之。",
              "citation": {
                "source": "魏志倭人傳",
                "author": "陳壽",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
