          "literary": [
            {
              "text": "三夾河まで買わせろ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三夾河行き」、「いや、蔡家溝で下車」、「三人で停車場まで走るんだ」など安重根、禹徳淳、劉東夏の三人、口ぐちに大声に言いながら勢いよく屋根を降りて行く。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（禹徳淳へ笑って）三夾河まで行った方がよかったかな。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "禹徳淳　明朝三夾河、寛城子の方へ発つつもりです。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            }
          ]
        }
