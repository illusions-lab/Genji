          "literary": [
            {
              "text": "まことに、きせる（煙管）を、よく、とをし奉候。",
              "citation": {
                "source": "盲人独笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋気次第に相増候処、愈々御機嫌｜能可被成御座、目出度千万存奉候。",
              "citation": {
                "source": "手紙",
                "author": "嘉永六年九月二十三日　父坂本八平直足あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり法外に高金と存候まゝ無余儀先生を労し奉候。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十一月十六日　溝渕広之丞あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰も道で出会って、「毎度御厚情万謝奉候」などとかたっ苦しい事をいふ人はないだらう、だからこれからは、すべての文章が口語体になるのだ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて旧臘以来種々御意匠を煩はし候｜赤坂豊狐祠畔の草庵やつと壁の上塗も乾き昨日｜小半新橋を引払ひ候｜間明後日夕景よりいつもの連中ばかりにて聊か新屋落成のしるしまで一酌致たく存候間｜御迷惑ながら何とぞ御枉駕の栄を得たく懇請｜奉候。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "凌暑の候起居｜倍御佳迪欣勝｜奉候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れば先日ハ両度の朶雲謝し奉候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "過日｜京師へ差出し下され候由｜是亦謝し奉候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「朶雲拝誦、先以て老兄｜足下御勝常賀し奉候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "固より二老は天下の大老に御座候間お為に相成候事□余益これ有る可くと存じ奉候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "末頼母しく存じ奉候処、右様の次第恐入り奉り候御事に御座候へども、別段歎息の至に存じ奉り候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一幽林翁遺稿御写し下され有難く存じ奉候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "先以テ御壮健ニ御座ナサレ賀シ奉候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "文面には、　私事、お許様御舟にて、船島へ遣さる可旨、仰せ被聞、重畳お心づかいの段、辱なくぞんじ奉候　然れどこの度、私と小次郎とは敵対の者にて御座候。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに小次郎は君公の御舟にて遣され、私は其許様お舟にて遣され候旨に御座候処、右、御主君に被対、如何わしく存じ奉候。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
