        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "不思議なことには、二人の間にまるで黙契でも成り立ったかのように、その対立が突如不自然きわまる消失を遂げてしまったのだよ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……如不事祖先裸葬之類。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "無如不妬（司馬光）。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "また桂園の父なる桂陰の墓誌は藤森弘庵の『如不及斎文鈔』に載っている。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "但既免之後、汝等手技｜如不伝習子孫、子孫弥降前姓、欲従卑品。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
