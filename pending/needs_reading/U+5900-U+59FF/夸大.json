        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼れが自負心強く、夸大の空想に耽り、莊嚴なる英雄の舞臺に神迷するの状は、亦明かに彼れの風采にも躍然たり然れども彼れ不幸にして、如何なる時代の英雄にも大抵普通なる特質を其風采に缺けり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れが自負心強く、夸大の空想に耽り、荘厳なる英雄の舞台に神迷するの状は、亦明かに彼れの風采にも躍然たり然れども彼れ不幸にして、如何なる時代の英雄にも大抵普通なる特質を其風采に欠けり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "其書如阜も餘り夸大に失す。",
              "citation": {
                "source": "支那近世の國粹主義",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
