          "literary": [
            {
              "text": "「先生御道中無御替奉大慶候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "其後益御安泰奉大賀候。",
              "citation": {
                "source": "手紙",
                "author": "慶応元年閏五月五日　渋谷彦介あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒気節益御安養可被成御座、奉大賀候。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十二月四日　坂本権平あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "-------------------------------------------------------益御安泰奉大賀候。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十二月十五日　木戸孝允あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "此が、日奉部（又、日祀部）なる聖職の團體で、その舍人出身なるが故に、詳しくは日奉大舍人部とも言うた樣である。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "此が、日奉部（又、日祀部）なる聖職の団体で、その舎人出身なるが故に、詳しくは日奉大舎人部とも言うた様である。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
