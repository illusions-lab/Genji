        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしこの感謝状のために、血のある奴らが如彼に騒ぐ。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「全くそうだ、先生も如彼見えても長くはあるまい！",
              "citation": {
                "source": "富岡先生",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "余程気の練れた者でなければ、如彼は行かぬ。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "如彼ひよつとこの一人や二人、欲しけりや何時でも貴方に上げますよ。",
              "citation": {
                "source": "絶望",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　青年が、何かを答へようとしたとき、女は突如彼を遮ぎつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　青年が、何かを答えようとしたとき、女は突如彼を遮ぎった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "突如彼は、まるで自分で自分を制する力がないように、またもや先ほどと同じ神経的な哄笑を爆発させた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し同氏は其後綿密に原稿に目を通され、主として出版者としての見地から、此處を如是したなら、彼處を如彼したならと、一々讀者に對する親切から湧いた意見を發表されるので、それには余も隨分弱らされた。",
              "citation": {
                "source": "大植物圖鑑",
                "author": "自序",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
