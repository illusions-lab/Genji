        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "初なる一紙には侍奉紳士と題せり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イル、カワリエル、セルヱンテ」又「チチスベオ」、今侍奉紳士と翻す。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを侍奉紳士といふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "侍奉紳士は婦の早起｜盥漱する時より、深更寢に就く時に至るまで、其身邊に在りて奉侍す。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "他婦を顧みることを容さず、聞く侍奉紳士中｜※褻に及ばざるもの往々にして有り。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て一男子の歿するや、其｜誄辭中侍奉紳士となりて責を負ひ任を全うすといふ語ありきと。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し二者中一を取らば、猶侍奉紳士をこそ辭を措き易しとせめ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
