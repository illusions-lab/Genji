        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ありゃ急々如律令というのろいことばのかしら文字さ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "急々如律令（悪魔払いの呪文）、もう寸刻の容赦はありません。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "剪燈新話",
                "note": "青空文庫"
              }
            },
            {
              "text": "急々如律令は添え言葉、たいして意味はないらしい……さてこれで字義は解った。",
              "citation": {
                "source": "銅銭会事変",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手製のもので、裏面には急々如律令と書くのだそうだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "安吾・伊勢神宮にゆく",
                "note": "青空文庫"
              }
            },
            {
              "text": "……いやはや、急々如律令……山谷を漕ぎだすと、いきなり、ドッと横ッ吹きの大土砂降り。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "蕃拉布",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうも、えらいことになりました」　急々如律令といったていで椅子に掛けて、ぐったりと首を投げ出している。",
              "citation": {
                "source": "犂氏の友情",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "急急如律令、もう寸刻の容赦もない。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "牡丹燈記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
