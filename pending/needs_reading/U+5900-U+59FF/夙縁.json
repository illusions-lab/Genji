        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "蘭軒は屡茶山に逢ひながら、何故に一語の夙縁ある山陽に及ぶものが無かつただらうか。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "心安くなつた外國人も、同舟の夙縁で、親切に見舞に來る。",
              "citation": {
                "source": "長谷川辰之助",
                "author": "森林太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも、決して禍をする者ではありません、あなたと私とは、夙縁があります」　源は夙縁とはどんなことであろうかと思った。",
              "citation": {
                "source": "緑衣人伝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君は家の女と夙縁があるから、今晩婚礼しなくてはならないよ」　杜陽は恐ろしかった。",
              "citation": {
                "source": "陳宝祠",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはどうしても夙縁だ。",
              "citation": {
                "source": "蓮花公主",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
