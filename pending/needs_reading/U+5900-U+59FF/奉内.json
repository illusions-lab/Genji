          "literary": [
            {
              "text": "屋敷拝領被仰付候様被仰出候に付、私共業柄之事故、町場近き屋敷拝領仕度奉内願候以上。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "私儀御領分深津郡吉津村え在宅仕度奉内願候以上。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "私拝領仕候御紋附類悴｜徳へ著用為仕度奉内願候、以上。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "私拝領仕候木綿御紋附御羽織異父兄飯田安石へ相譲申度奉内願候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
