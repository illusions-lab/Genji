        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "頭上の枝葉はぎつしりと密生んでゐて、葉洩日も殆ど落ちて來ない。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭上の枝葉はぎっしりと密生んでいて、葉洩日もほとんど落ちて来ない。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "洩日の美しい所もあった。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台一面、耀く緑の木洩日に充ち溢れている………家の土間には、造麻呂が坐り込んで「唄」をうたいながら青竹を籠に編んでいる。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の陽光は眼覚めるばかりにその輝きを増し、緑色の木洩日の耀いは一段と鮮やかになって行く。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "………やがて、あたりには、再び次第次第に緑の木洩日がきらきらと輝き始める。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "木洩日は輝いている。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に再び木洩日が輝き始める。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
