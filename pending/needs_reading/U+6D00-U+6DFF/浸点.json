          "literary": [
            {
              "text": "幹太郎は、そこから、浸点作業へ通り抜けた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あいつの仕事は、いつもおおばちだから、浸点で屑が出来るこた知っとるだろうね？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "軸列と、浸点と、乾燥室は幹太郎の受持になっていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」王洪吉は、おず／＼と、浸点を見ている幹太郎のそばへ近よった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "受持の浸点作業と、乾燥室から、事務室の計算係にまわされた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
