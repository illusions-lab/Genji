          "literary": [
            {
              "text": "外套そのものとしてはさしてわるくもなく、暖かくてよかったけれど、しかし綿入れもので、浣熊の襟がついていた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "とっくり熟考した末に、わたしは浣熊の襟を売ることに決めた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しい海狸が、もと見すぼらしい浣熊のついた場所に、堂々たる威容を輝かすことになった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
