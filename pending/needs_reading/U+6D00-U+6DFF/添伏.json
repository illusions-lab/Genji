          "literary": [
            {
              "text": "十九になる娘であったが、こうして、母親と、一つの床に添伏していると、子供の心になっていた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "深紅の色の薔薇の花、秋の夕日の豪奢やかさを思はせる深紅の色の薔薇の花、まだ世心のつかないのに欲を貪る者の爲｜添伏をして身を任す貴い供物、僞善の花よ、無言の花よ。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "が女房は昌彦のそばに添伏していて、「いや、ここにいる」と頑張る。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る人の覺えてゐるのはまだ乳呑兒の頃に、枕の傍で添伏しの母の懷のなかから、樂しく聞いた時計のオルゴオルの音色である。",
              "citation": {
                "source": "地方主義篇",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
