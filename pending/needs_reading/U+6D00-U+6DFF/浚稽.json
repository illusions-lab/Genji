        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "漠北・浚稽山の麓に至って軍はようやく止営した。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その歩兵も僅か五千、絶えて後援はなく、しかもこの浚稽山は、最も近い漢塞の居延からでも優に一千五百里（支那里程）は離れている。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "浚稽山の山間には十日余｜留まった。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十日の間、浚稽山の東西三十里の中には一人の胡兵をも見なかった。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "浚稽山の陣を撤するときは夜が暗かったのに、またも月が明るくなりはじめたのである。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、西南へと取った進路がたまたま浚稽山の麓を過ったとき、さすがに陵の心は曇った。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
