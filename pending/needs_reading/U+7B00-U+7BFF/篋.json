        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "光線の強い焦點はピストルの裝彈篋を熱した。",
              "citation": {
                "source": "探偵小説の魅力",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔｜高帝升遐したもう時、遺篋あり、大難に臨まば発くべしと宣いぬ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "宦者忽にして一の紅なる篋を舁き来りぬ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時程済は辛くも篋を砕き得て、篋中の物を取出す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "篋の内に朱書あり、之を読むに、応文は鬼門より出で、余は水関御溝よりして行き、薄暮にして神楽観の西房に会せよ、とあり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅篋の度牒、袈裟、剃刀、噫又何ぞ奇なるや。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "篋中の朱書、道士の霊夢、王鉞の言、呉亮の死と、道衍の請と、溥洽の黙と、嗚呼、数たると数たらざると、道衍｜蓋し知ることあらん。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「及其病革、書牘数十通、猶在篋笥、門人泉長達神保簡受遺言、尽返之各主。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "七日に至つて「初春逢置閏、四野未浮陽」、又「誰家挑菜女、載雪満傾篋」の句がある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "記して此に至つた時、わたくしは的矢の北条氏所蔵の霞亭尺牘一｜篋を借ることを得た。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは偶篋中より抽き出した一通が、わたくしをして嚢里新居の壬午の歳に成つたことを思はしむる一事である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭軒は平素身辺に大小種々の篋を置いた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "起居不自由なる蘭軒が篋※の便を藉ることの多かつたのは、固より異むに足らない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "榛軒は方纔篋を探つて、金三十両を出してわたした。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八五九年版、ノーツ・エンド・キーリース撰抄、一〇一頁）予が在英中親交したロバート・ダグラス男が玉篋卦てふ占ひ書から譯した文をタイラーの原始人文篇、二版一卷一〇七頁に引いたが「大工が家を建て初めるに先づ近處の地と木との神に牲を供ふべし。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて書三篋を亡う。",
              "citation": {
                "source": "失うた帳面を記憶力で書き復した人",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "この三山も今では易簀してしまったが、手紙は多分三山の遺篋の中に残ってるかも知れない。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ余の出立の朝、君は篋底を探りて一束の草稿を持ち来りて、亡児の終焉記なればとて余に示された、かつ今度出版すべき文学史をば亡児の記念としたいとのこと、及び余にも何か書き添えてくれよということをも話された。",
              "citation": {
                "source": "我が子の死",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女院は花篋肘にかけ花摘みに行かれた留守であつた。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "童女は左の腋に美くしい篋を挟んでゐて、呉夫人が命じると篋から細巻の煙草を抽いて捧げ、それに火を点じるのである。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは京都嵯峨の奥なる、小楠公の首塚のある宝篋院である。",
              "citation": {
                "source": "楠公夫人",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は嵯峨宝篋院へも、楠公夫人が一子正行に忠孝の道を説いている教訓的な絵を描いて納めようと思っている。",
              "citation": {
                "source": "楠公夫人",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "湊川神社の楠公夫人の像にしろ、宝篋院の楠公夫人と正行の絵にしろ、建仁寺の天人にしても、末代まで残るものであるだけに、相当の日数をかけて微塵隙のないものに仕上げなくてはならぬが、それがいずれも大作ばかりなので、この忙しさでは、なかなか手をつけられそうにない。",
              "citation": {
                "source": "楠公夫人",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへば「玉篋両浦嶼」を読んでも、如何に先生が日本語の響を知つてゐたかが窺はれるであらう。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "……至于箱、篋、鞍、而食之（『歸潛志』卷十一、録大梁事の條）。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "足利時代の寶篋印塔の一｜部等で、主墳には古過ぎたり、新し過ぎたり。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "お穴樣の探檢",
                "note": "青空文庫"
              }
            },
            {
              "text": "或いは無縫塔、或いは五輪、或いは宝篋印、高さは一丈にも二丈にも及ぶものがあって、米友の怪力を以てしても、ちょっとは動かし難いものばかりであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
