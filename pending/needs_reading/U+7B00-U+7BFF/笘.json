        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは皆俗に杭州舟と言っている笘を屋根にした小舟であった。",
              "citation": {
                "source": "雷峯塔物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もし、もし、船頭さん、すみませんが、乗せてってくださいまし」　ふくらみのある女の声がするので許宣は笘の隙から陸の方を見た。",
              "citation": {
                "source": "雷峯塔物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、綺麗な女の顔がもう笘屋根の下にくっきりと見えた。",
              "citation": {
                "source": "雷峯塔物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "絹糸のような雨が絶えず笘屋根の外にあった。",
              "citation": {
                "source": "雷峯塔物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は本所深川辺の堀割を散歩する折｜夕汐の水が低い岸から往来まで溢れかかって、荷船や肥料船の笘が貧家の屋根よりもかえって高く見える間からふと彼方に巍然として聳ゆる寺院の屋根を望み見る時、しばしば黙阿弥劇中の背景を想い起すのである。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "行人欄に倚りて見るものあるも更に恥る色なく指頭に一物を拈って静に雫を払い手鼻をかんで笘の中に入る。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
