          "literary": [
            {
              "text": "そんな六箇敷い話じゃないの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤醫術は甚だ六箇敷ものにて大に上手下手のあるものなれども、其上手下手を素人の目にて見辨ける事は中々出來ぬものなり。",
              "citation": {
                "source": "養生の心得",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、全體醫業は甚だ六箇敷物にて、始終書物をよみて學問せねば出來ぬものなり。",
              "citation": {
                "source": "養生の心得",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「畢竟如何」などと六箇敷いことは云わぬがよい。",
              "citation": {
                "source": "楞伽窟老大師の一年忌に当りて",
                "author": "鈴木大拙",
                "note": "青空文庫"
              }
            },
            {
              "text": "後継者は単にお寺の留守居をすると云うことだけでも、一寸｜六箇敷いものであるが、中興の跡を受け、又その上に事業を進めて行かんと云うには、中々の努力が必要である。",
              "citation": {
                "source": "楞伽窟老大師の一年忌に当りて",
                "author": "鈴木大拙",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
