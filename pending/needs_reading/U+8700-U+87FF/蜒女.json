          "literary": [
            {
              "text": "これを聞きこんだのが花川戸の親分と呼ばれていた御用聞きの早耳三次で、「女白浪だから、蜒女あたりが動かねえところだろう。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "海へ帰る女",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜒女上りの莫連女が情夫とぐるで仕組んだ手品にちげえねえ。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "海へ帰る女",
                "note": "青空文庫"
              }
            },
            {
              "text": "根が蜒女だから平気なわけだ。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "海へ帰る女",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく、江の島で蜒女をしてたことがあるという女を深川の古石場で押えた。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "海へ帰る女",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
