        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "空が曇つたら、蝗螽の瞳が、砂土の中に覗くだらう。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その中を、飛交うのは、琅※のような螽であった。",
              "citation": {
                "source": "小春の狐",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ここにも飛交う螽の翠に。",
              "citation": {
                "source": "小春の狐",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "可い塩梅な酔心地で、四方山の話をしながら、螽一ツ飛んじゃ来ない。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "といった次第で、雪の神様が、黒雲の中を、大な袖を開いて、虚空を飛行なさる姿が、遠くのその日向の路に、螽斯ほどの小さな旅のものに、ありありと拝まれます。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "螽の飛ぶよ、と光を放ちて、小路の月に閃めきたる槍の穂先霜を浴びて、柄長く一文字に横えつつ、「来い！",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝸牛の角を出して、櫓を操るものありとせよ、青螽の流るゝ如き発動汽艇の泳ぐとせよ。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "六番の美男の東海さんは「螽※みたいな、あんな女のどこが好いのだ。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜻蛉がからんだ、螽※がセ、栗鼠が駈け出す、鳶がセ、お薯もころげ出せ、馬鈴薯、里芋、つくね芋。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "未決監を出てからもう彼是一と月、その間、日となく夜となく緊張し切つた俺の神経はまるで螽斯のやうに間断もなく顫へ続けた。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "螽がぱら／＼と足の響に連れて稻を渉つて遁た。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして驚き易い私の皮膚と靈はつねに螽斯の薄い四肢のやうに新しい發見の前に喜び顫へた。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "苅麥のにほひあかい日の照る苅麥にそつと眠れば人のこゑ、鳥の鳴くよに、欷歔るよに、銀の螽斯の彈くよに。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人こそ誰あらう、ベスレム製鋼会社の社長から螽斯のやうに一飛びして米国管船局総裁の位置に上つたチヤールズ・シユワツプ氏である。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　応募兵は自分が螽斯のやうに勁い脚を持つてゐるのを見せるために、二三度靴の踵で地面を蹴つてみせた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰々しい宗左の行列が来かゝると、松平家の用人は螽斯のやうに表へ飛んで出た。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、町長は螽斯のやうに飛び出して来た。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうすると、かの音吐朗々たる不釣合な聲も、或日或時或機會、螽を喰ひ野蜜を甞め、駱駝の毛衣を着て野に呼ぶ豫言者の口から學び得たのかと推諒する事も出來る。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "インバネスを着て、薄鼠色の中折を左の手に持つて、螽の如く蹲んで居る男と、大分埃を吸つた古洋服の鈕を皆｜脱して、蟇の如く胡坐をかいた男とは、少し間を隔てて、共に海に向つて居る。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "螽の如く蹲んだ男は、平たい顏を俯向けて、右手の食指で砂の上に字を書いて居る。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうとすると、かの音吐朗々たる不釣合な声も、或日或時或機会、螽を喰ひ野蜜を嘗め、駱駝の毛衣を着て野に呼ぶ予言者の口から学び得たのかと推諒する事も出来る。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "インバネスを着て、薄鼠色の中折を左の手に持ツて、螽の如く蹲んで居る男と、大分埃を吸ツた古洋服の釦は皆｜脱して、蟇の如く胡坐をかいた男とは、少し間を隔てて、共に海に向ツて居る。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "螽の如く蹲んだ男は、平たい顔を俯向けて、右手の食指で砂の上に字を書いて居る――「忠志」と書いて居る。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "高等四年にも成つて、未だ※螽捕りに夢中に成つてるなんて、其様なものが何処にある――与太坊主め。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「房ちゃん、螽捕りに行きましょう」　と言って、下婢は出て行った。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
