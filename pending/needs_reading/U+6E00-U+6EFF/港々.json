        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "商人よふたたび椰子の葉の茂る港にかへり君のあたらしい綿と瑪瑙を積みかへせ亞細亞のふしぎなる港々にさまよひ來り青空高くひるがへる商業の旗の上にああかのさびしげなる幽靈船のうかぶをみる。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青森、三馬屋、そのほか外ヶ浜通り港々、最も甚敷丹後の人を忌嫌ふ。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "此説、隣境にも及びて松前南部等にても港々にては多くは丹後人を忌みて送り出す事なり。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてその音の音色はその港々で少しずつちがって聞こえるであろう。",
              "citation": {
                "source": "試験管",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、港々には、春婦宿を経営していたし、大規模な、世界を股にかけた、人肉買売までもやっておった。",
              "citation": {
                "source": "地虫",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて新七が太郎兵衛に言うには、難船をしたことは港々で知っている。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて新七が太郎兵衞に言ふには、難船をしたことは港々で知つてゐる。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから毛唐の嫌う金曜日金曜日に汽笛を鳴らして、到る処の港々を震駭させながら出帆する、倫敦から一気に新嘉坡まで、大手を振って帰って来る位の離れ業は平気の平左なんだから、到底｜吾々のアタマでは計り知る事の出来ないアタマだよ。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この戦争に、シナで人命を失うもの百万人、シナの港々は言うに及ばず、南京の都まで英国に乗っ取られ、和睦を求めるためにシナより英国へ渡した償金は小判にして五百万枚にも及んだ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "海から見た陸の連続、荷積の為に寄って行く港々――すべて一年前の船旅の光景を逆に巻返すかのようで、達雄に別れた時の悲しい心地が浮んで来た。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "船は魚を積む爲に港々へ寄つたが、處によると長く手間が取れた。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月の節句前のことで、船は港々へ寄つて、榮螺を詰めた俵を積んだ。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊豆の港々へ寄って行く船だ。",
              "citation": {
                "source": "船",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、汽船が荷積の為に港々へ寄って行くのを待つばかりで。",
              "citation": {
                "source": "船",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "北国の三国港、金石港、それからぐるりと能登半島を廻つて、七尾、魚津、越後に入つて出雲崎、それから羽後の酒田港かういふ港々が絶えず船で大阪と結び附けられてあつた。",
              "citation": {
                "source": "西鶴小論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "島の港々から漕ぎ寄せて来る船、そこにどつさり節を唄ふ芸者が乗つてゐたり、宿屋の名の黒々と記されてある番傘を持つた酌婦らしい女が蓮葉に客に物を言つてゐるのも何となくなつかしい。",
              "citation": {
                "source": "隠岐がよひの船",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒涼とした港々のあらい人気をこの鑿一丁でこじあけて来たという猛々しい言葉であった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロンボ、新嘉坡、その他東洋の港々の方へも行った。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠く喜望峰を経由して、印度洋から東洋の港々を帰って行く長い航海の旅を択ぼうか。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "この子供等を側に置いて岸本は自分の遍歴して来た港々の奇異な土人の風俗や、熱帯の植物や、鰐、駝鳥、山羊、鹿、斑馬、象、獅子、その他どれ程の種類のあるかも知れないような毒蛇や毒虫の実際に棲息する地方のことを話し聞かせた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロッパの港々を荒した海賊船を読者は想像してほしい。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "港々へ部下をやり、漂流して来た異邦人をさえ、自分の住居へつれて来て、特色に応じて芸を仕込み、お伽衆として売ったということでもある。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "権力を失うまいとするものが、どんなに卑しく膝をかがめて港々に出ばろうとも、着実真摯な男女市民の人生は、個人と民族の基本的人権のありどころを見失わないで、粘りづよく現実に、自主的で民主的な運命の展開のためにたたかわれてゆかなければならないと思う。",
              "citation": {
                "source": "偽りのない文化を",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は叔父にせびっては、ヨーロッパの港々の話をきかしてもらった。",
              "citation": {
                "source": "大人の眼と子供の眼",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、港々の売春婦なみに彼ら社会の常識だけは心得ていて、自分ではちゃあんと仏蘭西生れと名乗っていた。",
              "citation": {
                "source": "踊る地平線",
                "author": "しっぷ・あほうい！",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ぎ次ぎと現われて来る港々の景色にもこれと云う変りは認めなかった。",
              "citation": {
                "source": "続スウィス日記（千九百二十三年稿）",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "デハ、ワタシ、アナタノタメニ唄ヲウタッテ上ゲル、コノ手風琴デ、世界ノ国々ノ、港々ノ唄ヲウタッテアナタヲ慰メテ上ゲルデス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
