        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "土は畢の日の夕方に周圍に土手のやうな輪を拵へて其處に水を打つてはぐちや／＼と足で溲ねながら刻んだ藁を撒いては踏み込んでさうして一｜晩置いた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の日土は能く水を引いて居て程よく溲ねられた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "韓退之がいわゆる、牛溲馬勃、ともに収め並びに蓄うで、良医が用うれば馬糞も大功を奏し、不心得な奴が持てば金銭も馬糞同然だ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "菓子種はふつくりと溲起してゐる。",
              "citation": {
                "source": "聖ニコラウスの夜",
                "author": "SANKT NIKOLAUS BEI DEN SCHIFFERN",
                "note": "青空文庫"
              }
            },
            {
              "text": "溲瓶の用に使つた奴があるから」　彼は机の抽斗から香水の瓶をとりだして、異常に綿密な注意を払ひながら一小滴づつ床へ落した。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一罎というのはちょうど日本の溲瓶の形になって居る土焼の茶瓶一つを言うのです。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "溲瓶から油のどろどろした汁が出るように見えて、ちょいと手に取って飲んでみる気にはならない。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "それははなはだよくない徴候で、スールト元帥にその事が報告された時、昔ナポレオンの参謀だった彼もさすがに考え込んで、サラゴサの攻囲のおりシューシェが言った言葉を思い起こした、「婆さんどもまでが溲瓶のものをわれわれの頭上にぶちまけるようになっては、とてもだめだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに夜中尿意に悩まなければいいのであるから、先生は午後になるとお茶をのまず、その上部屋の四隅へ溲瓶を置いたが、無意識中における先生の意志はどうしても本に向って放尿せずには納まらない。",
              "citation": {
                "source": "勉強記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく牛溲、馬勃、敗鼓の皮といわれ、こんなものでも薬になるかと評せられたものだ。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小便がしたいのであろうと察し、溲瓶を当ててみるが排尿しない。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "溲瓶を当ててみるがやはり出ない。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿も今朝来溲瓶を用い辛うじて排尿するようになる。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お母さん、兄さんおしっこ」妹が云うと、向うの壁に凭りかかっていた母親が立って来て、「御免下さりませ」と、小腰を屈め、寝台の下に新聞紙に包んであった溲瓶を取って、病人の毛布の間に挿し入れた。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月は奴婢どもゝ少しは許て遊をなさしむるゆゑ、羽子を擢んとて、まづ其処を見たてゝ雪をふみかためて角力場のごとくになし、羽子は溲疏を一寸ほど筒切になし、これに甚高し。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「シビンを用い給え、シビンを」「溲瓶ですか？",
              "citation": {
                "source": "社長秘書",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "テキヤがすっかりイタについた丸万しか知らなかった俺は、りゅうとしたその背広姿のランバリ（立派なみなり）に眼を見はっていると、溲瓶を洗いに行っていた波子が、その不恰好な醜態なガラス瓶をぶらさげてはいってきた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "おすぎは若者が溲瓶をさげて部屋を出て行く姿をなんとなく目にとめた。",
              "citation": {
                "source": "夕張の宿",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "おすぎはまたトシを背負って、町へ出かけて、差当って必要なもの、洗面器、溲瓶、箒、塵とりなどを買ってきた。",
              "citation": {
                "source": "夕張の宿",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
