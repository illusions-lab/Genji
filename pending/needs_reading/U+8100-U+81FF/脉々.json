          "literary": [
            {
              "text": "されば之に代って昭和時代の東京市中に哀愁脉々たる夜曲を奏するもの、唯南京蕎麦売の簫があるばかりとなった。",
              "citation": {
                "source": "巷の声",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし花卉を愛する人のたま／＼わが廃宅に訪来ることあらんか、蝶影片々たる閑庭異様なる花香の脉々として漂へるを知るべし。",
              "citation": {
                "source": "来青花",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "手足の脉々は、飛び上るようにずきりずきり打ち初めた。",
              "citation": {
                "source": "悪魔",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
