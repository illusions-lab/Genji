          "literary": [
            {
              "text": "ひるの部、腐演、つく／″＼いやだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ帰って又もや勘平腐演し、終演後、迎の自動車で放送局へ、十二時半迄「坊ちゃん」のテストする、時間が余るので音楽を入れることにした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月二十六日（月曜）　座へ出る、ひるの「忠臣」腐演。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の部、腐演して入浴。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大久保」腐演、「海軍のロッパ」は、よく笑ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大久保」腐演、「海軍」普通。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「金色」のロクローで毎日くさり、「ロッパ従軍記」は、これ又毎日腐演である。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
