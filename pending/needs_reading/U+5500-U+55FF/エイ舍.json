        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕は竊に冷笑しながら營舍の側をぶら／＼歸つて來ると「おいこら軍醫生一寸待たんか」　といふ。",
              "citation": {
                "source": "開業醫",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手に中山競馬場の建物を松林の間に望み、右手に電信處の營舍を見る。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞夜なか過ぎになつて、營舍へ歸らうとする途で、彼は帽子も冠らずに、街路を歩いてゐる年増の女達に逢つた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "營舍の内の彼の周圍でも大騷ぎが起つてゐた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は着くと直ぐ營舍に彼を訪ねて行つた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして水兵等は大切な航海へ出發する前日は、營舍内から出ることを固く禁ぜられてゐる、（これは一寸考へると、寧ろ殘酷な習慣のやうに思はれるが、出征せんとする間際に、水兵等が陷り易い脱船に對する必然の豫防である。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてルクウブランスへの橋へ、そして自分の營舍へ歸つて行つた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
