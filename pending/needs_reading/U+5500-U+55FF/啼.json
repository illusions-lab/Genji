        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "身にしむやうな媚めかしい聲に大屋根の方へと啼いて行く。",
              "citation": {
                "source": "われから",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "畠うつや鳥さへ啼ぬ山蔭に　山村の白昼。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦秋や何におどろく屋根の鶏　農家の屋根の上に飛びあがって、けたたましく啼いてる鶏は、何に驚いたのであろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏が啼いて通る――庭の地面も鹿のやうに睡い。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "板は冷たい光沢をもち、小鳥は庭に啼いてゐる。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "空をわたつて行く烏の啼声までが、急にテムポを速めるやうに思はれました。",
              "citation": {
                "source": "家族",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "峠が上り下りして、森らしくなる、杜鵑がしきりに啼く、湯治の客が、運んだ飜ぼれ種子からであろうが、栂の大木の下に、菜の花が、いじけながらも、黄色に二株ばかり咲いていた、時は七月末、二千｜米突の峠、針葉樹林の蔭で！",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷の中が、黄な臭いやうに、ボーッと明るくなつたとおもふと、高い空を浮ぶ雲が、夕日を受けて、鈍い朱に染まつた、蜩が、時間を一秒一秒刻み込んで、谷の中へ追ひ込んでゆくやうに、キ、キ、キと啼き落す、杉林の一本々々の樹が、どちらから寄るともなく、塊まつて、黒い法師のやうになつて、囁き合つてゐる。",
              "citation": {
                "source": "天竜川",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかで、タケガラスが啼いている。",
              "citation": {
                "source": "奥常念岳の絶巓に立つ記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほえざるは、もう啼きやんでいて、島は割合に平静であった。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "からすあ、があて啼けば、橡の実あ、一つぼたんて落づるずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、からすあ、があて啼けば、橡の実あ、一つぼたんて落づるずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　金木川にわかれて、こんどは鹿の子川に沿うてしばらくのぼり、やつと森林鉄道の軌道から解放されて、ちよつと右へはひつたところに、周囲半里以上もあるかと思はれる大きい溜池が、それこそ一鳥啼いて更に静かな面持ちで、蒼々満々と水を湛へてゐる。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "壱唱　ふくろうの啼く夜かたわの子うまれけり　さいさきよいぞ。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、小鳥が啼いて、うるさい。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がここへ駈け込む途中の森でも、小鳥がピイチク啼いて居りました。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "無人島でない事はその山よりも高い空で雲雀が啼いているのが微かに聞こえるのでわかる。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "小心な鴉が重そうに羽ばたきをして、烈しく風を切りながら、頭上を高く飛び過ぎたが、フト首を回らして、横目で自分をにらめて、きゅうに飛び上がッて、声をちぎるように啼きわたりながら、林の向うへかくれてしまッた。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういえば、春過ぎて若葉の茂るのも、初鰹の味の乗って来るのも山時鳥の啼き渡るのもみんなそれぞれ色々な生化学の問題とどこかでつながっているようである。",
              "citation": {
                "source": "五月の唯物観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから吉浜まで海岸の雨の山道を、験潮器を背負って、苫をかぶってあるいていると、ホトトギスが啼いた。",
              "citation": {
                "source": "夏",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日カッコウやホトトギスがよく啼く。",
              "citation": {
                "source": "高原",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの鳥の啼くのでも大概平均三声くらい啼いてから少時休むという場合が多いようである。",
              "citation": {
                "source": "高原",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月下旬に沓掛へ行ったときは時鳥が盛んに啼いたが、八月中旬に再び行ったときはもう時鳥を聴くことが出来なかった。",
              "citation": {
                "source": "ＫからＱまで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、小徑の草の葉蔭には名も知らぬ秋の蟲がかぼそい聲で啼いてゐた。",
              "citation": {
                "source": "處女作の思ひ出",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "處處で蟋蟀が啼いてゐる。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
