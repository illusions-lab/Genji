        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "朱荷曲池のあと、緑萍蒼苔深く封して、寒蛩喞々たり、螢流二三點。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "看よ、喞々として秋を悲しむが如きもの、彼に於て何の悲しみかあらむ。",
              "citation": {
                "source": "一夕観",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "かう云ふ有様ですから、追々と涼しくなつて来るといつしよに、所謂虫声｜喞々。",
              "citation": {
                "source": "入庵雑記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫声喞々既に秋の如し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "松竹梅といふと古い言草であるが、松といひ竹といひ又梅といふは樹の中の三兄妹であつて、三樹交契のいみじさ美しさは喞々としてわたくしの心に何かを囁いてくるのだ。",
              "citation": {
                "source": "冬の庭",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "春雨秋風人の訪うなく、謖々たる松声は、日本男児の記念たる桜花の雪に和して吟じ、喞々たる虫語は武蔵野の原より出でて原に入る明月の清光を帯んで咽ぶ。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
