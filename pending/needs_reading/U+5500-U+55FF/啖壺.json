          "literary": [
            {
              "text": "啖壺が備えてあっても衛生や公徳の何物たるを知らない連中は平気で床の上へ啖を吐いたり、唾を吐いたりして何の心だかわざわざそれを靴の底で摺り拡げています。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "医局から帰つて来ると、私は早速彼の枕許を掃除してやり、啖壺を洗浄してやつて看護手の出て来るのを待つた。",
              "citation": {
                "source": "続癩院記録",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻が喉から口に出て来さうだから、窓の下の啖壺に吐きに行つた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕許には、啖壺が置かれてあった。",
              "citation": {
                "source": "貸間を探がしたとき",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
