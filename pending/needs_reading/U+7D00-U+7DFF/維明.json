          "literary": [
            {
              "text": "京都の相国寺に維明といふ僧がゐて、墨梅を画くことを善くした。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶山と波響とは始て維明が庵室に於て相見た。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは草卒に推算したから誤があるかも知れぬが、当時六十三歳の主人維明の許で、四十六歳の茶山と二十四歳の波響とが相識になつたのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この月の分は「悲願維明」と「元日のシャツ」の二つの小品で後者の方は未完。",
              "citation": {
                "source": "悲願に就て",
                "author": "――「文芸」の作品批評に関聯して――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
