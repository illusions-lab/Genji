        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "縄なひリレーは十四区から五人づゝの選手が出て、一メートルづゝ縄を綯つて、一定の長さに達した時、石を載せた箱を引つ張つて張力を試験して見た。",
              "citation": {
                "source": "運動会の風景",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは殆んど同時に綯ひ上つた組が多く、石が軽かつたために、切れた縄もなかつた。",
              "citation": {
                "source": "運動会の風景",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ、優勝区には、増産奨励の酒が一升づつ出ることになつて村長の机の上に六本並んでゐるのだから、他の賞品になら寛容の美徳を現はす連中も、この縄綯ひリレーだけは、勝敗が明確でないといふことにした。",
              "citation": {
                "source": "運動会の風景",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "本を読むなどという馬鹿なことをするならよいからその時間に縄を綯れ」といわれた。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」為吉はそう云って縄を綯いつゞけた。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お山の草叢から、黄腹、赤背の山鱗どもを、綯交ぜに、三筋の処を走らせ、あの踊りの足許へ、茄子畑から、にょっにょっと、蹴出す白脛へ搦ましょう。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "音を綯交ぜに波打つ雷鳴る。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "辻町は、欠伸と嚔を綯えたような掛声で、「ああ、提灯。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "申合わせて三人とも、青と白と綯交ぜの糸の、あたかも片襷のごときものを、紋附の胸へ顕著に帯した。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたが、山の神の眷属としてわたくしを、ただ眷属中での褒められ者として育つのを望んだ娘は、この福慈岳に籠れる選まれた偉大ないのちの中に綯い込められ、いまや天地大とも久遠劫来のものとなってしまいました。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとが一生けん命｜綯ったものをだまって持って行く。",
              "citation": {
                "source": "車",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの繩綯ふに一時間かかったんだ。",
              "citation": {
                "source": "車",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そして、ここにも亦新しい問題は綯ひ合はさつてゐるわけであつた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "かき集めた葉は、左綯ひに綯つた繩の綯ひ目に、一葉づつ、葉柄の先を一寸位※し込む。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "暇だと云つても、繩を綯つたり、筵を編んだり、夜なべ仕事のないわけはなかつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "太い強い針金をいく本も縄のように綯って、河の両岸へ渡してある。",
              "citation": {
                "source": "惨事のあと",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "腕に綯りをかけるといっても、銀子は倉持を搾る気はなく、お神が決めたもの以上に強請るのでもなく、未婚の男でこれと思うようなものも、めったにないので、千葉で挫折った結婚生活への憧憬が、倉持の純情を対象として、一本気な彼女の心に現実化されようとしているのだった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "花見ごろには、お庄も学校の隙にここの店番をしながら、袋を結える観世綯りなど綯らされた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十九　叔母の健康が、また綯りが戻ったように悪い方へ引き戻されて来た。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "子守りの家では、亭主に死なれた母親が、棕櫚縄などを綯って、多勢の子供を育てていた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "邪心を以て見るが故に、藁を綯うて造りたる縄も蛇体と見えるのぢや。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "客は宰相｜令狐綯の家の公子で令狐目の温が、二人の白面郎に侮られるのを見て、嘲謔の目標にしていた妓等は、この時温の傍に一人寄り二人寄って、とうとう温を囲んで傾聴した。",
              "citation": {
                "source": "魚玄機",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反して場外の名は京師に騒いで、大中四年に宰相になった令狐綯も、温を引見して度々筵席に列せしめた。",
              "citation": {
                "source": "魚玄機",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日席上で綯が一の故事を問うた。",
              "citation": {
                "source": "魚玄機",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "また宣宗が菩薩蛮の詞を愛するので、綯が填詞して上った。",
              "citation": {
                "source": "魚玄機",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
