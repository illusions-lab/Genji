        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「おも舵っ」「右にかわすだってえば」「右だ‥‥右だぞっ」「帆綱をしめろやっ」「友船は見えねえかよう、いたらくっつけやーい」　どう吹こうとためらっていたような疾風がやがてしっかり方向を定めると、これまでただあてもなく立ち騒いでいたらしく見える三角波は、だんだんと丘陵のような紆濤に変わって行った。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に耳に余る大きな音を立てて、紆濤は屏風倒しに倒れかえる。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほっと安堵の息をつく隙も与えず、後ろを見ればまた紆濤だ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の紆濤、第二の紆濤、第三の紆濤には天運が船を顛覆からかばってくれた。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし特別に大きな第四の紆濤を見た時、船中の人々は観念しなければならなかった。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝦夷富士といわれるマッカリヌプリの麓に続く胆振の大草原を、日本海から内浦湾に吹きぬける西風が、打ち寄せる紆濤のように跡から跡から吹き払っていった。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
