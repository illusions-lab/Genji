          "literary": [
            {
              "text": "船舷に頬杖を突いて一眠りした蒔蔵は痺れたような疲れもすっかり癒った。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒔蔵はその時たいして惜しいとも思わなかった。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒔蔵の故郷豊橋へはもう近い。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒔蔵は「ここは淡路じゃ無いぞ。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「簪を返して貰おう」　畳の目のような小皺を寄らせてねとりねとり透明な肌に媚びを見せて居る海の水を見詰めながら蒔蔵は帯を締め直した。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "簪を得る代りに蒔蔵は海へ命を落した。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
