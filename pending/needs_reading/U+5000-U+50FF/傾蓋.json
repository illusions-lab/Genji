          "literary": [
            {
              "text": "わたくしは傾蓋故きが如き念をした。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し方今のありさまにて、傾蓋の交はかかる所にて求むべしといわばわれ又何をかいわん。",
              "citation": {
                "source": "みちの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "井上｜蘭台の門に井上｜金峨を出し、金峨の門に此篁と偕に金峨の門に出で、蘭軒と親善に、又蘭軒の師友たる茶山と傾蓋｜故きが如くであつた人もある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "堅唾を呑んで見て居ると、二馬相逢いて傾蓋旧のごとしという塩梅に至って仲よく、互いに全身を舐り合った。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "拙者一見手を握てほとんど傾蓋の想をなしました。",
              "citation": {
                "source": "禾花媒助法之説",
                "author": "津田仙",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
