        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さて伏蔵、募人に語るは、汝は剛の者でわれを怖れぬ。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "王かの夜喚ぶ者は何物ぞと問うに、募人｜詐ってあれは化物でござったと申す。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "国王人を遣わし理髪師を捉えて委細を聞き、更に人を遣わして募人の家を検するに金銭夥しく持ち居る。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "王その銭を奪うと銭が毒蛇また火の玉と成ったので、これはわれが取るべきでないと言って募人に返したと。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に補欠試験には応募人員は中々多かつた中から、僅に少数の者が採用せられたのであるから、最も優秀のものでなければ合格は出来なかつた筈である。",
              "citation": {
                "source": "落第と退校",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
