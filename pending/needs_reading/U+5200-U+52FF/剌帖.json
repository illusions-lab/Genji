          "literary": [
            {
              "text": "小姓｜巴剌帖木、朱の袱紗の上に金の兜を捧持して、急いで後に従う。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "小姓｜巴剌帖木の捧げる兜を、無意識にかぶりながら、成吉思汗　巴剌帖木。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴剌帖木　（前に片膝ついて）はっ。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴剌帖木　（不思議そうに）は？",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴剌帖木はびっくりして後ろに退る。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "小姓｜巴剌帖木が酌しようとする。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "小姓｜巴剌帖木が続こうとすると、汪克児　巴剌帖木！",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、不審顔の巴剌帖木の手を引き、道行きのおかし味よろしく、下手へ引っ込む。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟｜合撒児を先頭に、忽必来、速不台、小姓｜巴剌帖木、その他参謀等多勢、厳しき武装にて馳せ入り、成吉思汗の前に整列する。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
