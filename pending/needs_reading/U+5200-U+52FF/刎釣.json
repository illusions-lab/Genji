        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それと申すが、まず庭口と思う処で、キリキリトーンと、余程その大轆轤の、刎釣瓶を汲上げますような音がいたす。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "刎釣瓶の竹も動かず、蚊遣の煙の靡くもなき、夏の盛の午後四時ごろ。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍なる苫屋の背戸に、緑を染めた青菜の畠、結い繞らした蘆垣も、船も、岩も、ただなだらかな面平に、空に躍った刎釣瓶も、靄を放れぬ黒い線。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "原を出ると大根畑があって、その向うに生垣があって、そこでギーッと刎釣瓶の音がします。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "刎釣瓶の竿に残月のかかった趣なぞは知ろうはずもない。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
