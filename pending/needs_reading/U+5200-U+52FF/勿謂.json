          "literary": [
            {
              "text": "輪船一夜辞舎港、轟轟遥向太平洋、天外雲鎖渾渺漠、檣頭風掛自清涼、更無山影入吟望、時有月光窺客牀、喜此波上甚静穏、笑我閑中却多忙、或説礦業或美術、談罷呼茶又挙觴、勿謂五千里程遠、従今旬余到家郷。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "九七　雅事多是虚、勿謂之雅而耽之。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "俗事却是實、勿謂之俗而忽之。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            }
          ]
        }
