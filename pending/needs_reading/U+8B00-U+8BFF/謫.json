        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "永保元年の冬、在京中、讒者の為に西海に謫せらる。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "卿は熱帯の鬱林に放たれずして、山地の碧潭に謫されたのである。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "筑波山の夕紫はあかあかとした落日に謫落の紅を増して来た。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "母族｜林彦清等、妻族｜鄭原吉等九族既に戮せられて、門生等まで、方氏の族として罪なわれ、坐死する者およそ八百七十三人、遠謫配流さるゝもの数う可からず。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "公の貶謫と死とは余ほど当時の人心に響を与へてゐたに疑無い。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすれば謂は早くより因果の説を信じていたればこそ、後年｜貶謫されるに至って愈々深く之を信じたので、或は早く寂照に点化されたのかも知れない。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "真宗崩じて後、其｜后の悪みを受け、擅に永定陵を改めたるによって罪を被り、且つ宦官雷允恭と交通したるを論ぜられ、崖州に遠謫せられ、数年にして道州に徙され、致仕して光州に居りて卒した。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "海は少し遠いのであるが、須磨の関も越えるほどの秋の波が立つと行平が歌った波の音が、夜はことに高く響いてきて、堪えがたく寂しいものは謫居の秋であった。",
              "citation": {
                "source": "源氏物語",
                "author": "須磨",
                "note": "青空文庫"
              }
            },
            {
              "text": "源氏が日を暮らし侘びているころ、須磨の謫居へ左大臣家の三位中将が訪ねて来た。",
              "citation": {
                "source": "源氏物語",
                "author": "須磨",
                "note": "青空文庫"
              }
            },
            {
              "text": "逍遙子の諸評語小説三派（小羊漫言七一面より）及梓神子（春廼舍漫筆一五一面より）　さきにわれ忍月、不知庵、謫天の三人を目して新文界の批評家とせしことあり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "獨り謫天｜情仙のみ舊に依りて、言ふこと稀なれども、中ること多からむことを求むるに似たり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "永禄四年女婿秀次の事に坐して北国に謫せられ、慶長元年赦されて還り、元和三年七十九歳で薨じた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "文政七年林氏の門人籍に列し、昌平黌に講説し、十年｜榊原遠江守政令に聘せられ、天保三年故あつて林氏の籍を除かれ、弘化四年榊原氏の臣となり、嘉永三年伊豆七島全圖を著して幕府の譴責を受け、榊原氏の藩邸に幽せられ、四年｜謫せられて越後國高田に往き、戊辰の年には尚高田｜幸橋町に居つた。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "先哲叢談續編に「先生後獲罪、謫在越之高田、（中略）無幾王室中興、先生嘗得列官于朝」と書してある。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は此の流謫を決して不幸とは考えない……。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "マターファは称号｜剥奪の上、遥かヤルート島へ流謫され、彼の部下の酋長十三人もそれぞれ他の島々に追放された。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何等罪状の指摘できないマターファ（彼は、いわば喧嘩を売られたに過ぎぬのだから）が千｜浬離れた孤島に流謫され、一方、島内白人の殲滅を標榜して立った小タマセセは小銃五十｜梃の没収で済んだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "火箭　乾隆六年、嘉興の知府を勤める楊景震が罪をえて軍台に謫戍の身となった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "子不語",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち、永保元年に謫せられた正氏が、三歳のあんじゆ、当歳のつし王を残して置いたとして、全篇の出来事を、あんじゆが十四、十五になり、つし王が十二、十三になる寛治六七年の間に経過させた。",
              "citation": {
                "source": "歴史其儘と歴史離れ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に正氏が謫所へ、赦免状を持たせて、安否を問いに使いをやった。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛇もまた人祖堕落の時まで駱駝ごとき四脚を具え、人を除けてはエデン境内最も美しい物じゃったが、禁果を偸み食った神罰たちまち至って、楽土諸樹木の四の枝が低れ下り、四つの罪人永く追いやられ、アダムはヒンドスタンに、エヴァはジッダに、蛇はイスパハンに、エブリスはシムナーンに謫居した。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三年｜前伊太利のカプリ島に謫居してゐた頃、日本人の学生がその近所に旅をしてゐる事を聞いて、日本人といふものはまだ見た事が無い、一度会つてみたいものだと、恰で動物園に新着の鸚鵡でも見るやうな物好きな気持で、その日本人に会つた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "み空の花なる星、この世の星なる花、黙々として千古語らざれども、夜々｜綢繆の思ひ絶えざる彷彿一味の調は、やがて絶海の孤島に謫死したる大英雄を歌ふの壮調となり五丈原頭凄惨の秋を奏でゝは人をして啾々の鬼哭に泣かしめ、時に鏗爾たる暮天の鐘に和して、劫風ともにたえざる深沈の声を作し。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "張はその前にひれ伏して、「どうか私の生命が延びるように、おとりはからいを願います」「いかん、俺は一度、漢朝の権臣の生命を延ばそうとおもって、奏請したために、ここへ謫居の身となっておる、帰れ」　張はここぞと思って一生懸命になって頼んでいると、一人の使がやってきて書簡を道士に渡した。",
              "citation": {
                "source": "賭博の負債",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "開元の末になって、柳毅の義弟の薜瑕が京畿の令となっていたが、東南に謫官せられて洞庭湖を舟でとおっていると、不意に水の中に碧あおとした山が見えてきた。",
              "citation": {
                "source": "柳毅伝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は間もなく失脚して循州に謫せられたが、障州の木綿庵に着いて便所へ往こうとする所を、鄭虎臣という者のために拉殺せられた。",
              "citation": {
                "source": "緑衣人伝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉之助の、建白書の内、知政の始、国政を誤りたる専横の徒を貶黜すべきこととあるのと、お由羅処分のこと、それから、近藤崩れにて、流謫脱奔したる者を、召還すことと、この三ヶ条は、今申したように、総て、父を恥かしめることになる。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬来は流謫地という意味だそうだ。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラトンの弟子のアリストテレスはあるデメーテル僧から神を冒涜したといって告訴され、大官アレオパガスから死刑を宣告されたが、際どくもユーボェア（〔Eubo:a〕）のカルキス（Chalkis）に逃れることを得て、そこに流謫の余生を送り六三歳で死んだ（紀元前三二二年）。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
