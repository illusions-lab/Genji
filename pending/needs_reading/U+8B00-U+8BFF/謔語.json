        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この謔語は、森彦でなければ言えないからであった。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と私は謔語のつもりで、「今に菜の花が咲いてるから。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "謔語のつもりで言つたことは眞實に成つて來た。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　謔語の積りで言つて見て、私は眩暈を紛さうとしたが、何となく底の知れない方へ引入れられるやうな氣がした。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「夜逃げにでも逃げようかしらん」どうかすると私は家のものに向って、謔語半分にこんなことを言うこともあった。",
              "citation": {
                "source": "芽生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
