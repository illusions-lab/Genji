          "literary": [
            {
              "text": "医学生は肌脱で、うつむけに寝て、踏返した夜具の上へ、両足を投懸けて眠って居る。",
              "citation": {
                "source": "星あかり",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――危く駒下駄を踏返して、駕籠でなくっちゃ見なかった隅田川へ落ちようとしたっさ。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "穿物の緒が弛んで居たので踏返してばつたり横に轉ぶと姿が亂れる。",
              "citation": {
                "source": "迷子",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "醫學生は肌脱で、うつむけに寢て、踏返した夜具の上へ、兩足を投懸けて眠つて居る。",
              "citation": {
                "source": "星あかり",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊兵衛の示す指を追って行くと、崖のひとところが崩れて、熊笹の密生している場所から、径を越して、楢の疎林の中まで、その血痕は点々と尾を曳いていた……先に行った二人が気付かなかったのは吹きつける雪に埋れていたからで、彼らが雪を踏返したため、はじめて伊兵衛の眼についたのである。",
              "citation": {
                "source": "夜明けの辻",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
