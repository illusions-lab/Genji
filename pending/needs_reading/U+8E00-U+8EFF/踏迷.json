        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "かくてわれ踏迷ひたる紅の雪のなかをばのがれつ。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "途次、彼の世に聞えた鬼門關を過ぎようとして、不案内の道に踏迷つて、漸と辿着いたのが此の古廟で、べろんと額の禿げた大王が、正面に口を赫と開けてござる、うら枯れ野に唯一つ、閻魔堂の心細さ。",
              "citation": {
                "source": "みつ柏",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでよく仔細が解って確になりはなったけれども、現に一人｜踏迷った者がある。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてわれ踏迷いたる紅の雪のなかをばのがれつ。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "キットあのトラホームのために、眩しい雪道を踏迷うか、谷川へ落ちるかして、どこかで凍え死んでいるに違いないであろうと思うと、立っても居ても居られなくなった。",
              "citation": {
                "source": "眼を開く",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間てものは誰でも誤って邪路に踏迷う事があるが、心から悔悛めれば罪は奇麗に拭い去られると懇々説諭して、俺はお前に顔へ泥を塗られたからって一端の過失のために前途にドンナ光明が待ってるかも解らないお前の一生を葬ってしまいたくない。",
              "citation": {
                "source": "三十年前の島田沼南",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "此道を行かば又何処とも無く踏迷ひなんとて、尚峯に登る云々」とあった。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
