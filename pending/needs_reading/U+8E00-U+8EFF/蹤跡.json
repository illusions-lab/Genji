        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかし蹤跡は絶て知れなかった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにこの鳥獏を蹤跡する途中ちょっと立ち留って樹をつつくと虫が出る、それを食うと素敵に旨い。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間と空間のあらん限りを馳けめぐって、脳髄の正体を突止めて行ったポカンの苦心惨憺の蹤跡をモウ一度くり返して辿ってみるがいい。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "義直はその夜から蹤跡が判らなくなつてしまつた。",
              "citation": {
                "source": "黒い蝶",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "捕吏の、盜人を蹤跡する詞に、「足がつく」足をつける」といふことあり、語釋の穿鑿も相似たりと、ひとり笑へる事ありき。",
              "citation": {
                "source": "ことばのうみのおくがき",
                "author": "大槻文彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんの蹤跡かこれ遺すことあらんや。",
              "citation": {
                "source": "通俗講義　霊魂不滅論",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十一歳にしてスウェデンに歸り、大學に入つたが、遂に兄の蹤跡を蹈まず、父と共に家業に從事した。",
              "citation": {
                "source": "ノーベル小傳とノーベル賞",
                "author": "長岡半太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "虚空の如き心の上でさまざまの風情を彩るといえども、そこには更に蹤跡というものがない。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
