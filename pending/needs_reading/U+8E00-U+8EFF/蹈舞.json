        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三絃の音耳を離れず、蹈舞の響森を穿ちて来る。",
              "citation": {
                "source": "秋窓雑記",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "當年士女が此に來りて蹈舞せし歌垣の名殘は、今も絶えずして、筑波祠前に六箇の妓樓あり。",
              "citation": {
                "source": "春の筑波山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "男女だかれあって蹈舞するなんどは。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夫と蹈舞することを許さないというのはなぜだろう。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "蹈舞のことなどをこなしたところが。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわば蹈舞の上手より毛糸あみの手内職をして。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
