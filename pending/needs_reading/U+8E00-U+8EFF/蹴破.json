        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "濕地には水芭蕉の青々とした廣葉が枯葦の間から、谷間には蕗の薹や福壽草が腐つた蕗の葉を蹴破つて、ずん／＼と延びて行く。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "掘鑿の中は、雪の皮膚を蹴破って大地がその黒い、岩の大腸を露出していた。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨブは信仰に由て友を蹴破して終るべきではなかった。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どてツ腹あ蹴破つて、このわたを引ずり出して、噛潰して吐出すんだい！",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "停車場前のいか屋という旅館へひとまず泊ることとし、何はともあれ、まず第一に、山河二百里を蹴破り来りしこの鉄脚を、日本海の荒浪に洗わんものと、海岸を指して出かけた。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "どてッ腹あ蹴破って、このわたを引ずり出して、噛潰して吐出すんだい！",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二頭の乳牛を両腕の下に引据え、奔流を蹴破って目的地に進んだ。",
              "citation": {
                "source": "水害雑録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "二頭の乳牛を兩腕の下に引据ゑ、奔流を蹴破つて目的地に進んだ。",
              "citation": {
                "source": "水害雜録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "がその男は勇敢な、そして力の強い男だったので、プレンダーガストが血だらけのナイフを手に持って彼に近づいて行くのを見ると、彼は以前から出ようとしていた所の留置場を蹴破って、デッキをかけ抜けて後部の方にある監禁室に飛び込んだ。",
              "citation": {
                "source": "グロリア・スコット号",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "それなら雨戸を蹴破って斬り込むから、そう思え。",
              "citation": {
                "source": "夢のお七",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも、いつまでもこの通りでいなんしたら、遅かれ速かれ、やっぱり一間住居に決まりんしょうが……」「一間住居は蹴破っても出る」と、男の眼には反抗の強い光りがひらめいた。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は市郎の靴で額の真向を蹴破られたと見えて、濃黒いような鮮血が其凄愴い半面を浸していた。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "況て市郎の為に、最初は靴で額を蹴破られ、次に石を以て真向を打割られ、最後には味方の石に因て顔一面を砕かれたのであるから、肉は砕け、骨は露われて、其の醜、其の怪、実に形容も能ぬ光景であった。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうとう三十頭の馬が皆騒ぎ出したらしく、どかんどかんばりばりと板を蹴破る音、嘶く声、急を呼ぶ人々の叫びが暴風のように、又は戦争のように場内に響き渡った。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "禿頭の親爺がピンピンして頑張っておりましたので……その親父が引いてくれた魚類の荷籠に天秤棒を突込んで、母親が洗濯してくれた袢纏一枚、草鞋一足、赤褌一本で、雨風を蹴破ってワアッと飛出します。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかたなく障子を蹴破って縁側へ出たが、雨戸を締めない戸外は真黒で火らしいものはなかった。",
              "citation": {
                "source": "魔王物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、襖を蹴破つて穴をあけた。",
              "citation": {
                "source": "眠い一日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、突然対岸からは銅鑼がなった、すると、尾に火をつけられた一団の野牛の群れが、雲のように棚曳いた対岸の芒の波を蹴破って、奴国の陣地へ突進して来た。",
              "citation": {
                "source": "日輪",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと一処に一瞬の時も移さず宙を飛んで奴等はパツと飛び散つた、かと思ふと、てんでんに吾先きにと、或者は障子を突き抜き、或者は上りがまちからもんどり打つて転げ落ち、扉を蹴破り、一陣の突風を巻き起しながら風を喰つて一目散に逃走した。",
              "citation": {
                "source": "バラルダ物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "扉を蹴破つてやれ、そして出て来た奴から誰彼の差別もなく、一騎打ちだ！",
              "citation": {
                "source": "月あかり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは座敷へあがると同時に、いつか泥酔の挙句唐紙などを蹴破つたり、手あたり次第のものを売り飛したりしたのが、非常に恥しかつたので、おそるおそる見廻したところ綺麗に痕かたもなく片づいてゐるので吻つとした。",
              "citation": {
                "source": "茜蜻蛉",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを聞いて此方が悶絶してしまつたのだつたから仔細は判別出来なかつたが、程経て私は息を吹き返したから、兜を脱いでそのあたりを見聞すると、祠の扉が蹴破られてゐて、堂の中には、賽ころや銀貨や酒の道具が散乱してゐるのだ。",
              "citation": {
                "source": "鬼の門",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と吠えて、立ちあがりさうにすると、二人は、かんばんの腰高障子を蹴破つて遁走してしまつた。",
              "citation": {
                "source": "心象風景（続篇）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "奇怪の光景に驚き乍らも、素破敵を見付けたわと、戸を蹴破つて押し入りつ松蔵は大音に呼ばはるやう「今は天命遁れ難し、いで立ち上がつて勝負せよ！",
              "citation": {
                "source": "高島異誌",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と木戸口が蹴破られ、軒の高さよりも尚身丈の高い、腹突出した大山伏が、三才の松太郎を小脇に抱え、馬のように走り出た。",
              "citation": {
                "source": "稚子法師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　小間使いお菊の女勘助と、大日坊の火柱夜叉丸とは、戸を蹴破って飛び出した。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　とその時ビショット邸からけたたましい声が響いて来たが、潜門を蹴破り飛び出して来たのは見覚えのある貧乏神で、小脇に二本の箱を抱え飛鳥のように駆け過ぎた。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫れゆえ大きな声を出して蹴破って中へ飛込みさえすれば誠に楽な話だ。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
