          "literary": [
            {
              "text": "この夜はあたかも嫩会の若き人々わが家にあつまりて劇談会を催す例会の夕なりしかば、通知するまでもなく皆々来りあつまる。",
              "citation": {
                "source": "叔父と甥と",
                "author": "――甲字楼日記の一節――",
                "note": "青空文庫"
              }
            },
            {
              "text": "地に墜ちて殻ばかりなり秋の蝉　二十四日、嫩会の人々打ちつれて青山へまいる。",
              "citation": {
                "source": "叔父と甥と",
                "author": "――甲字楼日記の一節――",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫩会全員で押し出した事も再三ならずあった。",
              "citation": {
                "source": "解説　趣味を通じての先生",
                "author": "額田六福",
                "note": "青空文庫"
              }
            },
            {
              "text": "その年の秋には、それをもって例の嫩会の連中と青梅から、多摩上流を氷川村まで行かれた。",
              "citation": {
                "source": "解説　趣味を通じての先生",
                "author": "額田六福",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
