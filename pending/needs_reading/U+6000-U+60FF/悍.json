        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "精悍無比の表情を装い、斬人斬馬の身ぶりを示して居るペテロは誰。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "田村麻呂、頼義、義家などの武将が、これを緩服するに頗る困難であつたのも、敵手が単に無智なるがために精悍なる台湾生蕃の如き土族でなかつたと考へて、はじめて氷解するのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とぐろを巻いて、しかも精悍な、ああ、それは蝮蛇そっくりである。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日焼けした精悍な顔になっていた。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "街を、剽悍な蒙古騎兵の一隊が南へ、砂煙を立てながら、風のように飛んで行く。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "慄悍な動物は、弾丸をくぐって直ちに、人に迫って来る。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋色をした小さな身体が精悍の気ではち切れそうに見えた。",
              "citation": {
                "source": "蜂が団子をこしらえる話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後で立った人は、短い顔と多角的な顎骨とに精悍の気を溢らせて、身振り交じりに前の人の説を駁しているようであった。",
              "citation": {
                "source": "議会の印象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがこのうえ後れると、勇悍なのが一羽｜押寄せる。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、選抜した慓悍な黒潮騎士の精鋭｜等に、長槍をもって四辺を払わせて通るのです。",
              "citation": {
                "source": "海神別荘",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そうでしょうとも、あなたには、何処か精悍な歯があるわ。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "硬い老幹と、精悍な痩せた枝の緊密な組み合せは、鋼鉄と鋳鉄を混ぜ合せて作つた廊門を想はせる。",
              "citation": {
                "source": "花は勁し",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月末頃から咲き出した紅椿の上枝の花は、少し萎れかかって花弁の縁が褐色に褪せているが、中部の枝には満開の生き生きした花が群がり、四月下旬の午後になったばかりの精悍な太陽の光線が、斜めにその花の群りの一部を截ち切っている。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば一頭の悍馬谷川へ陥ちて今や押し流されんず有様。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し位の悍馬でも峠位は差支えなかろうが、後の三人と来ては、生まれて以来、しみじみ馬背の厄介になった事すらない人間だ。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と見る／＼内に長蛇の船列は横形の列に變じて、七｜隻の海賊船の甲板には月光に反射して、劍戟の晃くさへ見ゆ、本艦の士官水兵は一時に憤激の眉を揚げた、中にも年少士官等は早や軍刀の※を握り詰めて、艦長の號令を待つ、舷門の邊、砲門の邊、慓悍無双の水兵等は腕を摩つて居る。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "電光艇の觀外塔には、櫻木海軍大佐、武村兵曹、日出雄少年、他三十｜餘名の慓悍無双なる水兵あり。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその弁護人が摯悍矯直にして裁判官を面責することを恐れざる放胆を予め示して置いたときである。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "悍馬〔二〕廐肥をはらひてその馬の、　　まなこは変る紅の竜、けいけい碧きびいどろの、　　天をあがきてとらんとす。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）むっとしたような慓悍な三十台の男の声がした。",
              "citation": {
                "source": "泉ある家",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）またその慓悍な声が刺すように云った。",
              "citation": {
                "source": "泉ある家",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕のほしいのは早耳と、それから、お嬢さんです」　いつの間に見染めたのか、陽子を妻にくれという章三の言葉は、鉱三を驚かせたが、しかし、小切手を背景にした章三の精悍な顔と、押しの強さは、鉱三の青年時代を想わせて、満更でもなかった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、さすがに不安は残り、キョロキョロうしろをみていると、十番線のホームで大阪仕立ての東京行き急行列車の二等に乗ろうとしている三十過ぎの男の精悍な顔が眼にはいった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "精悍な面魂に欠けた前歯――これがふと曲物のようなのだ。",
              "citation": {
                "source": "四月馬鹿",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は彼女に何の魅力も感じないどころか、万一まかり間違ってこの女と情事めいた関係に陥ったら、今は初々しくはにかんでいるこの女もたちまち悍婦に変じて私の自由を奪うだろうという殺風景な観察すら下していた。",
              "citation": {
                "source": "髪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和五年一月、渋柿）　　　　　　　＊「三毛」に交際を求めて来る男猫が数匹ある中に、額に白斑のある黒猫で、からだの小さいくせに恐ろしく慓悍なのがいる。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルネラは昔の力士の大砲を思い出させるような偉大な体躯となんとなく鈍重な表情の持ち主であり、ベーアはこれに比べると小さいが、鋼鉄のような弾性と剛性を備えた肉体全体に精悍で隼のような気魄のひらめきが見える。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "悍馬を慣らす顛末は、もちろん編集の細工が多分にはいってはいるであろうが、あばれるときのあばれ方はやはりほんとうのあばれ方で寸毫の芝居はないから実におもしろい。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この映画を見て、自分ははじめて悍馬の美しさというものを発見したような気がする。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "運転手は悍馬を乗鎮めるが如くに腰を切って、昂然として、（来る……九月一日、十一時五十八分までは大丈夫請合います。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
