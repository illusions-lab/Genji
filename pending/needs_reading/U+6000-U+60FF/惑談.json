        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これを自己催眠の一種とするが、世間の狐惑談は多く自己催眠である。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "世に狐惑談多き中には、かくのごときの類もすくなくなかろうと思う。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "民間に伝われる書物に『人狐弁惑談』と申すものがある。",
              "citation": {
                "source": "迷信解",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのことにつき、『人狐弁惑談』の書中の一節を転載しておこう。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
