          "literary": [
            {
              "text": "と云うのは、小道具掛りの中に、たしか今里銀五郎とかいった、恰腹のいい、顔中切り傷だらけの男がいたっけね。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "客のうちで赭顔の恰腹の好い男が仕手をやる事になって、その隣の貴族院議員が脇、父は主人役で「娘」と「男」を端役だと云う訳か二つ引き受けた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の顔色とその巨きな恰腹を見るとみな気が鎮まった。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
