        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さういふ時また室生は、手製の紙箱などを造つて、金三錢也の玩具の笛を、さも貴重品か何かのやうにし、恭々しく包裝して讓り渡すのである。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お爺さんは、鬼どもの酒宴の円陣のまんなかに恭々粛々と歩を運び、「ふつつかながら。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お爺さんは、鬼どもの酒宴の圓陣のまんなかに恭々肅々と歩を運び、「ふつつかながら。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "杜氏は、恭々しく頭を下げて、伏目勝ちに主人の話をきいた。",
              "citation": {
                "source": "砂糖泥棒",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼方此方と搜す中、漸とのことで大きな無花果の樹蔭に臥こんで居るのを見つけ出し、親父は恭々しく近寄つて丁寧にお辭儀をして言ふのには『實は今日お願があつてお邪魔に出ました。",
              "citation": {
                "source": "怠惰屋の弟子入り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一度お目にかかり度いと思ってたのに、お目にかかれて」　ここで今までの雛妓らしい所作から離れてまるで生娘のように技巧を取り払った顔付になり、わたくしを長谷の観音のように恭々しげに高く見上げた。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士は笑って相手にしないで壇を下りて行くねえ、子供の助手は少し悄気ながら手を拱いてあとから恭々しくついて行く。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなまっ黒な長い服を着て、恭々しく礼をいたしました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると一人の判事が恭々しく申しました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペンネンネンネンネン・ネネムは、恭々しく進んで片膝を床につけて頭を下げました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "警察長は新聞のくらいある名刺を出してひろげてネネムに恭々しくよこしました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い前掛をつけたばけものの給仕が、さしわたし四尺ばかりあるまっ白の皿を、恭々しく持って来て卓子の上に置きました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　説教の木のとなりに居た鼠いろの梟は恭々しく答へました。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」海蛇は白髪を振って恭々しく申しました。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　けらいたちが一度に恭々しくお辞儀をしました。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　説教の木のとなりに居た鼠いろの梟は恭々しく答えました。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "穴熊は自分の外套を恭々しく獅子の傍まで持つて行くと、獅子は寝そべつたまゝで、いかにも面倒臭さうに穴熊に着せた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "「失礼でございますが」　と、式部官の一人が恭々しく訊ねたのである。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして私たちの虔ましく取り囲んでいるこの卓子は、恐らく殿下の侍従たちの額が恭々しく集められたことであろう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、また、向うの壁と壁との隅、その高い上部にぶちつけた三角の小棚には何が恭々しく飾られてあったか。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十日後でなければ、それがふたたび開かれることがないであろうことを知っていた悟浄は、睡れる先生に向かって恭々しく頭を下げてから、立去った。",
              "citation": {
                "source": "悟浄出世",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "橿原宮の御即位の式には、大伴氏、久米氏、物部氏の祖は、矛を執つて、儀衛に任じ、斎部氏、中臣氏の祖＊は、恭々しく御前に進み出て、祝詞を言上し奉つてゐる。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツカツカと平馬の前に進み寄って、恭々しく、頭を下げた。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "領事館へ挨拶に行けば、英吉利の王様の写真などが恭々しく飾ってあって、まるで倫敦のような気持になる。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と樽野は吃驚りして、その手を恭々しくおしのけたのである。",
              "citation": {
                "source": "円卓子での話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "何枚かを丁寧に立派にとぢて、恭々しく母に捧げよう……これやア、案外仕事としても面白いかも知れないぞ――などと、彼は呟いた。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "とおばあさんは、普段の源兵衛さんぢやないから斯う云つて恭々しくお辞儀をしたけれど、お前達も出遇つたら丁寧に頭を下げるんだぜ。",
              "citation": {
                "source": "熱い風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と気づいたので、今日は、わざわざ丸ビルの食料品店に出掛けて、この魚を購つて来た、まあ、どうぞ、これを――といふやうに、半ば鹿爪らしく、半ば苦笑をしながら、恭々しく贈られた。",
              "citation": {
                "source": "断想的に",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの市長は一個の煉瓦に至るまで恭々しく自らの手で焼き、一つ一つ自分で積みあげて、塔を建て、ビルヂングを建てゝゐる目醒しい努力家だ。",
              "citation": {
                "source": "花束一つ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
