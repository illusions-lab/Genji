          "literary": [
            {
              "text": "ギヨオテのメヒストフエリスを捕捉して其曲中に入らしむるや、必らずしも斯の如き他界の霊物実存せりと信ぜしにもあらざるべし、余が他界に対する観念を論じて、詩歌の世界に鬼神を用ふる事を言ふも、強いて他界の鬼神を惑信するにはあらず。",
              "citation": {
                "source": "他界に対する観念",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "またしても、「惑信！",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "こりゃあどうも惑信沙汰に違えねえて。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "惑信と言えばまず家の方位だ。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "「家の内には井の神――おう、惑信！",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だが待てよ、あの高札が惑信の本尊じゃあねえかな。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            }
          ]
        }
