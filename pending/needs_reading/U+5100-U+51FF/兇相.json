        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "世に獅子が猛烈だの、狼が兇惡だのといつて、此猛狒ほど恐ろしい動物はまたとあるまい、動物園の鐵の檻の中に居る姿でも、一見して戰慄する程の兇相、それが此深林の中で襲來したのだから堪らない。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "その友人は、手相を専門に研究していたが、ある日自分の掌に肉親に不幸があるという兇相が現われたのである。",
              "citation": {
                "source": "易と手相",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "掌中の兇相は自分自身の身上であったことに気がつかなかったのである。",
              "citation": {
                "source": "易と手相",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "……四壁全く定まらず、眷族惨害の兇相に」　象牙の箆ででも擦るような、滑らかな音が聞こえて来た。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "棘のように高い鋭い鼻、それはむしろ兇相である。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人は兇相の老人である。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれも兇相の連中である。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」新吾の顔に一瞬間、身振るいするような兇相が、ムラムラとばかり現われた。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬっと姿を現わしたのは、向こう傷のある兇相の武士。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時アニキはたちまち兇相を現わし、大喝一声した。",
              "citation": {
                "source": "狂人日記",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "兇悪遂に身をほろぼした、かれの凄味と、断末の無念そうな眉間の影は消えていないが、頭巾をとれば年頃まだ三十に足らず、白蝋青隈の死相、ほつれ毛たれて耳朶に一点の血、生ける時の兇相よりは、むしろ美男に見えたくらいである。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "鳴門の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、世の乱脈な兇相は、ひとりこの地方ばかりではない。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、陽はかげって、狂風砂を飛ばし、白波乱岸を搏って、天地は須史のまに、険しい兇相をあらわして来た。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
