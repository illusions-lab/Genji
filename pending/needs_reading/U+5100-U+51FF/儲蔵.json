        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "徳さんの言ふ所に拠れば、当時山陽が伊沢氏の家に留めた筆蹟が、近年に至るまで儲蔵せられてあつたさうである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "此書も亦、彼詩集と同じく、富士川游さんの儲蔵する所となつてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗家三世瑞仙直温繕写の過去帖及二世全安儲蔵の過去帳に拠るに、此瑞長の後に猶一人の瑞長があつたらしく、法諡用ゐる所の文字より推するに、初の瑞長は天渓と号し、後の瑞長は三矼と号したらしい。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "天下の名画を蒐めた徽宗の宣和御府の儲蔵も、往年の乱で大部分は散逸したが、臨安の新都には、中興館閣儲蔵の制がふたたび設けられた。",
              "citation": {
                "source": "人間山水図巻",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
