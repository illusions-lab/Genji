        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "火のかたなるべきか、冰のかたなるべきか。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "（かの身材小さき男は冰の如き短劍を拔き出だして手に持ちたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しその尊さの蔭には尊さそのものをも冰らせるような淋しさが潜んでいる。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫木集中に詠ずる冰室ならんか。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "土人冰室が嶽といふ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "（正月二日｜祁寒、硯に生冰。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」売冰は何の国の風俗であらうか。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時の江戸に冰を売るものがあつたか、どうかは不詳である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おまえは何者か」とおたずねになりますと、「私はこの国の神で井冰鹿と申すものでございます」とお答えいたしました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その神たちの中に、秋山の下冰男という神がいました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "全軍の将卒に各二升の糒と一個の冰片とが頒たれ、遮二無二、遮虜※に向かって走るべき旨がふくめられた。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはちょうど冰水を飲んだように。",
              "citation": {
                "source": "続黄梁",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おのが身を世に知れず隠さんために、みずからの聡明の光を和らげ、「予として冬、川を渉るがごとく、猶として四隣をおそるるがごとく、儼としてそれ客のごとく、渙として冰のまさに釈けんとするがごとく、敦としてそれ樸のごとく、曠としてそれ谷のごとく、渾としてそれ濁るがごとし（二二）。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "二二　予として冬川を渉るがごとく、猶として四隣をおそるるがごとく、儼としてそれ客のごとく、渙として冰のまさに釈けんとするがごとく、敦としてそれ樸のごとく、曠としてそれ谷のごとく、渾としてそれ濁るがごとし。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月十六日冬夜偶成硯池冰欲雪　　硯池氷りて雪ならんとするも、茵蓐暖於春　　茵蓐春よりも暖かなり。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "落華生「春桃」、冰心女士「超人」「うつしえ」、葉紹鈞「稲草人」「古代英雄の石像」、郭沫若「黒猫」「自叙伝」等である。",
              "citation": {
                "source": "春桃",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のように、中国文化について知らない者でさえも、謝冰心女士の名は聞いて久しいし、郭沫若と云えば、彼が日本の家の内に愛妻と愛子たちとをのこし故国へ向って脱出した朝の物語までを、心に銘して知っている。",
              "citation": {
                "source": "春桃",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "冰心女士の作品である。",
              "citation": {
                "source": "春桃",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パール・バックの作品を近代の堂々とした三面鏡にたとえるならば、冰心女士のこの小説は、紫檀の枠にはめこまれた一個の手鏡というにふさわしい。",
              "citation": {
                "source": "春桃",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「淑貞や、私は中国へ帰ろうかと思っているんだよ」　冰心女士は、読み終った人々の心の中に同情と哀愁とを湛えさせたまま、そっと自分はものかげへ退いてしまう。",
              "citation": {
                "source": "春桃",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中国の謝冰瑩という、連合国の代表で来ておった人が、上海へ帰りまして、「日本の人は立派です。",
              "citation": {
                "source": "社会と人間の成長",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其は火袁理命の目無堅間・熊野大神の八目荒籠・秋山下冰壮夫の形代を容れたといふ川島のいくみ竹の荒籠などぼつ／＼見えてゐるのが其で、どうやら供物容れが神の在処であつたことを暗示してゐる様である。",
              "citation": {
                "source": "髯籠の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時、塚穴の深い奧から、冰りきつた、而も今息を吹き返したばかりの聲が、明らかに和したのである。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "其文望之如冰凌之理也。",
              "citation": {
                "source": "染織に關する文獻の研究",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "も一度、こう　こう　こう其時、塚穴の深い奥から、冰りきつた、而も活き出したばかりの様な声が、明らかに和したのである。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時、塚穴の深い奥から、冰りきつた、而も今息を吹き返したばかりの声が、明らかに和したのである。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時、塚穴の深い奥から、冰りきった、而も今息を吹き返したばかりの声が、明らかに和したのである。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋山下冰壮夫に対する春山霞壮夫の御母の採つた方法などは、此例のとこひの著しい例である。",
              "citation": {
                "source": "「ほ」・「うら」から「ほがひ」へ",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
