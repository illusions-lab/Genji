          "literary": [
            {
              "text": "儻くは生家の祖母か。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "国権派の政治家、すなわち後の民選議院建白者は政策において粗豪の嫌いなきにあらざれども、その気質は※儻正大を旨とし、学者の講談、志士の横議には毫も危懼を抱かず、むしろ喜んで聴くの風ありき。",
              "citation": {
                "source": "近時政論考",
                "author": "陸羯南",
                "note": "青空文庫"
              }
            },
            {
              "text": "年二十性｜※儻、縦横の術を喜び任侠を事とす。",
              "citation": {
                "source": "岷山の隠士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "※儻不羈の精神が、軽快洒脱の精神に変った。",
              "citation": {
                "source": "岷山の隠士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩人特有の白昼夢とも云えれば、※儻不羈の本性が、仙骨を破って迸しったとも云えた。",
              "citation": {
                "source": "岷山の隠士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗟乎｜儻非名將仗皇威而勦之。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "儻くは所謂天道は是か非か。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "伯夷列傳第一",
                "note": "青空文庫"
              }
            },
            {
              "text": "儻所謂天道是耶非耶。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "伯夷列傳第一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
