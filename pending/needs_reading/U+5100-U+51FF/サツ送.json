        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アンドレ・ジッドに一冊送って批評をもらおう。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日スケッチ帳ヲ三冊送リマシタ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "義庵老師から、禅の生活と大乗禅とを六冊送つて下さつた、深謝感佩。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "……澄太君から地下の水を四冊送つて来た、先日懇請したのであるが、それにしても、君の正しい温情が今更のやうに有難い。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の毒だとお思ひなら、貴女の書物を一冊送つて呉れ」と申込んで来た。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜速達で大泉という人の写し上中下三冊送られました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうか上下二冊送るようにして下さい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五日　漸々本が出来て十五冊送ってくれる。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がこの間、それの返事を受取りたいばっかりに、女学校を卒業してからも英吉利語の勉強をしていたお前の姉に、洋書を二三冊送ってやったので、そのお礼だった。",
              "citation": {
                "source": "麦藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "なおＲ大尉は「君はジャーナリストだそうだが、帰国して本でも書いたら一冊送ってくれないか」と僕の手帳にアドレスを書いた。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と聞いたら「面白い探偵小説を二、三冊送ってくれ」といったそうだ。",
              "citation": {
                "source": "探偵小説このごろ",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンドレ・ジツドに一册送つて批評をもらはう。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この本が出來ましたら、木曾の伯父さんの家に勉強して居る三｜郎のところへも一｜册送りたいと思ひます。",
              "citation": {
                "source": "ふるさと",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がこの間、それの返事を受取りたいばつかりに、女學校を卒業してからも英吉利語の勉強をしてゐたお前の姉に、洋書を二三册送つてやつたので、そのお禮だつた。",
              "citation": {
                "source": "麥藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
