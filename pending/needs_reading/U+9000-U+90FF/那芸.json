        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "旦那芸の典型である。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "葛西善蔵先生ハ、旦那芸ト言ウテ深ク苦慮シテ居マシタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "水戸神なる速秋津彦、速秋津姫二神の、河海に因りて持ち別けて、生みし神に、沫那芸神あり、沫那美神あり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "津右衛門の棋力は旦那芸にあらず、実力五段充分と諸国の碁打に折紙づきの評判が二十年もつづいて、各家元の打手をのぞいて、田舎棋士の筆頭に押されている達人であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "所詮は田舎の旦那芸。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旦那芸」というのは、この首ふり三年が一生続く芸である。",
              "citation": {
                "source": "脱出と回帰",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那芸というより、芸が身をたすける段階に入るのである。",
              "citation": {
                "source": "脱出と回帰",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいていの旦那芸はこれである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸人というのではなく、なかば好きからの旦那芸で、花見ごろから田植の始まるころまで、調布、府中、青梅などの村々をまわって歩き、名主の家の広座敷やお寺の本堂などで、説教節にあわせて、『石童丸』『出世景清』『牡丹灯籠』『四谷怪談』などの写し絵をうつして見せる。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "日高川",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤絵というのはあまりないのですが、魁丼などは素敵にうまい達者なもので、金気釉だって旦那芸ですから、いやしくなく、また強い。",
              "citation": {
                "source": "私の作陶体験は先人をかく観る",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから少くとも奈良朝頃までの芸術は六朝から唐代にかけて行われた支那芸術の標本であり、その模造であって、我々の民族の芸術ではない。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那芸といえば義太夫だ。",
              "citation": {
                "source": "心のアンテナ",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜左衛門は似相という俳号をもって、蕉風の俳諧では、すでに旦那芸の域をぬきんでていた。",
              "citation": {
                "source": "其角と山賊と殿様",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらく、ほんとうのとこは旦那芸ぐらいな腕だろうというんだが」「あてにはなるめえ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――世間の噂にゃ、托塔旦那は、男｜伊達だ、槍や棒も旦那芸じゃねえ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "耕すに手頃な土地なんぞ手に入れることが出來てさ、それもそれだけで食ふといふのなら大へんなことだが、耕すといふことも旦那藝で、田園趣味の程度ですましておいて差支へない結構な御身分なんだ。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "是れ支那藝術一般の傾向より考ふるも明かにして、唐代までは彫刻大いに行はれしも、宋代以後には頗る衰へたり。",
              "citation": {
                "source": "日本の肖像畫と鎌倉時代",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "この速秋津日子、速秋津比賣の二神、河海によりて持ち別けて生みたまふ神の名四は、沫那藝の神。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "沫那藝の神より國の久比奢母智の神まで并はせて八神。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に奧津那藝佐毘古の神。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に邊津那藝佐毘古の神。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
