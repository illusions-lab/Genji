        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "友なる男は、アントニオ、物にや狂へると私語ぎて、急に婦人を拉きつゝ、巡査、希臘人、牧婦などにいでたちたる人の間を潛りて逋れ去りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにおいて諸屯邸に至り、諸強族が官兵を役使しまた逋亡を蔵せるを検校し、ことごとく事を以て言上し、罪さるる者甚だ多し、陸杭時に江陵の都督たり、ことさらに孫皓に下請し、しかる後釈くを得たりとある。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "また禁制品や逋税を取締る爲に、官憲がその輸入物貨を檢閲する。",
              "citation": {
                "source": "蒲壽庚の事蹟",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も、古くして尚、痕を曳くのは、本の意の忘却せられて後、新しい利用の逋げ路を開くゆとりのあるものであつた為である。",
              "citation": {
                "source": "稲むらの蔭にて",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "又諸国の百姓課役を逃れ、租調を逋るゝ者、私に自ら髪を落し、猥りに法服を著く。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "これすなわち清行のいわゆる「諸国の百姓課役を逃れ、租調を逋るゝ者、私に自ら髪を落し、猥りに法服を著く」とある者である。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "敢て許允を求めず、政府待つに逋亡を以てするも可なり。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜窓如夢到西湖月下見花思老逋忽有鐘声来呼醒挙頭半幅墨梅図　信孝。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
