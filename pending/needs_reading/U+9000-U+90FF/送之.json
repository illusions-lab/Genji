          "literary": [
            {
              "text": "又称別禄、生美絹積船三艘送之処、仏師抃躍之余、戯論云、雖喜悦無極、猶練絹大切也云云。",
              "citation": {
                "source": "奥州における御館藤原氏",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "而依聞大衆蜂起事、自其所、以山臥之姿、称可入大峯之由入山、件坊主僧送之。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
