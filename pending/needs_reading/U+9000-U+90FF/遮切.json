        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしそのとき、すいすいと足早に近寄って遮切ったのは主水之介です。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いえ、あの、殿――」　再び門七が慌てて遮切ると、千之介を庇うように言った。",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまで点々としてしょんぼりうなだれていた千之介が、突如｜面をあげると、何ごとか恐れるように声をふるわせ乍らけわしく遮切った。",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "よし行こう」二　明けても暮れても単調な、だだっぴろい眼を遮切るもののない曠野である。",
              "citation": {
                "source": "シベリヤに近く",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええ、その……私のみつけ出した、幽霊なんですが」　すると警部は遮切るようにして、「じゃア君は、もう澄子を殺した犯人を、知ってると云うんだね？",
              "citation": {
                "source": "銀座幽霊",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "房枝はあの通り地味な着物を着ていたし、澄子は、あの通り派手な着物を着ていたし……」「お待ち下さい」支配人が遮切った。",
              "citation": {
                "source": "銀座幽霊",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "出掛けよう」「待って下さい」技師が遮切った。",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり飛び出してホッとして振返った女と、防火扉を締めかけた浅川監督との間のなにもなかった空間に、峯吉がいたわけです……」「待て待て、君の云うことは、どうも判るようで、判らん」　係長が、顔を顰めながら遮切るようにして云った。",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう、私の考えていることが、いや、こうよりほかに考えざるを得ないことが、大体お判りになったでしょう……つまり、峯吉は、あの発火の時に、てんから坑内には入っていなかったのですよ」「待ち給え」係長が遮切った。",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで少しでも発火坑の開放を遅くらそうとしたのです」「待ち給え」　再び係長が遮切った。",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「な、なぜ、あんな白状をなすったのですか」「それは今云う通り――」「いえ、いえ」　静子は激しく遮切った。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しもし先生が彼に憐れみを垂れて下されば――」「鳥渡お待ち下さい」　神戸牧師は遮切った。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不意に車力は女の道を遮切るやうに寄つて行つた。",
              "citation": {
                "source": "貝殼追放",
                "author": "女人崇拜",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、女に力を出させては気の毒、それに袖を濡らすと宜しく無い」　竜次郎はそれを遮切って、矢張自分で手繰るので有った。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と女は遮切つて、やゝ真剣に眼を光らせた。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と裕佐は遮切つた。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と一人の百姓らしい男が傍から立ち上つて遮切つた。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
