        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「落合敬助太田同居にてたび／＼御逢被成候よし、如仰好人物也。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「金輪上人度々御逢被成候よし、御次に宜奉願上候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "梧堂つてにて御逢被成候ひしや。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆゑ茶山は「梧堂つてにて御逢被成しや」と云つてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "つがるや市のや両三右衛門時々御逢被成候哉、いづれもおもしろき人物に候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "和尚に御逢被成候はば、宜御申可被下候、草々。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
