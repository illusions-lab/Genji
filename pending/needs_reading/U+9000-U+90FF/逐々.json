          "literary": [
            {
              "text": "が、前者は家が乱れはせぬかといふ打算的｜杞憂から、後者は、例の彼の矜持が、彼を逐々、何の間違ひもないうちに引きとめた。",
              "citation": {
                "source": "老主の一時期",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "高柳曰、御頼の事件ハ逐々重役ニ申聞候処、実御尤の御事と一同申居候。",
              "citation": {
                "source": "坂本龍馬手記",
                "author": "イロハ丸航海日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "……されば、逐々戻り来しか。",
              "citation": {
                "source": "生霊",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあさんは、また涙になって、「兄様が、逐々戻り来しぞ。",
              "citation": {
                "source": "生霊",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
