        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "炬燵の火もいとよし、酒もあたゝめんばかりなるを。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうち子供は、炬燵にもぐり込んで転寝をしている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにその同じ家郷を、ひとえに時間の所在に求めて、追懐のノスタルジアに耽った蕪村は、いつも冬の炬燵にもぐり込んで、炭団法師と共に丸くなって暮していた。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "芭蕉は「漂泊の詩人」であったが、蕪村は「炉辺の詩人」であり、殆んど生涯を家に籠って、炬燵に転寝をして暮していた。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは「炬燵の詩人」であり、「炉辺の詩人」であったところの、俳人蕪村の風貌を表象している。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は炬燵にあたつてゐました彼女は畳に坐つてゐました冬の日の、珍しくよい天気の午前私の室には、陽がいつぱいでした彼女が頸かしげると彼女の耳朶　陽に透きました。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは登別の温泉宿の一室で、燃えるような、緋の布団のかかった炬燵の中であった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日、夕飯をすませてから、私たちは次兄に誘はれて彼の部屋へ行き、三人して火燵にはひりながらトランプをして遊んだ。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこへかず枝が、大きい火燵を自分で運んで持って来た。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かず枝の蒲団の足のほうに、大きい火燵がいれられていて、温かそうであった。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "火燵もって来てよう。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と私は周さんと向き合って炬燵にもぐり、れいの如く愚問を発した。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だ、気が狂ってるんじゃないか、あいつが酒をやめて勉強しているなんて嘘だよ、「源の実朝さま」という子供の絵本を一冊買って来て、炬燵にもぐり込んで配給の焼酎でも飲みながら、絵本の説明文に仔細らしく赤鉛筆でしるしをつけたりなんかして、ああ、そのさまが見えるようだ。",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥の部屋に通されて、私は炬燵にあたった。",
              "citation": {
                "source": "チャンス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "炬燵の上にはお料理のお膳が載せられてある。",
              "citation": {
                "source": "チャンス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとで聞いた事だが、その弘前の或る有力者のお妾で、まあ、当時は一流のねえさんであったようである）そうして、私のあたっている炬燵の上に置いた瞬間、既に私はそのお膳の一隅に雀焼きを発見し、や、寒雀！",
              "citation": {
                "source": "チャンス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんにも書けない低能の文学少女、炬燵にはいって雑誌を読んでいたら眠くなって来たので、炬燵は人間の眠り箱だと思った、という小説を一つ書いてお見せしたら、叔父さんは中途で投げ出してしまいました。",
              "citation": {
                "source": "千代女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかみさんは心配して、峠の麓の吉田へ行き、炬燵をひとつ買つて来た。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは二月の末の事で、毎日大風が吹きすさび、雨戸が振動し障子の破れがハタハタ囁き、夜もよく眠れず、私は落ちつかぬ気持で一日一ぱい火燵にしがみついて、仕事はなんにも出来ず、腐りきっていたら、こんどは宿のすぐ前の空地に見世物小屋がかかってドンジャンドンジャンの大騒ぎをはじめた。",
              "citation": {
                "source": "黄村先生言行録",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」先生は大きい紙いれを懐中から出して火燵の上に載せてにやりと笑った。",
              "citation": {
                "source": "黄村先生言行録",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」先生は立って行って、その男の肩に手を掛け、むりやり火燵にはいらせ、「まあ一つ飲み給え。",
              "citation": {
                "source": "黄村先生言行録",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ちついた振りをしていても、火燵の中の膝頭が、さっきからがくがく震えているじゃありませんか。",
              "citation": {
                "source": "黄村先生言行録",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "折紙細工に長じ、炬燵の中にて、弟子たちの習う琴の音を聴き正しつつ、鼠、雉、蟹、法師、海老など、むずかしき形をこっそり紙折って作り、それがまた不思議なほどに実体によく似ていた。",
              "citation": {
                "source": "盲人独笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし朝は授業がないからゆっくりして日のよく当った居間の障子の内で炬燵にあたりながら何かしていた。",
              "citation": {
                "source": "病中記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくのごとく我儘であるくせにまた甚だしく臆病な彼は、自分で断然年賀端書を廃して悠然｜炬燵にあたりながら彼の好む愚書濫読に耽るだけの勇気もないので、表面だけは大人しく人並に毎年この年中行事を遂行して来た。",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "手水鉢を座敷のまん中で取り落として洪水を起こしたり、火燵のお下がりを入れて寝て蒲団から畳まで径一尺ほどの焼け穴をこしらえた事もあった。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、冬の日のわびしさに、紅椿の花を炬燵へ乗せて、籠を開けると、花を被って、密を吸いつつ嘴を真黄色にして、掛蒲団の上を押廻った。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "炬燵から見ていると、しばらくすると、雀が一羽、パッと来て、おなじ枝に、花の上下を、一所に廻った。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで座敷だが――その二度めだったか、厠のかえりに、わが座敷へ入ろうとして、三階の欄干から、ふと二階を覗くと、階子段の下に、開けた障子に、箒とはたきを立て掛けた、中の小座敷に炬燵があって、床の間が見通される。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
