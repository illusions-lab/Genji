        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二三年まえ、罪なきものを殴り、蹴ちらかして、馬の如く巷を走り狂い、いまもなお、ときたま、余燼ばくはつして、とりかえしのつかぬことをしてしまうのである。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一日、辛未、晴、若宮辻の人家焼亡す、酉戌両時の間、廿余町悉く灰燼と為る。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこれに新しき衝動を与えるものは往々にして古き考えの余燼から産れ出るのである。",
              "citation": {
                "source": "科学上の骨董趣味と温故知新",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "烈々たる渠が心中の活火はすでに燼えたるか。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "空の肌質はいつの間にか夕日の余燼を冷まして磨いた銅鉄色に冴えかかっていた。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん投書も少くなるし、内地の現代向の人に代えろと始終、編輯主任に攻撃されもしますが、なに、これだけは死ぬまで人にはやらせない積りです」　日盛りの中での日盛りになったらしく、戸外の風物は灼熱極まって白燼化した灰色の焼野原に見える。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "天明｜蕪村の時代に一度は燃え上がった余燼も到底｜元禄の光炎に比すべくはなかった。",
              "citation": {
                "source": "俳諧の本質的概論",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この能役者は、木曾の中津川に避暑中だつたが、猿樂町の住居はもとより、寶生の舞臺をはじめ、芝の琴平町に、意氣な稽古所の二階屋があつたが、それもこれも皆灰燼して、留守の細君――（評判の賢婦人だから厚禮して）――御新造が子供たちを連れて辛うじて火の中をのがれたばかり、何にもない。",
              "citation": {
                "source": "十六夜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍資器械、倶に※燼となり、河水｜尽く熱きに至る。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃ち屍を※燼中より出して、之を哭し、翰林侍読王景を召して、葬礼まさに如何すべき、と問いたもう。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝋燭の火に氣の張弛が有ると云へば可笑しく聞えるが、少しく其の心を剔らずに、心の燼餘を其の儘にして置けば蝋燭の火の氣は弛んで、其の光は暗くなり、其の功は少くなる。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝋燭の心を剪つてより暫時は漸く明らかになる、其は張る氣で有るが、又やがて暗くなるのは火の氣が餘燼に妨げられて弛み弱るからである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし水気が尽き湿潤の作用が乏しくなれば水は既に涸渇しているのであり、火気が尽き乾熱の威力作用が衰耗すれば、火も既に余燼となっているのであって、水火の本体が無ければ湿乾の気もまた無いのである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ等は漸く登りて、今暗黒なる燼餘の灰壘を打ち拔きたる洞穴の前に立てり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖母は彼｜拙く彩りたる、罪障深きものゝ手に穢されたる影像の、灰燼となりて滅せんことをこそ願ふなれといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　笹村はもう一度、その余燼を掻き廻して見たいような気がしていた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "その感傷性は老い先の短かい人間が、感情の余燼としてやつとの思ひで取り戻すことができた、感情の小さな興奮なのである。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "天明八年の火事とは、正月｜晦に洛東団栗辻から起って、全都を灰燼に化せしめたものをいうのである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その理想の美をも併せて灰燼とするに忍びず。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "後に想へば、水戸の栗山潜鋒に弊帚集六卷があつて火災に罹り、弟｜敦恒が其｜燼餘を拾つて二卷を爲した。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし燼余の五百部は世間の誅求が急なので、正誤表を添えるに遑あらずして売り出された。",
              "citation": {
                "source": "訳本ファウストについて",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘次はおつぎを相手に灰燼を掻き集めることに一｜日を費した。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は灰燼の中から鍋や釜や鐵瓶や其の他の器物をだん／＼と萬能の先から掻き出した。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京の大部分が一朝にして灰燼に帰したかと思うと、ただむやみに神経が興奮して、まったく居ても立ってもいられないので、町の人たちと一緒になって毎日そこらを駈け廻っていた。",
              "citation": {
                "source": "指輪一つ",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて、冬の陣のままで四月か半年も頑張ったならば、当時は戦国の余燼がやっと収まったばかりであるから、関ヶ原の浪人も多く、天下にどんな異変が生じたか分らないと思う。",
              "citation": {
                "source": "大阪夏之陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕をも得挙げざりし病人の今かく健に起きて、常に来ては親く慰められし人の頑にも強かりしを、空く燼余の断骨に相見て、弔ふ言だにあらざらんとは、貫一の遽にその真をば真とし能はざるところなりき。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて帰り来たりしが、その家祝融氏の怒りに触れて、たちまち灰燼となりぬ。",
              "citation": {
                "source": "失うた帳面を記憶力で書き復した人",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "一夕民家火｜作り、およそあるところの物、文書をあわせてみな燼す。",
              "citation": {
                "source": "失うた帳面を記憶力で書き復した人",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正の大震火災では、東京が灰燼になったと見ると、一目散に東京を飛び出して、五人十人二十人三十人と醜業婦を仕入れて帰って来て大金儲けをしたものが多い。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度｜灰燼となった吾が大和民族の中央都市が、かような活力と元気とに依って溌溂と蘇らせられつつあるのを見ると、真に涙ぐましい程の心強さと嬉しさを感じさせられる。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
