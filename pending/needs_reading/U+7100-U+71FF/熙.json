        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "女仙外史一百回は、清の逸田叟、呂熊、字は文兆の著すところ、康熙四十年に意を起して、四十三年秋に至りて業を卒る。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "天地和熙の時、晝は地氣の上昇し、夜は天氣の下降すると同じに、健全純氣の童子は、晝は氣が上り、夜は氣が下り、晝は陽動し、夜は陰靜し、そして平穩に靈妙に、腦力も發達し、體力も生長するのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "気息の道を以って正を保持し邪を駆逐し、病を厭い寿を全うする事は、仏家にもまた存在していたことで、吹気・呼気・嘘気・呵気・熙気・師気の六気は天台（天台宗）の智者大師が示した六気である。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹気は吹いて冷やかにする気、呼気はダン気、嘘気は出気、呵・熙・師三気は『科解』にも全くこの字体無しとしてあり、全く字の態を以って義としないとあるから、ただその帯びる声を取るので、呵気は「かー」という声を帯びた気、熙気は「きー」という声、師気は「し」という声を帯びた気をいうのである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその調子は、呵は商、吹呼は羽、嘘は徴、熙は宮、師は角であると伝えられている。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「衆人熙々トシテ大牢ヲ享クルガ如ク、春、臺ニ登ルガ如シ。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "熙々として照つてゐた春の陽は何時か烈しい夏の光に變り、澄んだ秋空を高く雁が渡つて行つたかと思ふと、はや、寒々とした灰色の空から霙が落ちかかる。",
              "citation": {
                "source": "名人傳",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "『池北偶談』二六に、〈釈典に三必死あり、いわく人の老病、竹の結実、騾の懐胎、しかるに康熙某年、旗下人の家に、騾ありて子を生みついに恙なし〉。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "淵鑑類凾三一五に、厥口呪詛、言怨上也、子罕曰、宋國區々、有詛有呪、亂之本也、康熙字典に、書無逸を引て、民否則厥心違怨、否則厥口詛祝、是等は惡政に堪ざる民が、爲政者を詛ふので、詩に出此三物、以詛爾斯、また晏子曰、祝有益也、詛亦有損、雖其善祝、豈勝億兆人之詛者とも有る。",
              "citation": {
                "source": "詛言に就て",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬆は髮亂と康熙字典に出づ。",
              "citation": {
                "source": "蓮の花開く音を聽く事",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "――支那花鳥画の名手徐熙の孫で、花卉を描くのに初めて没骨法を用いたというので知られている徐崇嗣は、豊熟した果実の枝を離れて地に墜つる状を描いて、その情趣を髣髴せしめたということだが、私は果実の大地に墜ちる音を聞くのが好きだ。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代更紗で大尽遊び５・３（夕）　平岡熙氏といへば、例の運動好きの平岡寅之助氏の兄さんで、平岡大尽の名を取つた大通である。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは康熙年間の某夏の午後のことである。",
              "citation": {
                "source": "涼亭",
                "author": "――序に代へて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "近衛忠熙は潜み、中川宮（青蓮院）も隠れた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "『女官御双紙』に「此大君は三十三君の最上なり、昔は女性の極位にて御座しゝに大清康熙六丁未年王妃に次ぐ御位に改め玉ふなり」ということがあります。",
              "citation": {
                "source": "ユタの歴史的研究",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "『女官御双紙』に、聞得大君、此大君は三十三君の最上なり、昔は女性の極位にて御座しゝに大清康熙六年丁未王妃に次ぐ御位に改め玉ふなり。",
              "citation": {
                "source": "ユタの歴史的研究",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "これじつに西暦千六百七十三年（わが延宝元年、清の康熙十二年）三月のことで、時之大屋子を廃してから七、八年後のことであります。",
              "citation": {
                "source": "ユタの歴史的研究",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて今から二百十七年前すなわち清の康熙五十六年に、この御初地入を挙行することについて端なくも政治家と聞得大君｜御殿との間に大衝突が起ったのであります。",
              "citation": {
                "source": "ユタの歴史的研究",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "けだし活字の初は『康熙字典』によりて一字々々作りたりといへば活字は極めて正しき者にてありき。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく専門的の攻撃に遇ひては余ら『康熙字典』位を標準とせし素人先生はその可否の判断すら為しかねて今は口をつぐむより外なきに至りたり。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の人が楷書の標準として見んはやはり『康熙字典』にて十分ならん。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "康熙帝が三藩を平げて支那を支配する形勢が定まつてより、明史編纂の爲め多くの學者を北京に集めた。",
              "citation": {
                "source": "支那史學史概要",
                "author": "――史記より清初まで――",
                "note": "青空文庫"
              }
            },
            {
              "text": "顧炎武の方は、彼の甥に徐乾學があり、康熙帝の氣に入りで、晩年南方に歸つて太湖の洞庭山に學者を集めて清一統志を編纂することを許され、ここに又多くの學者が集まつた。",
              "citation": {
                "source": "支那史學史概要",
                "author": "――史記より清初まで――",
                "note": "青空文庫"
              }
            },
            {
              "text": "心にある除熙の絵が働いて、私は朝靄の裡に開いたばかりの一輪の白蓮の花を思い浮べた。",
              "citation": {
                "source": "蓮花図",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "碑閣には康熙帝撰文の宝牌がある。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "老子に「衆人｜熙々。",
              "citation": {
                "source": "念仁波念遠入礼帖",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えればやさしいことで、康熙字典を翻訳すればよい。",
              "citation": {
                "source": "辞書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "康熙字典のはいってくる前から利用されているものに『玉篇』がある。",
              "citation": {
                "source": "辞書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "又支那人の方でも、彼等が天文暦算に秀でた事を認め、清朝の官制にも欽天監監正即ち天文臺長ともいふべきものは、滿一人西洋一人を以て之れに充つることに規定され、殊に康熙帝の如きは西洋の學術に注意し拉丁文字迄に通じて居たといふ話である。",
              "citation": {
                "source": "支那近世の國粹主義",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
