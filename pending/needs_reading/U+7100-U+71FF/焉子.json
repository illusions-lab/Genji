          "literary": [
            {
              "text": "長子仁焉子元端は一に雲軒と号し、医を以て朝に仕へ、益寿院と称した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "二子義焉子元淵、名は兼時、小字は平二郎、後俳人落柿舎去来となつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "三子礼焉子元成は一に魯町と号して儒となつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "四子智焉子利文、通称は七郎左衛門、出でて久米氏を嗣いだ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子信焉子兼之は通称城右衛門であつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
