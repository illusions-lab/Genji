          "literary": [
            {
              "text": "「イヤ割が悪いどころでは無い、熔金を入れるその時に勝負が着くのだからネ。",
              "citation": {
                "source": "鵞鳥",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれなら熔金の断れるおそれなどは少しも無くて済む。",
              "citation": {
                "source": "鵞鳥",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の熔金の廻りがどんなところで足る足らぬが出来るのも同じことである。",
              "citation": {
                "source": "鵞鳥",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "残念にも雄の鵞鳥の頸は熔金のまわりが悪くて断れていた。",
              "citation": {
                "source": "鵞鳥",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
