        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "王の子｜高煦、張玉等の軍を率いて斉しく進む。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "高煦急を見、精騎数千を帥い、前んで王と合せんとす。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "王これに乗じ、勁騎を以て繞って其後に出で、突入｜馳撃し、高煦の騎兵と合し、瞿能父子を乱軍の裏に殺す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "適々高煦、華衆等を率いて至り、追兵を撃退して去る。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "燕王壮士万人を分ちて敵の援兵を遮らしめ、子｜高煦をして兵を林間に伏せ、敵戦いて疲れなば出でゝ撃つべしと命じ、躬ずから師を率いて逆え戦い、騎兵を両翼と為す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "何福等｜此を見て安と合撃し、燕兵数千を殺して之を却けしが、高煦は南軍の罷れたるを見、林間より突出し、新鋭の勢をもて打撃を加え、王は兵を還して掩い撃ちたり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "高煦急に立って帝の不意に出で、一足を伸して帝を勾し地に※せしむ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "高煦｜多力なりければ、缸の重き三百｜斤なりしも、項に缸を負いて起つ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "高煦生きながらに焦熱地獄に堕し、高煦の諸子皆死を賜う。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "燕王範を垂れて反を敢てし、身｜幸にして志を得たりと雖も、終に域外の楡木川に死し、愛子高煦は焦熱地獄に堕つ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "正統帝の御父宣宗皇帝は漢王｜高煦の反に会いたまいて、幸に之を降したまいたれども、叔父の為に兵を動すに至りたるの境遇は、まことに建文帝に異なること無し。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して楡木川の客死、高煦の焦死、数たると数たらざるとは、道衍｜袁※の輩の固より知らざるところにして、たゞ天｜之を知ることあらん。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「壬午元日雪、将※新霽、天気和煦、即欣然而作。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうやって、煦々たる春日に背中をあぶって、椽側に花の影と共に寝ころんでいるのが、天下の至楽である。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "和煦の作用ではない粛殺の運行である。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに当局および老政治家らの意見は、三蔵を死に処して露国に謝するに非ざれば、国難忽ちに来らん、国家ありての後の法律なり、煦々たる法文に拘泥して国家の重きを忘るるは学究の迂論なり、宜しく法律を活用して帝国を危急の時に救うべしというにあった。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これで一切のくくりがついた、やがて、花も咲けば実もむすばれよう」と彼は誰にともなく云った、「――春日｜煦々の船出じゃからのう」　家族を落ち着かせた家中のものは邦夷の周りに集っていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "村田の煙管未世に出でざりし時、われらが祖先は既にシガレツトを口にしつつ、春日煦々たる山口の街頭、天主会堂の十字架を仰いで、西洋機巧の文明に賛嘆の声を惜まざりしならん。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "玻璃張りの天蓋を透して降りそそぐ煦々たる二月の春光を浴びながら、歓談笑発して午餐に耽る凡百の面々を眺め渡せば、これはさながら魑魅魍魎の大懇親会。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "南風吹かば　――モンテ・カルロの巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽はその中腹あたりの岩肌をキラキラと輝かせているが、天地万物｜寂としてしかも陽だけが煦々として、なごやかにこの野原に遊んでいる。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手彼方には階高く大理石の円柱林立して、エフィゲニウス邸の大殿堂が空を圧して聳え立ち、陽光は煦々として建物を蒼穹の中に浮き立たせ、ペンを軋ませている私の指先に戯れ、大噴泉は絶えず菫の薫りを四辺に撒き散らしているのです。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
