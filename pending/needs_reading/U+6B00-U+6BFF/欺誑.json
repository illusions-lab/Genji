          "literary": [
            {
              "text": "若不順我呪　悩乱説法者頭破作七分　如阿梨樹枝如殺父母罪　亦如厭油殃斗秤欺誑人　調達破僧罪犯此法師者　当獲如是殃　と一心不乱、さっと木の葉を捲いて風が南へ吹いたが、たちまち静り返った、夫婦が閨もひッそりした。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――という欺誑と譎詐に満ちた休戦状でありまた誠に虫のいい盟約の申し込みでもあった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "経論ニ迷惑シテ諸人ヲ欺誑シ、往生ノ行ヲ以テ宗トナストイエドモ、却ッテ、往生ノ行ヲ妨碍セリ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
