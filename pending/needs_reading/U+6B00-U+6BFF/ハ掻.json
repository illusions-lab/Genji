          "literary": [
            {
              "text": "あたし歯掻ゆくって仕方がなかったわ。",
              "citation": {
                "source": "ニッケルの文鎮",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おばあさまは俺が引受けたつもりだったに）さう思ふと自分の体が歯掻ゆかった。",
              "citation": {
                "source": "霜",
                "author": "金田千鶴",
                "note": "青空文庫"
              }
            },
            {
              "text": "自己の根氣と精力の足らない事を齒掻く思ふ上に、夫程歳月を掛けなければ成就出來ないものなら、自分は何しに此山の中迄遣つて來たか、それからが第一の矛盾であつた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
