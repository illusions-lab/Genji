          "literary": [
            {
              "text": "その空に、その苑に、ほのの青みに静かなる欷歔泣きもいでつつ、いづくにか、さまだるる愛慕のなげき。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "三吉は子供の傍の方で妻の歔泣の音を聞くまでは安心しなかった。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて彼女は炉辺の方で寝る仕度をしたが、三吉の耳に歔泣の音が聞えた。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝床の裾のところで、歔泣の声が起った。",
              "citation": {
                "source": "風宴",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
