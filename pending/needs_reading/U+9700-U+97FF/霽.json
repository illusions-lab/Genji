        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "霧がすっきりと霽れて、前には笠ヶ岳の大尾根が、赭っちゃけた紅殻色の膚をあらわし、小笠から大笠へと兀々とした瘤が、その肩へ隆起している、遠くの空に、加賀の白山は、いつもの冷たい藍色に冴えて、雪の縞が、むしろ植物性の白い色をおもわせる。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士山は日本では三千七百七十八米突という抜群の標高を有しているが、太平洋方面は黒潮が流れるほどの暖かさで、かつ冬季は霽れて雨量が少なく、山腹以上の傾斜が急峻であるから、これも氷河を作る資格がない。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗黒はなお霽れやらず光明はいまだ照り亘らない。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "廿七日、辛亥、霽、寅剋大地震、今朝日に光陰無し、其色赤黄なり。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "廿二日、辛未、霽、禅師公登壇受戒の為に、定暁僧都を相伴ひて上洛せしめ給ふ、将軍家より、扈従の侍五人を差遣はさる、是御猶子たるに依りてなり。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五日、丙戌、天霽、千葉介成胤、法師一人を生虜りて、相州に進ず、是叛逆の輩の中使なり、相州即ち此子細を上啓せらる。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "六日、丁未、天霽、弾正大弼仲章朝臣の使者、京都より到来す、去月廿七日閑院遷幸、今夜即ち造営の賞を行はる、将軍家正二位に叙し給ふ、仍つて其除書を送り進ず。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "廿九日、庚辰、霽、相模次郎朝時主、駿河国より参上す、将軍家の御気色並びに厳閤の義絶にて、彼国に籠居するの処、御用心の間、飛脚を以て之を召さると云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五日、乙巳、天霽、義盛、時兼以下の謀叛の輩の所領美作淡路等の国の守護職、横山庄以下の宗たるの所々、先づ以て之を収公し、勲功の賞に充てらる可しと云々、相州、大官令之を沙汰し申さる、次に侍別当の事、義盛の闕を以て相州に仰せらると云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "六日、丙午、天霽、申剋、将軍家前大膳大夫広元朝臣の亭に入御、是去る二日、御所焼失せるに依るなり、御台所、又南御堂より其所に入御、尼御台所、本所に渡御。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "廿六日、乙未、天霽、相州、武州、大官令等参会し、御所新造の事群議に及ぶ、是去る五月合戦の時、焼失するに依りてなり。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "七日、丙午、霽、今日御所に於て和歌御会有り、相州、修理亮、東平太重胤等其座に候する所なり。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十八日、丙戌、霽、子剋、将軍家南面に出御、時に灯消え、人定まりて、悄然として音無し、只月色蛬思心を傷むる計なり、御歌数首、御独吟有り、丑剋に及びて、夢の如くして青女一人前庭を奔り通る、頻りに問はしめ給ふと雖も、遂に名乗らず、而して漸く門外に至るの程、俄かに光物有り、頗る松明の光の如し。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十四日、己酉、霽、将軍家烟霞の興を催され、杜戸浦に出でしめ給ふ、漸く黄昏に及びて、明月の光を待ち、孤舟に棹して、由比浜より還御と云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日、丙申、霽、諸国炎旱を愁ふ、仍つて将軍家、祈雨の為に八戒を保ち、法花経を転読し給ふ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "廿二日、癸未、霽、丑剋大地震。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十日、辛丑、霽、申刻甚雨雷鳴。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八日、戊辰、霽、伊豆国の飛御参ず、申して云ふ、去る六日、戌剋、入道遠江守時政、北条郡に於て卒去す、日来腫物を煩ひ給ふと云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五日、甲子、快霽、将軍家、花を覧んが為、三浦の横須賀に御出。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "廿二日、己酉、霽、地震、鷺の怪の事、御占を行はるるの処、重変の由之を申す、仍つて御所を去つて、相州の御亭に入御、亭主は他所に移らると云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六日、庚子、霽、終日風烈し、連々の天変等の事、将軍家殊に御謹慎有る可きの変なりと云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七日、辛未、霽、将軍家の御持仏堂の御本尊、運慶造り奉り、京都より渡し奉らる、開眼供養の事有る可し、信濃守行光奉行として其沙汰有り。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "四日、丙午、快霽、尼御台所御上洛。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "廿日、庚申、霽、内蔵頭忠綱朝臣勅使として下向す、先づ御車二両、已下御拝賀料の調度等、之を舁かしむ、疋夫数十人歩列す。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三日、辛巳、天晴陰、酉刻快霽、明月の夜、御所にて和歌の御会なり。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五日、癸卯、霽、鶴岳の別当公暁、宮寺に参籠して、更に退出せられず、数ヶの祈請を致され、都て以て除髪の儀無し、人之を恠しむ、又白河左衛門尉義典を以て、大神宮に奉幣せんが為、進発せしむ、其外諸社に使節を立てらるるの由、今日御所中に披露すと云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "松本から島々までの電車でも時々降るかと思ふと又霽れたりしてゐた。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の隧道を抜けていよ／＼上高地の関門をくゞつたとき一番に自分の眼に映じた美しい見ものは、昔から写真でお馴染の大正池の眺めではなくて、丁度その時雲の霽間にその全貌を現はした焼岳の姿と色彩とであつた。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "松本から島々までの電車でも時々降るかと思うとまた霽れたりしていた。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の隧道を抜けていよいよ上高地の関門をくぐったとき一番に自分の眼に映じた美しい見ものは、昔から写真でお馴染の大正池の眺めではなくて、恰度その時雲の霽間にその全貌を現わした焼岳の姿と色彩とであった。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
