          "literary": [
            {
              "text": "万葉集を見ると、雨障・霖禁・霖忌など書いて、あまつゝみとよませて居る。",
              "citation": {
                "source": "大嘗祭の本義",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、此ながめは、霖禁に関係がありさうだ。",
              "citation": {
                "source": "大嘗祭の本義",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "本義は、五月の田植ゑ時の慎しみ、即、雨つゝみ（雨障・霖禁）である。",
              "citation": {
                "source": "大嘗祭の本義",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
